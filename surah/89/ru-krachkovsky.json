{
  "surah": 89,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Клянусь зарею,"
    },
    {
      "number": 2,
      "text": "и десятью ночами,"
    },
    {
      "number": 3,
      "text": "и четом и нечетом,"
    },
    {
      "number": 4,
      "text": "и ночью, когда она движется!"
    },
    {
      "number": 5,
      "text": "Разве в этом - не клятва рассудительного?"
    },
    {
      "number": 6,
      "text": "Разве ты не видел, как поступил твой Господь с Адом,"
    },
    {
      "number": 7,
      "text": "Ирамом, обладателем колонн,"
    },
    {
      "number": 8,
      "text": "подобного которому не было создано в странах,"
    },
    {
      "number": 9,
      "text": "и самудитами, которые пробивали скалы в долине,"
    },
    {
      "number": 10,
      "text": "и с Фирауном, обладателем кольев,"
    },
    {
      "number": 11,
      "text": "которые творили нечестие в странах"
    },
    {
      "number": 12,
      "text": "и умножали там порчу?"
    },
    {
      "number": 13,
      "text": "Пролил на них Господь твой бич наказания."
    },
    {
      "number": 14,
      "text": "Ведь Господь твой - в засаде."
    },
    {
      "number": 15,
      "text": "А человек, когда испытает его Господь, почтит и облагодетельствует, тогда он говорит: \"Господь мой почтил меня!\""
    },
    {
      "number": 16,
      "text": "А когда Он испытает его и определит ему пропитание, то он говорит: \"Господь мой унизил меня!\""
    },
    {
      "number": 17,
      "text": "Так нет! Вы сами не почитаете сироту,"
    },
    {
      "number": 18,
      "text": "не поощряете покормить бедняка,"
    },
    {
      "number": 19,
      "text": "пожираете наследство едой настойчивой,"
    },
    {
      "number": 20,
      "text": "любите богатство любовью упорной."
    },
    {
      "number": 21,
      "text": "Так нет! Когда будут распростерта земля плоско,"
    },
    {
      "number": 22,
      "text": "и придет твой Господь и ангелы рядами,"
    },
    {
      "number": 23,
      "text": "и приведут тогда геенну - в тот день вспомнит человек, но к чему ему воспоминание?"
    },
    {
      "number": 24,
      "text": "Он говорит: \"Если бы я уготовал вперед для моей жизни?\""
    },
    {
      "number": 25,
      "text": "И в тот день никто не накажет его наказанием"
    },
    {
      "number": 26,
      "text": "и никто не завяжет его оковами."
    },
    {
      "number": 27,
      "text": "О ты, душа упокоившаяся!"
    },
    {
      "number": 28,
      "text": "Вернись к твоему Господу довольной и снискавшей довольство!"
    },
    {
      "number": 29,
      "text": "Войди с Моими рабами."
    },
    {
      "number": 30,
      "text": "Войди в Мой рай!"
    }
  ]
}