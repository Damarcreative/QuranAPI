{
  "surah": 89,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>a</b>lfajr<b>i</b>"
    },
    {
      "number": 2,
      "text": "Walay<u>a</u>lin AAashr<b>in</b>"
    },
    {
      "number": 3,
      "text": "Wa<b>al</b>shshafAAi wa<b>a</b>lwatr<b>i</b>"
    },
    {
      "number": 4,
      "text": "Wa<b>a</b>llayli i<u>tha</u> yasr<b>i</b>"
    },
    {
      "number": 5,
      "text": "Hal fee <u>tha</u>lika qasamun li<u>th</u>ee <u>h</u>ijr<b>in</b>"
    },
    {
      "number": 6,
      "text": "Alam tara kayfa faAAala rabbuka biAA<u>a</u>d<b>in</b>"
    },
    {
      "number": 7,
      "text": "Irama <u>tha</u>ti alAAim<u>a</u>d<b>i</b>"
    },
    {
      "number": 8,
      "text": "Allatee lam yukhlaq mithluh<u>a</u> fee albil<u>a</u>d<b>i</b>"
    },
    {
      "number": 9,
      "text": "Wathamooda alla<u>th</u>eena j<u>a</u>boo a<b>l</b><u>ss</u>akhra bi<b>a</b>lw<u>a</u>d<b>i</b>"
    },
    {
      "number": 10,
      "text": "WafirAAawna <u>th</u>ee alawt<u>a</u>d<b>i</b>"
    },
    {
      "number": 11,
      "text": "Alla<u>th</u>eena <u>t</u>aghaw fee albil<u>a</u>d<b>i</b>"
    },
    {
      "number": 12,
      "text": "Faaktharoo feeh<u>a</u> alfas<u>a</u>d<b>a</b>"
    },
    {
      "number": 13,
      "text": "Fa<u>s</u>abba AAalayhim rabbuka saw<u>t</u>a AAa<u>tha</u>b<b>in</b>"
    },
    {
      "number": 14,
      "text": "Inna rabbaka labi<b>a</b>lmir<u>sa</u>d<b>i</b>"
    },
    {
      "number": 15,
      "text": "Faamm<u>a</u> alins<u>a</u>nu i<u>tha</u> m<u>a</u> ibtal<u>a</u>hu rabbuhu faakramahu wanaAAAAamahu fayaqoolu rabbee akraman<b>i</b>"
    },
    {
      "number": 16,
      "text": "Waamm<u>a</u> i<u>tha</u> m<u>a</u> ibtal<u>a</u>hu faqadara AAalayhi rizqahu fayaqoolu rabbee ah<u>a</u>nan<b>i</b>"
    },
    {
      "number": 17,
      "text": "Kall<u>a</u> bal l<u>a</u> tukrimoona alyateem<b>a</b>"
    },
    {
      "number": 18,
      "text": "Wal<u>a</u> ta<u>hadd</u>oona AAal<u>a</u> <u>t</u>aAA<u>a</u>mi almiskeen<b>i</b>"
    },
    {
      "number": 19,
      "text": "Watakuloona a<b>l</b>ttur<u>a</u>tha aklan lamm<u>a</u><b>n</b>"
    },
    {
      "number": 20,
      "text": "Watu<u>h</u>ibboona alm<u>a</u>la <u>h</u>ubban jamm<u>a</u><b>n</b>"
    },
    {
      "number": 21,
      "text": "Kall<u>a</u> i<u>tha</u> dukkati alar<u>d</u>u dakkan dakk<u>a</u><b>n</b>"
    },
    {
      "number": 22,
      "text": "Waj<u>a</u>a rabbuka wa<b>a</b>lmalaku <u>s</u>affan <u>s</u>aff<u>a</u><b>n</b>"
    },
    {
      "number": 23,
      "text": "Wajeea yawmai<u>th</u>in bijahannama yawmai<u>th</u>in yata<u>th</u>akkaru alins<u>a</u>nu waann<u>a</u> lahu a<b>l</b><u>thth</u>ikr<u>a</u>"
    },
    {
      "number": 24,
      "text": "Yaqoolu y<u>a</u> laytanee qaddamtu li<u>h</u>ay<u>a</u>tee"
    },
    {
      "number": 25,
      "text": "Fayawmai<u>th</u>in l<u>a</u> yuAAa<u>thth</u>ibu AAa<u>tha</u>bahu a<u>h</u>ad<b>un</b>"
    },
    {
      "number": 26,
      "text": "Wal<u>a</u> yoothiqu wath<u>a</u>qahu a<u>h</u>ad<b>un</b>"
    },
    {
      "number": 27,
      "text": "Y<u>a</u> ayyatuh<u>a</u> a<b>l</b>nnafsu almu<u>t</u>mainna<b>tu</b>"
    },
    {
      "number": 28,
      "text": "IrjiAAee il<u>a</u> rabbiki r<u>ad</u>iyatan mar<u>d</u>iyya<b>tan</b>"
    },
    {
      "number": 29,
      "text": "Fa<b>o</b>dkhulee fee AAib<u>a</u>dee"
    },
    {
      "number": 30,
      "text": "Wa<b>o</b>dkhulee jannatee"
    }
  ]
}