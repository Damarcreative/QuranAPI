{
  "surah": 104,
  "translation": "en-itani",
  "ayahs": [
    {
      "number": 0,
      "text": "In the name of God, the Gracious, the Merciful."
    },
    {
      "number": 1,
      "text": "Woe to every slanderer backbiter."
    },
    {
      "number": 2,
      "text": "Who gathers wealth and counts it over."
    },
    {
      "number": 3,
      "text": "Thinking that his wealth has made him immortal."
    },
    {
      "number": 4,
      "text": "By no means. He will be thrown into the Crusher."
    },
    {
      "number": 5,
      "text": "And what will make you realize what the Crusher is?"
    },
    {
      "number": 6,
      "text": "God's kindled Fire."
    },
    {
      "number": 7,
      "text": "That laps to the hearts."
    },
    {
      "number": 8,
      "text": "It closes in on them."
    },
    {
      "number": 9,
      "text": "In extended columns."
    }
  ]
}