{
  "surah": 104,
  "translation": "ru-porokhova",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Всемилостивого, Милосердного!"
    },
    {
      "number": 1,
      "text": "Будь проклят клеветник и тот, Кто за спиной злословит,"
    },
    {
      "number": 2,
      "text": "Тот, кто копит добро И в закрома его кладет,"
    },
    {
      "number": 3,
      "text": "Надеясь, что богатства эти Навечно жизнь ему продлят!"
    },
    {
      "number": 4,
      "text": "Поистине, низвергнут будет он в аль хутамУ."
    },
    {
      "number": 5,
      "text": "Как объяснить тебе, Что значит \"аль хутамА\"?"
    },
    {
      "number": 6,
      "text": "Пылающий Огонь, Возжженный гневом Божьим,"
    },
    {
      "number": 7,
      "text": "Что захватил сердца и души (скверных)"
    },
    {
      "number": 8,
      "text": "И погребальным сводом стал для них"
    },
    {
      "number": 9,
      "text": "На вытянутых до небес шестах."
    }
  ]
}