{
  "surah": 104,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "കുത്തുവാക്ക് പറയുന്നവനൊക്കെയും നാശം! അവഹേളിക്കുന്നവന്നും!"
    },
    {
      "number": 2,
      "text": "അവനോ, ധനം ഒരുക്കൂട്ടുകയും അത് എണ്ണിക്കണക്കാക്കുകയും ചെയ്യുന്നവനാണ്."
    },
    {
      "number": 3,
      "text": "ധനം തന്നെ അനശ്വരനാക്കിയതായി അവന്‍ കരുതുന്നു."
    },
    {
      "number": 4,
      "text": "സംശയം വേണ്ട; അവന്‍ ഹുത്വമയില്‍ എറിയപ്പെടുക തന്നെ ചെയ്യും."
    },
    {
      "number": 5,
      "text": "ഹുത്വമ എന്തെന്ന് നിനക്കറിയാമോ?"
    },
    {
      "number": 6,
      "text": "അല്ലാഹുവിന്റെ കത്തിപ്പടരും നരകത്തീയാണത്."
    },
    {
      "number": 7,
      "text": "ഹൃദയങ്ങളിലേക്ക് കത്തിപ്പടരുന്നത്."
    },
    {
      "number": 8,
      "text": "അത് അവരുടെ മേല്‍ മൂടിയിരിക്കും;"
    },
    {
      "number": 9,
      "text": "നാട്ടിനിര്‍ത്തിയ സ്തംഭങ്ങളില്‍ അവര്‍ ബന്ധിതരായിരിക്കെ."
    }
  ]
}