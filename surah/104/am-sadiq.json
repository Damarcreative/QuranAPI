{
  "surah": 104,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "ለሃሜተኛ ለዘላፊ ሁሉ ወዮለት፡፡"
    },
    {
      "number": 2,
      "text": "ለዚያ ገንዘብን የሰበሰበና የቆጣጠረው (ያደለበውም) ለኾነ ፤(ወዮለት)፡፡"
    },
    {
      "number": 3,
      "text": "ገንዘቡ የሚያዘወትረው መኾኑን ያስባል፡፡"
    },
    {
      "number": 4,
      "text": "ይከልከል፤ በሰባሪይቱ (እሳት) ውስጥ በእርግጥ ይጣላል፡፡"
    },
    {
      "number": 5,
      "text": "ሰባሪይቱም ምን እንደ ኾነች ምን አሳወቀህ?"
    },
    {
      "number": 6,
      "text": "የተነደደችው የአላህ እሳት ናት፡፡"
    },
    {
      "number": 7,
      "text": "ያቺ በልቦች ላይ የምትዘልቅ የኾነችው፡፡"
    },
    {
      "number": 8,
      "text": "እርሷ በእርግጥ በእነርሱ ላይ የተዘጋጀች ናት፡፡"
    },
    {
      "number": 9,
      "text": "በተዘረጋች አዕማድ ውስጥ (የተዘጋች ናት)፡፡"
    }
  ]
}