{
  "surah": 104,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 0,
      "text": "Хвала Аллаху – Господу миров [создавшему мир и управляющему им],"
    },
    {
      "number": 1,
      "text": "Горе всякому клеветнику и обидчику,"
    },
    {
      "number": 2,
      "text": "который копит богатство и пересчитывает его."
    },
    {
      "number": 3,
      "text": "Он думает, что его богатство даст ему вечную жизнь."
    },
    {
      "number": 4,
      "text": "Но нет! Он непременно будет ввергнут в аль-Хутама [Ад]."
    },
    {
      "number": 5,
      "text": "Откуда ты узнал, что такое аль-Хутама?"
    },
    {
      "number": 6,
      "text": "Это – неугасимый [адский] огонь Аллаха,"
    },
    {
      "number": 7,
      "text": "который доходит до сердец."
    },
    {
      "number": 8,
      "text": "Поистине, он сомкнется над ними,"
    },
    {
      "number": 9,
      "text": "[подпертый] длинными столбами."
    }
  ]
}