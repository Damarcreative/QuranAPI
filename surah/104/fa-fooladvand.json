{
  "surah": 104,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "وای بر هر بدگوی عیبجویی،"
    },
    {
      "number": 2,
      "text": "که مالی گرد آورد و برشمردش."
    },
    {
      "number": 3,
      "text": "پندارد که مالش او را جاوید کرده،"
    },
    {
      "number": 4,
      "text": "ولی نه! قطعاً در آتش خردکننده فرو افکنده خواهد شد."
    },
    {
      "number": 5,
      "text": "و تو چه دانی که آن آتش خردکننده چیست؟"
    },
    {
      "number": 6,
      "text": "آتش افروخته خدا[یی‌] است."
    },
    {
      "number": 7,
      "text": "[آتشی‌] که به دلها می‌رسد."
    },
    {
      "number": 8,
      "text": "آنان را در میان فرامی‌گیرد."
    },
    {
      "number": 9,
      "text": "[آتشی که‌] در ستونهایی دراز است."
    }
  ]
}