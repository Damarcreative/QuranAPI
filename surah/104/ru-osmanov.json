{
  "surah": 104,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного."
    },
    {
      "number": 1,
      "text": "Горе всякому клеветнику, хулителю,"
    },
    {
      "number": 2,
      "text": "который накопил состояние и подсчитал его."
    },
    {
      "number": 3,
      "text": "Он полагает, что богатство обеспечит ему бессмертие."
    },
    {
      "number": 4,
      "text": "Так нет же! Ведь он будет ввергнут туда, где сокрушают."
    },
    {
      "number": 5,
      "text": "Откуда тебе знать, что такое место, где сокрушают?"
    },
    {
      "number": 6,
      "text": "[Это] - разожженный огонь Аллаха,"
    },
    {
      "number": 7,
      "text": "который вздымается пламенем над [горящими] сердцами."
    },
    {
      "number": 8,
      "text": "Воистину, он сомкнется над ними (т. е. хулителями)"
    },
    {
      "number": 9,
      "text": "на воздвигнутых столбах."
    }
  ]
}