{
  "surah": 104,
  "translation": "en-ahmedali",
  "ayahs": [
    {
      "number": 1,
      "text": "WOE TO EVERY slanderer, back-biter,"
    },
    {
      "number": 2,
      "text": "Who amasses wealth and hordes it."
    },
    {
      "number": 3,
      "text": "Does he think his wealth will abide for ever with him?"
    },
    {
      "number": 4,
      "text": "By no means. He will be thrown into Hutama."
    },
    {
      "number": 5,
      "text": "How will you comprehend what Hutama is?"
    },
    {
      "number": 6,
      "text": "It is the fire kindled by God"
    },
    {
      "number": 7,
      "text": "Which penetrates the hearts"
    },
    {
      "number": 8,
      "text": "(And) vaults them over"
    },
    {
      "number": 9,
      "text": "In extending columns."
    }
  ]
}