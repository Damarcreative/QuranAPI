{
  "surah": 104,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Горе всякому хулителю - поносителю,"
    },
    {
      "number": 2,
      "text": "который собрал богатство и приготовил его!"
    },
    {
      "number": 3,
      "text": "Думает он, что богатство его увековечит."
    },
    {
      "number": 4,
      "text": "Так нет же! Будет ввергнут он в \"сокрушилище\"."
    },
    {
      "number": 5,
      "text": "А что даст тебе знать, что такое \"сокрушилище\"?"
    },
    {
      "number": 6,
      "text": "Огонь Аллаха воспламененный,"
    },
    {
      "number": 7,
      "text": "который вздымается над сердцами!"
    },
    {
      "number": 8,
      "text": "Он над ними воздвигнут сводом"
    },
    {
      "number": 9,
      "text": "на колоннах вытянутых."
    }
  ]
}