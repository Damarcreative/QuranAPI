{
  "surah": 104,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "傷哉！每個誹謗者, 詆毀者,"
    },
    {
      "number": 2,
      "text": "他聚積財產, 而當作武器,"
    },
    {
      "number": 3,
      "text": "他以為他的財產, 能使他不滅。"
    },
    {
      "number": 4,
      "text": "絕不然, 他必定要被投在毀滅坑中。"
    },
    {
      "number": 5,
      "text": "你怎能知道毀滅坑是什麼？"
    },
    {
      "number": 6,
      "text": "是真主的燃著的烈活。"
    },
    {
      "number": 7,
      "text": "能升到人的心上。"
    },
    {
      "number": 8,
      "text": "他們必定要被關在烈火中,"
    },
    {
      "number": 9,
      "text": "吊在許多很高的柱子上。"
    }
  ]
}