{
  "surah": 104,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Горе каждому хулителю, поносителю,"
    },
    {
      "number": 2,
      "text": "Который собирает имущество и копит его,"
    },
    {
      "number": 3,
      "text": "Думая, что его имущество увековечит его!"
    },
    {
      "number": 4,
      "text": "Нет, он ввержен будет в Хотаму."
    },
    {
      "number": 5,
      "text": "О если бы кто вразумил тебя, что такое Хотама!"
    },
    {
      "number": 6,
      "text": "Это - разженный огонь Божий,"
    },
    {
      "number": 7,
      "text": "Который взвивается вкруг сердец,"
    },
    {
      "number": 8,
      "text": "И над ними смыкается в свод"
    },
    {
      "number": 9,
      "text": "На высоких столбах."
    }
  ]
}