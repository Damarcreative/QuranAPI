{
  "surah": 105,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በዝሆኑ ባለቤቶች ጌታህ እንዴት እንደሠራ አላወቅህምን?"
    },
    {
      "number": 2,
      "text": "ተንኮላቸውን በጥፋት ውስጥ (ከንቱ) አላደረገምን? (አድርጓል)፡፡"
    },
    {
      "number": 3,
      "text": "በእነርሱም ላይ መንጎች የኾኑን ዎፎች ላከ፡፡"
    },
    {
      "number": 4,
      "text": "ከተጠበሰ ጭቃ በኾነ ድንጋይ የምትወረውርባቸው የኾነችን፤ (አዕዋፍ)፡፡"
    },
    {
      "number": 5,
      "text": "ቅጠሉ እንደ ተበላ አዝመራም አደረጋቸው፡፡"
    }
  ]
}