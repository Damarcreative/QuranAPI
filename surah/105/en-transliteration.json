  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Alam tara kayfa faAAala rabbuka bia<u>s</u><u>ha</u>bi alfeel<b>i</b>"
    },
    {
      "number": 2,
      "text": "Alam yajAAal kaydahum fee ta<u>d</u>leel<b>in</b>"
    },
    {
      "number": 3,
      "text": "Waarsala AAalayhim <u>t</u>ayran ab<u>a</u>beel<b>a</b>"
    },
    {
      "number": 4,
      "text": "Tarmeehim bi<u>h</u>ij<u>a</u>ratin min sijjeel<b>in</b>"
    },
    {
      "number": 5,
      "text": "FajaAAalahum kaAAa<u>s</u>fin makool<b>in</b>"
    }
