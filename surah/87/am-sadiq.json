{
  "surah": 87,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ከሁሉ በላይ የኾነውን ጌታህን ስም አሞግሥ፡፡"
    },
    {
      "number": 2,
      "text": "የዚያን (ሁሉን ነገር) የፈጠረውን ያስተካከለውንም፡፡"
    },
    {
      "number": 3,
      "text": "የዚያንም የወሰነውን፡፡ (ለተፈጠረለት ነገር) የመራውንም፡፡"
    },
    {
      "number": 4,
      "text": "የዚያንም ግጦሽን (ለምለም አድርጎ) ያወጣውን፡፡"
    },
    {
      "number": 5,
      "text": "(ከዚያ) ደረቅ ጥቁር ያደረገውንም (አምላክ ስም አሞግስ)፡፡"
    },
    {
      "number": 6,
      "text": "(ቁርኣንን) በእርግጥ እናስነብብሃለን፤ አትረሳምም፡፡"
    },
    {
      "number": 7,
      "text": "አላህ ከሻው ነገር በስተቀር፡፡ እርሱ ግልጹን የሚሸሸገውንም ሁሉ ያውቃልና፡፡"
    },
    {
      "number": 8,
      "text": "ለገሪቱም (ሕግጋት) እንገጥምሃለን፡፡"
    },
    {
      "number": 9,
      "text": "ግሣጼይቱ ብትጠቅም (ሰዎችን) ገሥጽም፡፡"
    },
    {
      "number": 10,
      "text": "(አላህን) የሚፈራ ሰው በእርግጥ ይገሠጻል፡፡"
    },
    {
      "number": 11,
      "text": "መናጢውም ይርቃታል፡፡"
    },
    {
      "number": 12,
      "text": "ያ ታላቂቱን እሳት የሚገባው፡፡"
    },
    {
      "number": 13,
      "text": "ከዚያም በእርሷ ውስጥ አይሞትም ሕያውም አይኾንም፡፡"
    },
    {
      "number": 14,
      "text": "የተጥራራ ሰው በእርግጥ ዳነ፡፡"
    },
    {
      "number": 15,
      "text": "የጌታውንም ስም ያወሳና የሰገደ፡፡"
    },
    {
      "number": 16,
      "text": "ይልቁንም ቅርቢቱን ሕይወት ትመርጣላችሁ፡፡"
    },
    {
      "number": 17,
      "text": "መጨረሻይቱ (ሕይወት) በላጭ ሁል ጊዜ ዘውታሪም ስትኾን፡፡"
    },
    {
      "number": 18,
      "text": "ይህ በፊተኞቹ መጻሕፍት ውስጥ ያልለ ነው፡፡"
    },
    {
      "number": 19,
      "text": "በኢብራሂምና በሙሳ ጽሑፎች ውስጥ፡፡"
    }
  ]
}