{
  "surah": 87,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Sabbi<u>h</u>i isma rabbika alaAAl<u>a</u>"
    },
    {
      "number": 2,
      "text": "Alla<u>th</u>ee khalaqa fasaww<u>a</u>"
    },
    {
      "number": 3,
      "text": "Wa<b>a</b>lla<u>th</u>ee qaddara fahad<u>a</u>"
    },
    {
      "number": 4,
      "text": "Wa<b>a</b>lla<u>th</u>ee akhraja almarAA<u>a</u>"
    },
    {
      "number": 5,
      "text": "FajaAAalahu ghuth<u>a</u>an a<u>h</u>w<u>a</u>"
    },
    {
      "number": 6,
      "text": "Sanuqrioka fal<u>a</u> tans<u>a</u>"
    },
    {
      "number": 7,
      "text": "Ill<u>a</u> m<u>a</u> sh<u>a</u>a All<u>a</u>hu innahu yaAAlamu aljahra wam<u>a</u> yakhf<u>a</u>"
    },
    {
      "number": 8,
      "text": "Wanuyassiruka lilyusr<u>a</u>"
    },
    {
      "number": 9,
      "text": "Fa<u>th</u>akkir in nafaAAati a<b>l</b><u>thth</u>ikr<u>a</u>"
    },
    {
      "number": 10,
      "text": "Saya<u>thth</u>akkaru man yakhsh<u>a</u>"
    },
    {
      "number": 11,
      "text": "Wayatajannabuh<u>a</u> alashq<u>a</u>"
    },
    {
      "number": 12,
      "text": "Alla<u>th</u>ee ya<u>s</u>l<u>a</u> a<b>l</b>nn<u>a</u>ra alkubr<u>a</u>"
    },
    {
      "number": 13,
      "text": "Thumma l<u>a</u> yamootu feeh<u>a</u> wal<u>a</u> ya<u>h</u>y<u>a</u>"
    },
    {
      "number": 14,
      "text": "Qad afla<u>h</u>a man tazakk<u>a</u>"
    },
    {
      "number": 15,
      "text": "Wa<u>th</u>akara isma rabbihi fa<u>s</u>all<u>a</u>"
    },
    {
      "number": 16,
      "text": "Bal tuthiroona al<u>h</u>ay<u>a</u>ta a<b>l</b>dduny<u>a</u>"
    },
    {
      "number": 17,
      "text": "Wa<b>a</b>l<u>a</u>khiratu khayrun waabq<u>a</u>"
    },
    {
      "number": 18,
      "text": "Inna h<u>atha</u> lafee a<b>l</b><u>ss</u>u<u>h</u>ufi alool<u>a</u>"
    },
    {
      "number": 19,
      "text": "<u>S</u>u<u>h</u>ufi ibr<u>a</u>heema wamoos<u>a</u>"
    }
  ]
}