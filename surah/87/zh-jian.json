{
  "surah": 87,
  "translation": "zh-jian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "你当赞颂你至尊主的大名超绝万物，"
    },
    {
      "number": 2,
      "text": "他创造万物，并使各物匀称。"
    },
    {
      "number": 3,
      "text": "他预定万物，而加以引导。"
    },
    {
      "number": 4,
      "text": "他生出牧草，"
    },
    {
      "number": 5,
      "text": "然後使它变成黑色的枯草。"
    },
    {
      "number": 6,
      "text": "我将使你诵读，故你不会忘记，"
    },
    {
      "number": 7,
      "text": "除非真主所欲你忘记的。他的确知道显著的和隐微的言行。"
    },
    {
      "number": 8,
      "text": "我将使你遵循平易的道路，"
    },
    {
      "number": 9,
      "text": "故你当教诲众人，如果教诲有裨於他们的话。"
    },
    {
      "number": 10,
      "text": "畏主的人，将觉悟；"
    },
    {
      "number": 11,
      "text": "薄命的人，将退避，"
    },
    {
      "number": 12,
      "text": "他将入於大火，"
    },
    {
      "number": 13,
      "text": "然後，在火里不死也不活。"
    },
    {
      "number": 14,
      "text": "有教养的人确已成功，"
    },
    {
      "number": 15,
      "text": "他记念他的主的尊名，而谨守拜功。"
    },
    {
      "number": 16,
      "text": "不然，你们却选择今世的生活；"
    },
    {
      "number": 17,
      "text": "其实，後世是更好的，是更久长的。"
    },
    {
      "number": 18,
      "text": "这确是载在古经典中的，"
    },
    {
      "number": 19,
      "text": "载在易卜拉欣和穆萨的经典中的。"
    }
  ]
}