{
  "surah": 87,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Хвали же им Господа твоего высочайшего,"
    },
    {
      "number": 2,
      "text": "который сотворил и соразмерил,"
    },
    {
      "number": 3,
      "text": "который распределил и направил"
    },
    {
      "number": 4,
      "text": "и который вывел пастбище,"
    },
    {
      "number": 5,
      "text": "и сделал его коричневым сором!"
    },
    {
      "number": 6,
      "text": "Мы дадим прочесть тебе, и ты не забудешь,"
    },
    {
      "number": 7,
      "text": "если не пожелает чего-нибудь Аллах, - ведь, поистине, Он знает явное и то, что скрыто!"
    },
    {
      "number": 8,
      "text": "И Мы облегчим тебе для легчайшего."
    },
    {
      "number": 9,
      "text": "Поминай же, если полезно поминание."
    },
    {
      "number": 10,
      "text": "Вспомнит тот, кто боязлив."
    },
    {
      "number": 11,
      "text": "И отвернется от него несчастнейший,"
    },
    {
      "number": 12,
      "text": "который будет гореть в огне величайшем."
    },
    {
      "number": 13,
      "text": "Потом не умрет он там и не будет жив."
    },
    {
      "number": 14,
      "text": "Получил прибыль тот, кто очистился,"
    },
    {
      "number": 15,
      "text": "и помянул им Господа своего и помолился."
    },
    {
      "number": 16,
      "text": "Да, вы предпочитаете жизнь ближайшую,"
    },
    {
      "number": 17,
      "text": "а последняя лучше и длительнее."
    },
    {
      "number": 18,
      "text": "Поистине, это - в свитках первых,"
    },
    {
      "number": 19,
      "text": "свитках Ибрахима и Мусы!"
    }
  ]
}