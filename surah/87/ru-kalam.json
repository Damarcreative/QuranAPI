{
  "surah": 87,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 1,
      "text": "Возвеличивай имя Господа твоего Всевышнего!"
    },
    {
      "number": 2,
      "text": "[Он – Тот] Кто сотворил [все сущее] и соразмерил,"
    },
    {
      "number": 3,
      "text": "Который предопределил и указал путь,"
    },
    {
      "number": 4,
      "text": "Который взрастил пастбища."
    },
    {
      "number": 5,
      "text": "И превратил их в черный сор."
    },
    {
      "number": 6,
      "text": "Мы дадим тебе прочесть Его [Куръан], и ты не забудешь [ничего из него],"
    },
    {
      "number": 7,
      "text": "кроме того, что пожелает Аллах. Поистине, Он знает явное и скрытое."
    },
    {
      "number": 8,
      "text": "И Мы облегчим тебе путь к легкому."
    },
    {
      "number": 9,
      "text": "Наставляй же [людей], если напоминание полезно."
    },
    {
      "number": 10,
      "text": "Примет [наставление] тот, кто страшится [Аллаха]."
    },
    {
      "number": 11,
      "text": "И отвернется от него несчастнейший,"
    },
    {
      "number": 12,
      "text": "который войдет в великий огонь."
    },
    {
      "number": 13,
      "text": "Затем он не сможет ни умереть там, ни жить."
    },
    {
      "number": 14,
      "text": "Преуспеет тот, кто очистился [от неверия и грехов],"
    },
    {
      "number": 15,
      "text": "поминал имя своего Господа и совершал намаз."
    },
    {
      "number": 16,
      "text": "Но вы предпочитаете земную жизнь."
    },
    {
      "number": 17,
      "text": "А вечная жизнь – лучше и не будет иметь конца."
    },
    {
      "number": 18,
      "text": "Поистине, об этом [говорится] в первых свитках –"
    },
    {
      "number": 19,
      "text": "свитках Ибрахима и Мусы."
    }
  ]
}