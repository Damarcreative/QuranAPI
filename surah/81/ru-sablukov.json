{
  "surah": 81,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Когда солнце обовьется мраком,"
    },
    {
      "number": 2,
      "text": "Когда звезды померкнут;"
    },
    {
      "number": 3,
      "text": "Когда горы с мест своих сдвинутся,"
    },
    {
      "number": 4,
      "text": "Когда девять месяцев сужеребые верблюдицы окажутся праздными;"
    },
    {
      "number": 5,
      "text": "Когда звери столпятся,"
    },
    {
      "number": 6,
      "text": "когда моря закипят;"
    },
    {
      "number": 7,
      "text": "когда души сопрягутся,"
    },
    {
      "number": 8,
      "text": "когда похороненная живою будет спрошена:"
    },
    {
      "number": 9,
      "text": "за какой грех она убита?"
    },
    {
      "number": 10,
      "text": "Когда свитки разовьются,"
    },
    {
      "number": 11,
      "text": "Когда небо, как покров, снимется,"
    },
    {
      "number": 12,
      "text": "Когда ад разгорится,"
    },
    {
      "number": 13,
      "text": "И когда рай приблизится:"
    },
    {
      "number": 14,
      "text": "Тогда душа узнает, что заготовила она себе."
    },
    {
      "number": 15,
      "text": "Клянусь планетами,"
    },
    {
      "number": 16,
      "text": "Скрывающимися кометами;"
    },
    {
      "number": 17,
      "text": "Клянусь ночью, когда она темнеет,"
    },
    {
      "number": 18,
      "text": "Клянусь утром, когда оно прохладно веет:"
    },
    {
      "number": 19,
      "text": "Действительно, он - слово посланника, славного,"
    },
    {
      "number": 20,
      "text": "Сильного пред Властителем престола, полномочного,"
    },
    {
      "number": 21,
      "text": "Покорно чтимого, верного."
    },
    {
      "number": 22,
      "text": "И согражданин ваш не беснующийся:"
    },
    {
      "number": 23,
      "text": "Он некогда видел его на светлом небосклоне;"
    },
    {
      "number": 24,
      "text": "У него нет недоумения о таинственном."
    },
    {
      "number": 25,
      "text": "Он не есть слово сатаны, прогоняемого камнями."
    },
    {
      "number": 26,
      "text": "За чем же вы идете прочь?"
    },
    {
      "number": 27,
      "text": "Он - увещание мирам,"
    },
    {
      "number": 28,
      "text": "Тем из вас, которые хотят идти прямо."
    },
    {
      "number": 29,
      "text": "Но вы можете хотеть только того, чего хочет Бог, Господь миров."
    }
  ]
}