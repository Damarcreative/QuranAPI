{
  "surah": 81,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 1,
      "text": "Когда солнце покроется мраком,"
    },
    {
      "number": 2,
      "text": "когда звезды померкнут,"
    },
    {
      "number": 3,
      "text": "когда горы придут в движение,"
    },
    {
      "number": 4,
      "text": "когда верблюдицы, беременные на десятом месяце, останутся без присмотра,"
    },
    {
      "number": 5,
      "text": "когда соберутся [все] дикие звери,"
    },
    {
      "number": 6,
      "text": "когда моря выйдут из берегов,"
    },
    {
      "number": 7,
      "text": "когда души соединятся [с телами],"
    },
    {
      "number": 8,
      "text": "когда зарытую заживо спросят,"
    },
    {
      "number": 9,
      "text": "за какой же грех ее убили,"
    },
    {
      "number": 10,
      "text": "когда развернут свитки [людских деяний],"
    },
    {
      "number": 11,
      "text": "когда небо будет низринуто,"
    },
    {
      "number": 12,
      "text": "когда разгорится адский огонь,"
    },
    {
      "number": 13,
      "text": "когда рай приблизится [к праведникам], -"
    },
    {
      "number": 14,
      "text": "тогда познает каждая душа, что она уготовила себе [деяниями своими]."
    },
    {
      "number": 15,
      "text": "Но нет же! Клянусь светилами,"
    },
    {
      "number": 16,
      "text": "передвигающимися [по небу] и исчезающими [с небосвода],"
    },
    {
      "number": 17,
      "text": "клянусь вечерним [сумраком] густеющим,"
    },
    {
      "number": 18,
      "text": "клянусь зарей брезжащей,"
    },
    {
      "number": 19,
      "text": "что, воистину, это (т. е. Коран) - слова посланца благородного,"
    },
    {
      "number": 20,
      "text": "обладателя силы при Властителе Трона, могущественного,"
    },
    {
      "number": 21,
      "text": "того, кому повинуются ангелы, и достойного доверия."
    },
    {
      "number": 22,
      "text": "Тот, с кем вы спорите, вовсе не безумец,"
    },
    {
      "number": 23,
      "text": "ибо он видел его (т. е. Джибрила) на ясном небосклоне,"
    },
    {
      "number": 24,
      "text": "и он (т. е. Мухаммад) не скупится сообщить другим [поведанное ему] сокровенное откровение."
    },
    {
      "number": 25,
      "text": "Это (т. е. Коран) - не речи побиваемого камнями шайтана."
    },
    {
      "number": 26,
      "text": "Так куда же вы устремляетесь, [отрицая Коран]?"
    },
    {
      "number": 27,
      "text": "Ведь он - только назидание для обитателей миров,"
    },
    {
      "number": 28,
      "text": "для тех из вас, кто хочет стать на прямой путь."
    },
    {
      "number": 29,
      "text": "Но вы не [сможете] захотеть этого, если того не захочет Аллах, Господь [обитателей] миров."
    }
  ]
}