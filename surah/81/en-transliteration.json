{
  "surah": 81,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "I<u>tha</u> a<b>l</b>shshamsu kuwwirat"
    },
    {
      "number": 2,
      "text": "Wai<u>tha</u> a<b>l</b>nnujoomu inkadarat"
    },
    {
      "number": 3,
      "text": "Wai<u>tha</u> aljib<u>a</u>lu suyyirat"
    },
    {
      "number": 4,
      "text": "Wai<u>tha</u> alAAish<u>a</u>ru AAu<u>tt</u>ilat"
    },
    {
      "number": 5,
      "text": "Wai<u>tha</u> alwu<u>h</u>ooshu <u>h</u>ushirat"
    },
    {
      "number": 6,
      "text": "Wai<u>tha</u> albi<u>ha</u>ru sujjirat"
    },
    {
      "number": 7,
      "text": "Wai<u>tha</u> a<b>l</b>nnufoosu zuwwijat"
    },
    {
      "number": 8,
      "text": "Wai<u>tha</u> almawoodatu suilat"
    },
    {
      "number": 9,
      "text": "Biayyi <u>th</u>anbin qutilat"
    },
    {
      "number": 10,
      "text": "Wai<u>tha</u> a<b>l</b><u>ss</u>u<u>h</u>ufu nushirat"
    },
    {
      "number": 11,
      "text": "Wai<u>tha</u> a<b>l</b>ssam<u>a</u>o kushi<u>t</u>at"
    },
    {
      "number": 12,
      "text": "Wai<u>tha</u> alja<u>h</u>eemu suAAAAirat"
    },
    {
      "number": 13,
      "text": "Wai<u>tha</u> aljannatu ozlifat"
    },
    {
      "number": 14,
      "text": "AAalimat nafsun m<u>a</u> a<u>hd</u>arat"
    },
    {
      "number": 15,
      "text": "Fal<u>a</u> oqsimu bi<b>a</b>lkhunnas<b>i</b>"
    },
    {
      "number": 16,
      "text": "Aljaw<u>a</u>ri alkunnas<b>i</b>"
    },
    {
      "number": 17,
      "text": "Wa<b>a</b>llayli i<u>tha</u> AAasAAas<b>a</b>"
    },
    {
      "number": 18,
      "text": "Wa<b>al</b><u>ss</u>ub<u>h</u>i i<u>tha</u> tanaffas<b>a</b>"
    },
    {
      "number": 19,
      "text": "Innahu laqawlu rasoolin kareem<b>in</b>"
    },
    {
      "number": 20,
      "text": "<u>Th</u>ee quwwatin AAinda <u>th</u>ee alAAarshi makeen<b>in</b>"
    },
    {
      "number": 21,
      "text": "Mu<u>ta</u>AAin thamma ameen<b>in</b>"
    },
    {
      "number": 22,
      "text": "Wam<u>a</u> <u>sah</u>ibukum bimajnoon<b>in</b>"
    },
    {
      "number": 23,
      "text": "Walaqad ra<u>a</u>hu bi<b>a</b>lofuqi almubeen<b>i</b>"
    },
    {
      "number": 24,
      "text": "Wam<u>a</u> huwa AAal<u>a</u> alghaybi bi<u>d</u>aneen<b>in</b>"
    },
    {
      "number": 25,
      "text": "Wam<u>a</u> huwa biqawli shay<u>ta</u>nin rajeem<b>in</b>"
    },
    {
      "number": 26,
      "text": "Faayna ta<u>th</u>haboon<b>a</b>"
    },
    {
      "number": 27,
      "text": "In huwa ill<u>a</u> <u>th</u>ikrun lilAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 28,
      "text": "Liman sh<u>a</u>a minkum an yastaqeem<b>a</b>"
    },
    {
      "number": 29,
      "text": "Wam<u>a</u> tash<u>a</u>oona ill<u>a</u> an yash<u>a</u>a All<u>a</u>hu rabbu alAA<u>a</u>lameen<b>a</b>"
    }
  ]
}