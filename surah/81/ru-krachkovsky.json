{
  "surah": 81,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Когда солнце будет скручено,"
    },
    {
      "number": 2,
      "text": "и когда звезды облетят."
    },
    {
      "number": 3,
      "text": "и когда горы сдвинутся с мест."
    },
    {
      "number": 4,
      "text": "и когда десять месяцев беременные верблюдицы будут без присмотра,"
    },
    {
      "number": 5,
      "text": "и когда животные соберутся."
    },
    {
      "number": 6,
      "text": "и когда моря перельются,"
    },
    {
      "number": 7,
      "text": "и когда души соединятся,"
    },
    {
      "number": 8,
      "text": "и когда зарытая живьем будет спрошена,"
    },
    {
      "number": 9,
      "text": "за какой грех она была убита,"
    },
    {
      "number": 10,
      "text": "и когда свитки развернутся,"
    },
    {
      "number": 11,
      "text": "и когда небо будет сдернуто."
    },
    {
      "number": 12,
      "text": "и когда ад будет разожжен,"
    },
    {
      "number": 13,
      "text": "и когда рай будет приближен, -"
    },
    {
      "number": 14,
      "text": "узнает душа, что она приготовила."
    },
    {
      "number": 15,
      "text": "Но нет! Клянусь движущимися обратно."
    },
    {
      "number": 16,
      "text": "текущими и скрывающимися,"
    },
    {
      "number": 17,
      "text": "и ночью, когда она темнеет,"
    },
    {
      "number": 18,
      "text": "и зарей, когда она дышит!"
    },
    {
      "number": 19,
      "text": "Это - поистине, слово посланника благородного,"
    },
    {
      "number": 20,
      "text": "обладающего силой у властителя трона могучего,"
    },
    {
      "number": 21,
      "text": "встречающего покорность и, кроме того, доверенного."
    },
    {
      "number": 22,
      "text": "И ваш товарищ не одержимый:"
    },
    {
      "number": 23,
      "text": "он ведь видел Его на ясном горизонте,"
    },
    {
      "number": 24,
      "text": "и он не скупится на скрытое"
    },
    {
      "number": 25,
      "text": "И это - не речь сатаны, побиваемого камнями."
    },
    {
      "number": 26,
      "text": "Куда же вы идете?"
    },
    {
      "number": 27,
      "text": "Это ведь только увещевание мирам, -"
    },
    {
      "number": 28,
      "text": "тем из вас, кто желает быть прямым."
    },
    {
      "number": 29,
      "text": "Но вы этого не пожелаете, если не пожелает Аллах, Владыка миров."
    }
  ]
}