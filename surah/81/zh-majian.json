{
  "surah": 81,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "當太陽黯黮的時候，"
    },
    {
      "number": 2,
      "text": "當星宿零落的時候，"
    },
    {
      "number": 3,
      "text": "當山巒崩潰的時候，"
    },
    {
      "number": 4,
      "text": "當孕駝被拋棄的時候，"
    },
    {
      "number": 5,
      "text": "當野獸被集合的時候，"
    },
    {
      "number": 6,
      "text": "當海洋澎湃的時候，"
    },
    {
      "number": 7,
      "text": "當靈魂被配合的時候，"
    },
    {
      "number": 8,
      "text": "當被活埋的女孩被詢問的時候："
    },
    {
      "number": 9,
      "text": "「她為什麼罪過而遭殺害呢？」"
    },
    {
      "number": 10,
      "text": "當功過簿被展開的時候，"
    },
    {
      "number": 11,
      "text": "當天皮被揭去的時候，"
    },
    {
      "number": 12,
      "text": "當火獄被燃著的時候，"
    },
    {
      "number": 13,
      "text": "當樂園被送近的時候，"
    },
    {
      "number": 14,
      "text": "每個人都知道他所作過的善惡。"
    },
    {
      "number": 15,
      "text": "我誓以運行的眾星——"
    },
    {
      "number": 16,
      "text": "沒落的行星，"
    },
    {
      "number": 17,
      "text": "和逝去時的黑夜，"
    },
    {
      "number": 18,
      "text": "照耀時的早晨，"
    },
    {
      "number": 19,
      "text": "這確是一個尊貴的使者的言辭，"
    },
    {
      "number": 20,
      "text": "他在寶座的主那裡，是有權力的，是有地位的，"
    },
    {
      "number": 21,
      "text": "是眾望所歸，而且忠於職守的。"
    },
    {
      "number": 22,
      "text": "你們的朋友，不是一個瘋人，"
    },
    {
      "number": 23,
      "text": "他確已看見那個天使在明顯的天邊，"
    },
    {
      "number": 24,
      "text": "他對幽玄不是吝教的。"
    },
    {
      "number": 25,
      "text": "這不是被放逐的惡魔的言辭，"
    },
    {
      "number": 26,
      "text": "然則，你們將往那裡去呢？"
    },
    {
      "number": 27,
      "text": "這只是對於全世界的教誨——"
    },
    {
      "number": 28,
      "text": "對於你們中欲循規蹈矩者的教誨，"
    },
    {
      "number": 29,
      "text": "你們不欲循規蹈矩，除非真主——全世界的主——意欲的時候。"
    }
  ]
}