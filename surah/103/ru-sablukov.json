{
  "surah": 103,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь вечерним временем:"
    },
    {
      "number": 2,
      "text": "Род человеческий - в заблуждении,"
    },
    {
      "number": 3,
      "text": "Кроме тех, которые веруют, делают добрые дела, учат друг друга истине, учат друг друга терпению."
    }
  ]
}