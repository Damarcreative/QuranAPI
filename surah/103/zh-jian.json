{
  "surah": 103,
  "translation": "zh-jian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "以时光盟誓，"
    },
    {
      "number": 2,
      "text": "一切人确是在亏折之中，"
    },
    {
      "number": 3,
      "text": "惟信道而且行善，并以真理相劝，以坚忍相勉的人则不然。"
    }
  ]
}