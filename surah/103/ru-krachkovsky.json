  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Клянусь предвечерним временем,"
    },
    {
      "number": 2,
      "text": "поистине, человек ведь в убытке,"
    },
    {
      "number": 3,
      "text": "кроме тех, которые уверовали, и творили добрые дела, и заповедали между собой истину, и заповедали между собой терпение!"
    }
  ]
}