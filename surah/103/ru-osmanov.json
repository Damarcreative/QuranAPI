{
  "surah": 103,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь послеполуденным временем,"
    },
    {
      "number": 2,
      "text": "что люди, несомненно, [понесут] урон,"
    },
    {
      "number": 3,
      "text": "кроме тех, которые уверовали, вершили добрые деяния и заповедали друг другу истину и терпение."
    }
  ]
}