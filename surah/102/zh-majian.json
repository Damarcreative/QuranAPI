{
  "surah": 102,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "競賽富庶, 已使你們疏忽,"
    },
    {
      "number": 2,
      "text": "直到你們去遊墳地。"
    },
    {
      "number": 3,
      "text": "真的, 你們將來就知道了。"
    },
    {
      "number": 4,
      "text": "真的, 你們將來就知道了。"
    },
    {
      "number": 5,
      "text": "真的, 假若你們有真知灼見, (你們必不疏忽),"
    },
    {
      "number": 6,
      "text": "你們必定看見火獄,"
    },
    {
      "number": 7,
      "text": "然後, 你們必親眼看見它。"
    },
    {
      "number": 8,
      "text": "在那日, 你們必為恩澤而被審問。"
    }
  ]
}