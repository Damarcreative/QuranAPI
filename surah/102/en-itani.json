{
  "surah": 102,
  "translation": "en-itani",
  "ayahs": [
    {
      "number": 0,
      "text": "In the name of God, the Gracious, the Merciful."
    },
    {
      "number": 1,
      "text": "Abundance distracts you."
    },
    {
      "number": 2,
      "text": "Until you visit the graveyards."
    },
    {
      "number": 3,
      "text": "Indeed, you will know."
    },
    {
      "number": 4,
      "text": "Certainly, you will know."
    },
    {
      "number": 5,
      "text": "If you knew with knowledge of certainty."
    },
    {
      "number": 6,
      "text": "You would see the Inferno."
    },
    {
      "number": 7,
      "text": "Then you will see it with the eye of certainty."
    },
    {
      "number": 8,
      "text": "Then, on that Day, you will be questioned about the Bliss."
    }
  ]
}