{
  "surah": 102,
  "translation": "ru-porokhova",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Всемилостивого, Милосердного!"
    },
    {
      "number": 1,
      "text": "Страсть к накоплению добра Вас отвлекает от деяний должных"
    },
    {
      "number": 2,
      "text": "До самой гробовой доски."
    },
    {
      "number": 3,
      "text": "Но нет, познаете вы скоро!"
    },
    {
      "number": 4,
      "text": "И вновь, познаете вы скоро!"
    },
    {
      "number": 5,
      "text": "Но нет же! Если бы вы знали знаньем достоверным,"
    },
    {
      "number": 6,
      "text": "Узрели бы вы пламя Ада."
    },
    {
      "number": 7,
      "text": "Поистине, вы оком достоверным Увидите его!"
    },
    {
      "number": 8,
      "text": "Поистине, В тот День Сполна с вас спросят за греховные услады, (Что вы вкусили на земле)."
    }
  ]
}