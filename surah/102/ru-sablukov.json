{
  "surah": 102,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Привязанность к богатству озабочивает вас"
    },
    {
      "number": 2,
      "text": "Дотоле, покуда не уходите гостить в могилах."
    },
    {
      "number": 3,
      "text": "Действительно, узнаете,"
    },
    {
      "number": 4,
      "text": "И еще, действительно, вы узнаете -"
    },
    {
      "number": 5,
      "text": "О если бы знали вы это теперь верным знанием -"
    },
    {
      "number": 6,
      "text": "Вы увидите пламень ада,"
    },
    {
      "number": 7,
      "text": "Увидите его очами уверенности."
    },
    {
      "number": 8,
      "text": "В тот день от вас спросят ответственности за привязанность к удовольствиям."
    }
  ]
}