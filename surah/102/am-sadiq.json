{
  "surah": 102,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በብዛት መፎካከር (ጌታችሁን ከመገዛት) አዘነጋችሁ፡፡"
    },
    {
      "number": 2,
      "text": "መቃብሮችን እስከ ጎበኛችሁ ድረስ፡፡"
    },
    {
      "number": 3,
      "text": "ተከልከሉ፤ ወደፊት (ውጤቱን) ታውቃላችሁ፡፡"
    },
    {
      "number": 4,
      "text": "ከዚያም ተከልከሉ፤ ወደ ፊት ታውቃላችሁ፡፡"
    },
    {
      "number": 5,
      "text": "በእውነቱ (የሚጠብቃችሁን) እርግጠኛ ዕውቀትን ብታውቁ ኖሮ፤ (ባልዘናጋችሁ ነበር)፡፡"
    },
    {
      "number": 6,
      "text": "ገሀነምን በእርግጥ ታያላችሁ፡፡"
    },
    {
      "number": 7,
      "text": "ከዚያም እርግጠኛን ማየት ታዩዋታላችሁ፡፡"
    },
    {
      "number": 8,
      "text": "ከዚያም ከድሎታችሁ ሁሉ በዚያ ቀን ትጠየቃላችሁ፡፡"
    }
  ]
}