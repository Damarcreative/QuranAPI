  "ayahs": [
    {
      "number": 1,
      "text": "Alh<u>a</u>kumu a<b>l</b>ttak<u>a</u>thur<b>u</b>"
    },
    {
      "number": 2,
      "text": "<u>H</u>att<u>a</u> zurtumu almaq<u>a</u>bir<b>a</b>"
    },
    {
      "number": 3,
      "text": "Kall<u>a</u> sawfa taAAlamoon<b>a</b>"
    },
    {
      "number": 4,
      "text": "Thumma kall<u>a</u> sawfa taAAlamoon<b>a</b>"
    },
    {
      "number": 5,
      "text": "Kall<u>a</u> law taAAlamoona AAilma alyaqeen<b>i</b>"
    },
    {
      "number": 6,
      "text": "Latarawunna alja<u>h</u>eem<b>a</b>"
    },
    {
      "number": 7,
      "text": "Thumma latarawunnah<u>a</u> AAayna alyaqeen<b>i</b>"
    },
    {
      "number": 8,
      "text": "Thumma latusalunna yawmai<u>th</u>in AAani a<b>l</b>nnaAAeem<b>i</b>"
    }
  ]
