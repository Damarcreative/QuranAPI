{
  "surah": 102,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "പരസ്പരം പെരുമനടിക്കല്‍ നിങ്ങളെ അശ്രദ്ധരാക്കിയിരിക്കുന്നു."
    },
    {
      "number": 2,
      "text": "നിങ്ങള്‍ ശവക്കുഴികള്‍ സന്ദര്‍ശിക്കും വരെ."
    },
    {
      "number": 3,
      "text": "സംശയം വേണ്ട; നിങ്ങളതറിയുകതന്നെ ചെയ്യും."
    },
    {
      "number": 4,
      "text": "വീണ്ടും സംശയം വേണ്ട; നിങ്ങളതറിയുകതന്നെ ചെയ്യും."
    },
    {
      "number": 5,
      "text": "നിസ്സംശയം! നിങ്ങള്‍ ദൃഢമായ അറിവ് നേടിയിരുന്നെങ്കില്‍!"
    },
    {
      "number": 6,
      "text": "നരകത്തെ നിങ്ങള്‍ നേരില്‍ കാണുകതന്നെ ചെയ്യും."
    },
    {
      "number": 7,
      "text": "പിന്നെ നിങ്ങളതിനെ ഉറപ്പായും കണ്ണുകൊണ്ട് കാണുകതന്നെ ചെയ്യും."
    },
    {
      "number": 8,
      "text": "പിന്നീട് നിങ്ങളനുഭവിച്ച സുഖാനുഗ്രഹങ്ങളെപ്പറ്റി അന്ന് നിങ്ങളെ ചോദ്യം ചെയ്യും."
    }
  ]
}