{
  "surah": 102,
  "translation": "az-musayev",
  "ayahs": [
    {
      "number": 0,
      "text": "Mərhəmətli və Rəhmli Allahın adı ilə!"
    },
    {
      "number": 1,
      "text": "Çoxluğa hərisliyiniz başınızı o qədər qatdı ki,"
    },
    {
      "number": 2,
      "text": "gömülməklə qəbirləri ziyarət etdiniz."
    },
    {
      "number": 3,
      "text": "Yox-yox! Siz aqibətinizi hökmən biləcəksiniz!"
    },
    {
      "number": 4,
      "text": "Bir də yox! Siz aqibətinizi tezliklə biləcəksiniz!"
    },
    {
      "number": 5,
      "text": "Xeyr! Kaş ki, yəqin biləydiniz."
    },
    {
      "number": 6,
      "text": "Siz Cəhənnəmi mütləq görəcəksiniz!"
    },
    {
      "number": 7,
      "text": "Onu həqiqətən öz gözünüzlə mütləq görəcəksiniz!"
    },
    {
      "number": 8,
      "text": "Sonra, o gün nemətlər barəsində hökmən sorğu-suala tutulacaqsınız."
    }
  ]
}