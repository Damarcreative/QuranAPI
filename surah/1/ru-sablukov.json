{
  "surah": 1,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 2,
      "text": "Слава Богу, Господу миров,"
    },
    {
      "number": 3,
      "text": "Милостивому, милосердному,"
    },
    {
      "number": 4,
      "text": "Держащему в своём распоряжении день суда!"
    },
    {
      "number": 5,
      "text": "Тебе поклоняемся и у Тебя просим помощи:"
    },
    {
      "number": 6,
      "text": "\"Веди нас путём прямым,"
    },
    {
      "number": 7,
      "text": "Путём тех, которых Ты облагодетельствовал, не тех, которые под гневом, ни тех которые блуждают\"."
    }
  ]
}