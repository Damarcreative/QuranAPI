{
  "surah": 1,
  "translation": "az-musayev",
  "ayahs": [
    {
      "number": 1,
      "text": "Mərhəmətli və Rəhmli Allahın adı ilə!"
    },
    {
      "number": 2,
      "text": "Həmd olsun aləmlərin Rəbbi Allaha,"
    },
    {
      "number": 3,
      "text": "Mərhəmətli və Rəhmliyə,"
    },
    {
      "number": 4,
      "text": "Haqq-hesab gününün Hökmdarına!"
    },
    {
      "number": 5,
      "text": "Biz yalnız Sənə ibadət edir və yalnız Səndən kömək diləyirik."
    },
    {
      "number": 6,
      "text": "Bizi doğru yola yönəlt –"
    },
    {
      "number": 7,
      "text": "nemət bəxş etdiyin şəxslərin yoluna, qəzəbə uğramışların və azmışların yoluna yox!"
    }
  ]
}