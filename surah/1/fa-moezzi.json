{
  "surah": 1,
  "translation": "fa-moezzi",
  "ayahs": [
    {
      "number": 1,
      "text": "بنام خداوند بخشاینده مهربان‌"
    },
    {
      "number": 2,
      "text": "سپاس خدایرا پروردگار جهانیان‌"
    },
    {
      "number": 3,
      "text": "بخشاینده مهربان‌"
    },
    {
      "number": 4,
      "text": "که فرمانروای روز رستاخیز است‌"
    },
    {
      "number": 5,
      "text": "خدایا تو را پرستش کنیم و از تو یاری خواهیم‌"
    },
    {
      "number": 6,
      "text": "ما را به راه راست هدایت فرما"
    },
    {
      "number": 7,
      "text": "راه آنانکه برایشان روزی فرستادی نه راه غضب‌شدگان و نه راه گمگشتگان‌"
    }
  ]
}