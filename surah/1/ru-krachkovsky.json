{
  "surah": 1,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 2,
      "text": "Хвала - Аллаху, Господу миров,"
    },
    {
      "number": 3,
      "text": "милостивому, милосердному,"
    },
    {
      "number": 4,
      "text": "царю в день суда!"
    },
    {
      "number": 5,
      "text": "Тебе мы поклоняемся и просим помочь!"
    },
    {
      "number": 6,
      "text": "Веди нас по дороге прямой,"
    },
    {
      "number": 7,
      "text": "по дороге тех, которых Ты облагодетельствовал, не тех, которые находятся под гневом, и не заблудших."
    }
  ]
}