{
  "surah": 1,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 2,
      "text": "一切贊頌，全歸真主，全世界的主，"
    },
    {
      "number": 3,
      "text": "至仁至慈的主，"
    },
    {
      "number": 4,
      "text": "報應日的主。"
    },
    {
      "number": 5,
      "text": "我們只崇拜你，只求你祐助，"
    },
    {
      "number": 6,
      "text": "求你引導我們上正路，"
    },
    {
      "number": 7,
      "text": "你所祐助者的路，不是受譴怒者的路，也不是迷誤者的路。"
    }
  ]
}