{
  "surah": 1,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 1,
      "text": "Во имя Аллаха, Милостивого, Милосердного."
    },
    {
      "number": 2,
      "text": "Хвала Аллаху - Господу [обитателей] миров,"
    },
    {
      "number": 3,
      "text": "милостивому, милосердному,"
    },
    {
      "number": 4,
      "text": "властителю дня Суда!"
    },
    {
      "number": 5,
      "text": "Тебе мы поклоняемся и к Тебе взываем о помощи:"
    },
    {
      "number": 6,
      "text": "веди нас прямым путем,"
    },
    {
      "number": 7,
      "text": "путем тех, которых Ты облагодетельствовал, не тех, что [подпали под Твой] гнев, и не [путем] заблудших."
    }
  ]
}