{
  "surah": 1,
  "translation": "ru-porokhova",
  "ayahs": [
    {
      "number": 1,
      "text": "Во имя Аллаха, Всемилостивого, Милосердного!"
    },
    {
      "number": 2,
      "text": "Хвала Аллаху, Господу миров!"
    },
    {
      "number": 3,
      "text": "Всемилостив и милосерден (Он Один),"
    },
    {
      "number": 4,
      "text": "Дня Судного Один Он властелин."
    },
    {
      "number": 5,
      "text": "Мы предаемся лишь Тебе И лишь к Тебе о помощи взываем:"
    },
    {
      "number": 6,
      "text": "Направь прямой стезею нас,"
    },
    {
      "number": 7,
      "text": "Стезею тех, Кто милостью Твоею одарен, А не стезею тех, на ком Твой гнев, И не стезей заблудших."
    }
  ]
}