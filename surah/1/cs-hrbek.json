{
  "surah": 1,
  "translation": "cs-hrbek",
  "ayahs": [
    {
      "number": 1,
      "text": "Ve jménu Boha milosrdného, slitovného."
    },
    {
      "number": 2,
      "text": "Chvála Bohu, Pánu lidstva veškerého,"
    },
    {
      "number": 3,
      "text": "Milosrdnému, Slitovnému,"
    },
    {
      "number": 4,
      "text": "vládci dne soudného!"
    },
    {
      "number": 5,
      "text": "Tebe uctíváme a Tebe o pomoc žádáme,"
    },
    {
      "number": 6,
      "text": "veď nás stezkou přímou,"
    },
    {
      "number": 7,
      "text": "stezkou těch, jež zahrnuls milostí Svou, ne těch, na něž jsi rozhněván, ani těch, kdo v bludu jsou."
    }
  ]
}