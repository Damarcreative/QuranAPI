  "ayahs": [
    {
      "number": 1,
      "text": "Rahman ve Rahim ALLAH'ın ismiyle."
    },
    {
      "number": 2,
      "text": "Övgü, evrenlerin Rabbi ALLAH'adır."
    },
    {
      "number": 3,
      "text": "Rahman, Rahim (Merhametli),"
    },
    {
      "number": 4,
      "text": "Yargı (Din) Gününün sahibi."
    },
    {
      "number": 5,
      "text": "Ancak sana tapar, ancak senden yardım dileriz."
    },
    {
      "number": 6,
      "text": "Bizi doğru yola ilet."
    },
    {
      "number": 7,
      "text": "Gazaba uğrayanların ve sapmışların değil; kendilerine iyilikte bulunduğun kimselerin yoluna..."
    }
  ]
