{
  "surah": 1,
  "translation": "tr-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "bismi-llâhi-rraḥmâni-rraḥîm."
    },
    {
      "number": 2,
      "text": "elḥamdü lillâhi rabbi-l`âlemîn."
    },
    {
      "number": 3,
      "text": "erraḥmâni-rraḥîm."
    },
    {
      "number": 4,
      "text": "mâliki yevmi-ddîn."
    },
    {
      "number": 5,
      "text": "iyyâke na`büdü veiyyâke neste`în."
    },
    {
      "number": 6,
      "text": "ihdine-ṣṣirâṭa-lmüsteḳîm."
    },
    {
      "number": 7,
      "text": "ṣirâṭa-lleẕîne en`amte `aleyhim gayri-lmagḍûbi `aleyhim vele-ḍḍâllîn."
    }
  ]
}