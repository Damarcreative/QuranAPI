{
  "surah": 80,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного."
    },
    {
      "number": 1,
      "text": "Он нахмурился и отвернулся"
    },
    {
      "number": 2,
      "text": "из-за того, что к нему подошел слепой."
    },
    {
      "number": 3,
      "text": "Так откуда же тебе знать: возможно, он очистился бы от скверны [грехов]"
    },
    {
      "number": 4,
      "text": "или запомнил бы [твое] наставление, и оно помогло бы ему?"
    },
    {
      "number": 5,
      "text": "А к тому, кто богат,"
    },
    {
      "number": 6,
      "text": "ты поворачиваешься приветливо,"
    },
    {
      "number": 7,
      "text": "хотя ты и не отвечаешь за то, что он не очистится от скверны [грехов]."
    },
    {
      "number": 8,
      "text": "Но тем, кто приходит к тебе со рвением"
    },
    {
      "number": 9,
      "text": "и кто боится [Аллаха],"
    },
    {
      "number": 10,
      "text": "ты пренебрегаешь."
    },
    {
      "number": 11,
      "text": "Но нет! Воистину, он (т. е. Коран) - назидание,"
    },
    {
      "number": 12,
      "text": "и тот, кто захочет, пусть извлекает из него (т. е. Корана) урок."
    },
    {
      "number": 13,
      "text": "[Коран] - в свитках почитаемых,"
    },
    {
      "number": 14,
      "text": "вознесенных, пречистых [от скверны],"
    },
    {
      "number": 15,
      "text": "переписанных руками ангелов-посланцев [от Аллаха к посланникам],"
    },
    {
      "number": 16,
      "text": "досточтимых, благородных."
    },
    {
      "number": 17,
      "text": "Да сгинет человек! Как он неблагодарен!"
    },
    {
      "number": 18,
      "text": "Из чего Он сотворил его?"
    },
    {
      "number": 19,
      "text": "Он создал его из капли семени и определил [его природу],"
    },
    {
      "number": 20,
      "text": "потом облегчил ему путь,"
    },
    {
      "number": 21,
      "text": "потом умертвил его и предал погребению."
    },
    {
      "number": 22,
      "text": "А потом, когда захотел, воскресил его."
    },
    {
      "number": 23,
      "text": "Так нет же! Не исполняет [человек] того, что велел ему [Господь]!"
    },
    {
      "number": 24,
      "text": "Пусть поразмыслит он о том, [кто посылает] ему пропитание,-"
    },
    {
      "number": 25,
      "text": "по Нашему велению обильно проливаются ливни,"
    },
    {
      "number": 26,
      "text": "потом Мы иссекаем землю ходами [от растений],"
    },
    {
      "number": 27,
      "text": "взращиваем на ней злаки,"
    },
    {
      "number": 28,
      "text": "виноград, травы,"
    },
    {
      "number": 29,
      "text": "маслины, пальмы,"
    },
    {
      "number": 30,
      "text": "сады обильные,"
    },
    {
      "number": 31,
      "text": "плоды и пастбища"
    },
    {
      "number": 32,
      "text": "на пользу вам и вашей скотине."
    },
    {
      "number": 33,
      "text": "Когда раздастся [второй] трубный глас"
    },
    {
      "number": 34,
      "text": "в тот день, когда брат бросит в беде своего брата,"
    },
    {
      "number": 35,
      "text": "мать, отца,"
    },
    {
      "number": 36,
      "text": "жену и детей своих,"
    },
    {
      "number": 37,
      "text": "ибо каждому человеку будет не до них,"
    },
    {
      "number": 38,
      "text": "в тот день одни лица сияют [от счастья],"
    },
    {
      "number": 39,
      "text": "смеются и ликуют,"
    },
    {
      "number": 40,
      "text": "на других же лицах в тот день прах,"
    },
    {
      "number": 41,
      "text": "которым они омрачены."
    },
    {
      "number": 42,
      "text": "Они-то и есть нечестивые неверные."
    }
  ]
}