{
  "surah": 80,
  "translation": "ru-kuliev",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного!"
    },
    {
      "number": 1,
      "text": "Он нахмурился и отвернулся,"
    },
    {
      "number": 2,
      "text": "потому что к нему подошел слепой."
    },
    {
      "number": 3,
      "text": "Откуда тебе знать? Возможно, он бы очистился"
    },
    {
      "number": 4,
      "text": "или помянул бы наставление, и поминание принесло бы ему пользу."
    },
    {
      "number": 5,
      "text": "Тому, кто решил, что он ни в чем не нуждается,"
    },
    {
      "number": 6,
      "text": "ты уделяешь внимание,"
    },
    {
      "number": 7,
      "text": "Что же будет тебе, если он не очистится?"
    },
    {
      "number": 8,
      "text": "А того, кто приходит к тебе со рвением"
    },
    {
      "number": 9,
      "text": "и страшится Аллаха,"
    },
    {
      "number": 10,
      "text": "ты оставляешь без внимания."
    },
    {
      "number": 11,
      "text": "Но нет! Это есть Назидание,"
    },
    {
      "number": 12,
      "text": "и пусть помянет его всякий желающий."
    },
    {
      "number": 13,
      "text": "Оно записано в свитках почитаемых,"
    },
    {
      "number": 14,
      "text": "вознесенных и очищенных,"
    },
    {
      "number": 15,
      "text": "в руках посланцев"
    },
    {
      "number": 16,
      "text": "благородных и покорных."
    },
    {
      "number": 17,
      "text": "Да сгинет человек! Как же он неблагодарен!"
    },
    {
      "number": 18,
      "text": "Из чего Он сотворил его?"
    },
    {
      "number": 19,
      "text": "Он сотворил его из капли и соразмерил (или предопределил стадии его развития),"
    },
    {
      "number": 20,
      "text": "потом облегчил ему путь,"
    },
    {
      "number": 21,
      "text": "потом умертвил его и поместил в могилу."
    },
    {
      "number": 22,
      "text": "Потом, когда пожелает, Он воскресит его."
    },
    {
      "number": 23,
      "text": "Но нет! Он не выполняет того, что Он приказал ему."
    },
    {
      "number": 24,
      "text": "Пусть посмотрит человек на свое пропитание!"
    },
    {
      "number": 25,
      "text": "Мы проливаем обильные ливни,"
    },
    {
      "number": 26,
      "text": "затем рассекаем землю трещинами"
    },
    {
      "number": 27,
      "text": "и взращиваем на ней зерна,"
    },
    {
      "number": 28,
      "text": "виноград и люцерну,"
    },
    {
      "number": 29,
      "text": "маслины и финиковые пальмы,"
    },
    {
      "number": 30,
      "text": "сады густые (или с могучими деревьями),"
    },
    {
      "number": 31,
      "text": "фрукты и травы"
    },
    {
      "number": 32,
      "text": "на пользу вам и вашей скотине."
    },
    {
      "number": 33,
      "text": "Когда же раздастся Оглушительный глас,"
    },
    {
      "number": 34,
      "text": "в тот день человек бросит своего брата,"
    },
    {
      "number": 35,
      "text": "свою мать и своего отца,"
    },
    {
      "number": 36,
      "text": "свою жену и своих сыновей,"
    },
    {
      "number": 37,
      "text": "ибо у каждого человека своих забот будет сполна."
    },
    {
      "number": 38,
      "text": "В тот день одни лица будут сиять,"
    },
    {
      "number": 39,
      "text": "смеяться и ликовать."
    },
    {
      "number": 40,
      "text": "На других же лицах в тот день будет прах,"
    },
    {
      "number": 41,
      "text": "покрывающий их мраком."
    },
    {
      "number": 42,
      "text": "Это будут неверующие грешники."
    }
  ]
}