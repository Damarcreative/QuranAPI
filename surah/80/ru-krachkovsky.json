{
  "surah": 80,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Он нахмурился и отвернулся"
    },
    {
      "number": 2,
      "text": "от того, что подошел к нему слепой"
    },
    {
      "number": 3,
      "text": "А что дало тебе знать, - может быть, он очистится,"
    },
    {
      "number": 4,
      "text": "или станет поминать увещевание, и поможет ему воспоминание."
    },
    {
      "number": 5,
      "text": "А вот тот, кто богат,"
    },
    {
      "number": 6,
      "text": "к нему ты поворачиваешься."
    },
    {
      "number": 7,
      "text": "хотя и не на тебе лежит, что он не очищается."
    },
    {
      "number": 8,
      "text": "А тот, кто приходит к тебе со тщанием"
    },
    {
      "number": 9,
      "text": "и испытывает страх, -"
    },
    {
      "number": 10,
      "text": "ты от него отвлекаешься."
    },
    {
      "number": 11,
      "text": "Но нет! Это ведь напоминание, -"
    },
    {
      "number": 12,
      "text": "и кто пожелает, его вспомнит, -"
    },
    {
      "number": 13,
      "text": "в свитках почтенных,"
    },
    {
      "number": 14,
      "text": "возвышенных, очищенных"
    },
    {
      "number": 15,
      "text": "руками писцов"
    },
    {
      "number": 16,
      "text": "почтенных, благих."
    },
    {
      "number": 17,
      "text": "Убит будь человек, как он неверен!"
    },
    {
      "number": 18,
      "text": "Из чего Он его создал?"
    },
    {
      "number": 19,
      "text": "- Из капли! Создал его и соразмерил,"
    },
    {
      "number": 20,
      "text": "потом дорогу ему облегчил"
    },
    {
      "number": 21,
      "text": "Потом его умертвил и похоронил."
    },
    {
      "number": 22,
      "text": "Потом, когда пожелал, его воскресил."
    },
    {
      "number": 23,
      "text": "Так нет! Не совершает он того, что повелел Он!"
    },
    {
      "number": 24,
      "text": "Пусть же посмотрит человек на свою пищу, -"
    },
    {
      "number": 25,
      "text": "как Мы пролили воду ливнем,"
    },
    {
      "number": 26,
      "text": "потом рассекли землю трещинами"
    },
    {
      "number": 27,
      "text": "и взрастили на ней зерна,"
    },
    {
      "number": 28,
      "text": "и виноград, и траву,"
    },
    {
      "number": 29,
      "text": "и маслины, и пальмы,"
    },
    {
      "number": 30,
      "text": "и сады густые,"
    },
    {
      "number": 31,
      "text": "и фрукты, и растения"
    },
    {
      "number": 32,
      "text": "на пользу вам и вашим животным."
    },
    {
      "number": 33,
      "text": "И когда придет оглушительный,"
    },
    {
      "number": 34,
      "text": "в тот день, как убежит муж от брата,"
    },
    {
      "number": 35,
      "text": "и матери, и отца,"
    },
    {
      "number": 36,
      "text": "и подруги, и сыновей."
    },
    {
      "number": 37,
      "text": "У каждого мужа из них тогда - дело ему достаточное."
    },
    {
      "number": 38,
      "text": "Лица в тот день открытые,"
    },
    {
      "number": 39,
      "text": "смеющиеся, веселые,"
    },
    {
      "number": 40,
      "text": "и лица в тот день - на них пыль,"
    },
    {
      "number": 41,
      "text": "покрыл их прах."
    },
    {
      "number": 42,
      "text": "Они-то - неверные и распутники."
    }
  ]
}