{
  "surah": 80,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ፊቱን አጨፈገገ፤ ዞረም፡፡"
    },
    {
      "number": 2,
      "text": "ዕውሩ ስለ መጣው፡፡"
    },
    {
      "number": 3,
      "text": "ምን ያሳውቅሃል? (ከኀጢአቶቹ) ሊጥራራ ይከጀላል፡፡"
    },
    {
      "number": 4,
      "text": "ወይም ሊገሠጽ ግሠጼይቱም ልትጠቅመው (ይከጀላል)፡፡"
    },
    {
      "number": 5,
      "text": "የተብቃቃው ሰውማ፤"
    },
    {
      "number": 6,
      "text": "አንተ ለእርሱ (ለእምነቱ በመጓጓት) በፈገግታ ትቀበለዋለህ፡፡"
    },
    {
      "number": 7,
      "text": "ባይጥራራ (ባያምን) ባንተ ላይ ምንም የሌለብህ ስትኾን፡፡"
    },
    {
      "number": 8,
      "text": "እየገሰገሰ የመጣህ ሰውማ፤"
    },
    {
      "number": 9,
      "text": "እርሱ (አላህን) የሚፈራ ሲኾን፤"
    },
    {
      "number": 10,
      "text": "አንተ ከእርሱ ትዝዘናጋለህ፡፡"
    },
    {
      "number": 11,
      "text": "ተከልከል፡፡ እርሷ ማስገንዘቢያ ናት፡፡"
    },
    {
      "number": 12,
      "text": "የሻም ሰው (ቁርኣኑን) ያስታውሰዋል፡፡"
    },
    {
      "number": 13,
      "text": "በተከበሩ ጽሑፎች ውስጥ ነው፡፡"
    },
    {
      "number": 14,
      "text": "ከፍ በተደረገች ንጹሕ በተደረገች (ጽሑፍ ውስጥ ነው)፡፡"
    },
    {
      "number": 15,
      "text": "በጸሐፊዎቹ (መላእክት) እጆች (ንጹሕ የተደረገች)፡፡"
    },
    {
      "number": 16,
      "text": "የተከበሩና ታዛዦች በኾኑት (ጸሐፊዎች እጆች)፡፡"
    },
    {
      "number": 17,
      "text": "ሰው ተረገመ፤ ምን ከሓዲ አደረገው?"
    },
    {
      "number": 18,
      "text": "(ጌታው) በምን ነገር ፈጠረው? (አያስብምን?)"
    },
    {
      "number": 19,
      "text": "ከፍትወት ጠብታ ፈጠረው፤ መጠነውም፡፡"
    },
    {
      "number": 20,
      "text": "ከዚያም (መውጫ) መንገዱን አገራው፡፡"
    },
    {
      "number": 21,
      "text": "ከዚያም ገደለው፤ እንዲቀበርም አደረገው፡፡"
    },
    {
      "number": 22,
      "text": "ከዚያም (ማንሳቱን) በሻ ጊዜ ያስነሳዋል፡፡"
    },
    {
      "number": 23,
      "text": "በእውነት ያንን (ጌታው) ያዘዘውን ገና አልፈጸመም፡፡"
    },
    {
      "number": 24,
      "text": "ሰውም ወደ ምግቡ ይመልከት፡፡"
    },
    {
      "number": 25,
      "text": "እኛ ውሃን ማንቧቧትን ያንቧቧን መኾናችንን፡፡"
    },
    {
      "number": 26,
      "text": "ከዚያም ምድርን (በደካማ ቡቃያ) መሰንጠቅን የሰነጠቅን፤"
    },
    {
      "number": 27,
      "text": "በውስጧም እኽልን ያበቀልን፤"
    },
    {
      "number": 28,
      "text": "ወይንንም፤ እርጥብ ያበቀልን፤"
    },
    {
      "number": 29,
      "text": "የዘይት ወይራንም ዘንባባንም፤"
    },
    {
      "number": 30,
      "text": "ጭፍቆች አትክልቶችንም፤"
    },
    {
      "number": 31,
      "text": "ፍራፍሬንም ገለባንም፤ (ያበቀልን መኾናችንን ይመልከት)፡፡"
    },
    {
      "number": 32,
      "text": "ለእናንተም ለእንስሶቻችሁም መጠቀሚያ ይኾን ዘንድ (ይህን ሠራን)፡፡"
    },
    {
      "number": 33,
      "text": "አደንቋሪይቱም (መከራ) በመጣች ጊዜ፤"
    },
    {
      "number": 34,
      "text": "ሰው ከወንድሙ በሚሸሽበት ቀን፤"
    },
    {
      "number": 35,
      "text": "ከናቱም ካባቱም፤"
    },
    {
      "number": 36,
      "text": "ከሚስቱም ከልጁም፤"
    },
    {
      "number": 37,
      "text": "ከእነርሱ ለየሰው ሁሉ በዚያ ቀን (ከሌላው) የሚያብቃቃው ኹነታ አልለው፡፡"
    },
    {
      "number": 38,
      "text": "ፊቶች በዚያ ቀን አብሪዎች ናቸው፤"
    },
    {
      "number": 39,
      "text": "ሳቂዎችም ተደሳቾችም ናቸው፡፡"
    },
    {
      "number": 40,
      "text": "ፊቶችም በዚያ ቀን በላያቸው ላይ ትቢያ አልለባቸው፤"
    },
    {
      "number": 41,
      "text": "ጥቁረት ትሸፍናቸዋለች፤"
    },
    {
      "number": 42,
      "text": "እነዚያ እነሱ ከሓዲዎቹ አመጸኞቹ ናቸው፡፡"
    }
  ]
}