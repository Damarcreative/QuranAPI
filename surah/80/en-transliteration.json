{
  "surah": 80,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "AAabasa watawall<u>a</u>"
    },
    {
      "number": 2,
      "text": "An j<u>a</u>ahu alaAAm<u>a</u>"
    },
    {
      "number": 3,
      "text": "Wam<u>a</u> yudreeka laAAallahu yazzakk<u>a</u>"
    },
    {
      "number": 4,
      "text": "Aw ya<u>thth</u>akkaru fatanfaAAahu a<b>l</b><u>thth</u>ikr<u>a</u>"
    },
    {
      "number": 5,
      "text": "Amm<u>a</u> mani istaghn<u>a</u>"
    },
    {
      "number": 6,
      "text": "Faanta lahu ta<u>s</u>add<u>a</u>"
    },
    {
      "number": 7,
      "text": "Wam<u>a</u> AAalayka all<u>a</u> yazzakk<u>a</u>"
    },
    {
      "number": 8,
      "text": "Waamm<u>a</u> man j<u>a</u>aka yasAA<u>a</u>"
    },
    {
      "number": 9,
      "text": "Wahuwa yakhsh<u>a</u>"
    },
    {
      "number": 10,
      "text": "Faanta AAanhu talahh<u>a</u>"
    },
    {
      "number": 11,
      "text": "Kall<u>a</u> innah<u>a</u> ta<u>th</u>kira<b>tun</b>"
    },
    {
      "number": 12,
      "text": "Faman sh<u>a</u>a <u>th</u>akarah<b>u</b>"
    },
    {
      "number": 13,
      "text": "Fee <u>s</u>u<u>h</u>ufin mukarrama<b>tin</b>"
    },
    {
      "number": 14,
      "text": "MarfooAAatin mu<u>t</u>ahhara<b>tin</b>"
    },
    {
      "number": 15,
      "text": "Biaydee safara<b>tin</b>"
    },
    {
      "number": 16,
      "text": "Kir<u>a</u>min barara<b>tin</b>"
    },
    {
      "number": 17,
      "text": "Qutila alins<u>a</u>nu m<u>a</u> akfarah<b>u</b>"
    },
    {
      "number": 18,
      "text": "Min ayyi shayin khalaqah<b>u</b>"
    },
    {
      "number": 19,
      "text": "Min nu<u>t</u>fatin khalaqahu faqaddarah<b>u</b>"
    },
    {
      "number": 20,
      "text": "Thumma a<b>l</b>ssabeela yassarah<b>u</b>"
    },
    {
      "number": 21,
      "text": "Thumma am<u>a</u>tahu faaqbarah<b>u</b>"
    },
    {
      "number": 22,
      "text": "Thumma i<u>tha</u> sh<u>a</u>a ansharah<b>u</b>"
    },
    {
      "number": 23,
      "text": "Kall<u>a</u> lamm<u>a</u> yaq<u>d</u>i m<u>a</u> amarah<b>u</b>"
    },
    {
      "number": 24,
      "text": "Falyan<i><u>th</u></i>uri alins<u>a</u>nu il<u>a</u> <u>t</u>aAA<u>a</u>mih<b>i</b>"
    },
    {
      "number": 25,
      "text": "Ann<u>a</u> <u>s</u>ababn<u>a</u> alm<u>a</u>a <u>s</u>abb<u>a</u><b>n</b>"
    },
    {
      "number": 26,
      "text": "Thumma shaqaqn<u>a</u> alar<u>d</u>a shaqq<u>a</u><b>n</b>"
    },
    {
      "number": 27,
      "text": "Faanbatn<u>a</u> feeh<u>a</u> <u>h</u>abb<u>a</u><b>n</b>"
    },
    {
      "number": 28,
      "text": "WaAAinaban waqa<u>d</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 29,
      "text": "Wazaytoonan wanakhl<u>a</u><b>n</b>"
    },
    {
      "number": 30,
      "text": "Wa<u>h</u>ad<u>a</u>iqa ghulb<u>a</u><b>n</b>"
    },
    {
      "number": 31,
      "text": "Waf<u>a</u>kihatan waabb<u>a</u><b>n</b>"
    },
    {
      "number": 32,
      "text": "Mat<u>a</u>AAan lakum walianAA<u>a</u>mikum"
    },
    {
      "number": 33,
      "text": "Fai<u>tha</u> j<u>a</u>ati a<b>l</b><u>ssa</u>khkha<b>tu</b>"
    },
    {
      "number": 34,
      "text": "Yawma yafirru almaro min akheeh<b>i</b>"
    },
    {
      "number": 35,
      "text": "Waommihi waabeeh<b>i</b>"
    },
    {
      "number": 36,
      "text": "Wa<u>sah</u>ibatihi wabaneeh<b>i</b>"
    },
    {
      "number": 37,
      "text": "Likulli imriin minhum yawmai<u>th</u>in shanun yughneeh<b>i</b>"
    },
    {
      "number": 38,
      "text": "Wujoohun yawmai<u>th</u>in musfira<b>tun</b>"
    },
    {
      "number": 39,
      "text": "<u>Dah</u>ikatun mustabshira<b>tun</b>"
    },
    {
      "number": 40,
      "text": "Wawujoohun yawmai<u>th</u>in AAalayh<u>a</u> ghabara<b>tun</b>"
    },
    {
      "number": 41,
      "text": "Tarhaquh<u>a</u> qatara<b>tun</b>"
    },
    {
      "number": 42,
      "text": "Ol<u>a</u>ika humu alkafaratu alfajara<b>tu</b>"
    }
  ]
}