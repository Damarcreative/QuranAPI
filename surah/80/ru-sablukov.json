{
  "surah": 80,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Он нахмурился и отвернулся;"
    },
    {
      "number": 2,
      "text": "Потому что к нему пришел слепой."
    },
    {
      "number": 3,
      "text": "О если бы что нибудь вразумило тебя в том, что он может быть чистым,"
    },
    {
      "number": 4,
      "text": "Или, примет наставление, и наставление это принесет ему пользу!"
    },
    {
      "number": 5,
      "text": "Кто богат,"
    },
    {
      "number": 6,
      "text": "Того ты принимаешь ласково,"
    },
    {
      "number": 7,
      "text": "Тогда как не от тебя зависит, если он не сделается чистым."
    },
    {
      "number": 8,
      "text": "Кто же к тебе приходит с усердием,"
    },
    {
      "number": 9,
      "text": "И будучи богобоязлив,"
    },
    {
      "number": 10,
      "text": "На того ты не обращаешь внимание."
    },
    {
      "number": 11,
      "text": "Не так. Это тебе предостережение."
    },
    {
      "number": 12,
      "text": "Кто захочет, тот будет помнить его."
    },
    {
      "number": 13,
      "text": "Он на свитках, досточтимых,"
    },
    {
      "number": 14,
      "text": "Высоких, чистых,"
    },
    {
      "number": 15,
      "text": "Начертанных руками писцев"
    },
    {
      "number": 16,
      "text": "сановитых, праведных."
    },
    {
      "number": 17,
      "text": "Да будет поражен человек! Как неблагодарен он!"
    },
    {
      "number": 18,
      "text": "Из чего Он творит его?"
    },
    {
      "number": 19,
      "text": "Из семени. Он творит его, дает соразмерность его членам,"
    },
    {
      "number": 20,
      "text": "За тем облегчает ему путь,"
    },
    {
      "number": 21,
      "text": "Потом умерщвляет его и погребает его,"
    },
    {
      "number": 22,
      "text": "Потом когда захочет, воскресит его."
    },
    {
      "number": 23,
      "text": "А он не исполняет того, что повелел Он ему."
    },
    {
      "number": 24,
      "text": "Пусть обратит человек взор свой на то, чем питается он."
    },
    {
      "number": 25,
      "text": "Мы проливаем воду ливнями,"
    },
    {
      "number": 26,
      "text": "Потом заставляем землю растрескиваться трещинами,"
    },
    {
      "number": 27,
      "text": "Выращаем на ней хлеб,"
    },
    {
      "number": 28,
      "text": "Виноград, овощи,"
    },
    {
      "number": 29,
      "text": "Маслины, пальмы,"
    },
    {
      "number": 30,
      "text": "Сады, обильные деревами,"
    },
    {
      "number": 31,
      "text": "Плоды и злаки,"
    },
    {
      "number": 32,
      "text": "В продовольствие вам и скоту вашему."
    },
    {
      "number": 33,
      "text": "Но когда настанет оглушительный трубный звук,"
    },
    {
      "number": 34,
      "text": "В тот день, когда человек побежит от своего брата,"
    },
    {
      "number": 35,
      "text": "Своей матери и своего отца,"
    },
    {
      "number": 36,
      "text": "Своей супруги и своих сыновей:"
    },
    {
      "number": 37,
      "text": "В этот день для каждого из них будет забота, которая отяготит его."
    },
    {
      "number": 38,
      "text": "В этот день у некоторых лица будут светлые,"
    },
    {
      "number": 39,
      "text": "Смеющиеся, веселые;"
    },
    {
      "number": 40,
      "text": "В этот день у некоторых лица будут запыленные,"
    },
    {
      "number": 41,
      "text": "Покрытые прахом."
    },
    {
      "number": 42,
      "text": "Такими будут неверующие, развратные."
    }
  ]
}