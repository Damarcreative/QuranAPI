{
  "surah": 80,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "അദ്ദേഹം നെറ്റിചുളിച്ചു, മുഖം തിരിച്ചു."
    },
    {
      "number": 2,
      "text": "കുരുടന്റെ വരവു കാരണം."
    },
    {
      "number": 3,
      "text": "നിനക്കെന്തറിയാം? ഒരുവേള അവന്‍ വിശുദ്ധി വരിച്ചെങ്കിലോ?"
    },
    {
      "number": 4,
      "text": "അഥവാ, ഉപദേശം ശ്രദ്ധിക്കുകയും ആ ഉപദേശം അയാള്‍ക്ക് ഉപകരിക്കുകയും ചെയ്തേക്കാമല്ലോ."
    },
    {
      "number": 5,
      "text": "എന്നാല്‍ താന്‍പോരിമ നടിച്ചവനോ;"
    },
    {
      "number": 6,
      "text": "അവന്റെ നേരെ നീ ശ്രദ്ധ തിരിച്ചു."
    },
    {
      "number": 7,
      "text": "അവന്‍ നന്നായില്ലെങ്കില്‍ നിനക്കെന്ത്?"
    },
    {
      "number": 8,
      "text": "എന്നാല്‍ നിന്നെത്തേടി ഓടി വന്നവനോ,"
    },
    {
      "number": 9,
      "text": "അവന്‍ ദൈവഭയമുള്ളവനാണ്."
    },
    {
      "number": 10,
      "text": "എന്നിട്ടും നീ അവന്റെ കാര്യത്തില്‍ അശ്രദ്ധ കാണിച്ചു."
    },
    {
      "number": 11,
      "text": "അറിയുക: ഇതൊരുദ്ബോധനമാ ണ്."
    },
    {
      "number": 12,
      "text": "അതിനാല്‍ മനസ്സുള്ളവര്‍ ഇതോര്‍ക്കട്ടെ."
    },
    {
      "number": 13,
      "text": "ആദരണീയമായ ഏടുകളിലാണിതുള്ളത്."
    },
    {
      "number": 14,
      "text": "ഉന്നതങ്ങളും വിശുദ്ധങ്ങളുമായ ഏടുകളില്‍."
    },
    {
      "number": 15,
      "text": "ചില സന്ദേശവാഹകരുടെ കൈകളിലാണവ;"
    },
    {
      "number": 16,
      "text": "അവര്‍ മാന്യരും മഹത്തുക്കളുമാണ്."
    },
    {
      "number": 17,
      "text": "മനുഷ്യന്‍ തുലയട്ടെ. അവനിത്ര നന്ദിയില്ലാത്തവനായതെന്ത്?"
    },
    {
      "number": 18,
      "text": "ഏതൊരു വസ്തുവില്‍ നിന്നാണവനെ പടച്ചത്?"
    },
    {
      "number": 19,
      "text": "ഒരു ബീജ കണത്തില്‍നിന്നാണവനെ സൃഷ്ടിച്ചത്. അങ്ങനെ ക്രമാനുസൃതം രൂപപ്പെടുത്തി."
    },
    {
      "number": 20,
      "text": "എന്നിട്ട് അല്ലാഹു അവന്ന് വഴി എളുപ്പമാക്കിക്കൊടുത്തു."
    },
    {
      "number": 21,
      "text": "പിന്നീട് അവനെ മരിപ്പിച്ചു. മറമാടുകയും ചെയ്തു."
    },
    {
      "number": 22,
      "text": "പിന്നെ അല്ലാഹു ഇഛിക്കുമ്പോള്‍ അവനെ ഉയിര്‍ത്തെഴുന്നേല്‍പിക്കുന്നു."
    },
    {
      "number": 23,
      "text": "അല്ല, അല്ലാഹു കല്പിച്ചത് അവന്‍ നിര്‍വഹിച്ചില്ല."
    },
    {
      "number": 24,
      "text": "മനുഷ്യന്‍ തന്റെ ആഹാരത്തെ സംബന്ധിച്ച് ആലോചിക്കട്ടെ."
    },
    {
      "number": 25,
      "text": "നാം ധാരാളമായി മഴവെള്ളം വീഴ്ത്തി."
    },
    {
      "number": 26,
      "text": "പിന്നെ നാം മണ്ണ് കീറിപ്പിളര്‍ത്തി."
    },
    {
      "number": 27,
      "text": "അങ്ങനെ നാമതില്‍ ധാന്യത്തെ മുളപ്പിച്ചു."
    },
    {
      "number": 28,
      "text": "മുന്തിരിയും പച്ചക്കറികളും."
    },
    {
      "number": 29,
      "text": "ഒലീവും ഈത്തപ്പനയും."
    },
    {
      "number": 30,
      "text": "ഇടതൂര്‍ന്ന തോട്ടങ്ങളും."
    },
    {
      "number": 31,
      "text": "പഴങ്ങളും പുല്‍പടര്‍പ്പുകളും."
    },
    {
      "number": 32,
      "text": "നിങ്ങള്‍ക്കും നിങ്ങളുടെ കന്നുകാലികള്‍ക്കും ആഹാരമായി."
    },
    {
      "number": 33,
      "text": "എന്നാല്‍ ആ ഘോര ശബ്ദം വന്നുഭവിച്ചാല്‍."
    },
    {
      "number": 34,
      "text": "അതുണ്ടാവുന്ന ദിനം മനുഷ്യന്‍ തന്റെ സഹോദരനെ വെടിഞ്ഞോടും."
    },
    {
      "number": 35,
      "text": "മാതാവിനെയും പിതാവിനെയും."
    },
    {
      "number": 36,
      "text": "ഭാര്യയെയും മക്കളെയും."
    },
    {
      "number": 37,
      "text": "അന്ന് അവരിലോരോരുത്തര്‍ക്കും സ്വന്തം കാര്യം നോക്കാനുണ്ടാകും."
    },
    {
      "number": 38,
      "text": "അന്നു ചില മുഖങ്ങള്‍ പ്രസന്നങ്ങളായിരിക്കും;"
    },
    {
      "number": 39,
      "text": "ചിരിക്കുന്നവയും സന്തോഷപൂര്‍ണ്ണങ്ങളും."
    },
    {
      "number": 40,
      "text": "മറ്റു ചില മുഖങ്ങള്‍ അന്ന് പൊടി പുരണ്ടിരിക്കും;"
    },
    {
      "number": 41,
      "text": "ഇരുള്‍ മുറ്റിയും."
    },
    {
      "number": 42,
      "text": "അവര്‍ തന്നെയാണ് സത്യനിഷേധികളും തെമ്മാടികളും."
    }
  ]
}