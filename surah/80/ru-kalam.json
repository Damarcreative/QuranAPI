{
  "surah": 80,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 0,
      "text": "Хвала Аллаху – Господу миров [создавшему мир и управляющему им],"
    },
    {
      "number": 1,
      "text": "Он нахмурился и отвернулся"
    },
    {
      "number": 2,
      "text": "от того, что к нему пришел слепой."
    },
    {
      "number": 3,
      "text": "Откуда ты знаешь – возможно, он очистится"
    },
    {
      "number": 4,
      "text": "или примет наставление, и оно принесет ему пользу."
    },
    {
      "number": 5,
      "text": "Тому же, кто решил, что он ни в чем не нуждается,"
    },
    {
      "number": 6,
      "text": "ты уделяешь внимание."
    },
    {
      "number": 7,
      "text": "Но не будет твоей вины, если он не очистится."
    },
    {
      "number": 8,
      "text": "А того, кто приходит к тебе, спеша"
    },
    {
      "number": 9,
      "text": "и боясь [Аллаха],"
    },
    {
      "number": 10,
      "text": "ты оставляешь без внимания."
    },
    {
      "number": 11,
      "text": "Но нет! Это – напоминание."
    },
    {
      "number": 12,
      "text": "И кто пожелает, вспомнит [и примет] его."
    },
    {
      "number": 13,
      "text": "Оно – в досточтимых свитках."
    },
    {
      "number": 14,
      "text": "[Эти свитки] Возвышены и чисты."
    },
    {
      "number": 15,
      "text": "[Они] В руках [ангелов] посланцев"
    },
    {
      "number": 16,
      "text": "благородных и благочестивых."
    },
    {
      "number": 17,
      "text": "Да погибнет [неверующий] человек! Как же он неблагодарен!"
    },
    {
      "number": 18,
      "text": "Из чего [Аллах] сотворил его?"
    },
    {
      "number": 19,
      "text": "Он сотворил его из капли и предопределил."
    },
    {
      "number": 20,
      "text": "Затем [Аллах] облегчил ему путь."
    },
    {
      "number": 21,
      "text": "Затем умертвил его и поместил в могилу."
    },
    {
      "number": 22,
      "text": "Затем, когда пожелает [Аллах], воскресит его."
    },
    {
      "number": 23,
      "text": "Но нет! [Человек] Не выполняет того, что [Аллах] ему повелел."
    },
    {
      "number": 24,
      "text": "Пусть посмотрит человек на свою еду!"
    },
    {
      "number": 25,
      "text": "Мы проливаем обильные ливни."
    },
    {
      "number": 26,
      "text": "Затем рассекаем землю трещинами."
    },
    {
      "number": 27,
      "text": "И [Мы] взращиваем на ней семена."
    },
    {
      "number": 28,
      "text": "Виноград и люцерну."
    },
    {
      "number": 29,
      "text": "Оливы и пальмы."
    },
    {
      "number": 30,
      "text": "Густые сады."
    },
    {
      "number": 31,
      "text": "Фрукты и травы."
    },
    {
      "number": 32,
      "text": "[Все это] На пользу вам и вашему скоту."
    },
    {
      "number": 33,
      "text": "И когда раздастся оглушительный шум,"
    },
    {
      "number": 34,
      "text": "в этот день человек побежит от своего брата,"
    },
    {
      "number": 35,
      "text": "матери и отца,"
    },
    {
      "number": 36,
      "text": "жены и детей."
    },
    {
      "number": 37,
      "text": "В этот день каждый человек будет заботиться только о себе."
    },
    {
      "number": 38,
      "text": "В тот день [одни] лица будут сияющими,"
    },
    {
      "number": 39,
      "text": "смеющимися и радостными."
    },
    {
      "number": 40,
      "text": "На [других же] лицах в этот день будет пыль,"
    },
    {
      "number": 41,
      "text": "которая покроет их тьмой."
    },
    {
      "number": 42,
      "text": "Это будут неверующие грешники."
    }
  ]
}