{
  "surah": 80,
  "translation": "ta-tamil",
  "ayahs": [
    {
      "number": 1,
      "text": "அவர் கடுகடுத்தார், மேலும் (முகத்தைத்) திருப்பிக் கொண்டார்."
    },
    {
      "number": 2,
      "text": "அவரிடம் அந்த அந்தகர் வந்தபோது,"
    },
    {
      "number": 3,
      "text": "(நபியே! உம்மிடம் வந்த அவர்) அவர் தூய்மையாகி விடக்கூடும் என்பதை நீர் அறிவீரா?"
    },
    {
      "number": 4,
      "text": "அல்லது அவர் (உம் உபதேசத்தை) நினைவு படுத்திக்கொள்வதன் மூலம், (உம்முடைய) உபதேசம் அவருக்குப் பலனளித்திருக்கலாம்."
    },
    {
      "number": 5,
      "text": "(உம் உபதேசத்தின்) தேவையை எவன் அலட்சியம் செய்கிறானோ-"
    },
    {
      "number": 6,
      "text": "நீர் அவன்பாலே முன்னோக்குகின்றீர்."
    },
    {
      "number": 7,
      "text": "ஆயினும் (இஸ்லாத்தை யேற்று) அவன் தூய்மையடையாமல் போனால், உம் மீது (அதனால் குற்றம்) இல்லை."
    },
    {
      "number": 8,
      "text": "ஆனால், எவர் உம்மிடம் விரைந்து வந்தாரோ,"
    },
    {
      "number": 9,
      "text": "அல்லாஹ்வுக்கு அஞ்சியவராக-"
    },
    {
      "number": 10,
      "text": "அவரை விட்டும் பராமுகமாய் இருக்கின்றீர்."
    },
    {
      "number": 11,
      "text": "அவ்வாறல்ல! ஏனெனில் (இத்திருக் குர்ஆன் நினைவூட்டும்) நல்லுபதேசமாகும்."
    },
    {
      "number": 12,
      "text": "எனவே, எவர் விரும்புகிறாரோ அவர் அதை நினைவு கொள்வார்."
    },
    {
      "number": 13,
      "text": "(அது) சங்கையாக்கப்பட்ட ஏடுகளில் இருக்கிறது."
    },
    {
      "number": 14,
      "text": "உயர்வாக்கப்பட்டது, பரிசுத்தமாக்கப்பட்டது."
    },
    {
      "number": 15,
      "text": "(வானவர்களான) எழுதுபவர்களின் கைகளால்-"
    },
    {
      "number": 16,
      "text": "(லவ்ஹுல் மஹ்ஃபூளிலிருந்து எழுதிய அவ்வானவர்கள்) சங்கை மிக்கவர்கள்; நல்லோர்கள்."
    },
    {
      "number": 17,
      "text": "(நன்றி கெட்ட மனிதன்) அழிவானாக! எவ்வளவு நன்றி மறந்தவனாக அவன் இருக்கின்றான்!"
    },
    {
      "number": 18,
      "text": "எப்பொருளால் அவனை (அல்லாஹ்) படைத்தான்? (என்பதை அவன் சிந்தித்தானா?)"
    },
    {
      "number": 19,
      "text": "(ஒரு துளி) இந்திரியத்திலிருந்து அவனைப் படைத்து, அவனை (அளவுப்படி) சரியாக்கினான்."
    },
    {
      "number": 20,
      "text": "பின் அவனுக்காக வழியை எளிதாக்கினான்."
    },
    {
      "number": 21,
      "text": "பின் அவனை மரிக்கச் செய்து, அவனை கப்ரில்' ஆக்குகிறான்."
    },
    {
      "number": 22,
      "text": "பின்னர், அவன் விரும்பும்போது அவனை (உயிர்ப்பித்து) எழுப்புவான்."
    },
    {
      "number": 23,
      "text": "(இவ்வாறிருந்தும் அல்லாஹ் மனிதனுக்கு) எதை ஏவினானோ அதை அவன் நிறைவேற்றுவதில்லை."
    },
    {
      "number": 24,
      "text": "எனவே, மனிதன் தன் உணவின் பக்கமே (அது எவ்வாறு பெறப்படுகிறது) என்பதை நோட்டமிட்டுப் பார்க்கட்டும்."
    },
    {
      "number": 25,
      "text": "நிச்சயமாக நாமே மழையை நன்கு பொழியச் செய்கிறோம்."
    },
    {
      "number": 26,
      "text": "பின், பூமியைப் பிளப்பதாகப் பிளந்து-"
    },
    {
      "number": 27,
      "text": "பின் அதிலிருந்து வித்தை முளைப்பிக்கிறோம்."
    },
    {
      "number": 28,
      "text": "திராட்சைகளையும், புற்பூண்டுகளையும்-"
    },
    {
      "number": 29,
      "text": "ஒலிவ மரத்தையும், பேரீச்சையையும் -"
    },
    {
      "number": 30,
      "text": "அடர்ந்த தோட்டங்களையும்,"
    },
    {
      "number": 31,
      "text": "பழங்களையும், தீவனங்களையும்-"
    },
    {
      "number": 32,
      "text": "(இவையெல்லாம்) உங்களுக்கும், உங்கள் கால் நடைகளுக்கும் பயனளிப்பதற்காக,"
    },
    {
      "number": 33,
      "text": "ஆகவே, (யுக முடிவின் போது காதைச் செவிடாக்கும் பெருஞ் சப்தம் வரும் போது -"
    },
    {
      "number": 34,
      "text": "அந்த நாளில் மனிதன் விரண்டு ஓடுவான் - தன் சகோதரனை விட்டும் -"
    },
    {
      "number": 35,
      "text": "தன் தாயை விட்டும், தன் தந்தையை விட்டும்;"
    },
    {
      "number": 36,
      "text": "தன் மனைவியை விட்டும், தன் மக்களை விட்டும்-"
    },
    {
      "number": 37,
      "text": "அன்று ஒவ்வொரு மனிதனுக்கும் அவனவன் (அவல) நிலையே போதுமானதாயிருக்கும்."
    },
    {
      "number": 38,
      "text": "அந்நாளில் சில முகங்கள் இலங்கிக் கொண்டிருக்கும்."
    },
    {
      "number": 39,
      "text": "சிரித்தவையாகவும், மகிழ்வுடையதாகவும் இருக்கும்."
    },
    {
      "number": 40,
      "text": "ஆனால் அந்நாளில் - (வேறு) சில முகங்கள், அவற்றின் மீது புழுதி படிந்திருக்கும்."
    },
    {
      "number": 41,
      "text": "அவற்றைக் கருமை இருள் மூடியிருக்கும்."
    },
    {
      "number": 42,
      "text": "அவர்கள்தாம், நிராகரித்தவர்கள,; தீயவர்கள்."
    }
  ]
}