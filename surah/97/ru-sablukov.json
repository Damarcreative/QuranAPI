{
  "surah": 97,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Мы ниспослали его в ночь определений."
    },
    {
      "number": 2,
      "text": "О если бы кто вразумил тебя, что такое ночь определений!"
    },
    {
      "number": 3,
      "text": "Ночь определений - лучше тысячи месяцев."
    },
    {
      "number": 4,
      "text": "Во время ее ангелы и дух, по изволению Господа их, нисходят со всеми повелениями Его."
    },
    {
      "number": 5,
      "text": "Она мирна до появления зари."
    }
  ]
}