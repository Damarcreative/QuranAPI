{
  "surah": 97,
  "translation": "tr-vakfi",
  "ayahs": [
    {
      "number": 0,
      "text": "Rahman (ve) rahim (olan) Allah'ın adıyla."
    },
    {
      "number": 1,
      "text": "Biz onu (Kur'an'ı) Kadir gecesinde indirdik."
    },
    {
      "number": 2,
      "text": "Kadir gecesinin ne olduğunu sen bilir misin?"
    },
    {
      "number": 3,
      "text": "Kadir gecesi, bin aydan hayırlıdır."
    },
    {
      "number": 4,
      "text": "O gecede, Rablerinin izniyle melekler ve Ruh (Cebrail), her iş için iner dururlar."
    },
    {
      "number": 5,
      "text": "O gece, esenlik doludur. Ta fecrin doğuşuna kadar."
    }
  ]
}