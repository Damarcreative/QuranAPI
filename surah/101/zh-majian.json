{
  "surah": 101,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "大難,"
    },
    {
      "number": 2,
      "text": "大難是什麼？"
    },
    {
      "number": 3,
      "text": "你怎能知道大難是什麼？"
    },
    {
      "number": 4,
      "text": "在那日, 眾人將似分散的飛蛾,"
    },
    {
      "number": 5,
      "text": "山岳將似疏松的釆絨。"
    },
    {
      "number": 6,
      "text": "至於善功的份量較重者,"
    },
    {
      "number": 7,
      "text": "將在滿意的生活中;"
    },
    {
      "number": 8,
      "text": "至於善功的份量較輕者,"
    },
    {
      "number": 9,
      "text": "他的歸宿是深坑。"
    },
    {
      "number": 10,
      "text": "你怎能知道深坑裏有什麼？"
    },
    {
      "number": 11,
      "text": "有烈火。"
    }
  ]
}