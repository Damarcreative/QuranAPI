{
  "surah": 101,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 1,
      "text": "Бедствие [Судный день]!"
    },
    {
      "number": 2,
      "text": "Что такое Бедствие?"
    },
    {
      "number": 3,
      "text": "Откуда ты узнал, что такое Бедствие?"
    },
    {
      "number": 4,
      "text": "В тот день люди будут похожи на разлетевшихся мотыльков."
    },
    {
      "number": 5,
      "text": "А горы станут [мягкими], как расчесанная шерсть."
    },
    {
      "number": 6,
      "text": "Тот, чья чаша Весов окажется тяжелой,"
    },
    {
      "number": 7,
      "text": "будет доволен своей жизнью."
    },
    {
      "number": 8,
      "text": "Тому же, чья чаша Весов окажется легкой,"
    },
    {
      "number": 9,
      "text": "прибежищем станет Ад."
    },
    {
      "number": 10,
      "text": "Откуда ты мог знать, что это такое?"
    },
    {
      "number": 11,
      "text": "Это – пылающий [жарко] Огонь!"
    }
  ]
}