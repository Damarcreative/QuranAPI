{
  "surah": 101,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Поражающее -"
    },
    {
      "number": 2,
      "text": "Что такое поражающее?"
    },
    {
      "number": 3,
      "text": "О если бы кто вразумил тебя, что - это поражающее!"
    },
    {
      "number": 4,
      "text": "Это день, в который люди будут как бабочки разогнанные;"
    },
    {
      "number": 5,
      "text": "Горы будут как шерсть расщипанная."
    },
    {
      "number": 6,
      "text": "Тогда, на чьих весах будет тяжело,"
    },
    {
      "number": 7,
      "text": "тот будет в блаженной жизни;"
    },
    {
      "number": 8,
      "text": "А на чьих весах будет легко,"
    },
    {
      "number": 9,
      "text": "тому матерью будет безчадная преисподняя."
    },
    {
      "number": 10,
      "text": "О если бы кто вразумил тебя, о! Какова она!"
    },
    {
      "number": 11,
      "text": "Она - жгучий огонь."
    }
  ]
}