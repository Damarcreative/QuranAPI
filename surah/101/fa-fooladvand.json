{
  "surah": 101,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 1,
      "text": "کوبنده،"
    },
    {
      "number": 2,
      "text": "چیست کوبنده؟"
    },
    {
      "number": 3,
      "text": "و تو چه دانی که کوبنده چیست؟"
    },
    {
      "number": 4,
      "text": "روزی که مردم چون پروانه‌[های‌] پراکنده گردند،"
    },
    {
      "number": 5,
      "text": "و کوه‌ها مانند پشم زده‌شده رنگین شود."
    },
    {
      "number": 6,
      "text": "اما هر که سنجیده‌هایش سنگین برآید،"
    },
    {
      "number": 7,
      "text": "پس وی در زندگی خوشی خواهد بود!"
    },
    {
      "number": 8,
      "text": "و اما هر که سنجیده‌هایش سبک بر آید،"
    },
    {
      "number": 9,
      "text": "پس جایش «هاویه» باشد."
    },
    {
      "number": 10,
      "text": "و تو چه دانی که آن چیست؟"
    },
    {
      "number": 11,
      "text": "آتشی است سوزنده."
    }
  ]
}