{
  "surah": 101,
  "translation": "az-musayev",
  "ayahs": [
    {
      "number": 1,
      "text": "Qəlbləri Qorxuya salan!"
    },
    {
      "number": 2,
      "text": "Qəlbləri Qorxuya salan nədir?"
    },
    {
      "number": 3,
      "text": "Sən haradan biləsən ki, qəlbləri Qorxuya salan nədir?"
    },
    {
      "number": 4,
      "text": "O gün insanlar ətrafa səpələnmiş pərvanələr tək olacaqlar."
    },
    {
      "number": 5,
      "text": "Dağlar isə didilmiş yun görkəmi alacaqdır."
    },
    {
      "number": 6,
      "text": "O gün kimin tərəziləri ağır gələrsə"
    },
    {
      "number": 7,
      "text": "xoşbəxt güzəran sürəcək."
    },
    {
      "number": 8,
      "text": "Kimin tərəziləri yüngül gələrsə,"
    },
    {
      "number": 9,
      "text": "məskəni Haviyə olacaqdır."
    },
    {
      "number": 10,
      "text": "Sən haradan biləsən ki, o nədir?"
    },
    {
      "number": 11,
      "text": "O, çox qızmar bir oddur!"
    }
  ]
}