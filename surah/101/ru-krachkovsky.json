{
  "surah": 101,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Поражающее!.."
    },
    {
      "number": 2,
      "text": "И что есть поражающее?"
    },
    {
      "number": 3,
      "text": "И что даст тебе знать, что такое поражающее?"
    },
    {
      "number": 4,
      "text": "В тот день, как люди будут, как разогнанные мотыльки,"
    },
    {
      "number": 5,
      "text": "и будут горы, как расщипанная шерсть..."
    },
    {
      "number": 6,
      "text": "И вот тот, у кого тяжелы весы, -"
    },
    {
      "number": 7,
      "text": "он в жизни блаженной."
    },
    {
      "number": 8,
      "text": "А тот, у кого легки весы, -"
    },
    {
      "number": 9,
      "text": "мать его - \"пропасть\"."
    },
    {
      "number": 10,
      "text": "А что даст тебе знать, что такое она? -"
    },
    {
      "number": 11,
      "text": "Огонь пылающий!"
    }
  ]
}