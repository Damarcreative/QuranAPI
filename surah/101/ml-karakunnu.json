{
  "surah": 101,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "ഭയങ്കര സംഭവം!"
    },
    {
      "number": 2,
      "text": "എന്താണാ ഭയങ്കര സംഭവം?"
    },
    {
      "number": 3,
      "text": "ആ ഭയങ്കര സംഭവം ഏതെന്ന് നിനക്കെന്തറിയാം?"
    },
    {
      "number": 4,
      "text": "അന്ന് മനുഷ്യര്‍ ചിന്നിച്ചിതറിയ പാറ്റപോലെയാകും."
    },
    {
      "number": 5,
      "text": "പര്‍വതങ്ങള്‍ കടഞ്ഞ കമ്പിളി രോമം പോലെയും."
    },
    {
      "number": 6,
      "text": "അപ്പോള്‍ ആരുടെ തുലാസിന്റെ തട്ട് കനം തൂങ്ങുന്നുവോ,"
    },
    {
      "number": 7,
      "text": "അവന് സംതൃപ്തമായ ജീവിതമുണ്ട്."
    },
    {
      "number": 8,
      "text": "ആരുടെ തുലാസിന്‍ തട്ട് കനം കുറയുന്നുവോ,"
    },
    {
      "number": 9,
      "text": "അവന്റെ സങ്കേതം ഹാവിയ ആയിരിക്കും."
    },
    {
      "number": 10,
      "text": "ഹാവിയ ഏതെന്ന് നിനക്കെന്തറിയാം?"
    },
    {
      "number": 11,
      "text": "അത് കൊടും ചൂടുള്ള നരകത്തീ തന്നെ."
    }
  ]
}