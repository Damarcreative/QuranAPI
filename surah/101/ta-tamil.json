{
  "surah": 101,
  "translation": "ta-tamil",
  "ayahs": [
    {
      "number": 0,
      "text": "அளவற்ற அருளாளன், நிகரற்ற அன்பாளன், அல்லாஹ்வின் பெயரால்! (தொடங்குகிறேன்)."
    },
    {
      "number": 1,
      "text": "திடுக்கிடச் செய்யும் (நிகழ்ச்சி)."
    },
    {
      "number": 2,
      "text": "திடுக்கிடச் செய்யும் (நிகழ்ச்சி) என்ன?"
    },
    {
      "number": 3,
      "text": "திடுக்கிடச் செய்யும் (நிகழ்ச்சி) என்ன வென்று உமக்கு எது அறிவித்தது?"
    },
    {
      "number": 4,
      "text": "அந்நாளில் சிதறடிக்கப்பட்ட ஈசல்களைப் போன்று மனிதர்கள் ஆகிவிடுவார்கள்."
    },
    {
      "number": 5,
      "text": "மேலும், மலைகள் கொட்டப்பட்ட பஞ்சைப் போன்று ஆகிவிடும்."
    },
    {
      "number": 6,
      "text": "எனவே, (அந்நாளில்) எவருடைய (நன்மையின்) நிறை கனத்ததோ-"
    },
    {
      "number": 7,
      "text": "அவர் திருப்தி பொருந்திய வாழ்வில் இருப்பார்."
    },
    {
      "number": 8,
      "text": "ஆனால் எவனுடைய (நன்மையின்) நிறை இலேசாக இருக்கிறதோ-"
    },
    {
      "number": 9,
      "text": "அவன் தங்குமிடம் \"ஹாவியா\" தான்."
    },
    {
      "number": 10,
      "text": "இன்னும் ('ஹாவியா') என்ன என்று உமக்கு அறிவித்தது எது?"
    },
    {
      "number": 11,
      "text": "அது சுட்டெரிக்கும் (நரகத்தின்) தீக்கிடங்காகும்."
    }
  ]
}