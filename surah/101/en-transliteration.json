  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Alq<u>a</u>riAAa<b>tu</b>"
    },
    {
      "number": 2,
      "text": "M<u>a</u> alq<u>a</u>riAAa<b>tu</b>"
    },
    {
      "number": 3,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> alq<u>a</u>riAAa<b>tu</b>"
    },
    {
      "number": 4,
      "text": "Yawma yakoonu a<b>l</b>nn<u>a</u>su ka<b>a</b>lfar<u>a</u>shi almabthooth<b>i</b>"
    },
    {
      "number": 5,
      "text": "Watakoonu aljib<u>a</u>lu ka<b>a</b>lAAihni almanfoosh<b>i</b>"
    },
    {
      "number": 6,
      "text": "Faamm<u>a</u> man thaqulat maw<u>a</u>zeenuh<b>u</b>"
    },
    {
      "number": 7,
      "text": "Fahuwa fee AAeeshatin r<u>ad</u>iya<b>tin</b>"
    },
    {
      "number": 8,
      "text": "Waamm<u>a</u> man khaffat maw<u>a</u>zeenuh<b>u</b>"
    },
    {
      "number": 9,
      "text": "Faommuhu h<u>a</u>wiya<b>tun</b>"
    },
    {
      "number": 10,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> hiya<b>h</b>"
    },
    {
      "number": 11,
      "text": "N<u>a</u>run <u>ha</u>miya<b>tun</b>"
    }
  ]
