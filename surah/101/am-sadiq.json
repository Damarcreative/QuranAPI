{
  "surah": 101,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "ቆርቋሪይቱ (ጩኸት)፤"
    },
    {
      "number": 2,
      "text": "ምን አስደናቂ ቆርቋሪ ናት!"
    },
    {
      "number": 3,
      "text": "ቆርቋሪይቱም ምን እንደኾነች ምን አሳወቀህ?"
    },
    {
      "number": 4,
      "text": "ሰዎች እንደ ተበታተነ ቢራቢሮ (ወይም ኩብኩባ) በሚኾኑበት ቀን፤"
    },
    {
      "number": 5,
      "text": "ጋራዎችም እንደ ተነደፈ ሱፍ በሚኾኑበት (ቀን ልቦችን በድንጋጤ ትቆረቁራለች፡፡)"
    },
    {
      "number": 6,
      "text": "ሚዛኖቹ የከበዱለት ሰውማ፤"
    },
    {
      "number": 7,
      "text": "እርሱ በምትወደድ ኑሮ ውስጥ ይኾናል፡፡"
    },
    {
      "number": 8,
      "text": "ሚዛኖቹም የቀለሉበት ሰውማ፤"
    },
    {
      "number": 9,
      "text": "መኖሪያው ሃዊያህ ናት"
    },
    {
      "number": 10,
      "text": "እርሷም ምን እንደ ኾነች ምን አሳወቀህ?"
    },
    {
      "number": 11,
      "text": "(እርሷ) በጣም ተኳሳ እሳት ናት፡፡"
    }
  ]
}