{
  "surah": 82,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ሰማይ በተሰነጠቀች ጊዜ፤"
    },
    {
      "number": 2,
      "text": "ከዋክብትም ተበታትነው በወደቁ ጊዜ፤"
    },
    {
      "number": 3,
      "text": "ባሕሮችም በተከፈቱና በተደበላለቁ ጊዜ፤"
    },
    {
      "number": 4,
      "text": "መቃብሮችም በተገለባበጡና (ሙታን) በተነሱ ጊዜ፤"
    },
    {
      "number": 5,
      "text": "ማንኛይቱም ነፍስ ያስቀደመችውንና ያቆየችውን ታውቃለች፡፡"
    },
    {
      "number": 6,
      "text": "አንተ ሰው ሆይ! በቸሩ ጌታህ ምን አታለለህ?"
    },
    {
      "number": 7,
      "text": "በዚያ በፈጠረህ አካለ ሙሉም ባደረገህ ባስተካከለህም፡፡"
    },
    {
      "number": 8,
      "text": "በማንኛውም በሻው ቅርፅ በገጣጠመህ (ጌታህ ምን አታለለህ)፡፡"
    },
    {
      "number": 9,
      "text": "ተከልከሉ፤ በእውነቱ በፍርዱ ቀን ታስተባብላላችሁ፡፡"
    },
    {
      "number": 10,
      "text": "በእናንተ ላይ ተጠባባቂዎች ያሉባችሁ፤ ስትኾኑ፤"
    },
    {
      "number": 11,
      "text": "የተከበሩ ጸሐፊዎች የኾኑ፤ (ተጠባባቂዎች)፡፡"
    },
    {
      "number": 12,
      "text": "የምትሠሩትን ሁሉ የሚያውቁ፡፡"
    },
    {
      "number": 13,
      "text": "እውነተኞቹ ምእምናን በእርግጥ በገነት ውስጥ ናቸው፡፡"
    },
    {
      "number": 14,
      "text": "ከሓዲዎቹም በእርግጥ በገሀነም ውስጥ ናቸው፡፡"
    },
    {
      "number": 15,
      "text": "በፍርዱ ቀን ይገቧታል፡፡"
    },
    {
      "number": 16,
      "text": "እነርሱም ከርሷ ራቂዎች አይደሉም፡፡"
    },
    {
      "number": 17,
      "text": "የፍርድ ቀን ምን እንደኾነ ምን አሳወቀህ?"
    },
    {
      "number": 18,
      "text": "ከዚያም የፍርዱ ቀን ምን እንደኾነ ምን አሳወቀህ?"
    },
    {
      "number": 19,
      "text": "(እርሱ) ማንኛይቱም ነፍስ ለሌላይቱ ነፍስ ምንም ማድረግን የማትችልበት ቀን ነው፡፡ ነገሩም ሁሉ በዚያ ቀን ለአላህ ብቻ ነው፡፡"
    }
  ]
}