{
  "surah": 82,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "I<u>tha</u> a<b>l</b>ssam<u>a</u>o infa<u>t</u>arat"
    },
    {
      "number": 2,
      "text": "Wai<u>tha</u> alkaw<u>a</u>kibu intatharat"
    },
    {
      "number": 3,
      "text": "Wai<u>tha</u> albi<u>ha</u>ru fujjirat"
    },
    {
      "number": 4,
      "text": "Wai<u>tha</u> alqubooru buAAthirat"
    },
    {
      "number": 5,
      "text": "AAalimat nafsun m<u>a</u> qaddamat waakhkharat"
    },
    {
      "number": 6,
      "text": "Y<u>a</u> ayyuh<u>a</u> alins<u>a</u>nu m<u>a</u> gharraka birabbika alkareem<b>i</b>"
    },
    {
      "number": 7,
      "text": "Alla<u>th</u>ee khalaqaka fasaww<u>a</u>ka faAAadalak<b>a</b>"
    },
    {
      "number": 8,
      "text": "Fee ayyi <u>s</u>ooratin m<u>a</u> sh<u>a</u>a rakkabak<b>a</b>"
    },
    {
      "number": 9,
      "text": "Kall<u>a</u> bal tuka<u>thth</u>iboona bi<b>al</b>ddeen<b>i</b>"
    },
    {
      "number": 10,
      "text": "Wainna AAalaykum la<u>ha</u>fi<i><u>th</u></i>een<b>a</b>"
    },
    {
      "number": 11,
      "text": "Kir<u>a</u>man k<u>a</u>tibeen<b>a</b>"
    },
    {
      "number": 12,
      "text": "YaAAlamoona m<u>a</u> tafAAaloon<b>a</b>"
    },
    {
      "number": 13,
      "text": "Inna alabr<u>a</u>ra lafee naAAeem<b>in</b>"
    },
    {
      "number": 14,
      "text": "Wainna alfujj<u>a</u>ra lafee ja<u>h</u>eem<b>in</b>"
    },
    {
      "number": 15,
      "text": "Ya<u>s</u>lawnah<u>a</u> yawma a<b>l</b>ddeen<b>i</b>"
    },
    {
      "number": 16,
      "text": "Wam<u>a</u> hum AAanh<u>a</u> bigh<u>a</u>ibeen<b>a</b>"
    },
    {
      "number": 17,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> yawmu a<b>l</b>ddeeni"
    },
    {
      "number": 18,
      "text": "Thumma m<u>a</u> adr<u>a</u>ka m<u>a</u> yawmu a<b>l</b>ddeen<b>i</b>"
    },
    {
      "number": 19,
      "text": "Yawma l<u>a</u> tamliku nafsun linafsin shayan wa<b>a</b>lamru yawmai<u>th</u>in lill<u>a</u>h<b>i</b>"
    }
  ]
}