{
  "surah": 82,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Когда небо расторгнется,"
    },
    {
      "number": 2,
      "text": "Когда звезды рассеятся,"
    },
    {
      "number": 3,
      "text": "Когда моря польются,"
    },
    {
      "number": 4,
      "text": "Когда гробы откроются:"
    },
    {
      "number": 5,
      "text": "Тогда душа увидит, что сделала она прежде и что делала после."
    },
    {
      "number": 6,
      "text": "Человек! Что возбуждает тебя к дерзости против должночтимого Господа твоего,"
    },
    {
      "number": 7,
      "text": "Который сотворил тебя, дал тебе стройность, все в тебе соразмерил,"
    },
    {
      "number": 8,
      "text": "Составил тебя в том образе, в каком хотел?"
    },
    {
      "number": 9,
      "text": "Но при всём этом, вы считаете это вероучение ложным."
    },
    {
      "number": 10,
      "text": "Истинно, при вас есть стражи,"
    },
    {
      "number": 11,
      "text": "Досточтимые, записывающие:"
    },
    {
      "number": 12,
      "text": "Они знают, что делаете вы."
    },
    {
      "number": 13,
      "text": "Истинно, благочестивые будут в отраде;"
    },
    {
      "number": 14,
      "text": "Истинно, нечестивые будут в аде."
    },
    {
      "number": 15,
      "text": "В день суда они будут гореть в нем,"
    },
    {
      "number": 16,
      "text": "И от него не освободятся."
    },
    {
      "number": 17,
      "text": "О если бы узнал, каков будет день суда!"
    },
    {
      "number": 18,
      "text": "Да, о если бы узнал ты, каков будет день суда!"
    },
    {
      "number": 19,
      "text": "В тот день ни одна душа не может ничего сделать для другой души: в тот день все во власти Бога."
    }
  ]
}