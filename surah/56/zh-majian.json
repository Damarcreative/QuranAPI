{
  "surah": 56,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "當那件大事發生的時候，"
    },
    {
      "number": 2,
      "text": "沒有任何人否認其發生。"
    },
    {
      "number": 3,
      "text": "那件大事將是能使人降級，能使人升級的；"
    },
    {
      "number": 4,
      "text": "當大地震盪，"
    },
    {
      "number": 5,
      "text": "山巒粉碎，"
    },
    {
      "number": 6,
      "text": "化為散漫的塵埃，"
    },
    {
      "number": 7,
      "text": "而你們分為三等的時候。"
    },
    {
      "number": 8,
      "text": "幸福者，幸福者是何等的人？"
    },
    {
      "number": 9,
      "text": "薄命者，薄命者是何等的人？"
    },
    {
      "number": 10,
      "text": "最先行善者，是最先入樂園的人。"
    },
    {
      "number": 11,
      "text": "這等人，確是蒙主眷顧的。"
    },
    {
      "number": 12,
      "text": "他們將在恩澤的樂園中。"
    },
    {
      "number": 13,
      "text": "許多前人"
    },
    {
      "number": 14,
      "text": "和少數後人，"
    },
    {
      "number": 15,
      "text": "在珠寶鑲成的床榻上，"
    },
    {
      "number": 16,
      "text": "彼此相對地靠在上面。"
    },
    {
      "number": 17,
      "text": "長生不老的僮僕，輪流著服侍他們，"
    },
    {
      "number": 18,
      "text": "捧著盞和壺，與滿杯的醴泉；"
    },
    {
      "number": 19,
      "text": "他們不因那醴泉而頭痛，也不酩酊。"
    },
    {
      "number": 20,
      "text": "他們有自己所選擇的水果，"
    },
    {
      "number": 21,
      "text": "和自己所愛好的鳥肉。"
    },
    {
      "number": 22,
      "text": "還有白晢的、美目的妻子，"
    },
    {
      "number": 23,
      "text": "好像藏在蚌殼裡的珍珠一樣。"
    },
    {
      "number": 24,
      "text": "那是為了報酬他們的善行。"
    },
    {
      "number": 25,
      "text": "他們在樂園裡，聽不到惡言和謊話，"
    },
    {
      "number": 26,
      "text": "但聽到說：「祝你們平安！祝你們平安！」"
    },
    {
      "number": 27,
      "text": "幸福者，幸福者是何等的人？"
    },
    {
      "number": 28,
      "text": "他們享受無刺的酸棗樹，"
    },
    {
      "number": 29,
      "text": "結實累累的香蕉樹；"
    },
    {
      "number": 30,
      "text": "漫漫的樹蔭；"
    },
    {
      "number": 31,
      "text": "泛泛的流水；"
    },
    {
      "number": 32,
      "text": "豐富的水果，"
    },
    {
      "number": 33,
      "text": "四時不絕，可以隨意摘食；"
    },
    {
      "number": 34,
      "text": "與被升起的床榻。"
    },
    {
      "number": 35,
      "text": "我使她們重新生長，"
    },
    {
      "number": 36,
      "text": "我使她們常為處女，"
    },
    {
      "number": 37,
      "text": "依戀丈夫，彼此同歲；"
    },
    {
      "number": 38,
      "text": "這些都是幸福者所享受的。"
    },
    {
      "number": 39,
      "text": "他們是許多前人"
    },
    {
      "number": 40,
      "text": "和許多後人。"
    },
    {
      "number": 41,
      "text": "薄命者，薄命者是何等的人？"
    },
    {
      "number": 42,
      "text": "他們在毒風和沸水中，"
    },
    {
      "number": 43,
      "text": "在黑煙的陰影下，"
    },
    {
      "number": 44,
      "text": "既不涼爽，又不美觀。"
    },
    {
      "number": 45,
      "text": "以前他們確是豪華的，"
    },
    {
      "number": 46,
      "text": "確是固執大罪的，"
    },
    {
      "number": 47,
      "text": "他們常說：「難道我們死後，已變成塵土和枯骨的時候，我們必定要復活嗎？"
    },
    {
      "number": 48,
      "text": "連我們的祖先也要復活嗎？」"
    },
    {
      "number": 49,
      "text": "你說：「前人和後人，"
    },
    {
      "number": 50,
      "text": "在一個著名的日期的特定時間必定要被集合。"
    },
    {
      "number": 51,
      "text": "然後迷誤的、否定復活的人們啊！"
    },
    {
      "number": 52,
      "text": "你們必定食欑楛木的果實，"
    },
    {
      "number": 53,
      "text": "而以它充饑，"
    },
    {
      "number": 54,
      "text": "然後痛飲沸水，"
    },
    {
      "number": 55,
      "text": "像害消渴病的駱駝飲涼水一樣。"
    },
    {
      "number": 56,
      "text": "這是他們在報應之日所受的款待。"
    },
    {
      "number": 57,
      "text": "我曾創造你們，你們怎不信復活呢？"
    },
    {
      "number": 58,
      "text": "你們告訴我吧！你們所射的精液，"
    },
    {
      "number": 59,
      "text": "究竟是你們把它造成人呢？還是我把他造成人呢？"
    },
    {
      "number": 60,
      "text": "我曾將死亡分配給你們，任何人不能阻撓我，"
    },
    {
      "number": 61,
      "text": "不讓我改變你們的品性，而使你們生長在你們所不知的狀態中。"
    },
    {
      "number": 62,
      "text": "你們確已知道初次的生長，你們怎不覺悟呢？"
    },
    {
      "number": 63,
      "text": "你們告訴我吧！你們所耕種的莊稼，"
    },
    {
      "number": 64,
      "text": "究竟是你們使它發榮呢？還是我使它發榮呢？"
    },
    {
      "number": 65,
      "text": "假若我意欲，我必使它凋零，而你們變成詫異者，"
    },
    {
      "number": 66,
      "text": "你們將說：「我們是遭損失的。"
    },
    {
      "number": 67,
      "text": "不然！我們是被剝奪的。」"
    },
    {
      "number": 68,
      "text": "你們告訴我吧！你們所飲的水，"
    },
    {
      "number": 69,
      "text": "究竟是你們使它從雲中降下的呢？還是我使它降下的呢？"
    },
    {
      "number": 70,
      "text": "假若我意欲，我必定使它變成苦的，你們怎麼不感謝呢？"
    },
    {
      "number": 71,
      "text": "你們告訴我吧！你們所鑽取的火，"
    },
    {
      "number": 72,
      "text": "究竟是你們使燧木生長的呢？還是我使它生長的呢？"
    },
    {
      "number": 73,
      "text": "我以它為教訓，並且以它為荒野的居民的慰藉，"
    },
    {
      "number": 74,
      "text": "故你們應當頌揚你的主的大名。"
    },
    {
      "number": 75,
      "text": "我必以星宿的沒落處盟誓，"
    },
    {
      "number": 76,
      "text": "這確是一個重大的盟誓，假若你們知道。"
    },
    {
      "number": 77,
      "text": "這確是寶貴的《古蘭經》，"
    },
    {
      "number": 78,
      "text": "記錄在珍藏的經本中，"
    },
    {
      "number": 79,
      "text": "只有純潔者才得撫摸那經本。"
    },
    {
      "number": 80,
      "text": "《古蘭經》是從全世界的主降示的。"
    },
    {
      "number": 81,
      "text": "難道你們藐視這訓辭，"
    },
    {
      "number": 82,
      "text": "而以否認代替感謝嗎？"
    },
    {
      "number": 83,
      "text": "（你們）怎麼不在靈魂到將死者的咽喉的時候——"
    },
    {
      "number": 84,
      "text": "那時候，你們大家看著他，"
    },
    {
      "number": 85,
      "text": "我比你們更臨近他，但你們不曉得，"
    },
    {
      "number": 86,
      "text": "如果你們不是受報應的，——"
    },
    {
      "number": 87,
      "text": "你們怎不使靈魂復返於本位呢？如果你們是說實話的。"
    },
    {
      "number": 88,
      "text": "如果他是被眷顧的，"
    },
    {
      "number": 89,
      "text": "那末，他將享受舒適、給養與恩澤的樂園；"
    },
    {
      "number": 90,
      "text": "如果他是幸福者，"
    },
    {
      "number": 91,
      "text": "那末，一般幸福的人將對他說：「祝你平安！」"
    },
    {
      "number": 92,
      "text": "如果他是迷誤的、否認復活者，"
    },
    {
      "number": 93,
      "text": "那末，他將享受沸水的款待，"
    },
    {
      "number": 94,
      "text": "和烈火的燒灼。"
    },
    {
      "number": 95,
      "text": "這確是無可置疑的真理。"
    },
    {
      "number": 96,
      "text": "故你應當頌揚你的主的大名。"
    }
  ]
}