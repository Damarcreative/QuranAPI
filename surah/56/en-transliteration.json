{
  "surah": 56,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "I<u>tha</u> waqaAAati alw<u>a</u>qiAAat<b>u</b>"
    },
    {
      "number": 2,
      "text": "Laysa liwaqAAatih<u>a</u> k<u>ath</u>iba<b>tun</b>"
    },
    {
      "number": 3,
      "text": "Kh<u>a</u>fi<u>d</u>atun r<u>a</u>fiAAa<b>tun</b>"
    },
    {
      "number": 4,
      "text": "I<u>tha</u> rujjati alar<u>d</u>u rajj<u>a</u><b>n</b>"
    },
    {
      "number": 5,
      "text": "Wabussati aljib<u>a</u>lu bass<u>a</u><b>n</b>"
    },
    {
      "number": 6,
      "text": "Fak<u>a</u>nat hab<u>a</u>an munbathth<u>a</u><b>n</b>"
    },
    {
      "number": 7,
      "text": "Wakuntum azw<u>a</u>jan thal<u>a</u>tha<b>tan</b>"
    },
    {
      "number": 8,
      "text": "Faa<u>s</u><u>ha</u>bu almaymanati m<u>a</u> a<u>s</u><u>ha</u>bu almaymanat<b>i</b>"
    },
    {
      "number": 9,
      "text": "Waa<u>s</u><u>ha</u>bu almashamati m<u>a</u> a<u>s</u><u>ha</u>bu almashamat<b>i</b>"
    },
    {
      "number": 10,
      "text": "Wa<b>al</b>ss<u>a</u>biqoona a<b>l</b>ss<u>a</u>biqoon<b>a</b>"
    },
    {
      "number": 11,
      "text": "Ol<u>a</u>ika almuqarraboon<b>a</b>"
    },
    {
      "number": 12,
      "text": "Fee jann<u>a</u>ti a<b>l</b>nnaAAeem<b>i</b>"
    },
    {
      "number": 13,
      "text": "Thullatun mina alawwaleen<b>a</b>"
    },
    {
      "number": 14,
      "text": "Waqaleelun mina al<u>a</u>khireena"
    },
    {
      "number": 15,
      "text": "AAal<u>a</u> sururin maw<u>d</u>oona<b>tin</b>"
    },
    {
      "number": 16,
      "text": "Muttakieena AAalayh<u>a</u> mutaq<u>a</u>bileen<b>a</b>"
    },
    {
      "number": 17,
      "text": "Ya<u>t</u>oofu AAalayhim wild<u>a</u>nun mukhalladoon<b>a</b>"
    },
    {
      "number": 18,
      "text": "Biakw<u>a</u>bin waab<u>a</u>reeqa wakasin min maAAeen<b>in</b>"
    },
    {
      "number": 19,
      "text": "L<u>a</u> yu<u>s</u>addaAAoona AAanh<u>a</u> wal<u>a</u> yunzifoon<b>a</b>"
    },
    {
      "number": 20,
      "text": "Waf<u>a</u>kihatin mimm<u>a</u> yatakhayyaroon<b>a</b>"
    },
    {
      "number": 21,
      "text": "Wala<u>h</u>mi <u>t</u>ayrin mimm<u>a</u> yashtahoon<b>a</b>"
    },
    {
      "number": 22,
      "text": "Wa<u>h</u>oorun AAeen<b>un</b>"
    },
    {
      "number": 23,
      "text": "Kaamth<u>a</u>li allului almaknoon<b>i</b>"
    },
    {
      "number": 24,
      "text": "Jaz<u>a</u>an bim<u>a</u> k<u>a</u>noo yaAAmaloon<b>a</b>"
    },
    {
      "number": 25,
      "text": "L<u>a</u> yasmaAAoona feeh<u>a</u> laghwan wal<u>a</u> tatheem<u>a</u><b>n</b>"
    },
    {
      "number": 26,
      "text": "Ill<u>a</u> qeelan sal<u>a</u>man sal<u>a</u>m<u>a</u><b>n</b>"
    },
    {
      "number": 27,
      "text": "Waa<u>s</u><u>ha</u>bu alyameeni m<u>a</u> a<u>s</u><u>ha</u>bu alyameen<b>i</b>"
    },
    {
      "number": 28,
      "text": "Fee sidrin makh<u>d</u>ood<b>in</b>"
    },
    {
      "number": 29,
      "text": "Wa<u>t</u>al<u>h</u>in man<u>d</u>ood<b>in</b>"
    },
    {
      "number": 30,
      "text": "Wa<i><u>th</u></i>illin mamdood<b>in</b>"
    },
    {
      "number": 31,
      "text": "Wam<u>a</u>in maskoob<b>in</b>"
    },
    {
      "number": 32,
      "text": "Waf<u>a</u>kihatin katheera<b>tin</b>"
    },
    {
      "number": 33,
      "text": "L<u>a</u> maq<u>t</u>ooAAatin wal<u>a</u> mamnooAAa<b>tin</b>"
    },
    {
      "number": 34,
      "text": "Wafurushin marfooAAa<b>tin</b>"
    },
    {
      "number": 35,
      "text": "Inn<u>a</u> anshan<u>a</u>hunna insh<u>aa</u><b>n</b>"
    },
    {
      "number": 36,
      "text": "FajaAAaln<u>a</u>hunna abk<u>a</u>r<u>a</u><b>n</b>"
    },
    {
      "number": 37,
      "text": "AAuruban atr<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 38,
      "text": "Lia<u>s</u><u>ha</u>bi alyameen<b>i</b>"
    },
    {
      "number": 39,
      "text": "Thullatun mina alawwaleen<b>a</b>"
    },
    {
      "number": 40,
      "text": "Wathullatun mina al<u>a</u>khireen<b>a</b>"
    },
    {
      "number": 41,
      "text": "Waa<u>s</u><u>ha</u>bu a<b>l</b>shshim<u>a</u>li m<u>a</u> a<u>s</u><u>ha</u>bu a<b>l</b>shshim<u>a</u>l<b>i</b>"
    },
    {
      "number": 42,
      "text": "Fee samoomin wa<u>h</u>ameem<b>in</b>"
    },
    {
      "number": 43,
      "text": "Wa<i><u>th</u></i>illin min ya<u>h</u>moom<b>in</b>"
    },
    {
      "number": 44,
      "text": "L<u>a</u> b<u>a</u>ridin wal<u>a</u> kareem<b>in</b>"
    },
    {
      "number": 45,
      "text": "Innahum k<u>a</u>noo qabla <u>tha</u>lika mutrafeen<b>a</b>"
    },
    {
      "number": 46,
      "text": "Wak<u>a</u>noo yu<u>s</u>irroona AAal<u>a</u> al<u>h</u>inthi alAAa<i><u>th</u></i>eem<b>i</b>"
    },
    {
      "number": 47,
      "text": "Wak<u>a</u>noo yaqooloona ai<u>tha</u> mitn<u>a</u> wakunn<u>a</u> tur<u>a</u>ban waAAi<i><u>th</u></i><u>a</u>man ainn<u>a</u> lamabAAoothoon<b>a</b>"
    },
    {
      "number": 48,
      "text": "Awa <u>a</u>b<u>a</u>on<u>a</u> alawwaloon<b>a</b>"
    },
    {
      "number": 49,
      "text": "Qul inna alawwaleena wa<b>a</b>l<u>a</u>khireen<b>a</b>"
    },
    {
      "number": 50,
      "text": "LamajmooAAoona il<u>a</u> meeq<u>a</u>ti yawmin maAAloom<b>in</b>"
    },
    {
      "number": 51,
      "text": "Thumma innakum ayyuh<u>a</u> a<b>l</b><u>dda</u>lloona almuka<u>thth</u>iboon<b>a</b>"
    },
    {
      "number": 52,
      "text": "La<u>a</u>kiloona min shajarin min zaqqoom<b>in</b>"
    },
    {
      "number": 53,
      "text": "Fam<u>a</u>lioona minh<u>a</u> albu<u>t</u>oon<b>a</b>"
    },
    {
      "number": 54,
      "text": "Fash<u>a</u>riboona AAalayhi mina al<u>h</u>ameem<b>i</b>"
    },
    {
      "number": 55,
      "text": "Fash<u>a</u>riboona shurba alheem<b>i</b>"
    },
    {
      "number": 56,
      "text": "H<u>atha</u> nuzuluhum yawma a<b>l</b>ddeen<b>i</b>"
    },
    {
      "number": 57,
      "text": "Na<u>h</u>nu khalaqn<u>a</u>kum falawl<u>a</u> tu<u>s</u>addiqoon<b>a</b>"
    },
    {
      "number": 58,
      "text": "Afaraaytum m<u>a</u> tumnoon<b>a</b>"
    },
    {
      "number": 59,
      "text": "Aantum takhluqoonahu am na<u>h</u>nu alkh<u>a</u>liqoon<b>a</b>"
    },
    {
      "number": 60,
      "text": "Na<u>h</u>nu qaddarn<u>a</u> baynakumu almawta wam<u>a</u> na<u>h</u>nu bimasbooqeen<b>a</b>"
    },
    {
      "number": 61,
      "text": "AAal<u>a</u> an nubaddila amth<u>a</u>lakum wanunshiakum fee m<u>a</u> l<u>a</u> taAAlamoon<b>a</b>"
    },
    {
      "number": 62,
      "text": "Walaqad AAalimtumu a<b>l</b>nnashata alool<u>a</u> falawl<u>a</u> ta<u>th</u>akkaroon<b>a</b>"
    },
    {
      "number": 63,
      "text": "Afaraaytum m<u>a</u> ta<u>h</u>ruthoon<b>a</b>"
    },
    {
      "number": 64,
      "text": "Aantum tazraAAoonahu am na<u>h</u>nu a<b>l</b>zz<u>a</u>riAAoon<b>a</b>"
    },
    {
      "number": 65,
      "text": "Law nash<u>a</u>o lajaAAaln<u>a</u>hu <u>h</u>u<u>ta</u>man fa<i><u>th</u></i>altum tafakkahoon<b>a</b>"
    },
    {
      "number": 66,
      "text": "Inn<u>a</u> lamughramoon<b>a</b>"
    },
    {
      "number": 67,
      "text": "Bal na<u>h</u>nu ma<u>h</u>roomoon<b>a</b>"
    },
    {
      "number": 68,
      "text": "Afaraaytumu alm<u>a</u>a alla<u>th</u>ee tashraboon<b>a</b>"
    },
    {
      "number": 69,
      "text": "Aantum anzaltumoohu mina almuzni am na<u>h</u>nu almunziloon<b>a</b>"
    },
    {
      "number": 70,
      "text": "Law nash<u>a</u>o jaAAaln<u>a</u>hu oj<u>a</u>jan falawl<u>a</u> tashkuroon<b>a</b>"
    },
    {
      "number": 71,
      "text": "Afaraaytumu a<b>l</b>nn<u>a</u>ra allatee tooroon<b>a</b>"
    },
    {
      "number": 72,
      "text": "Aantum anshatum shajaratah<u>a</u> am na<u>h</u>nu almunshioon<b>a</b>"
    },
    {
      "number": 73,
      "text": "Na<u>h</u>nu jaAAaln<u>a</u>h<u>a</u> ta<u>th</u>kiratan wamat<u>a</u>AAan lilmuqween<b>a</b>"
    },
    {
      "number": 74,
      "text": "Fasabbi<u>h</u> bi<b>i</b>smi rabbika alAAa<i><u>th</u></i>eem<b>i</b>"
    },
    {
      "number": 75,
      "text": "Fal<u>a</u> oqsimu bimaw<u>a</u>qiAAi a<b>l</b>nnujoom<b>i</b>"
    },
    {
      "number": 76,
      "text": "Wainnahu laqasamun law taAAlamoona AAa<i><u>th</u></i>eem<b>un</b>"
    },
    {
      "number": 77,
      "text": "Innahu laqur<u>a</u>nun kareem<b>un</b>"
    },
    {
      "number": 78,
      "text": "Fee kit<u>a</u>bin maknoon<b>in</b>"
    },
    {
      "number": 79,
      "text": "L<u>a</u> yamassuhu ill<u>a</u> almu<u>t</u>ahharoon<b>a</b>"
    },
    {
      "number": 80,
      "text": "Tanzeelun min rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 81,
      "text": "Afabih<u>atha</u> al<u>h</u>adeethi antum mudhinoon<b>a</b>"
    },
    {
      "number": 82,
      "text": "WatajAAaloona rizqakum annakum tuka<u>thth</u>iboon<b>a</b>"
    },
    {
      "number": 83,
      "text": "Falawl<u>a</u> i<u>tha</u> balaghati al<u>h</u>ulqoom<b>a</b>"
    },
    {
      "number": 84,
      "text": "Waantum <u>h</u>eenai<u>th</u>in tan<i><u>th</u></i>uroona"
    },
    {
      "number": 85,
      "text": "Wana<u>h</u>nu aqrabu ilayhi minkum wal<u>a</u>kin l<u>a</u> tub<u>s</u>iroon<b>a</b>"
    },
    {
      "number": 86,
      "text": "Falawl<u>a</u> in kuntum ghayra madeeneen<b>a</b>"
    },
    {
      "number": 87,
      "text": "TarjiAAoonah<u>a</u> in kuntum <u>sa</u>diqeen<b>a</b>"
    },
    {
      "number": 88,
      "text": "Faamm<u>a</u> in k<u>a</u>na mina almuqarrabeen<b>a</b>"
    },
    {
      "number": 89,
      "text": "Faraw<u>h</u>un waray<u>ha</u>nun wajannatu naAAeem<b>in</b>"
    },
    {
      "number": 90,
      "text": "Waamm<u>a</u> in k<u>a</u>na min a<u>s</u><u>ha</u>bi alyameen<b>i</b>"
    },
    {
      "number": 91,
      "text": "Fasal<u>a</u>mun laka min a<u>s</u><u>ha</u>bi alyameen<b>i</b>"
    },
    {
      "number": 92,
      "text": "Waamm<u>a</u> in k<u>a</u>na mina almuka<u>thth</u>ibeena a<b>l</b><u>dda</u>lleen<b>a</b>"
    },
    {
      "number": 93,
      "text": "Fanuzulun min <u>h</u>ameem<b>in</b>"
    },
    {
      "number": 94,
      "text": "Wata<u>s</u>liyatu ja<u>h</u>eem<b>in</b>"
    },
    {
      "number": 95,
      "text": "Inna h<u>atha</u> lahuwa <u>h</u>aqqu alyaqeen<b>i</b>"
    },
    {
      "number": 96,
      "text": "Fasabbi<u>h</u> bi<b>i</b>smi rabbika alAAa<i><u>th</u></i>eem<b>i</b>"
    }
  ]
}