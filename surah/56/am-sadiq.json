{
  "surah": 56,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "መከራይቱ በወደቀች ጊዜ፡፡"
    },
    {
      "number": 2,
      "text": "ለመውደቋ አስተባባይ (ነፍስ) የለችም፡፡"
    },
    {
      "number": 3,
      "text": "ዝቅ አድራጊና ከፍ አድራጊ ናት፡፡"
    },
    {
      "number": 4,
      "text": "ምድር መናወጥን በተናወጠች ጊዜ፡፡"
    },
    {
      "number": 5,
      "text": "ተራራዎችም መፍፈርፈርን በተፈረፈሩ ጊዜ (እንደተፈጨ ዱቄት በኾኑ ጊዜ)፡፡"
    },
    {
      "number": 6,
      "text": "የተበተነ ብናኝ በኾኑም ጊዜ"
    },
    {
      "number": 7,
      "text": "ሦስት ዓይነቶችም በኾናችሁ ጊዜ (ታዋርዳለች፤ ታነሳለችም)፡፡"
    },
    {
      "number": 8,
      "text": "የቀኝ ጓዶችም ምን (የተከበሩ) የቀኝ ጓዶች ናቸው፡፡"
    },
    {
      "number": 9,
      "text": "የግራ ጓዶችም ምን (የተዋረዱ) የግራ ጓዶች ናቸው፡፡"
    },
    {
      "number": 10,
      "text": "(ለበጎ ሥራ) ቀዳሚዎቹም (ለገነት) ቀዳሚዎች ናቸው፡፡"
    },
    {
      "number": 11,
      "text": "እነዚያ ባለሟሎቹ ናቸው፡፡"
    },
    {
      "number": 12,
      "text": "በመጠቀሚያ ገነቶች ውስጥ ሲኾኑ፡፡"
    },
    {
      "number": 13,
      "text": "ከፊተኞቹ ብዙ ጭፍሮች ናቸው፡፡"
    },
    {
      "number": 14,
      "text": "ከኋለኞቹም ጥቂቶች ናቸው፡፡"
    },
    {
      "number": 15,
      "text": "በተታቱ አልጋዎች ላይ ይኾናሉ፡፡"
    },
    {
      "number": 16,
      "text": "በእርሷ ላይ የተመቻቹና ፊት ለፊት የተቅጣጩ ሲኾኑ፡፡"
    },
    {
      "number": 17,
      "text": "በእነርሱ ላይ ሁል ጊዜ የማያረጁ ወጣቶች ልጆች ይዘዋወራሉ፡፡"
    },
    {
      "number": 18,
      "text": "ከጠጅ ምንጭም በብርጭቆዎችና በኩስኩስቶች በጽዋም (በእነርሱ ላይ ይዝዞራሉ)፡፡"
    },
    {
      "number": 19,
      "text": "ከእርሷ የራስ ምታት አያገኛቸውም፤ አይሰክሩምም፡፡"
    },
    {
      "number": 20,
      "text": "ከሚመርጡትም ዓይነት በእሸቶች፡፡"
    },
    {
      "number": 21,
      "text": "ከሚሹትም በኾነ የበራሪ ሥጋ (ይዞሩባቸዋል)፡፡"
    },
    {
      "number": 22,
      "text": "ዓይናማዎች የኾኑ ነጫጭ ቆንጆዎችም አሏቸው፡፡"
    },
    {
      "number": 23,
      "text": "ልክ እንደተሸፈነ ሉል መሰሎች የኾኑ፡፡"
    },
    {
      "number": 24,
      "text": "በዚያ ይሠሩት በነበሩት ምክንያት ዋጋ ይኾን ዘንድ (ይህንን አደረግንላቸው)፡፡"
    },
    {
      "number": 25,
      "text": "በውስጥዋ ውድቅ ንግግርንና መውወንጀልን አይሰሙም፡፡"
    },
    {
      "number": 26,
      "text": "ግን ሰላም መባባልን (ይሰማሉ)፡፡"
    },
    {
      "number": 27,
      "text": "የቀኝም ጓዶች ምንኛ (የከበሩ) የቀኝ ጓዶች!"
    },
    {
      "number": 28,
      "text": "በተቀፈቀፈ (እሾህ በሌለው) ቁርቁራ ውስጥ ናቸው፡፡"
    },
    {
      "number": 29,
      "text": "(ፍሬው) በተነባበረ በሙዝ ዛፍም፡፡"
    },
    {
      "number": 30,
      "text": "በተዘረጋ ጥላ ሥርም፡፡"
    },
    {
      "number": 31,
      "text": "በሚንቧቧ ውሃ አጠገብም፡፡"
    },
    {
      "number": 32,
      "text": "ብዙ (ዓይነት) በኾኑ ፍራፍሬዎችም፡፡"
    },
    {
      "number": 33,
      "text": "የማትቋረጥም የማትከለከልም የኾነች፡፡"
    },
    {
      "number": 34,
      "text": "ከፍ በተደረጉ ምንጣፎችም (ሴቶችም መካከል)፡፡"
    },
    {
      "number": 35,
      "text": "እኛ አዲስ ፍጥረት አድርገን (ለእነርሱ) ፈጠርናቸው፡፡"
    },
    {
      "number": 36,
      "text": "ደናግሎችም አደረግናቸው፡፡"
    },
    {
      "number": 37,
      "text": "ለባሎቻቸው ተሽሞርሟሪዎች እኩያዎች (አደረግናቸው)፡፡"
    },
    {
      "number": 38,
      "text": "ለቀኝ ጓዶች (አዘጋጀናቸው)፡፡"
    },
    {
      "number": 39,
      "text": "ከፊተኞቹ ብዙ ጭፍሮች ናቸው፡፡"
    },
    {
      "number": 40,
      "text": "ከኋለኞቹም ብዙ ጭፍሮች ናቸው፡፡"
    },
    {
      "number": 41,
      "text": "የግራ ጓደኞችም ምንኛ (የተዋረዱ) የግራ ጓዶች! ናቸው፡፡"
    },
    {
      "number": 42,
      "text": "በመርዛም ነፋስ በጣም በፈላ ውሃም ውስጥ ናቸው፡፡"
    },
    {
      "number": 43,
      "text": "ከጥቁር ጭስም በኾነ ጥላ ውስጥ፡፡"
    },
    {
      "number": 44,
      "text": "ቀዝቃዛም መልካምም ያልኾነ፡፡"
    },
    {
      "number": 45,
      "text": "እነርሱ ከዚህ በፊት ቅምጥሎች ነበሩና፡፡"
    },
    {
      "number": 46,
      "text": "በታላቅ ኀጢአትም ላይ ይዘወትሩ ነበሩና፡፡"
    },
    {
      "number": 47,
      "text": "ይሉም ነበሩ፡- «በሞትንና ዐፈር፣ ዐጥንቶችም በኾን ጊዜ እኛ በእርግጥ የምንቀሰቀስ ነን?"
    },
    {
      "number": 48,
      "text": "«የፊተኞቹ አባቶቻችንም?»"
    },
    {
      "number": 49,
      "text": "በላቸው፡- «ፊተኞቹም ኋለኞቹም፡፡"
    },
    {
      "number": 50,
      "text": "«በተወሰነ ቀን ቀጠሮ በእርግጥ ተሰብሳቢዎች ናቸው፡፡"
    },
    {
      "number": 51,
      "text": "«ከዚያም እናንተ ጠማሞች አስተባባዮች ሆይ!"
    },
    {
      "number": 52,
      "text": "« ከዘቁም ዛፍ በእርግጥ በይዎች ናችሁ፡፡"
    },
    {
      "number": 53,
      "text": "«ከእርሷም ሆዶቻችሁን ሞይዎች ናችሁ፡፡"
    },
    {
      "number": 54,
      "text": "«በእርሱ ላይም ከፈላ ውሃ ጠጪዎች ናችሁ፡፡"
    },
    {
      "number": 55,
      "text": "«የተጠሙንም ግመሎች አጠጣጥ ብጤ ጠጪዎች ናችሁ፡፡»"
    },
    {
      "number": 56,
      "text": "ይህ በፍርዱ ቀን መስተንግዷቸው ነው፡፡"
    },
    {
      "number": 57,
      "text": "እኛ ፈጠርናችሁ አታምኑምን?"
    },
    {
      "number": 58,
      "text": "(በማኅፀኖች) የምታፈሱትን አያችሁን?"
    },
    {
      "number": 59,
      "text": "እናንተ ትፈጥሩታላችሁን? ወይስ እኛ ፈጣሪዎቹን ነን?"
    },
    {
      "number": 60,
      "text": "እኛ ሞትን (ጊዜውን) በመካከላችሁ ወሰንን፡፡ እኛም ተሸናፊዎች አይደለንም፡፡"
    },
    {
      "number": 61,
      "text": "ብጤዎቻችሁን በመለወጥና በዚያ በማታውቁትም (ቅርጽ) እናንተን በመፍጠር ላይ (አንሸነፍም)፡፡"
    },
    {
      "number": 62,
      "text": "የፊተኛይቱንም አፈጣጠር በእርግጥ ዐውቃችኋል፡፡ አትገነዘቡምን?"
    },
    {
      "number": 63,
      "text": "የምትዘሩትንም አያችሁን?"
    },
    {
      "number": 64,
      "text": "እናንተ ታበቅሉታላችሁን? ወይስ እኛ አብቃዮቹ ነን?"
    },
    {
      "number": 65,
      "text": "ብነሻ ኖሮ ደረቅ ስብርብር ባደረግነውና የምትደነቁም በኾናችሁ ነበር፡፡"
    },
    {
      "number": 66,
      "text": "«እኛ በዕዳ ተያዦች ነን፡፡"
    },
    {
      "number": 67,
      "text": "«በእርግጥም እኛ (ከመጠቀም) የተከለከልን ነን» (ትሉ ነበር)፡፡"
    },
    {
      "number": 68,
      "text": "ያንንም የምትጠጡትን ውሃ አየችሁን?"
    },
    {
      "number": 69,
      "text": "እናንተ ከደመናው አወረዳችሁትን? ወይስ እኛ አውራጆቹ ነን?"
    },
    {
      "number": 70,
      "text": "ብንሻ ኖሮ መርጋጋ ባደረግነው ነበር፡፡ አታመሰግኑምን?"
    },
    {
      "number": 71,
      "text": "ያቺንም የምትሰብቋትን እሳት አያችሁን?"
    },
    {
      "number": 72,
      "text": "እናንተ ዛፏን ፈጠራችሁን? ወይስ እኛ ፈጣሪዎችዋ ነን?"
    },
    {
      "number": 73,
      "text": "እኛ (ለገሀናም) ማስታወሻ ለመንገደኞችም መጠቀሚያ አደረግናት፡፡"
    },
    {
      "number": 74,
      "text": "የታላቁን ጌታህንም ስም አወድስ፡፡"
    },
    {
      "number": 75,
      "text": "በከዋክብትም መጥለቂያዎች እምላለሁ፡፡"
    },
    {
      "number": 76,
      "text": "እርሱም ብታወቁ ታላቅ መሓላ ነው፡፡"
    },
    {
      "number": 77,
      "text": "እርሱ የከበረ ቁርኣን ነው፡፡"
    },
    {
      "number": 78,
      "text": "በተጠበቀ መጽሐፍ ውስጥ ነው፡፡"
    },
    {
      "number": 79,
      "text": "የተጥራሩት እንጅ ሌላ አይነካውም፡፡"
    },
    {
      "number": 80,
      "text": "ከዓለማት ጌታ የተወረደ ነው፡፡"
    },
    {
      "number": 81,
      "text": "በዚህ ንግግር እናንተ ቸልተኞች ናችሁን?"
    },
    {
      "number": 82,
      "text": "ሲሳያችሁንም (ዝናምን) እናንተ የምታስተባብሉት ታደርጋላችሁን?"
    },
    {
      "number": 83,
      "text": "(ነፍስ) ጉረሮንም በደረሰች ጊዜ፡፡"
    },
    {
      "number": 84,
      "text": "እናንተ ያን ጊዜ የምታዩ ስትኾኑ፡፡"
    },
    {
      "number": 85,
      "text": "እኛም ግን አታዩም እንጅ ከእናንተ ይልቅ ወደእርሱ የቀረብን ስንኾን፡፡"
