    {
      "number": 23,
      "text": "am tyaqutin iffren."
    },
    {
      "number": 24,
      "text": "D arraz n wayen xeddmen."
    },
    {
      "number": 25,
      "text": "Ur din sellen awal n leqbaêa, ne$ n tuccva;"
    },
    {
      "number": 26,
      "text": "siwa awal n tifrat, tifrat!"
    },
    {
      "number": 27,
      "text": "At uyeffus, at uyeffus, d acu ten?"
    },
    {
      "number": 28,
      "text": "Ar tzegwart, war isennanen."
    },
    {
      "number": 29,
      "text": "Tulmatin iurwen."
