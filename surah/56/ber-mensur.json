    {
      "number": 66,
      "text": "\"Aql a$ nepwalas!"
    },
    {
      "number": 67,
      "text": "Sennig waya: aql a$ neppuêeôôem\"!"
    },
    {
      "number": 68,
      "text": "Twalam aman i teppessem?"
    },
    {
      "number": 69,
      "text": "D kunwi iten id isse$layen seg usigna, ne$ d Nekwni?"
    },
    {
      "number": 70,
      "text": "Ma ihwa ya£, a ten Nerr d imeô$anen. A lemmer tesnemmiren!"
    },
    {
      "number": 71,
      "text": "Twalam times i tesskarem s uêukku?"
    },
    {
      "number": 72,
      "text": "D kunwi i s d ixelqen ttjuô is, ne$ d Nekwni ay d Ixellaqen?"
    },
    {
      "number": 73,
      "text": "D Nekwni i p Irran d asmekti, u d lâafia i wid ineêwwaoen."
    },
    {
      "number": 74,
      "text": "Sbuccaâ, s ccekôan, isem n Mass ik, Ameqwôaêan!"
    },
    {
      "number": 75,
      "text": "Ih, gulle$ seg wanda llan itran!"
    },
    {
      "number": 76,
      "text": "U, tagi, lemmer a ppeéôem, ard tagallit tameqwôaêant!"
    },
    {
      "number": 77,
      "text": "Ar neppa d Leqwôan ukyis,"
    },
    {
      "number": 78,
      "text": "di Tezmamt iffren."
    },
    {
      "number": 79,
      "text": "Ur t pnalen, siwa wid zeddigen."
    },
    {
      "number": 80,
      "text": "D tarusi s$uô Mass imavalen."
    },
    {
      "number": 81,
      "text": "S usali agi, amendeô ma a ppiéidem?"
    },
    {
      "number": 82,
      "text": "S ôôeéq nnwen, kunwi tnekôem?"
    },
    {
      "number": 83,
      "text": "Mara d tawev s agerjum,"
