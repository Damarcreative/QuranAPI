    {
      "number": 7,
      "text": "a d tevêum krav leûnaf:"
    },
    {
      "number": 8,
      "text": "at uyeffus. At uyeffus, anwi ten?"
    },
    {
      "number": 9,
      "text": "At uzelmav. At uzelmav, anwi ten?"
    },
    {
