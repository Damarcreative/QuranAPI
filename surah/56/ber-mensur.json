      "text": "di leonanat isaâdiyen."
    },
    {
      "number": 13,
      "text": "Seg imenza, deg waîas idsen."
    },
    {
      "number": 14,
      "text": "Seg ineggura, drus nnsen."
    },
    {
      "number": 15,
      "text": "£ef imîeôêen iévan,"
