    {
      "number": 52,
      "text": "a ppeççem, war ccekk, si ttejôa n Zaqqum."
    },
    {
      "number": 53,
      "text": "A ppacaôem segs ifwaden."
    },
    {
      "number": 54,
      "text": "Sinna, a ppernum tissit seg waman iô$an."
    },
    {
      "number": 55,
      "text": "A ppetessem tissit ile$wman."
    },
    {
      "number": 56,
      "text": "D wagi ar asen d irsen, ass uqeîîi."
    },
    {
      "number": 57,
      "text": "D Nekwni ikwen Ixelqen. Lemmer a ppamnem."
    },
    {
      "number": 58,
      "text": "Twalam l$ella id iteff$en segwen?"
    },
    {
      "number": 59,
      "text": "D kunwi ip ixelqen, ne$ d Nekwni ay d ixellaqen?"
    },
    {
      "number": 60,
      "text": "Nseyya tameppant garawen. Ur a£ izeggwir yiwen"
    },
    {
      "number": 61,
      "text": "iwakken a Nerr deg umkan nnwen wid i kwen icban; u kunwi, a kwen Nexleq d ayen ur tessinem."
    },
    {
      "number": 62,
      "text": "Ni$ tesnem axlaq amenzu, lemmer tesmektayem!"
    },
    {
      "number": 63,
      "text": "Twalam ayen tkerrzem?"
    },
    {
      "number": 64,
      "text": "D kunwi i t ikerzen, ne$ d Nekwni ay d imekrazen?"
    },
    {
      "number": 65,
      "text": "Ma ihwa ya£, a t Nerr d uêvim, d$a a kwen tekkat lwehma:"
