{
  "surah": 56,
  "translation": "ber-mensur",
  "ayahs": [
    {
      "number": 1,
      "text": "Mara d tas, tin ara d iasen,"
    },
    {
      "number": 2,
      "text": "$ef tisin is, ur illi ucehrir."
    },
    {
      "number": 3,
      "text": "Tessrusu, treffed."
    },
    {
      "number": 4,
      "text": "Ma tenhez tmurt, lhezz iqesêen,"
