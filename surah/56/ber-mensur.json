    {
      "number": 40,
      "text": "Seg ineggura, deg aîas idsen."
    },
    {
      "number": 41,
      "text": "At uzelmav, at uzelmav, d acu ten?"
    },
    {
      "number": 42,
      "text": "Deg wavu, akked waman iô$an."
    },
    {
      "number": 43,
      "text": "Tili n wabbu iô$an."
    },
    {
      "number": 44,
      "text": "Ur degs tasmuvi, lekyasa."
    },
    {
      "number": 45,
      "text": "Ih, nitni zik, llan ôwan."
    },
    {
      "number": 46,
      "text": "Zgan deg ubekkav abarar."
    },
    {
      "number": 47,
      "text": "Llan qqaôen: \"ma nemmut, nu$al d akal, akked i$san, day a d a$ d rren?"
    },
    {
      "number": 48,
      "text": "Akked imezwura nne$ imenza\"?"
