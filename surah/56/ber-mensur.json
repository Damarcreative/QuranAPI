    {
      "number": 16,
      "text": "éélen fellasen, mqabalen."
    },
    {
      "number": 17,
      "text": "Tezzin asen ilmeéiyen iwekkôen,"
    },
    {
      "number": 18,
      "text": "s tbuqalin, iqbucen, akked lkas n tissit iûfan."
    },
    {
      "number": 19,
      "text": "Yis, ur ppavnen, ur sekkôen."
    },
    {
      "number": 20,
      "text": "Izwayen, seg wid smenyafen."
    },
    {
      "number": 21,
      "text": "Aksum n yifôax, seg win cedhan."
    },
    {
      "number": 22,
      "text": "Tiêuôiyin lâin,"
