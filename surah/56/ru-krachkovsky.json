{
  "surah": 56,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Когда упадет падающее, -"
    },
    {
      "number": 2,
      "text": "нет ничего отрицающего ее падение! -"
    },
    {
      "number": 3,
      "text": "унижая и возвышая,"
    },
    {
      "number": 4,
      "text": "когда сотрясается земля сотрясением,"
    },
    {
      "number": 5,
      "text": "когда сокрушатся горы сокрушением"
    },
    {
      "number": 6,
      "text": "и станут рассыпающимся прахом,"
    },
    {
      "number": 7,
      "text": "и станете вы тремя группами,"
    },
    {
      "number": 8,
      "text": "то владыки правой стороны, - что это за владыки правой стороны?"
    },
    {
      "number": 9,
      "text": "И владыки левой стороны, - что это за владыки левой стороны?"
    },
    {
      "number": 10,
      "text": "И предварившие - предварившие?"
    },
    {
      "number": 11,
      "text": "Эти - те, которые будут приближены"
    },
    {
      "number": 12,
      "text": "в садах благодати, -"
    },
    {
      "number": 13,
      "text": "толпа первых"
    },
    {
      "number": 14,
      "text": "и немного последних,"
    },
    {
      "number": 15,
      "text": "на ложах расшитых,"
    },
    {
      "number": 16,
      "text": "облокотившись на них друг против друга."
    },
    {
      "number": 17,
      "text": "Обходят их мальчики вечно юные"
    },
    {
      "number": 18,
      "text": "с чашами, сосудами и кубками из текущего источника -"
    },
    {
      "number": 19,
      "text": "от него не страдают головной болью и ослаблением -"
    },
    {
      "number": 20,
      "text": "и плодами из тех, что они выберут,"
    },
    {
      "number": 21,
      "text": "и мясом птиц из тех, что пожелают."
    },
    {
      "number": 22,
      "text": "А черноокие, большеглазые,"
    },
    {
      "number": 23,
      "text": "подобные жемчугу хранимому -"
    },
    {
      "number": 24,
      "text": "в воздаяние за то, что они делали."
    },
    {
      "number": 25,
      "text": "Не услышат они там пустословия и укоров в грехе,"
    },
    {
      "number": 26,
      "text": "а лишь слова: \"Мир, мир!\""
    },
    {
      "number": 27,
      "text": "А владыки правой стороны, - что это за владыки правой стороны? -"
    },
    {
      "number": 28,
      "text": "среди лотоса, лишенного шипов,"
    },
    {
      "number": 29,
      "text": "и талха, увешанного плодами,"
    },
    {
      "number": 30,
      "text": "и тени протянутой,"
    },
    {
      "number": 31,
      "text": "и воды текучей,"
    },
    {
      "number": 32,
      "text": "и плодов обильных,"
    },
    {
      "number": 33,
      "text": "не истощаемых и не запретных,"
    },
    {
      "number": 34,
      "text": "и ковров разостланных,"
    },
    {
      "number": 35,
      "text": "Мы ведь создали их творением"
    },
    {
      "number": 36,
      "text": "и сделали их девственницами,"
    },
    {
      "number": 37,
      "text": "мужа любящими, сверстницами"
    },
    {
      "number": 38,
      "text": "для владык правой стороны."
    },
    {
      "number": 39,
      "text": "Толпа первых"
    },
    {
      "number": 40,
      "text": "и толпа последних!"
    },
    {
      "number": 41,
      "text": "А владыки левой стороны - что это за владыки левой стороны? -"
    },
    {
      "number": 42,
      "text": "в самуме и кипятке,"
    },
    {
      "number": 43,
      "text": "и тени черного дыма,"
    },
    {
      "number": 44,
      "text": "не прохладной и не благой."
    },
    {
      "number": 45,
      "text": "Они ведь до этого были избалованы"
    },
    {
      "number": 46,
      "text": "и упорствовали в великом грехе,"
    },
    {
      "number": 47,
      "text": "и, бывало, говорили: \"Разве, когда мы умрем и станем прахом и костями, - разве мы действительно будем воскрешены,"
    },
    {
      "number": 48,
      "text": "или отцы наши первые?\""
    },
    {
      "number": 49,
      "text": "Скажи: \"Поистине, первые и последние,"
    },
    {
      "number": 50,
      "text": "конечно, будут собраны к сроку известного дня!"
    },
    {
      "number": 51,
      "text": "Потом, поистине, вы - заблудшие, обвиняющие во лжи,"
    },
    {
      "number": 52,
      "text": "будете есть с дерева заккум"
    },
    {
      "number": 53,
      "text": "и наполнять им животы,"
    },
    {
      "number": 54,
      "text": "и пить за этим кипяток,"
    },
    {
      "number": 55,
      "text": "и пить, как пьют истомленные жаждой\"."
    },
    {
      "number": 56,
      "text": "Это - угощение их в день суда."
    },
    {
      "number": 57,
      "text": "Мы создали вас, и почему вам не поверить?"
    },
    {
      "number": 58,
      "text": "Видели ли вы то, что извергаете семенем,"
    },
    {
      "number": 59,
      "text": "вы ли творите это, или Мы творцы?"
    },
    {
      "number": 60,
      "text": "Мы распределили вам смерть, - и Нас не опередить! -"
    },
    {
      "number": 61,
      "text": "с тем, чтобы заменить вас подобными, и воссоздать вас в том, как вы этого не знаете."
    },
    {
      "number": 62,
      "text": "Вы ведь уже первое создание, и почему бы вам не размыслить?"
    },
    {
      "number": 63,
      "text": "Видели ли вы, что возделываете?"
    },
    {
      "number": 64,
      "text": "Вы ли это сеете, или Мы сеем?"
    },
    {
      "number": 65,
      "text": "Если бы Мы пожелали, то сделали бы это сухим мусором, а вы стали бы удивляться:"
    },
    {
      "number": 66,
      "text": "\"Мы ведь обременены долгами,"
    },
    {
      "number": 67,
      "text": "и, вдобавок, мы еще лишены\"."
    },
    {
      "number": 68,
      "text": "Видели ли вы воду, которую пьете?"
    },
    {
      "number": 69,
      "text": "Разве вы ее низвели из облака, или Мы низводим?"
    },
    {
      "number": 70,
      "text": "Если бы Мы пожелали, Мы бы сделали ее горькой, отчего же вы не поблагодарите?"
    },
    {
      "number": 71,
      "text": "Видели ли вы огонь, который высекаете?"
    },
    {
      "number": 72,
      "text": "Разве вы произвели дерево его, или Мы - произведшие?"
    },
    {
      "number": 73,
      "text": "Мы сделали его напоминанием и припасом для людей, находящихся в пустыне."
    },
    {
      "number": 74,
      "text": "Хвали же имя Господа своего великого!"
    },
    {
      "number": 75,
      "text": "Но нет, клянусь местом заката звезд!"
    },
    {
      "number": 76,
      "text": "А ведь это - клятва, если бы вы знали, великая."
    },
    {
      "number": 77,
      "text": "Поистине, это ведь Коран благородный"
    },
    {
      "number": 78,
      "text": "в книге сокровенной."
    },
    {
      "number": 79,
      "text": "Прикасаются к нему только очищенные."
    },
    {
      "number": 80,
      "text": "Ниспослание от Господа миров."
    },
    {
      "number": 81,
      "text": "Разве же и этим повествованием вы небрежете?"
    },
    {
      "number": 82,
      "text": "И свою долю обращаете в то, что объявляете ложью."
    },
    {
      "number": 83,
      "text": "А если бы - тогда она дойдет до гортани,"
    },
    {
      "number": 84,
      "text": "и вы будете тогда смотреть,"
    },
    {
      "number": 85,
      "text": "а Мы ближе к этому, чем вы сами, но вы не видите."
    },
    {
      "number": 86,
      "text": "А если бы - разве не будете судимы,"
    },
    {
      "number": 87,
      "text": "вы бы вернули ее обратно, если вы говорите правду!"
    },
    {
      "number": 88,
      "text": "А если он из приближенных,"
    },
    {
      "number": 89,
      "text": "то - покой, и аромат, и сад благодати."
    },
    {
      "number": 90,
      "text": "А если он из владык правой руки,"
    },
    {
      "number": 91,
      "text": "то \"мир тебе\" от владык правой руки!"
    },
    {
      "number": 92,
      "text": "А если он из числа считавших ложью, заблудших,"
    },
    {
      "number": 93,
      "text": "то - угощение из кипятка"
    },
    {
      "number": 94,
      "text": "и горение в огне."
    },
    {
      "number": 95,
      "text": "Действительно, это, конечно, истина несомненности!"
    },
    {
      "number": 96,
      "text": "Хвали же имя Господа твоего великого!"
    }
  ]
}