{
  "surah": 77,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>a</b>lmursal<u>a</u>ti AAurf<u>a</u><b>n</b>"
    },
    {
      "number": 2,
      "text": "Fa<b>a</b>lAA<u>as</u>if<u>a</u>ti AAa<u>s</u>f<u>a</u><b>n</b>"
    },
    {
      "number": 3,
      "text": "Wa<b>al</b>nn<u>a</u>shir<u>a</u>ti nashr<u>a</u><b>n</b>"
    },
    {
      "number": 4,
      "text": "Fa<b>a</b>lf<u>a</u>riq<u>a</u>ti farq<u>a</u><b>n</b>"
    },
    {
      "number": 5,
      "text": "Fa<b>a</b>lmulqiy<u>a</u>ti <u>th</u>ikr<u>a</u><b>n</b>"
    },
    {
      "number": 6,
      "text": "AAu<u>th</u>ran aw nu<u>th</u>ra<b>n</b>"
    },
    {
      "number": 7,
      "text": "Innam<u>a</u> tooAAadoona law<u>a</u>qiAA<b>un</b>"
    },
    {
      "number": 8,
      "text": "Fai<u>tha</u> a<b>l</b>nnujoomu <u>t</u>umisat"
    },
    {
      "number": 9,
      "text": "Wai<u>tha</u> a<b>l</b>ssam<u>a</u>o furijat"
    },
    {
      "number": 10,
      "text": "Wai<u>tha</u> aljib<u>a</u>lu nusifat"
    },
    {
      "number": 11,
      "text": "Wai<u>tha</u> a<b>l</b>rrusulu oqqitat"
    },
    {
      "number": 12,
      "text": "Liayyi yawmin ojjilat"
    },
    {
      "number": 13,
      "text": "Liyawmi alfa<u>s</u>l<b>i</b>"
    },
    {
      "number": 14,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> yawmu alfa<u>s</u>l<b>i</b>"
    },
    {
      "number": 15,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 16,
      "text": "Alam nuhliki alawwaleen<b>a</b>"
    },
    {
      "number": 17,
      "text": "Thumma nutbiAAuhumu al<u>a</u>khireen<b>a</b>"
    },
    {
      "number": 18,
      "text": "Ka<u>tha</u>lika nafAAalu bi<b>a</b>lmujrimeen<b>a</b>"
    },
    {
      "number": 19,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 20,
      "text": "Alam nakhluqkum min m<u>a</u>in maheen<b>in</b>"
    },
    {
      "number": 21,
      "text": "FajaAAaln<u>a</u>hu fee qar<u>a</u>rin makeen<b>in</b>"
    },
    {
      "number": 22,
      "text": "Il<u>a</u> qadarin maAAloom<b>in</b>"
    },
    {
      "number": 23,
      "text": "Faqadarn<u>a</u> faniAAma alq<u>a</u>diroon<b>a</b>"
    },
    {
      "number": 24,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 25,
      "text": "Alam najAAali alar<u>d</u>a kif<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 26,
      "text": "A<u>h</u>y<u>a</u>an waamw<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 27,
      "text": "WajaAAaln<u>a</u> feeh<u>a</u> raw<u>a</u>siya sh<u>a</u>mikh<u>a</u>tin waasqayn<u>a</u>kum m<u>a</u>an fur<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 28,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 29,
      "text": "In<u>t</u>aliqoo il<u>a</u> m<u>a</u> kuntum bihi tuka<u>thth</u>iboon<b>a</b>"
    },
    {
      "number": 30,
      "text": "In<u>t</u>aliqoo il<u>a</u> <i><u>th</u></i>illin <u>th</u>ee thal<u>a</u>thi shuAAab<b>in</b>"
    },
    {
      "number": 31,
      "text": "L<u>a</u> <i><u>th</u></i>aleelin wal<u>a</u> yughnee mina allahab<b>i</b>"
    },
    {
      "number": 32,
      "text": "Innah<u>a</u> tarmee bishararin ka<b>a</b>lqa<u>s</u>r<b>i</b>"
    },
    {
      "number": 33,
      "text": "Kaannahu jim<u>a</u>latun <u>s</u>ufr<b>un</b>"
    },
    {
      "number": 34,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 35,
      "text": "H<u>atha</u> yawmu l<u>a</u> yan<u>t</u>iqoon<b>a</b>"
    },
    {
      "number": 36,
      "text": "Wal<u>a</u> yu<u>th</u>anu lahum fayaAAta<u>th</u>iroon<b>a</b>"
    },
    {
      "number": 37,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 38,
      "text": "H<u>atha</u> yawmu alfa<u>s</u>li jamaAAn<u>a</u>kum wa<b>a</b>lawwaleen<b>a</b>"
    },
    {
      "number": 39,
      "text": "Fain k<u>a</u>na lakum kaydun fakeedoon<b>i</b>"
    },
    {
      "number": 40,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 41,
      "text": "Inna almuttaqeena fee <i><u>th</u></i>il<u>a</u>lin waAAuyoon<b>in</b>"
    },
    {
      "number": 42,
      "text": "Wafaw<u>a</u>kiha mimm<u>a</u> yashtahoon<b>a</b>"
    },
    {
      "number": 43,
      "text": "Kuloo wa<b>i</b>shraboo haneean bim<u>a</u> kuntum taAAmaloon<b>a</b>"
    },
    {
      "number": 44,
      "text": "Inn<u>a</u> ka<u>tha</u>lika najzee almu<u>h</u>sineen<b>a</b>"
    },
    {
      "number": 45,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 46,
      "text": "Kuloo watamattaAAoo qaleelan innakum mujrimoon<b>a</b>"
    },
    {
      "number": 47,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 48,
      "text": "Wai<u>tha</u> qeela lahumu irkaAAoo l<u>a</u> yarkaAAoon<b>a</b>"
    },
    {
      "number": 49,
      "text": "Waylun yawmai<u>th</u>in lilmuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 50,
      "text": "Fabiayyi <u>h</u>adeethin baAAdahu yuminoon<b>a</b>"
    }
  ]
}