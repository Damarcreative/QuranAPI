{
  "surah": 77,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ተከታታይ ኾነው በተላኩት፣"
    },
    {
      "number": 2,
      "text": "በኀይል መንፈስን ነፋሾች በኾኑትም፣"
    },
    {
      "number": 3,
      "text": "መበተንን በታኞች በኾኑትም፤ (ነፋሶች)፣"
    },
    {
      "number": 4,
      "text": "መለየትን ለይዎች በኾኑትም፣"
    },
    {
      "number": 5,
      "text": "መገሠጫን (ወደ ነቢያት) ጣይዎች በኾኑትም፣"
    },
    {
      "number": 6,
      "text": "ምክንያትን ለማስወገድ ወይም ለማስፈራራት (ጣይዎች በኾኑት መላእክት) እምላለሁ፡፡"
    },
    {
      "number": 7,
      "text": "ያ የምትስፈራሩበት (ትንሣኤ) በእርግጥ ኋኝ ነው፡፡"
    },
    {
      "number": 8,
      "text": "ከዋክብትም (ብርሃንዋ) በታበሰች ጊዜ፡፡"
    },
    {
      "number": 9,
      "text": "ሰማይም በተከፈተች ጊዜ፡፡"
    },
    {
      "number": 10,
      "text": "ጋራዎችም በተንኮተኮቱ ጊዜ፡፡"
    },
    {
      "number": 11,
      "text": "መልክተኞቹም ወቅት በተደረገላቸው ጊዜ፡፡"
    },
    {
      "number": 12,
      "text": "ለየትኛው ቀን ተቀጠሩ (የሚባል ሲኾን)፤"
    },
    {
      "number": 13,
      "text": "ለመለያው ቀን (በተባለ ጊዜ፤ በፍጡሮች መካከል ይፈረዳል)፡፡"
    },
    {
      "number": 14,
      "text": "የመለያውም ቀን ምን እንደኾነ ምን አሳወቀህ?"
    },
    {
      "number": 15,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 16,
      "text": "የፊተኞቹን (ሕዝቦች) አላጠፋንምን?"
    },
    {
      "number": 17,
      "text": "ከዚያም የኋለኞቹን እናስከትላቸዋለን፡፡"
    },
    {
      "number": 18,
      "text": "በአመጸኞች ሁሉ እንደዚሁ እንሠራለን፡፡"
    },
    {
      "number": 19,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 20,
      "text": "ከደካማ ውሃ አልፈጠርናችሁምን?"
    },
    {
      "number": 21,
      "text": "በተጠበቀ መርጊያ ውስጥም (በማሕፀን) አደረግነው፡፡"
    },
    {
      "number": 22,
      "text": "እስከ ታወቀ ልክ ድረስ፡፡ መጠንነውም፤ ምን ያማርንም"
    },
    {
      "number": 23,
      "text": "መጣኞች ነን!"
    },
    {
      "number": 24,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 25,
      "text": "ምድርን ሰብሳቢ አላደረግናትምን?"
    },
    {
      "number": 26,
      "text": "ሕያዋን ኾናችሁ ሙታንም ኾናችሁ፡፡"
    },
    {
      "number": 27,
      "text": "በውስጧም ከፍተኛዎችን ተራራዎች አደረግን፡፡ ጣፋጭ ውሃንም አጠጣናችሁ፡፡"
    },
    {
      "number": 28,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 29,
      "text": "«ወደዚያ በእርሱ ታስተባብሉ ወደ ነበራችሁት (ቅጣት) አዝግሙ፡፡"
    },
    {
      "number": 30,
      "text": "«ባለ ሦስት ቅርንጫፎች ወደ ኾነው ጥላ አዝግሙ፤» (ይባላሉ)፡፡"
    },
    {
      "number": 31,
      "text": "አጠላይ ያልኾነ ከእሳቱም ላንቃ የማያድን ወደ ኾነው (አዝግሙ)፡፡"
    },
    {
      "number": 32,
      "text": "እርሷ እንደ ታላላቅ ሕንጻ የኾኑን ቃንቄዎች ትወረውራለች፡፡"
    },
    {
      "number": 33,
      "text": "(ቃንቄውም) ልክ ዳለቻዎች ግመሎችን ይመስላል፡፡"
    },
    {
      "number": 34,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 35,
      "text": "ይህ የማይናገሩበት ቀን ነው፡፡"
    },
    {
      "number": 36,
      "text": "ይቅርታም ይጠይቁ ዘንድ፤ ለእነርሱ አይፈቀድላቸውም፡፡"
    },
    {
      "number": 37,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 38,
      "text": "ይህ መለያው ቀን ነው፡፡ እናንተንም የፊተኞቹንም ሰብሰብናችሁ፡፡"
    },
    {
      "number": 39,
      "text": "ለናንተም (ለማምለጥ) ብልሃት እንዳላችሁ ተተናኮሉኝ፡፡"
    },
    {
      "number": 40,
      "text": "ላስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 41,
      "text": "ጥንቁቆቹ በጥላዎችና በምንጮች ውስጥ ናቸው፡፡"
    },
    {
      "number": 42,
      "text": "ከሚከጅሉትም ሁሉ በፍራፍሬዎች ውስጥ ናቸው፡፡"
    },
    {
      "number": 43,
      "text": "«ትሠሩት በነበራችሁት ዋጋ የምትደሰቱ ኾናችሁ ብሉ፣ ጠጡም፤» (ይባላሉ)፡፡"
    },
    {
      "number": 44,
      "text": "እኛ እንደዚሁ መልካም ሠሪዎችን ሁሉ እንመነዳለን፡፡"
    },
    {
      "number": 45,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 46,
      "text": "ብሉ፤ ጥቂትንም (ጊዜ) ተጠቀሙ፡፡ እናንተ አመጸኞች ናችሁና፡፡"
    },
    {
      "number": 47,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 48,
      "text": "«ለእነርሱ ስገዱም» በተባሉ ጊዜ አይሰግዱም፡፡"
    },
    {
      "number": 49,
      "text": "ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"
    },
    {
      "number": 50,
      "text": "ከእርሱም ሌላ በየትኛው ንግግር ያምናሉ?"
    }
  ]
}