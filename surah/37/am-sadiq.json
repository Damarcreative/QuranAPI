{
  "surah": 37,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "መሰለፍን በሚሰለፉት፡፡"
    },
    {
      "number": 2,
      "text": "መገሠጽንም በሚገሥጹት፤"
    },
    {
      "number": 3,
      "text": "ቁርኣንንም በሚያነቡት እምላለሁ፡፡"
    },
    {
      "number": 4,
      "text": "አምላካችሁ በእርግጥ አንድ ነው፡፡"
    },
    {
      "number": 5,
      "text": "የሰማያትና የምድር በመካከላቸው ያለውም ፍጡር ሁሉ ጌታ ነው፡፡ የምሥራቆችም ጌታ ነው፡፡"
    },
    {
      "number": 6,
      "text": "እኛ ቅርቢቱን ሰማይ በከዋክብት ጌጥ አጌጥናት፡፡"
    },
    {
      "number": 7,
      "text": "አመጸኛም ከሆነ ሰይጣን ሁሉ መጠበቅን ጠበቅናት፡፡"
    },
    {
      "number": 8,
      "text": "ወደላይኛው ሰራዊት አያዳምጡም፡፡ ከየወገኑም ሁሉ ችቦ ይጣልባቸዋል፡፡"
    },
    {
      "number": 9,
      "text": "የሚባረሩ ሲሆኑ (ይጣልባቸዋል)፡፡ ለእነሱም ዘውታሪ ቅጣት አላቸው፡፡"
    },
    {
      "number": 10,
      "text": "ንጥቂያን የነጠቀ ወዲያውም አብሪ ኮከብ የተከተለው ሲቀር፤ (እርሱ ይሰማዋል)፡፡"
    },
    {
      "number": 11,
      "text": "ጠይቃቸውም፤ እነርሱ በአፈጣጠር ይበልጥ የበረቱ ናቸውን? ወይስ እኛ (ከእነርሱ በፊት) የፈጠርነው? (ፍጡር) እኛ ከሚጣበቅ ጭቃ ፈጠርናቸው፡፡"
    },
    {
      "number": 12,
      "text": "ይልቁንም (በማስተባበላቸው) ተደነቅህ፤(ከመደነቅህ) ይሳለቃሉም፡፡"
    },
    {
      "number": 13,
      "text": "በተገሠጹም ጊዜ አይመለሱም፡፡"
    },
    {
      "number": 14,
      "text": "ተዓምርን ባዩም ጊዜ ለመሳለቅ ይጠራራሉ፡፡"
    },
    {
      "number": 15,
      "text": "ይላሉም «ይህ ግልጽ ድግምት እንጂ ሌላ አይደለም፡፡"
    },
    {
      "number": 16,
      "text": "«በሞትንና ዐፈርና አጥንቶችም በኾን ጊዜ እኛ የምንቀሰቀስ ነን?"
    },
    {
      "number": 17,
      "text": "«የቀድሞዎቹ አባቶችንም? (ይላሉ)፡፡"
    },
    {
      "number": 18,
      "text": "«አዎን እናንተ ወራዶች ሆናችሁ (ትነሳላችሁ)» በላቸው፡፡"
    },
    {
      "number": 19,
      "text": "እርሷም አንዲት ጩኸት ብቻ ናት፡፡ እነርሱም ወዲያውኑ (ምን እንደሚፈጸምባቸው) ያያሉ፡፡"
    },
    {
      "number": 20,
      "text": "«ዋ ጥፋታችን! ይህ የፍርዱ ቀን ነው» ይላሉም፡፡"
    },
    {
      "number": 21,
      "text": "«ይህ ያ በእርሱ ታስተባብሉ የነበራችሁት መለያው ቀን ነው» (ይባላሉ)፡፡"
    },
    {
      "number": 22,
      "text": "(ለመላእክቶችም) «እነዚያን ነፍሶቻቸውን የበደሉትን ሰዎች ጓደኞቻቸውንም ይግገዟቸው የነበሩትንም (ጣዖታት) ሰብስቡ፡፡"
    },
    {
      "number": 23,
      "text": "«ከአላህ ሌላ (የሚገዙዋቸውን ሰብስቧቸው) ወደ እሳት መንገድም ምሩዋቸው፡፡"
    },
    {
      "number": 24,
      "text": "«አቁሟቸውም፡፡ እነርሱ ተጠያቂዎች ናቸውና» (ይባላል)፡፡"
    },
    {
      "number": 25,
      "text": "(ለእነርሱም) «የማትረዳዱት ለእናንተ ምን አላችሁ? (ይባላሉ)፡፡"
    },
    {
      "number": 26,
      "text": "በእርግጥ እነርሱ ዛሬ እጃቸውን የሰጡ ወራዳዎች ናቸው፡፡"
    },
    {
      "number": 27,
      "text": "የሚወቃቀሱም ሆነው ከፊላቸው በከፊሉ ላይ ይመጣሉ፡፡"
    },
    {
      "number": 28,
      "text": "(ለአስከታዮቹ) እናንተ ከስተቀኝ ትመጡብን ነበር ይላሉ፡፡"
    },
    {
      "number": 29,
      "text": "(አስከታዮቹም) ይላሉ «አይደለም ፈጽሞ ምእምናን አልነበራችሁም፡፡"
    },
    {
      "number": 30,
      "text": "«ለእኛም በእናንተ ላይ ምንም ስልጣን አልነበረንም፡፡ በእርግጥ እናንተ ጠማሞች ሕዝቦች ነበራችሁ፡፡"
    },
    {
      "number": 31,
      "text": "«በእኛም ላይ የጌታችን ቃል ተረጋገጠብን፤ እኛ (ሁላችንም ቅጣቱን) ቀማሾች ነን፡፡"
    },
    {
      "number": 32,
      "text": "«ወደ ጥምመት ጠራናችሁም፡፡ እኛ ጠማሞች ነበርንና» (ይላሉ)፡፡"
    },
    {
      "number": 33,
      "text": "ስለዚህ እነርሱ በዚያ ቀን በቅጣቱ ነጋሪዎች ናቸው፡፡"
    },
    {
      "number": 34,
      "text": "እኛ በአመጸኞች ሁሉ እንደዚሁ እንሠራለን፡፡"
    },
    {
      "number": 35,
      "text": "እነርሱ ከአላህ ሌላ አምላክ የለም በተባሉ ጊዜ ይኮሩ ነበሩ፡፡"
    },
    {
      "number": 36,
      "text": "እኛ ለዕብድ ባለቅኔ ብለን አማልክቶቻችንን የምንተው ነን? ይሉም ነበር፡፡"
    },
    {
      "number": 37,
      "text": "አይደለም እውነቱን (ሃይማኖት) አመጣ፡፡ መልክተኞቹንም እውነተኛነታቸውን አረጋገጠ፡፡"
    },
    {
      "number": 38,
      "text": "እናንተ አሳማሚውን ቅጣት በእርግጥ ቀማሾች ናችሁ፡፡"
    },
    {
      "number": 39,
      "text": "ትሠሩትም የነበራችሁትን እንጂ ሌላን አትመነዱም፡፡"
    },
    {
      "number": 40,
      "text": "ግን ምርጥ የሆኑት የአላህ ባሮች (ቅጣትን አይቀምሱም)፡፡"
    },
    {
      "number": 41,
      "text": "እነዚያ ለእነርሱ የታወቀ ሲሳይ አላቸው፡፡"
    },
    {
      "number": 42,
      "text": "ፍራፍሬዎች (አሏቸው) እነርሱም የተከበሩ ናቸው፤"
    },
    {
      "number": 43,
      "text": "በድሎት ገነቶች ውስጥ፡፡"
    },
    {
      "number": 44,
      "text": "ፊት ለፊት የሚታያዩ ሲሆኑ በአልጋዎች ላይ (ይንፈላሰሳሉ)፡፡"
    },
    {
      "number": 45,
      "text": "ከሚመነጭ ወይን ጠጅ በያዘ ብርጭቆ በእነርሱ ላይ ይዞርባቸዋል፡፡"
    },
    {
      "number": 46,
      "text": "ነጭ ለጠጪዎች ጣፋጭ ከኾነች፡፡"
    },
    {
      "number": 47,
      "text": "በእርሷ ውስጥም ምታት የለባትም፡፡ እነርሱም ከእርሷ የሚሰክሩ አይደሉም፡፡"
    },
    {
      "number": 48,
      "text": "እነርሱም ዘንድ ዓይናቸውን (በባሎቻቸው ላይ) አሳጣሪዎች የኾኑ ዓይናማዎች አልሉ፡፡"
    },
    {
      "number": 49,
      "text": "እነርሱ ልክ የተሸፈነ (የሰጎን) ዕንቁላል ይመስላሉ፡፡"
    },
    {
      "number": 50,
      "text": "የሚጠያየቁም ሆነው ከፊላቸው ወደ ከፊሉ ይመጣሉ፡፡"
    },
    {
      "number": 51,
      "text": "ከእነርሱ የሆነ ተናጋሪ ይላል «እኔ ጓደኛ ነበረኝ፡፡"
    },
    {
      "number": 52,
      "text": "«በእርግጥ አንተ ከሚያምኑት ነህን? የሚል፡፡"
    },
    {
      "number": 53,
      "text": "«በሞትንና ዐፈር አጥንቶችም በሆን ጊዜ እኛ በእርግጥ እንመረመራለን?» (የሚል)፡፡"
    },
    {
      "number": 54,
      "text": "እናንተ ተመልካቾች ናችሁን? ይላል፡፡"
    },
    {
      "number": 55,
      "text": "ይመለከታልም፤ በገሀነም መካከልም (ጓደኛውን) ያየዋል፡፡"
    },
    {
      "number": 56,
      "text": "ይላል «በአላህ እምላለሁ፤ በእርግጥ ልታጠፋኝ ቀርበህ ነበር፡፡"
    },
    {
      "number": 57,
      "text": "«የጌታየም ጸጋ ባልነበረ ኖሮ ወደ እሳት ከሚቀርቡት እሆን ነበር፡፡»"
    },
    {
      "number": 58,
      "text": "(የገነት ሰዎች ይላሉ) «እኛ የምንሞት አይደለንምን?"
    },
    {
      "number": 59,
      "text": "«የመጀመሪያይቱ መሞታችን ብቻ ስትቀር፡፡ እኛም የምንቅቀጣ አይደለንምን?» (ይላሉ)፡፡"
    },
    {
      "number": 60,
      "text": "ይህ (ለገነት ሰዎች የተወሳው) እርሱ በእርግጥ ታላቅ ዕድል ነው፡፡"
    },
    {
      "number": 61,
      "text": "ለዚህ ብጤ ሠሪዎች ይሥሩ፡፡"
    },
    {
      "number": 62,
      "text": "በመስተንግዶነት ይህ ይበልጣልን? ወይስ የዘቁም ዛፍ?"
    },
    {
      "number": 63,
      "text": "እኛ ለበዳዮች ፈተና አድርገናታል፡፡"
    },
    {
      "number": 64,
      "text": "እርሷ በገሀነም አዘቅት ውስጥ የምትወጣ ዛፍ ናት፡፡"
    },
    {
      "number": 65,
      "text": "እንቡጧ ልክ የሰይጣናት ራሶች ይመስላል፡፡"
    },
    {
      "number": 66,
      "text": "እነርሱም ከእርሷ በይዎች ናቸው፤ ሆዶችንም ከእርሷ ሞይዎች ናቸው፡፡"
    },
    {
      "number": 67,
      "text": "ከዚያም ለእነርሱ በእርሷ ላይ ከተኳሳ ውሃ ቅልቅል (መጠጥ) አልላቸው፡፡"
    },
    {
      "number": 68,
