{
  "surah": 37,
  "translation": "tr-yuksel",
  "ayahs": [
    {
      "number": 1,
      "text": "And olsun sıralar halinde dizenlere,"
    },
    {
      "number": 2,
      "text": "İtekleyip sürenlere,"
    },
    {
      "number": 3,
      "text": "Ve mesajı okuyanlara..."
    },
    {
      "number": 4,
      "text": "Ki sizin Tanrınız birdir."
    },
    {
      "number": 5,
      "text": "Göklerin, yerin ve her ikisinin arasında bulunanların Rabbidir, doğuların Rabbidir."
    },
    {
      "number": 6,
      "text": "Biz en aşağıdaki göğü gezegenler ile süsleyip,"
    },
    {
      "number": 7,
      "text": "Her türlü inatçı şeytana karşı bir koruma yaptık."
    },
    {
      "number": 8,
      "text": "Yüce topluluğu dinleyemezler; her yandan atılırlar."
    },
    {
      "number": 9,
      "text": "Kovulurlar; sürekli bir azabı hakketmişlerdir."
    },
    {
      "number": 10,
      "text": "Bir söz kapan olursa, onu, delici bir ışın izler."
    },
    {
      "number": 11,
      "text": "Sor onlara, \"Yaratılış bakımından onlar mı daha çetin, yoksa bizim yarattıklarımız mı?\" Onları yapışkan bir balçıktan yarattık."
    },
    {
      "number": 12,
      "text": "Sen hayranlık duyarken onlar alay ediyorlar."
    },
    {
      "number": 13,
      "text": "Kendilerine hatırlatıldığında öğüt almıyorlar."
    },
    {
      "number": 14,
      "text": "Bir delil gördüklerinde onu alaya alıyorlar."
    },
    {
      "number": 15,
      "text": "Derler, \"Bu, apaçık bir büyüden başka bir şey değildir.\""
    },
    {
      "number": 16,
      "text": "\"Ölüp, toprak ve kemik olduktan sonra mı, biz mi diriltilecekmişiz?\""
    },
    {
      "number": 17,
      "text": "\"Hatta bizden önceki atalarımız da mı?\""
    },
    {
      "number": 18,
      "text": "De ki, \"Evet, hem de horlanarak.\""
    },
    {
      "number": 19,
      "text": "O, bir tek dokunmadır. O zaman (kalkıp) bakınırlar."
    },
    {
      "number": 20,
      "text": "\"Vay halimize!\" derler, \"Bu Yargı Günüdür.\""
    },
    {
      "number": 21,
      "text": "Bu, sizin yalanlamış olduğunuz karar günüdür."
    },
    {
      "number": 22,
      "text": "Zalimleri toplayın. Eşlerini ve,"
    },
    {
      "number": 23,
      "text": "ALLAH'tan başka taptıklarını... Onlara cehennemin yolunu gösterin."
    },
    {
      "number": 24,
      "text": "Ve durdurun onları; sorguya çekileceklerdir."
    },
    {
      "number": 25,
      "text": "\"Neden bir birinize yardım etmiyorsunuz?\""
    },
    {
      "number": 26,
      "text": "Hayır, o gün tümüyle teslim olmuşlardır."
    },
    {
      "number": 27,
      "text": "Dönüp birbirlerini sorgularlar."
    },
    {
      "number": 28,
      "text": "\"Siz bize sağ yanımızdan yaklaşıyordunuz,\" derler."
    },
    {
      "number": 29,
      "text": "Derler ki, \"Aslında siz inanmış kimseler değildiniz.\""
    },
    {
      "number": 30,
      "text": "\"Bizim sizin üzerinizde her hangi bir gücümüz yoktu. Aksine siz azmış bir topluluktunuz.\""
    },
    {
      "number": 31,
      "text": "\"Rabbimizin hakkımızdaki sözü gerçekleşti, artık tadacağız.\""
    },
    {
      "number": 32,
      "text": "\"Biz azmıştık. Sizi de azdırdık.\""
    },
    {
      "number": 33,
      "text": "Böylece, o gün onlar azabta ortaktırlar."
    },
    {
      "number": 34,
      "text": "Biz suçlulara böyle yaparız."
    },
    {
      "number": 35,
      "text": "Kendilerine \"La ilahe illa ALLAH\" denildiğinde büyükleniyorlardı."
    },
    {
      "number": 36,
      "text": "\"Tanrılarımızı deli bir şair için mi terkedeceğiz?\" diyorlardı."
    },
    {
      "number": 37,
      "text": "Doğrusu, o, gerçeği getirmiş ve elçileri doğrulamıştır. Yine O diriltecektir. O her türlü yaratmayı bilendir."
    },
    {
      "number": 38,
      "text": "Siz elbette acı azabı tadacaksınız."
    },
    {
      "number": 39,
      "text": "Sadece yapmış olduklarınızın karşılığını görüyorsunuz."
    },
    {
      "number": 40,
      "text": "Kendilerini sadece ALLAH'a adamış kulları hariç."
    },
    {
      "number": 41,
      "text": "Onlar bilinen bir rızkı haketmişlerdir."
    },
    {
      "number": 42,
      "text": "Meyvelerle ağırlanacaklardır."
    },
    {
      "number": 43,
      "text": "Nimet cennetlerinde."
    },
    {
      "number": 44,
      "text": "Karşılıklı koltuklar üzerinde."
    },
    {
      "number": 45,
      "text": "Onlara pınarlardan doldurulmuş kadehler sunulur."
    },
    {
      "number": 46,
      "text": "Durudur, içenlere zevk ve lezzet verir."
    },
    {
      "number": 47,
      "text": "Onda ne başağrısı ne de sarhoşluk vardır."
    },
    {
      "number": 48,
      "text": "Yanlarında da, gözlerinin içine bakan güzel eşler..."
    },
    {
      "number": 49,
      "text": "Kornumuş yumurtalar gibidirler."
    },
    {
      "number": 50,
      "text": "Birbirlerine dönüp soruşurlar."
    },
    {
      "number": 51,
      "text": "İçlerinden biri der ki, \"Benim bir arkadaşım vardı.\""
    },
    {
      "number": 52,
      "text": "\"Şöyle konuşurdu, 'Sen de doğruluyor musun?\""
    },
    {
      "number": 53,
      "text": "\"Biz toprak ve kemik olduktan sonra mı, biz mi dirileceğiz?\""
    },
    {
      "number": 54,
      "text": "(Yanındakilere,) \"Bakar mısınız?\" der."
    },
    {
      "number": 55,
      "text": "Baktığında, onu cehennemin ortasında bulur."
    },
    {
      "number": 56,
      "text": "\"ALLAH'a andolsun, az kalsın sen beni de mahfedecektin,\" der."
    },
    {
      "number": 57,
      "text": "\"Rabbimin nimeti olmasaydı, ben de şimde seninle birlikte olurdum.\""
    },
    {
      "number": 58,
      "text": "\"(Sana göre), biz öldüğümüzde,\""
    },
    {
      "number": 59,
      "text": "\"İlk ölüm hariç, cezalandırılmayacaktık hani?\""
    },
    {
      "number": 60,
      "text": "İşte büyük zafer budur."
    },
    {
      "number": 61,
      "text": "Çalışanlar bunun için çalışmalı."
    },
    {
      "number": 62,
      "text": "Bu mu daha iyi bir duraktır, yoksa zakkum ağacı mı?"
    },
    {
      "number": 63,
      "text": "Biz onu zalimler için bir test kıldık."
    },
    {
      "number": 64,
      "text": "O, cehennemin dibinden çıkan bir ağaçtır."
    },
    {
      "number": 65,
      "text": "Tomurcukları şeytanların başı gibidir."
    },
    {
      "number": 66,
      "text": "Onlar ondan yiyerek karınlarını doyuracaklar."
    },
    {
      "number": 67,
      "text": "Bunun üstüne onlar için cehennemi bir kokteyl vardır."
    },
    {
      "number": 68,
      "text": "Sonra dönüşleri yine cehennemedir."
    },
    {
      "number": 69,
      "text": "Onlar, atalarını sapık kimseler olarak bulmuşlardı."
    },
    {
      "number": 70,
      "text": "Ve onların izlerini körükörüne izliyorlardı."
    },
    {
      "number": 71,
      "text": "Kendilerinden önce de niceleri aynı şekilde sapmıştı."
    },
    {
      "number": 72,
      "text": "İçlerinden uyarıcılar göndermiştik."
    },
    {
      "number": 73,
      "text": "Uyarılanların sonunun nasıl olduğuna bir bak."
    },
    {
      "number": 74,
      "text": "Kendilerini sadece ALLAH'a adayan kulları hariç."
    },
    {
      "number": 75,
      "text": "Nuh bize seslenmişti de ne güzel karşılık vermiştik."
    },
    {
      "number": 76,
      "text": "Onu ve ailesini o büyük felaketten kurtarmıştık."
    },
    {
      "number": 77,
      "text": "Onun soyunu ise yaşattık."
    },
    {
      "number": 78,
      "text": "Ve biz onu daha sonrakiler için bıraktık."
    },
    {
      "number": 79,
      "text": "Tarih boyunca Nuh'a selam."
    },
    {
      "number": 80,
      "text": "Biz güzel davrananları işte böyle ödüllendiririz."
    },
    {
      "number": 81,
      "text": "O, bizim inanan kullarımızdandı."
    },
    {
      "number": 82,
      "text": "Sonra diğerlerini boğduk."
    },
    {
      "number": 83,
      "text": "İbrahim onun bir kolundan idi."
    },
    {
      "number": 84,
      "text": "Rabbine tertemiz bir kalp ile gelmişti."
    },
    {
      "number": 85,
      "text": "Babasına ve halkına, \"Neye tapıyorsunuz?\" demişti."
    },
    {
      "number": 86,
      "text": "\"ALLAH'ın dışında, uyduruk tanrılar mı istiyorsunuz?\""
    },
    {
      "number": 87,
      "text": "\"Evrenlerin Rabbini ne zannediyorsunuz?\""
    },
    {
      "number": 88,
      "text": "Yıldızlara bir göz attı."
    },
    {
      "number": 89,
      "text": "\"Bıktım, yoruldum artık,\" dedi."
    },
    {
      "number": 90,
      "text": "Onlar da onu bırakıp gittiler."
    },
    {
      "number": 91,
      "text": "Sonra, tanrılarına yöneldi ve \"Yemez misiniz?\" dedi."
    },
    {
      "number": 92,
      "text": "\"Neyiniz var, neden konuşmuyorsunuz?\""
    },
    {
      "number": 93,
      "text": "Ve üzerlerine yürüyüp tüm gücüyle vurdu."
    },
    {
      "number": 94,
      "text": "Hemen ona doğru koşuştular"
    },
    {
      "number": 95,
      "text": "Dedi ki, \"Yonttuğunuz şeylere mi tapıyorsunuz?\"."
    },
    {
      "number": 96,
      "text": "\"ALLAH, sizi de ve yaptığınız şeyleri de yaratandır.\""
    },
    {
      "number": 97,
      "text": "Dediler ki, \"Onun için bir yapı kurun ve onu ateşe atın.\""
    },
    {
      "number": 98,
      "text": "Onun için bir plan düşündüler, fakat biz onları altettik."
    },
    {
      "number": 99,
      "text": "Dedi ki, \"Ben Rabbime gidiyorum; O bana yol gösterir.\""
    },
    {
      "number": 100,
      "text": "\"Rabbim, bana erdemli birini bağışla.\""
    },
    {
      "number": 101,
      "text": "Biz de ona yumuşak huylu bir erkek çocuk bağışladık."
    },
    {
      "number": 102,
      "text": "Onunla birlikte çalışma çağına varınca, \"Oğlum,\" dedi, \"Rüyamda seni boğazlamam gerektiğini görüyorum. Ne düşünüyorsun?\" \"Babacığım,\" dedi, \"Sana emredileni uygula. ALLAH dilerse beni sabırlı bulacaksın.\""
    },
    {
      "number": 103,
      "text": "Böylece ikisi de teslim oldu ve onu alnı üzerine yıktı."
    },
    {
      "number": 104,
      "text": "Kendisine, \"İbrahim!\" diye seslendik,"
    },
    {
      "number": 105,
      "text": "\"Sen rüyanı uyguladın.\" İyileri böyle ödüllendiririz."
    },
    {
      "number": 106,
      "text": "Gerçekten bu apaçık bir sınavdı."
    },
    {
      "number": 107,
      "text": "Ve biz ona fidye olarak büyük bir kurban verdik."
    },
    {
      "number": 108,
      "text": "Sonrakiler için onun tarihini koruduk."
    },
    {
      "number": 109,
      "text": "İbrahim'e selam olsun."
    },
    {
      "number": 110,
      "text": "Biz iyi davrananları böyle ödüllendiririz."
    },
    {
      "number": 111,
      "text": "O, bizim inanan kullarımızdandı."
    },
    {
      "number": 112,
      "text": "Ona İshak'ı müjdeledik, erdemlilerden bir peygamber olarak."
    },
    {
      "number": 113,
      "text": "Ona da İshak'a da lütufta bulunduk. Kuşkusuz, ikisinin de soyundan hem iyi davrananlar var, hem kendisine zulmedenler."
    },
    {
      "number": 114,
      "text": "Biz Musa'ya ve Harun'a iyilikte bulunmuştuk."
    },
    {
      "number": 115,
      "text": "İkisini ve halklarını o büyük felaketten kurtardık."
    },
    {
      "number": 116,
      "text": "Onlara yardım ettik de üstün geldiler."
    },
    {
      "number": 117,
      "text": "Ve o ikisine apaçık anlaşılan kitabı verdik."
    },
    {
      "number": 118,
      "text": "Her ikisini doğru yola ilettik."
    },
    {
      "number": 119,
      "text": "O ikisinin tarihini sonrakiler için koruduk."
    },
    {
      "number": 120,
      "text": "Musa'ya ve Harun'a selam (barış) olsun."
    },
    {
      "number": 121,
      "text": "Biz, iyi davrananları işte böyle ödüllendiririz."
    },
    {
      "number": 122,
      "text": "O ikisi bizim inanan kullarımızdandı."
    },
    {
      "number": 123,
      "text": "İlyas elçilerden biriydi."
    },
    {
      "number": 124,
      "text": "Halkına, \"Erdemli olmayacak mısınız?\" dedi."
    },
    {
      "number": 125,
      "text": "En güzel Yaratanı bırakıp Ba'le mi taparsınız?"
    },
    {
      "number": 126,
      "text": "ALLAH sizin ve geçmişteki atalarınızın Rabbidir."
    },
    {
      "number": 127,
      "text": "Onu yalanladılar; onlar hesaba çekileceklerdir."
    },
    {
      "number": 128,
      "text": "Kendilerini sadece ALLAH'a adayan kulları hariç."
    },
    {
      "number": 129,
      "text": "Sonrakiler için onun tarihini koruduk."
    },
    {
      "number": 130,
      "text": "İlyasin'e salam olsun."
    },
    {
      "number": 131,
      "text": "İyi davrananları biz böyle ödüllendiririz."
    },
    {
      "number": 132,
      "text": "O bizim inanan kullarımızdandı."
    },
    {
      "number": 133,
      "text": "Lut da elçilerden biriydi."
    },
    {
      "number": 134,
      "text": "Onu ve ailesini topluca kurtardık."
    },
    {
      "number": 135,
      "text": "Ancak geride kalan yaşlı kadın hariç."
    },
    {
      "number": 136,
      "text": "Sonra diğerlerini yok ettik."
    },
    {
      "number": 137,
      "text": "Siz yıkıntılarının yanından geçiyorsunuz; sabahleyin,"
    },
    {
      "number": 138,
      "text": "Ve geceleyin. Aklınızı kullanmaz mısınız?"
    },
    {
      "number": 139,
      "text": "Yunus da elçilerden biriydi."
    },
    {
      "number": 140,
      "text": "Dolu bir gemiye kaçmıştı."
    },
    {
      "number": 141,
      "text": "Karşı çıktı ve kayanlardan oldu."
    },
    {
      "number": 142,
      "text": "Balık onu yuttu, bundan o sorumluydu."
    },
    {
      "number": 143,
      "text": "(Tanrı'yı) anıp düşünmeseydi,"
    },
    {
      "number": 144,
      "text": "Diriliş Gününe kadar onun karnında kalacaktı."
    },
    {
      "number": 145,
      "text": "Onu çöl gibi bir sahile attık, yorgun ve bitkin..."
    },
    {
      "number": 146,
      "text": "Ve onun için orada geniş yapraklı ağaç yetiştirdik."
    },
    {
      "number": 147,
      "text": "Biz onu yüzbin veya daha çok kişiye gönderdik."
    },
    {
      "number": 148,
      "text": "İnandılar, biz de onları bir süreye kadar geçindirdik."
    },
    {
      "number": 149,
      "text": "Sor onlara, kızları senin Rabbine, erkekleri kendilerine mi ayırıyorlar?\""
    },
    {
      "number": 150,
      "text": "Yoksa melekleri, onların gözü önünde dişi olarak mı yarattık?"
    },
    {
      "number": 151,
      "text": "Aslında onlar uydurdukları yüzünden diyorlar ki:"
    },
    {
      "number": 152,
      "text": "\"ALLAH doğurdu.\" Onlar yalancıdırlar."
    },
    {
      "number": 153,
      "text": "Kızları erkeklere mi tercih etti?"
    },
    {
      "number": 154,
      "text": "Size ne oldu, nasıl karar veriyorsunuz?"
    },
    {
      "number": 155,
      "text": "Öğüt almaz mısınız?"
    },
    {
      "number": 156,
      "text": "Yoksa apaçık bir delile mi sahipsiniz?"
    },
    {
      "number": 157,
      "text": "Doğruysanız kitabınızı getirin."
    },
    {
      "number": 158,
      "text": "Hatta O'nunla cinler arasında bir akrabalık uydurdular. Halbuki cinler sorguya çekileceklerini bilirler."
    },
    {
      "number": 159,
      "text": "ALLAH onları yakıştırmalarından çok Yücedir."
    },
    {
      "number": 160,
      "text": "Kendilerini sadece ALLAH'a adayan kulları hariç."
    },
    {
      "number": 161,
      "text": "Siz ve tapmakta olduklarınız,"
    },
    {
      "number": 162,
      "text": "O'na karşı kimseyi saptıramazsınız."
    },
    {
      "number": 163,
      "text": "Ancak cehennemde yanacaklar hariç."
    },
    {
      "number": 164,
      "text": "Her birimizin belli bir görevi vardır."
    },
    {
      "number": 165,
      "text": "Biz, dizenleriz,"
    },
    {
      "number": 166,
      "text": "Biz, anıp yüceltenleriz."
    },
    {
      "number": 167,
      "text": "Diyorlardı ki,"
    },
    {
      "number": 168,
      "text": "\"Yanımızda öncekilerden bir uyarı bulunsaydı,\""
    },
    {
      "number": 169,
      "text": "\"Kendimizi ALLAH'a adar, sadece O'na kul olurduk.\""
    },
    {
      "number": 170,
      "text": "Böylece onu inkar ettiler; ileride bilecekler."
    },
    {
      "number": 171,
      "text": "Elçilikle görevli kullarımız için söz verilmiştir."
    },
    {
      "number": 172,
      "text": "Onlar elbette zafere ulaşacaklar."
    },
    {
      "number": 173,
      "text": "Bizim ordumuz kesinlikle üstün gelecektir."
    },
    {
      "number": 174,
      "text": "Öyleyse bir süre için onlara aldırış etme."
    },
    {
      "number": 175,
      "text": "Onları seyret; onlar da görecekler."
    },
    {
      "number": 176,
      "text": "Azabımıza mı meydan okuyorlar?"
    },
    {
      "number": 177,
      "text": "Yurtlarına inince uyarılanların sabahı ne kötü olur!"
    },
    {
      "number": 178,
      "text": "Bir süreye kadar onlara aldırış etme."
    },
    {
      "number": 179,
      "text": "Onları gözle; onlar da görecekler."
    },
    {
      "number": 180,
      "text": "Üstünlük ve onurun sahibi olan Rabbin, onların nitelemelerinden çok yücedir."
    },
    {
      "number": 181,
      "text": "Gönderilmiş elçilere selam olsun."
    },
    {
      "number": 182,
      "text": "Evrenlerin Rabbi olan ALLAH'a övgüler olsun."
    }
  ]
}