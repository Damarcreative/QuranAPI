{
  "surah": 85,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь небом с созвездиями!"
    },
    {
      "number": 2,
      "text": "И клянусь обещанным днем!"
    },
    {
      "number": 3,
      "text": "И клянусь свидетельствующим и засвидетельствованным!"
    },
    {
      "number": 4,
      "text": "Прокляты хозяева рва!"
    },
    {
      "number": 5,
      "text": "[Хозяева] Огня пылающего."
    },
    {
      "number": 6,
      "text": "И они сидели возле него,"
    },
    {
      "number": 7,
      "text": "Наблюдая за тем, как поступают с верующими."
    },
    {
      "number": 8,
      "text": "И они мстили им только за то, что те уверовали в Аллаха Достойного, Хвалимого."
    },
    {
      "number": 9,
      "text": "Ему принадлежит власть над небесами и землей. И Аллах – Свидетель всему!"
    },
    {
      "number": 10,
      "text": "Поистине, кто подвергал мучениям верующих мужчин и женщин и не покаялся, тем [уготованы] адские муки, муки обжигающего огня."
    },
    {
      "number": 11,
      "text": "Поистине, кто уверовал и совершал благие поступки, тем – [райские] сады, под которыми текут реки. Это – великий успех!"
    },
    {
      "number": 12,
      "text": "Поистине, кара твоего Господа страшна!"
    },
    {
      "number": 13,
      "text": "Поистине, Он творит и возвращает."
    },
    {
      "number": 14,
      "text": "Он – Прощающий, Любящий."
    },
    {
      "number": 15,
      "text": "Владыка Арша [Трона], Славный."
    },
    {
      "number": 16,
      "text": "Он совершает все, что пожелает."
    },
    {
      "number": 17,
      "text": "Дошел ли до тебя рассказ о войске"
    },
    {
      "number": 18,
      "text": "Фараона и самудянах?"
    },
    {
      "number": 19,
      "text": "Но неверующие считают это ложью."
    },
    {
      "number": 20,
      "text": "Аллах же [Своим Знанием и Могуществом] охватывает их."
    },
    {
      "number": 21,
      "text": "Это – славный Куръан"
    },
    {
      "number": 22,
      "text": "в Хранимой книге."
    }
  ]
}