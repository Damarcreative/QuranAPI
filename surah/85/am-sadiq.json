{
  "surah": 85,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "የቡርጆች ባለቤት በኾነችው ሰማይ እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "በተቀጠረው ቀንም፤"
    },
    {
      "number": 3,
      "text": "በተጣጅና በሚጣዱትም፤ (እምላለሁ)፡፡"
    },
    {
      "number": 4,
      "text": "የጉድቡ ባለቤቶች ተረገሙ፡፡"
    },
    {
      "number": 5,
      "text": "የማገዶ ባለቤት የኾነቺው እሳት (ባለቤቶች)፡፡"
    },
    {
      "number": 6,
      "text": "እነርሱ በርሷ (አፋፍ) ላይ ተቀማጮች በኾኑ ጊዜ፤ (ተረገሙ)፡፡"
    },
    {
      "number": 7,
      "text": "እነርሱም በምእምናኖቹ በሚሠሩት (ማሰቃየት) ላይ መስካሪዎች ናቸው፡፡"
    },
    {
      "number": 8,
      "text": "ከእነርሱም በአላህ አሸናፊው፣ ምስጉኑ በኾነው (ጌታ) ማመናቸውን እንጅ ሌላ ምንም አልጠሉም፡፡"
    },
    {
      "number": 9,
      "text": "በእዚያ የሰማያትና የምድር ንግሥና ለእርሱ ብቻ በኾነው (አላህ ማመናቸውን)፡፡ አላህም በነገሩ ሁሉ ላይ መስካሪ ነው፡፡"
    },
    {
      "number": 10,
      "text": "እነዚያ ምእምንንና ምእምናትን ያሰቃዩ፣ ከዚያም ያልተጸጸቱ ለእነርሱ የገሀነም ቅጣት አልላቸው፡፡ ለእነርሱም የመቃጠሉ ስቃይ አልላቸው፡፡"
    },
    {
      "number": 11,
      "text": "እነዚያ ያመኑና መልካም ሥራዎችንም የሠሩ ለእነርሱ ከሥሮቻቸው ወንዞች የሚፈሱባቸው ገነቶች አሏቸው፡፡ ይህ ታላቅ ማግኘት ነው፡፡"
    },
    {
      "number": 12,
      "text": "የጌታህ በኀይል መያዝ ብርቱ ነው፡፡"
    },
    {
      "number": 13,
      "text": "እነሆ እርሱ መፍጠርን ይጀምራል፤ ይመልሳልም፡፡"
    },
    {
      "number": 14,
      "text": "እርሱም ምሕረተ ብዙ ወዳድ ነው፡፡"
    },
    {
      "number": 15,
      "text": "የዙፋኑ ባለቤት የላቀው ነው፡፡"
    },
    {
      "number": 16,
      "text": "የሚሻውን ሁሉ ሠሪ ነው፡፡"
    },
    {
      "number": 17,
      "text": "የሰራዊቶቹ ወሬ መጣልህን?"
    },
    {
      "number": 18,
      "text": "የፈርዖንና የሰሙድ፤ (ወሬ)፡፡"
    },
    {
      "number": 19,
      "text": "በእውነቱ እነዚያ የካዱት በማስተባበል ውስጥ ናቸው፡፡"
    },
    {
      "number": 20,
      "text": "አላህም በዙሪያቸው (በዕውቀቱ) ከባቢ ነው፡፡"
    },
    {
      "number": 21,
      "text": "ይልቁንም እርሱ የከበረ ቁርኣን ነው፡፡"
    },
    {
      "number": 22,
      "text": "የተጠበቀ በኾነ ሰሌዳ ውስጥ ነው፡፡"
    }
  ]
}