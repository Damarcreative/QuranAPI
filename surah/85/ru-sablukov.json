{
  "surah": 85,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Клянусь небом, украшенным созвездиями зодиака,"
    },
    {
      "number": 2,
      "text": "И днем предвозвещенным;"
    },
    {
      "number": 3,
      "text": "Клянусь свидетельствующим, и тем, о чем они свидетельствуют:"
    },
    {
      "number": 4,
      "text": "Гибель ископавшим ров,"
    },
    {
      "number": 5,
      "text": "Разжигавшим в нем огонь, поддерживавшим его растопкою!"
    },
    {
      "number": 6,
      "text": "Вот, они сидели при нем,"
    },
    {
      "number": 7,
      "text": "И сами были свидетелями тому, что делали верующим."
    },
    {
      "number": 8,
      "text": "Они мучили их только за то, что веровали они в Бога, сильного, славного,"
    },
    {
      "number": 9,
      "text": "В Того, у кого власть над небесами и землею: Бог свидетель всему."
    },
    {
      "number": 10,
      "text": "Тем, от кого подвергаются мучению верующие и верующия, и которые после того не покаются, - тем мука гееннская, тем мука в пламени горящем."
    },
    {
      "number": 11,
      "text": "А которые уверовали и делают доброе, тем сады райские, по которым текут реки. Это - великое блаженство!"
    },
    {
      "number": 12,
      "text": "Сила Господа твоего крепка:"
    },
    {
      "number": 13,
      "text": "Он производит и уничтожает;"
    },
    {
      "number": 14,
      "text": "Он, прощающий, любящий,"
    },
    {
      "number": 15,
      "text": "Владыка престола, славный,"
    },
    {
      "number": 16,
      "text": "Есть совершитель того, что захочет."
    },
    {
      "number": 17,
      "text": "Разве не доходил до тебя рассказ об этих войсках,"
    },
    {
      "number": 18,
      "text": "О Фараоне, о Фемудянах?"
    },
    {
      "number": 19,
      "text": "Но неверные в ложной вере."
    },
    {
      "number": 20,
      "text": "Бог отовсюду окружает их."
    },
    {
      "number": 21,
      "text": "Это учение есть славный Коран,"
    },
    {
      "number": 22,
      "text": "На хранимой скрижали."
    }
  ]
}