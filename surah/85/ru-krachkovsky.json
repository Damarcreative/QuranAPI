{
  "surah": 85,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь небом - обладателем башен,"
    },
    {
      "number": 2,
      "text": "и днем обещанным,"
    },
    {
      "number": 3,
      "text": "и свидетелем, и тем, о ком он свидетельствует!"
    },
    {
      "number": 4,
      "text": "Убиты будут владетели рва,"
    },
    {
      "number": 5,
      "text": "огня, обладающего искрами."
    },
    {
      "number": 6,
      "text": "Вот они сидят над ним"
    },
    {
      "number": 7,
      "text": "и созерцают то, что творят с верующими."
    },
    {
      "number": 8,
      "text": "И вымещали они им только за то, что они уверовали в Аллаха великого, достохвального,"
    },
    {
      "number": 9,
      "text": "которому принадлежит власть над небесами и землей. И Аллах о каждой вещи свидетель!"
    },
    {
      "number": 10,
      "text": "Ведь те, которые испытывали верующих мужчин и женщин, а потом не покаялись, - им ведь наказание геенны, им наказание огня."
    },
    {
      "number": 11,
      "text": "Ведь те, которые уверовали и творили добрые дела, им - сады, под которыми текут реки; это - великая прибыль!"
    },
    {
      "number": 12,
      "text": "Поистине, мощь твоего Господа сильна!"
    },
    {
      "number": 13,
      "text": "Ведь Он начинает и возвращает."
    },
    {
      "number": 14,
      "text": "И Он - прощающ и любвеобилен,"
    },
    {
      "number": 15,
      "text": "владыка трона, славный,"
    },
    {
      "number": 16,
      "text": "совершитель того, что пожелает."
    },
    {
      "number": 17,
      "text": "Дошел ли до тебя рассказ о войсках,"
    },
    {
      "number": 18,
      "text": "о Фирауне и самудянах?"
    },
    {
      "number": 19,
      "text": "Нет! Те, которые не веруют, - во лжи,"
    },
    {
      "number": 20,
      "text": "а Аллах окружает их сзади!"
    },
    {
      "number": 21,
      "text": "Да, это - Коран славный"
    },
    {
      "number": 22,
      "text": "в скрижали хранимой!"
    }
  ]
}