{
  "surah": 85,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Wa<b>al</b>ssam<u>a</u>i <u>tha</u>ti alburooj<b>i</b>"
    },
    {
      "number": 2,
      "text": "Wa<b>a</b>lyawmi almawAAood<b>i</b>"
    },
    {
      "number": 3,
      "text": "Wash<u>a</u>hidin wamashhood<b>in</b>"
    },
    {
      "number": 4,
      "text": "Qutila a<u>s</u><u>ha</u>bu alukhdood<b>i</b>"
    },
    {
      "number": 5,
      "text": "A<b>l</b>nn<u>a</u>ri <u>tha</u>ti alwaqood<b>i</b>"
    },
    {
      "number": 6,
      "text": "I<u>th</u> hum AAalayh<u>a</u> quAAood<b>un</b>"
    },
    {
      "number": 7,
      "text": "Wahum AAal<u>a</u> m<u>a</u> yafAAaloona bi<b>a</b>lmumineena shuhood<b>un</b>"
    },
    {
      "number": 8,
      "text": "Wam<u>a</u> naqamoo minhum ill<u>a</u> an yuminoo bi<b>A</b>ll<u>a</u>hi alAAazeezi al<u>h</u>ameed<b>i</b>"
    },
    {
      "number": 9,
      "text": "Alla<u>th</u>ee lahu mulku a<b>l</b>ssam<u>a</u>w<u>a</u>ti wa<b>a</b>lar<u>d</u>i wa<b>A</b>ll<u>a</u>hu AAal<u>a</u> kulli shayin shaheed<b>un</b>"
    },
    {
      "number": 10,
      "text": "Inna alla<u>th</u>eena fatanoo almumineena wa<b>a</b>lmumin<u>a</u>ti thumma lam yatooboo falahum AAa<u>tha</u>bu jahannama walahum AAa<u>tha</u>bu al<u>h</u>areeq<b>i</b>"
    },
    {
      "number": 11,
      "text": "Inna alla<u>th</u>eena <u>a</u>manoo waAAamiloo a<b>l</b><u>ssa</u>li<u>ha</u>ti lahum jann<u>a</u>tun tajree min ta<u>h</u>tih<u>a</u> alanh<u>a</u>ru <u>tha</u>lika alfawzu alkabeer<b>u</b>"
    },
    {
      "number": 12,
      "text": "Inna ba<u>t</u>sha rabbika lashadeed<b>un</b>"
    },
    {
      "number": 13,
      "text": "Innahu huwa yubdio wayuAAeed<b>u</b>"
    },
    {
      "number": 14,
      "text": "Wahuwa alghafooru alwadood<b>u</b>"
    },
    {
      "number": 15,
      "text": "<u>Th</u>oo alAAarshi almajeed<b>i</b>"
    },
    {
      "number": 16,
      "text": "FaAAAA<u>a</u>lun lim<u>a</u> yureed<b>u</b>"
    },
    {
      "number": 17,
      "text": "Hal at<u>a</u>ka <u>h</u>adeethu aljunood<b>i</b>"
    },
    {
      "number": 18,
      "text": "FirAAawna wathamood<b>a</b>"
    },
    {
      "number": 19,
      "text": "Bali alla<u>th</u>eena kafaroo fee tak<u>th</u>eeb<b>in</b>"
    },
    {
      "number": 20,
      "text": "Wa<b>A</b>ll<u>a</u>hu min war<u>a</u>ihim mu<u>h</u>ee<u>t</u><b>un</b>"
    },
    {
      "number": 21,
      "text": "Bal huwa qur<u>a</u>nun majeed<b>un</b>"
    },
    {
      "number": 22,
      "text": "Fee law<u>h</u>in ma<u>h</u>foo<i><u>th</u></i><b>in</b>"
    }
  ]
}