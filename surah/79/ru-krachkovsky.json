{
  "surah": 79,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь вырывающими с силой,"
    },
    {
      "number": 2,
      "text": "извлекающими стремительно,"
    },
    {
      "number": 3,
      "text": "плавающими плавно,"
    },
    {
      "number": 4,
      "text": "опережающими быстро"
    },
    {
      "number": 5,
      "text": "и распространяющими приказ!"
    },
    {
      "number": 6,
      "text": "В тот день, когда задрожит дрожащая"
    },
    {
      "number": 7,
      "text": "и последует за ней следующая,"
    },
    {
      "number": 8,
      "text": "сердца в тот день - трепещущие,"
    },
    {
      "number": 9,
      "text": "взоры - смиренные."
    },
    {
      "number": 10,
      "text": "Говорят они: \"Неужели же мы возвращаемся в прежнее!"
    },
    {
      "number": 11,
      "text": "Разве тогда, как мы были костями истлевшими?\""
    },
    {
      "number": 12,
      "text": "Скажут они: \"Это, значит, - возврат невыгодный!\""
    },
    {
      "number": 13,
      "text": "И вот только одно сотрясение -"
    },
    {
      "number": 14,
      "text": "и вот они - навечно бодрствующие."
    },
    {
      "number": 15,
      "text": "Дошел ли до тебя рассказ о Мусе?"
    },
    {
      "number": 16,
      "text": "Вот воззвал к нему его Господь в долине священной Тува:"
    },
    {
      "number": 17,
      "text": "\"Иди к Фирауну, он ведь уклонился,"
    },
    {
      "number": 18,
      "text": "и скажи ему: \"Не следует ли тебе очиститься?"
    },
    {
      "number": 19,
      "text": "И я поведу тебя к твоему Господу, и ты будешь богобоязнен\"\"."
    },
    {
      "number": 20,
      "text": "И показал он ему знамение величайшее,"
    },
    {
      "number": 21,
      "text": "но тот счел это ложью и ослушался,"
    },
    {
      "number": 22,
      "text": "а потом отвернулся, усердствуя."
    },
    {
      "number": 23,
      "text": "И собрал, и возгласил,"
    },
    {
      "number": 24,
      "text": "и сказал: \"Я - Господь ваш высочайший!\""
    },
    {
      "number": 25,
      "text": "И взял его Аллах наказанием жизни последней и первой."
    },
    {
      "number": 26,
      "text": "Поистине, в этом - наставление для тех, кто богобоязнен!"
    },
    {
      "number": 27,
      "text": "Вы ли труднее для создания или небо? Он его построил,"
    },
    {
      "number": 28,
      "text": "воздвиг свод его и устроил,"
    },
    {
      "number": 29,
      "text": "омрачил ночь его и вывел зарю,"
    },
    {
      "number": 30,
      "text": "и землю после этого распростер,"
    },
    {
      "number": 31,
      "text": "вывел из нее ее воду и пастбище,"
    },
    {
      "number": 32,
      "text": "и горы - Он утвердил их,"
    },
    {
      "number": 33,
      "text": "на пользу вам и вашим скотам."
    },
    {
      "number": 34,
      "text": "И когда придет величайшее переполнение, -"
    },
    {
      "number": 35,
      "text": "день, когда человек вспомнит, в чем он труждался,"
    },
    {
      "number": 36,
      "text": "и показана будет геенна тем, кто увидит."
    },
    {
      "number": 37,
      "text": "И тот, кто уклонялся"
    },
    {
      "number": 38,
      "text": "и предпочел жизнь ближнюю,"
    },
    {
      "number": 39,
      "text": "то, поистине, геенна, это - прибежище."
    },
    {
      "number": 40,
      "text": "А кто боялся пребывания Господа своего и удерживал душу от страсти,"
    },
    {
      "number": 41,
      "text": "то, поистине, рай, это - прибежище."
    },
    {
      "number": 42,
      "text": "Спрашивают они тебя о часе: \"Когда его прибытие?\""
    },
    {
      "number": 43,
      "text": "К чему тебе упоминать это?"
    },
    {
      "number": 44,
      "text": "К твоему Господу конечный предел его."
    },
    {
      "number": 45,
      "text": "Ты ведь - только увещатель для тех, кто Его боится."
    },
    {
      "number": 46,
      "text": "Они в тот день, как увидят Его, как будто бы пробыли только один вечер или утро."
    }
  ]
}