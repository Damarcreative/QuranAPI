{
  "surah": 79,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Wa<b>al</b>nn<u>a</u>ziAA<u>a</u>ti gharq<u>a</u><b>n</b>"
    },
    {
      "number": 2,
      "text": "Wa<b>al</b>nn<u>a</u>shi<u>ta</u>ti nash<u>ta</u><b>n</b>"
    },
    {
      "number": 3,
      "text": "Wa<b>al</b>ss<u>a</u>bi<u>ha</u>ti sab<u>ha</u><b>n</b>"
    },
    {
      "number": 4,
      "text": "Fa<b>al</b>ss<u>a</u>biq<u>a</u>ti sabq<u>a</u><b>n</b>"
    },
    {
      "number": 5,
      "text": "Fa<b>a</b>lmudabbir<u>a</u>ti amr<u>a</u><b>n</b>"
    },
    {
      "number": 6,
      "text": "Yawma tarjufu a<b>l</b>rr<u>a</u>jifa<b>tu</b>"
    },
    {
      "number": 7,
      "text": "TatbaAAuh<u>a</u> a<b>l</b>rr<u>a</u>difa<b>tu</b>"
    },
    {
      "number": 8,
      "text": "Quloobun yawmai<u>th</u>in w<u>a</u>jifa<b>tun</b>"
    },
    {
      "number": 9,
      "text": "Ab<u>sa</u>ruh<u>a</u> kh<u>a</u>shiAAa<b>tun</b>"
    },
    {
      "number": 10,
      "text": "Yaqooloona ainn<u>a</u> lamardoodoona fee al<u>ha</u>fira<b>ti</b>"
    },
    {
      "number": 11,
      "text": "Ai<u>tha</u> kunn<u>a</u> AAi<i><u>th</u></i><u>a</u>man nakhira<b>tan</b>"
    },
    {
      "number": 12,
      "text": "Q<u>a</u>loo tilka i<u>th</u>an karratun kh<u>a</u>sira<b>tun</b>"
    },
    {
      "number": 13,
      "text": "Fainnam<u>a</u> hiya zajratun w<u>ah</u>ida<b>tun</b>"
    },
    {
      "number": 14,
      "text": "Fai<u>tha</u> hum bi<b>al</b>ss<u>a</u>hira<b>ti</b>"
    },
    {
      "number": 15,
      "text": "Hal at<u>a</u>ka <u>h</u>adeethu moos<u>a</u>"
    },
    {
      "number": 16,
      "text": "I<u>th</u> n<u>a</u>d<u>a</u>hu rabbuhu bi<b>a</b>lw<u>a</u>di almuqaddasi <u>t</u>uw<u>a</u><b>n</b>"
    },
    {
      "number": 17,
      "text": "I<u>th</u>hab il<u>a</u> firAAawna innahu <u>t</u>agh<u>a</u>"
    },
    {
      "number": 18,
      "text": "Faqul hal laka il<u>a</u> an tazakk<u>a</u>"
    },
    {
      "number": 19,
      "text": "Waahdiyaka il<u>a</u> rabbika fatakhsh<u>a</u>"
    },
    {
      "number": 20,
      "text": "Faar<u>a</u>hu al<u>a</u>yata alkubr<u>a</u>"
    },
    {
      "number": 21,
      "text": "Faka<u>thth</u>aba waAAa<u>sa</u>"
    },
    {
      "number": 22,
      "text": "Thumma adbara yasAA<u>a</u>"
    },
    {
      "number": 23,
      "text": "Fa<u>h</u>ashara fan<u>a</u>d<u>a</u>"
    },
    {
      "number": 24,
      "text": "Faq<u>a</u>la an<u>a</u> rabbukumu alaAAl<u>a</u>"
    },
    {
      "number": 25,
      "text": "Faakha<u>th</u>ahu All<u>a</u>hu nak<u>a</u>la al<u>a</u>khirati wa<b>a</b>lool<u>a</u>"
    },
    {
      "number": 26,
      "text": "Inna fee <u>tha</u>lika laAAibratan liman yakhsh<u>a</u>"
    },
    {
      "number": 27,
      "text": "Aantum ashaddu khalqan ami a<b>l</b>ssam<u>a</u>o ban<u>a</u>h<u>a</u>"
    },
    {
      "number": 28,
      "text": "RafaAAa samkah<u>a</u> fasaww<u>a</u>h<u>a</u>"
    },
    {
      "number": 29,
      "text": "Waagh<u>t</u>asha laylah<u>a</u> waakhraja <u>d</u>u<u>ha</u>h<u>a</u>"
    },
    {
      "number": 30,
      "text": "Wa<b>a</b>lar<u>d</u>a baAAda <u>tha</u>lika da<u>ha</u>h<u>a</u>"
    },
    {
      "number": 31,
      "text": "Akhraja minh<u>a</u> m<u>a</u>ah<u>a</u> wamarAA<u>a</u>h<u>a</u>"
    },
    {
      "number": 32,
      "text": "Wa<b>a</b>ljib<u>a</u>la ars<u>a</u>h<u>a</u>"
    },
    {
      "number": 33,
      "text": "Mat<u>a</u>AAan lakum walianAA<u>a</u>mikum"
    },
    {
      "number": 34,
      "text": "Fai<u>tha</u> j<u>a</u>ati a<b>l</b><u>tta</u>mmatu alkubr<u>a</u>"
    },
    {
      "number": 35,
      "text": "Yawma yata<u>th</u>akkaru alins<u>a</u>nu m<u>a</u> saAA<u>a</u>"
    },
    {
      "number": 36,
      "text": "Waburrizati alja<u>h</u>eemu liman yar<u>a</u>"
    },
    {
      "number": 37,
      "text": "Faamm<u>a</u> man <u>t</u>agh<u>a</u>"
    },
    {
      "number": 38,
      "text": "Wa<u>a</u>thara al<u>h</u>ay<u>a</u>ta a<b>l</b>dduny<u>a</u>"
    },
    {
      "number": 39,
      "text": "Fainna alja<u>h</u>eema hiya almaw<u>a</u>"
    },
    {
      "number": 40,
      "text": "Waam<u>a</u> man kh<u>a</u>fa maq<u>a</u>ma rabbihi wanah<u>a</u> a<b>l</b>nnafsa AAani alhaw<u>a</u>"
    },
    {
      "number": 41,
      "text": "Fainna aljannata hiya almaw<u>a</u>"
    },
    {
      "number": 42,
      "text": "Yasaloonaka AAani a<b>l</b>ss<u>a</u>AAati ayy<u>a</u>na murs<u>a</u>h<u>a</u>"
    },
    {
      "number": 43,
      "text": "Feema anta min <u>th</u>ikr<u>a</u>h<u>a</u>"
    },
    {
      "number": 44,
      "text": "Il<u>a</u> rabbika muntah<u>a</u>h<u>a</u>"
    },
    {
      "number": 45,
      "text": "Innam<u>a</u> anta mun<u>th</u>iru man yakhsh<u>a</u>h<u>a</u>"
    },
    {
      "number": 46,
      "text": "Kaannahum yawma yarawnah<u>a</u> lam yalbathoo ill<u>a</u> AAashiyyatan aw <u>d</u>u<u>ha</u>h<u>a</u>"
    }
  ]
}