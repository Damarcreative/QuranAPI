{
  "surah": 79,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በኃይል አውጪዎች በኾኑት፤"
    },
    {
      "number": 2,
      "text": "በቀስታ መምዘዝንም መዘዦች በኾኑት፤"
    },
    {
      "number": 3,
      "text": "መዋኘትም ዋኚዎች በኾኑት፤"
    },
    {
      "number": 4,
      "text": "መቅደምንም ቀዳሚዎች በኾኑት፤"
    },
    {
      "number": 5,
      "text": "ነገርንም አስተናባሪዎች በኾኑት (መላእክት) እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"
    },
    {
      "number": 6,
      "text": "ተርገፍጋፊይቱ (ምድር) በምትርገፈገፍበት ቀን፤"
    },
    {
      "number": 7,
      "text": "ለጣቂይቱ የምትከተላት ስትኾን (ትቀሰቀሳላችሁ)፡፡"
    },
    {
      "number": 8,
      "text": "በዚያ ቀን ልቦች ተሸባሪዎች ናቸው፡፡"
    },
    {
      "number": 9,
      "text": "ዓይኖቻቸው ተዋራጆች (አቀርቃሪዎች) ናቸው፡፡"
    },
    {
      "number": 10,
      "text": "«እኛ ወደ መጀመሪያይቱ ኹነታ ተመላሾች ነን?» ይላሉ፡፡"
    },
    {
      "number": 11,
      "text": "«የበሰበሱ አጥንቶች በኾን ጊዜ (እንቀሰቀሳለን?)»"
    },
    {
      "number": 12,
      "text": "«ይህቺ ያን ጊዜ ባለ ከሳራ መመለስ ናት» ይላሉ፡፡"
    },
    {
      "number": 13,
      "text": "እርሷም አንዲት ጩኸት ብቻ ናት፡፡"
    },
    {
      "number": 14,
      "text": "ወዲያውኑም እነርሱ እንቅልፍ በሌለባት (ምድር) ላይ ይኾናሉ፡፡"
    },
    {
      "number": 15,
      "text": "የሙሳ ወሬ መጣልህን?"
    },
    {
      "number": 16,
      "text": "ጌታው በተቀደሰው ሸለቆ በጡዋ በጠራው ጊዜ፤"
    },
    {
      "number": 17,
      "text": "ወደ ፈርዖን ኺድ፡፡ እርሱ ወሰን አልፏልና፡፡"
    },
    {
      "number": 18,
      "text": "በለውም፡- «ወደ መጥራራትህ ላንተ (መንገድ) አለህን?»"
    },
    {
      "number": 19,
      "text": "«ወደ ጌታህም ልመራህ ትፈራውም ዘንድ፤ (መንገድ አለህን?)» አለው፡፡"
    },
    {
      "number": 20,
      "text": "ታላቂቱንም ተዓምር አሳየው፡፡"
    },
    {
      "number": 21,
      "text": "አስተባበለም፤ አመጸም፡፡"
    },
    {
      "number": 22,
      "text": "ከዚያም (ለማጥፋት) የሚተጋ ኾኖ ዞረ፡፡"
    },
    {
      "number": 23,
      "text": "(ሰራዊቶቹን) ሰበሰበም፤ ተጣራም፡፡"
    },
    {
      "number": 24,
      "text": "አለም፡- «እኔ ታላቁ ጌታችሁ ነኝ፡፡»"
    },
    {
      "number": 25,
      "text": "አላህም በኋለኛይቱና በፊተኛይቱ (ቃል) ቅጣት ያዘው፡፡"
    },
    {
      "number": 26,
      "text": "በዚህ ውስጥ ለሚፈራ ሰው በእርግጥ መገምገሚያ አለበት፡፡"
    },
    {
      "number": 27,
      "text": "ባፈጣጠር እናንተ ይበልጥ የበረታችሁ ናችሁን? ወይንስ ሰማይ? (አላህ) ገነባት፡፡"
    },
    {
      "number": 28,
      "text": "ከፍታዋን አጓነ፤ አስተካከላትም፡፡"
    },
    {
      "number": 29,
      "text": "ሌሊቷንም አጨለመ፡፡ ቀንዋንም ገለጸ፡፡"
    },
    {
      "number": 30,
      "text": "ምድርንም ከዚህ በኋላ ዘረጋት፡፡"
    },
    {
      "number": 31,
      "text": "ውሃዋንና ግጦሿን ከእርሷ አወጣ፡፡"
    },
    {
      "number": 32,
      "text": "ጋራዎችንም አደላደላቸው፡፡"
    },
    {
      "number": 33,
      "text": "ለእናንተና ለእንስሶቻችሁ መጣቀሚያ ይኾን ዘንድ (ይህን አደረገ)፡፡"
    },
    {
      "number": 34,
      "text": "ታላቂቱም መዐት በመጣች ጊዜ፣"
    },
    {
      "number": 35,
      "text": "ሰው ሁሉ የሠራውን በሚያስታውስበት ቀን፣"
    },
    {
      "number": 36,
      "text": "ገሀነምም ለሚያይ ሰው በተገለጠች ጊዜ፣"
    },
    {
      "number": 37,
      "text": "የካደ ሰውማ፣"
    },
    {
      "number": 38,
      "text": "ቅርቢቱንም ሕይወት የመረጠ፣"
    },
    {
      "number": 39,
      "text": "ገሀነም እርሷ በእርግጥ መኖሪያው ናት፡፡"
    },
    {
      "number": 40,
      "text": "በጌታው ፊት መቆምን የፈራ ሰውማ ነፍሱንም ከዝንባሌዋ የከለከለ"
    },
    {
      "number": 41,
      "text": "ገነት እርሷ በእርግጥ መኖሪያው ናት፡፡"
    },
    {
      "number": 42,
      "text": "«ከሰዓቲቱ መቼ ነው መኾኛዋ?» ሲሉ ይጠይቁሃል፡፡"
    },
    {
      "number": 43,
      "text": "አንተ እርሷን ከማስታወስ በምን ውስጥ ነህ?"
    },
    {
      "number": 44,
      "text": "(የዕውቀት) መጨረሻዋ ወደ ጌታህ ብቻ ነው፡፡"
    },
    {
      "number": 45,
      "text": "አንተ የሚፈራትን ሰው አስፈራሪ ብቻ ነህ፡፡"
    },
    {
      "number": 46,
      "text": "እነርሱ በሚያዩዋት ቀን ያንዲት ቀን ምሽትን ወይም ረፏዷን እንጅ ያልቆዩ ይመስላሉ፡፡"
    }
  ]
}