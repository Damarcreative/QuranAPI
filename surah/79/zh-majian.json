{
  "surah": 79,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "誓以急掣的，"
    },
    {
      "number": 2,
      "text": "輕曳的，"
    },
    {
      "number": 3,
      "text": "奔馳的，"
    },
    {
      "number": 4,
      "text": "先驅的，"
    },
    {
      "number": 5,
      "text": "決策的，"
    },
    {
      "number": 6,
      "text": "當震動者震動，"
    },
    {
      "number": 7,
      "text": "而續髮者續髮之日，"
    },
    {
      "number": 8,
      "text": "在那日，許多心將忐忑不安，"
    },
    {
      "number": 9,
      "text": "許多眼將不敢仰視。"
    },
    {
      "number": 10,
      "text": "他們說：「我們必定復元嗎？"
    },
    {
      "number": 11,
      "text": "那是在我們已變成朽骨的時候嗎？」"
    },
    {
      "number": 12,
      "text": "他們說：「然則，那是一次虧折的復原。」"
    },
    {
      "number": 13,
      "text": "那只是一次吼聲，"
    },
    {
      "number": 14,
      "text": "他們忽然在地面之上。"
    },
    {
      "number": 15,
      "text": "穆薩的故事已來臨你了嗎？"
    },
    {
      "number": 16,
      "text": "當時，他的主，曾在聖谷杜洼中召喚他說："
    },
    {
      "number": 17,
      "text": "「你到法老那裡去吧！他確是悖逆的。"
    },
    {
      "number": 18,
      "text": "你對他說：『你願意成為純潔的人嗎？"
    },
    {
      "number": 19,
      "text": "你願意我引導你認識你的主，而你畏懼他嗎？』」"
    },
    {
      "number": 20,
      "text": "他把那最大的跡象昭示了法老，"
    },
    {
      "number": 21,
      "text": "但他否認，而且違抗。"
    },
    {
      "number": 22,
      "text": "然後，他轉身而奔走。"
    },
    {
      "number": 23,
      "text": "於是，召集民眾，而且喊叫，"
    },
    {
      "number": 24,
      "text": "說：「我是你們的至尊的主。」"
    },
    {
      "number": 25,
      "text": "故真主以後世和今世的刑罰懲治他。"
    },
    {
      "number": 26,
      "text": "對於畏懼的人們，此中確有一種鑒戒。"
    },
    {
      "number": 27,
      "text": "你們是更難造的呢？還是天是更難造的呢？他曾建造了天，"
    },
    {
      "number": 28,
      "text": "他升起它的高度，而成全它的形體，"
    },
    {
      "number": 29,
      "text": "他使它的夜間黑暗，並顯出它的光明。"
    },
    {
      "number": 30,
      "text": "此後，他將地面展開，"
    },
    {
      "number": 31,
      "text": "他使地面涌出泉水來，生出植物來。"
    },
    {
      "number": 32,
      "text": "他使山巒穩定，"
    },
    {
      "number": 33,
      "text": "以便你們和你們的牲畜獲得享受。"
    },
    {
      "number": 34,
      "text": "大難來臨的時候，"
    },
    {
      "number": 35,
      "text": "就是人將記起自己所作的善惡，"
    },
    {
      "number": 36,
      "text": "火獄將為能見的人顯露出來的日子。"
    },
    {
      "number": 37,
      "text": "悖逆"
    },
    {
      "number": 38,
      "text": "而且選擇今世生活的人，"
    },
    {
      "number": 39,
      "text": "火獄必為他的歸宿。"
    },
    {
      "number": 40,
      "text": "至於怕站在主的御前受審問，並戒除私慾的人，"
    },
    {
      "number": 41,
      "text": "樂園必為他的歸宿。"
    },
    {
      "number": 42,
      "text": "他們問你復活時在什麼時候實現，"
    },
    {
      "number": 43,
      "text": "你怎能說明它呢？"
    },
    {
      "number": 44,
      "text": "惟有你的主能知它的究竟。"
    },
    {
      "number": 45,
      "text": "你的警告只有裨於畏懼它的人，"
    },
    {
      "number": 46,
      "text": "他們在見它的那日，好像在墳裡只逗留過一朝或一夕。"
    }
  ]
}