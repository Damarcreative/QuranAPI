{
  "surah": 92,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>a</b>llayli i<u>tha</u> yaghsh<u>a</u>"
    },
    {
      "number": 2,
      "text": "Wa<b>al</b>nnah<u>a</u>ri i<u>tha</u> tajall<u>a</u>"
    },
    {
      "number": 3,
      "text": "Wam<u>a</u> khalaqa a<b>l</b><u>thth</u>akara wa<b>a</b>lonth<u>a</u>"
    },
    {
      "number": 4,
      "text": "Inna saAAyakum lashatt<u>a</u>"
    },
    {
      "number": 5,
      "text": "Faamm<u>a</u> man aAA<u>ta</u> wa<b>i</b>ttaq<u>a</u>"
    },
    {
      "number": 6,
      "text": "Wa<u>s</u>addaqa bi<b>a</b>l<u>h</u>usn<u>a</u>"
    },
    {
      "number": 7,
      "text": "Fasanuyassiruhu lilyusr<u>a</u>"
    },
    {
      "number": 8,
      "text": "Waamm<u>a</u> man bakhila wa<b>i</b>staghn<u>a</u>"
    },
    {
      "number": 9,
      "text": "Waka<u>thth</u>aba bi<b>a</b>l<u>h</u>usn<u>a</u>"
    },
    {
      "number": 10,
      "text": "Fasanuyassiruhu lilAAusr<u>a</u>"
    },
    {
      "number": 11,
      "text": "Wam<u>a</u> yughnee AAanhu m<u>a</u>luhu i<u>tha</u> taradd<u>a</u>"
    },
    {
      "number": 12,
      "text": "Inna AAalayn<u>a</u> lalhud<u>a</u>"
    },
    {
      "number": 13,
      "text": "Wainna lan<u>a</u> lal<u>a</u>khirata wa<b>a</b>lool<u>a</u>"
    },
    {
      "number": 14,
      "text": "Faan<u>th</u>artukum n<u>a</u>ran tala<i><u>thth</u></i><u>a</u>"
    },
    {
      "number": 15,
      "text": "L<u>a</u> ya<u>s</u>l<u>a</u>h<u>a</u> ill<u>a</u> alashq<u>a</u>"
    },
    {
      "number": 16,
      "text": "Alla<u>th</u>ee ka<u>thth</u>aba watawall<u>a</u>"
    },
    {
      "number": 17,
      "text": "Wasayujannabuh<u>a</u> alatq<u>a</u>"
    },
    {
      "number": 18,
      "text": "Alla<u>th</u>ee yutee m<u>a</u>lahu yatazakk<u>a</u>"
    },
    {
      "number": 19,
      "text": "Wam<u>a</u> lia<u>h</u>adin AAindahu min niAAmatin tujz<u>a</u>"
    },
    {
      "number": 20,
      "text": "Ill<u>a</u> ibtigh<u>a</u>a wajhi rabbihi alaAAl<u>a</u>"
    },
    {
      "number": 21,
      "text": "Walasawfa yar<u>da</u>"
    }
  ]
}