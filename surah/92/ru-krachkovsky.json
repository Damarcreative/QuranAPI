{
  "surah": 92,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Клянусь ночью, когда она покрывает,"
    },
    {
      "number": 2,
      "text": "и днем, когда он засиял,"
    },
    {
      "number": 3,
      "text": "и тем, что создало мужчину и женщину, -"
    },
    {
      "number": 4,
      "text": "стремления ваши различны!"
    },
    {
      "number": 5,
      "text": "Но тот, кто давал и страшился,"
    },
    {
      "number": 6,
      "text": "и считал истиной прекраснейшее, -"
    },
    {
      "number": 7,
      "text": "тому Мы облегчим к легчайшему."
    },
    {
      "number": 8,
      "text": "А кто скупился и обогащался,"
    },
    {
      "number": 9,
      "text": "и считал ложью прекраснейшее, -"
    },
    {
      "number": 10,
      "text": "тому Мы облегчим к тягчайшему."
    },
    {
      "number": 11,
      "text": "И не спасет его достояние, когда низвергнется."
    },
    {
      "number": 12,
      "text": "Ведь на Нас лежит прямой путь."
    },
    {
      "number": 13,
      "text": "И ведь Нам принадлежит жизнь последняя и первая."
    },
    {
      "number": 14,
      "text": "И вот увещаю Я вас огнем, который пылает,"
    },
    {
      "number": 15,
      "text": "горит в нем только несчастнейший,"
    },
    {
      "number": 16,
      "text": "который счел ложью и отвернулся."
    },
    {
      "number": 17,
      "text": "Удален от него будет богобоязненный,"
    },
    {
      "number": 18,
      "text": "который приносит свое достояние, чтобы очиститься."
    },
    {
      "number": 19,
      "text": "И ни за кем нет у него милости, которая должна быть вознаграждена,"
    },
    {
      "number": 20,
      "text": "если не из стремления к лику Господа его высочайшего."
    },
    {
      "number": 21,
      "text": "И он будет доволен."
    }
  ]
}