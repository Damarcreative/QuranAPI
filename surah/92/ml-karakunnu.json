{
  "surah": 92,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "രാത്രി സാക്ഷി, അത് പ്രപഞ്ചത്തെ മൂടുമ്പോള്‍."
    },
    {
      "number": 2,
      "text": "പകല്‍ സാക്ഷി, അത് തെളിയുമ്പോള്‍."
    },
    {
      "number": 3,
      "text": "ആണിനെയും പെണ്ണിനെയും സൃഷ്ടിച്ചതു സാക്ഷി."
    },
    {
      "number": 4,
      "text": "തീര്‍ച്ചയായും നിങ്ങളുടെ പ്രവര്‍ത്തനം പലവിധമാണ്."
    },
    {
      "number": 5,
      "text": "അതിനാല്‍ ആര്‍ ദാനം നല്‍കുകയും ഭക്തനാവുകയും,"
    },
    {
      "number": 6,
      "text": "അത്യുത്തമമായതിനെ സത്യപ്പെടുത്തുകയും ചെയ്യുന്നുവോ."
    },
    {
      "number": 7,
      "text": "അവനു നാം ഏറ്റം എളുപ്പമായതിലേക്ക് വഴിയൊരുക്കിക്കൊടുക്കും."
    },
    {
      "number": 8,
      "text": "എന്നാല്‍ ആര്‍ പിശുക്കുകാണിക്കുകയും സ്വയം പൂര്‍ണതനടിക്കുകയും,"
    },
    {
      "number": 9,
      "text": "അത്യുത്തമമായതിനെ തള്ളിപ്പറയുകയും ചെയ്യുന്നുവോ,"
    },
    {
      "number": 10,
      "text": "അവനെ നാം ഏറ്റം ക്ളേശകരമായതില്‍ കൊണ്ടെത്തിക്കും."
    },
    {
      "number": 11,
      "text": "അവന്‍ നാശത്തിനിരയാകുമ്പോള്‍ അവന്റെ ധനം അവന്ന് ഉപകരിക്കുകയില്ല."
    },
    {
      "number": 12,
      "text": "സംശയമില്ല; നാമാണ് നേര്‍വഴി കാണിച്ചു തരേണ്ടത്."
    },
    {
      "number": 13,
      "text": "തീര്‍ച്ചയായും നമ്മുക്കുള്ളതാണ് പരലോകവും ഈ ലോകവും."
    },
    {
      "number": 14,
      "text": "അതിനാല്‍ കത്തിയെരിയും നരകത്തീയിനെക്കുറിച്ച് ഞാന്‍ നിങ്ങള്‍ക്ക് മുന്നറിയിപ്പ് നല്‍കിയിരിക്കുന്നു."
    },
    {
      "number": 15,
      "text": "പരമ നിര്‍ഭാഗ്യവാനല്ലാതെ അതില്‍ പ്രവേശിക്കുകയില്ല."
    },
    {
      "number": 16,
      "text": "സത്യത്തെ തള്ളിക്കളഞ്ഞവനും അതില്‍നിന്ന് പിന്മാറിയവനുമാണവന്‍."
    },
    {
      "number": 17,
      "text": "പരമഭക്തന്‍ അതില്‍നിന്ന് അകറ്റപ്പെടും."
    },
    {
      "number": 18,
      "text": "ധനം വ്യയം ചെയ്ത് വിശുദ്ധി വരിക്കുന്നവനാണവന്‍."
    },
    {
      "number": 19,
      "text": "പ്രത്യുപകാരം നല്‍കപ്പെടേണ്ട ഒരൌദാര്യവും അവന്റെ വശം ആര്‍ക്കുമില്ല."
    },
    {
      "number": 20,
      "text": "അത്യുന്നതനായ തന്റെ നാഥന്റെ പ്രീതിയെ സംബന്ധിച്ച പ്രതീക്ഷയല്ലാതെ."
    },
    {
      "number": 21,
      "text": "വഴിയെ അയാള്‍ സംതൃപ്തനാകും; തീര്‍ച്ച."
    }
  ]
}