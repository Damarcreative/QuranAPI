{
  "surah": 92,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "以籠罩時的黑夜發誓，"
    },
    {
      "number": 2,
      "text": "以顯著時的白晝發誓，"
    },
    {
      "number": 3,
      "text": "以創造男性和女性的主發誓，"
    },
    {
      "number": 4,
      "text": "你們的行為，確是不同的。"
    },
    {
      "number": 5,
      "text": "至於賑濟貧民，敬畏真主，"
    },
    {
      "number": 6,
      "text": "且承認至善者，"
    },
    {
      "number": 7,
      "text": "我將使他易於達到最易的結局。"
    },
    {
      "number": 8,
      "text": "至於吝惜錢財，自謂無求，"
    },
    {
      "number": 9,
      "text": "且否認至善者，"
    },
    {
      "number": 10,
      "text": "我將使他易於達到最難的結局。"
    },
    {
      "number": 11,
      "text": "當他淪亡的時候，他的財產於他有什麼裨益呢！"
    },
    {
      "number": 12,
      "text": "我確有指導的責任，"
    },
    {
      "number": 13,
      "text": "我確有後世和今世的主權。"
    },
    {
      "number": 14,
      "text": "故我警告你們一種發焰的火，"
    },
    {
      "number": 15,
      "text": "唯薄命者墜入其中，"
    },
    {
      "number": 16,
      "text": "他否認真理，而背棄之。"
    },
    {
      "number": 17,
      "text": "敬畏者，得免於火刑。"
    },
    {
      "number": 18,
      "text": "他虔誠地施捨他的財產，"
    },
    {
      "number": 19,
      "text": "他沒有受過任何人的應報的恩德，"
    },
    {
      "number": 20,
      "text": "但他施捨只是為了求他的至尊主的喜悅，"
    },
    {
      "number": 21,
      "text": "他自己將來必定喜悅。"
    }
  ]
}