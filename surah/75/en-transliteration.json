{
  "surah": 75,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "L<u>a</u> oqsimu biyawmi alqiy<u>a</u>mat<b>i</b>"
    },
    {
      "number": 2,
      "text": "Wal<u>a</u> oqsimu bi<b>al</b>nnafsi allaww<u>a</u>mat<b>i</b>"
    },
    {
      "number": 3,
      "text": "Aya<u>h</u>sabu alins<u>a</u>nu allan najmaAAa AAi<i><u>th</u></i><u>a</u>mah<b>u</b>"
    },
    {
      "number": 4,
      "text": "Bal<u>a</u> q<u>a</u>direena AAal<u>a</u> an nusawwiya ban<u>a</u>nah<b>u</b>"
    },
    {
      "number": 5,
      "text": "Bal yureedu alins<u>a</u>nu liyafjura am<u>a</u>mah<b>u</b>"
    },
    {
      "number": 6,
      "text": "Yasalu ayy<u>a</u>na yawmu alqiy<u>a</u>ma<b>ti</b>"
    },
    {
      "number": 7,
      "text": "Fai<u>tha</u> bariqa alba<u>s</u>ar<b>u</b>"
    },
    {
      "number": 8,
      "text": "Wakhasafa alqamar<b>u</b>"
    },
    {
      "number": 9,
      "text": "WajumiAAa a<b>l</b>shshamsu wa<b>a</b>lqamar<b>u</b>"
    },
    {
      "number": 10,
      "text": "Yaqoolu alins<u>a</u>nu yawmai<u>th</u>in ayna almafar<b>ru</b>"
    },
    {
      "number": 11,
      "text": "Kall<u>a</u> l<u>a</u> wazar<b>a</b>"
    },
    {
      "number": 12,
      "text": "Il<u>a</u> rabbika yawmai<u>th</u>in almustaqar<b>ru</b>"
    },
    {
      "number": 13,
      "text": "Yunabbao alins<u>a</u>nu yawmai<u>th</u>in bim<u>a</u> qaddama waakhkhar<b>a</b>"
    },
    {
      "number": 14,
      "text": "Bali alins<u>a</u>nu AAal<u>a</u> nafsihi ba<u>s</u>eera<b>tun</b>"
    },
    {
      "number": 15,
      "text": "Walaw alq<u>a</u> maAA<u>ath</u>eerah<b>u</b>"
    },
    {
      "number": 16,
      "text": "L<u>a</u> tu<u>h</u>arrik bihi lis<u>a</u>naka litaAAjala bih<b>i</b>"
    },
    {
      "number": 17,
      "text": "Inna AAalayn<u>a</u> jamAAahu waqur<u>a</u>nah<b>u</b>"
    },
    {
      "number": 18,
      "text": "Fai<u>tha</u> qaran<u>a</u>hu fa<b>i</b>ttabiAA qur<u>a</u>nah<b>u</b>"
    },
    {
      "number": 19,
      "text": "Thumma inna AAalayn<u>a</u> bay<u>a</u>nah<b>u</b>"
    },
    {
      "number": 20,
      "text": "Kall<u>a</u> bal tu<u>h</u>ibboona alAA<u>a</u>jila<b>ta</b>"
    },
    {
      "number": 21,
      "text": "Wata<u>th</u>aroona al<u>a</u>khira<b>ta</b>"
    },
    {
      "number": 22,
      "text": "Wujoohun yawmai<u>th</u>in n<u>ad</u>ira<b>tun</b>"
    },
    {
      "number": 23,
      "text": "Il<u>a</u> rabbih<u>a</u> n<u>a</u><i><u>th</u></i>ira<b>tun</b>"
    },
    {
      "number": 24,
      "text": "Wawujoohun yawmai<u>th</u>in b<u>a</u>sira<b>tun</b>"
    },
    {
      "number": 25,
      "text": "Ta<i><u>th</u></i>unnu an yufAAala bih<u>a</u> f<u>a</u>qira<b>tun</b>"
    },
    {
      "number": 26,
      "text": "Kall<u>a</u> i<u>tha</u> balaghati a<b>l</b>ttar<u>a</u>qiy<b>a</b>"
    },
    {
      "number": 27,
      "text": "Waqeela man r<u>a</u>q<b>in</b>"
    },
    {
      "number": 28,
      "text": "Wa<i><u>th</u></i>anna annahu alfir<u>a</u>q<b>u</b>"
    },
    {
      "number": 29,
      "text": "Wa<b>i</b>ltaffati a<b>l</b>ss<u>a</u>qu bi<b>a</b>lss<u>a</u>q<b>i</b>"
    },
    {
      "number": 30,
      "text": "Il<u>a</u> rabbika yawmai<u>th</u>in almas<u>a</u>q<b>u</b>"
    },
    {
      "number": 31,
      "text": "Fal<u>a</u> <u>s</u>addaqa wal<u>a</u> <u>s</u>all<u>a</u>"
    },
    {
      "number": 32,
      "text": "Wal<u>a</u>kin ka<u>thth</u>aba watawall<u>a</u>"
    },
    {
      "number": 33,
      "text": "Thumma <u>th</u>ahaba il<u>a</u> ahlihi yatama<u>tta</u>"
    },
    {
      "number": 34,
      "text": "Awl<u>a</u> laka faawl<u>a</u>"
    },
    {
      "number": 35,
      "text": "Thumma awl<u>a</u> laka faawl<u>a</u>"
    },
    {
      "number": 36,
      "text": "Aya<u>h</u>sabu alins<u>a</u>nu an yutraka sud<u>a</u><b>n</b>"
    },
    {
      "number": 37,
      "text": "Alam yaku nu<u>t</u>fatan min manayyin yumn<u>a</u>"
    },
    {
      "number": 38,
      "text": "Thumma k<u>a</u>na AAalaqatan fakhalaqa fasaww<u>a</u>"
    },
    {
      "number": 39,
      "text": "FajaAAala minhu a<b>l</b>zzawjayni a<b>l</b><u>thth</u>akara wa<b>a</b>lonth<u>a</u>"
    },
    {
      "number": 40,
      "text": "Alaysa <u>tha</u>lika biq<u>a</u>dirin AAal<u>a</u> an yu<u>h</u>yiya almawt<u>a</u>"
    }
  ]
}