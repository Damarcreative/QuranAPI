{
  "surah": 75,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "(ነገሩ ከሓዲዎች እንደሚሉት) አይደለም፡፡ በትንሣኤ ቀን እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "(ራሷን) ወቃሽ በኾነች ነፍስም እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"
    },
    {
      "number": 3,
      "text": "ሰው አጥንቶቹን አለመሰብሰባችንን ያስባልን?"
    },
    {
      "number": 4,
      "text": "አይደለም ጣቶቹን (ፊት እንደ ነበሩ) በማስተካከል ላይ ቻዮች ስንኾን (እንሰበስባቸዋለን)፡፡"
    },
    {
      "number": 5,
      "text": "ይልቁንም ሰው በፊቱ ባለው ነገር (በትንሣኤ) ሊያስተባብል ይፈልጋል፡፡"
    },
    {
      "number": 6,
      "text": "«የትንሣኤው ቀን መቼ ነው?» ሲል ይጠይቃል፡፡"
    },
    {
      "number": 7,
      "text": "ዓይንም በዋለለ ጊዜ፡፡"
    },
    {
      "number": 8,
      "text": "ጨረቃም በጨለመ ጊዜ፡፡"
    },
    {
      "number": 9,
      "text": "ፀሐይና ጨረቃም በተሰበሰቡ ጊዜ፡፡"
    },
    {
      "number": 10,
      "text": "«ሰው በዚያ ቀን መሸሻው የት ነው?» ይላል፡፡"
    },
    {
      "number": 11,
      "text": "ይከልከል፤ ምንም መጠጊያ የለም፡፡"
    },
    {
      "number": 12,
      "text": "በዚያ ቀን መርጊያው ወደ ጌታህ ብቻ ነው፡፡"
    },
    {
      "number": 13,
      "text": "ሰው በዚያ ቀን ባስቀደመውና ባስቆየው ሁሉ ይነገራል፡፡"
    },
    {
      "number": 14,
      "text": "በእርግጥም ሰው በነፍሱ ላይ አስረጅ ነው፡፡ (አካሎቹ ይመሰክሩበታል)፡፡"
    },
    {
      "number": 15,
      "text": "ምክንያቶቹን ሁሉ ቢያመጣም እንኳ (አይሰማም)፡፡"
    },
    {
      "number": 16,
      "text": "በእርሱ (በቁርኣን ንባብ) ልትቸኩል ምላስህን በእርሱ አታላውስ፡፡"
    },
    {
      "number": 17,
      "text": "(በልብህ ውስጥ) መሰብሰቡና ማንበቡ በእኛ ላይ ነውና፡፡"
    },
    {
      "number": 18,
      "text": "ባነበብነውም ጊዜ (ካለቀ በኋላ) ንባቡን ተከተል፡፡"
    },
    {
      "number": 19,
      "text": "ከዚያም ማብራራቱ በእኛ ላይ ነው፡፡"
    },
    {
      "number": 20,
      "text": "(ከመጣደፍ) ተከልከል፡፡ ይልቁንም (ሰዎች) ፈጣኒቱን (ዓለም) ትወዳላችሁ፡፡"
    },
    {
      "number": 21,
      "text": "መጨረሻይቱንም (ዓለም) ትተዋላችሁ፡፡ (አትዘጋጁላትም)፡፡"
    },
    {
      "number": 22,
      "text": "ፊቶች በዚያ ቀን አብሪዎች ናቸው፡፡"
    },
    {
      "number": 23,
      "text": "ወደ ጌታቸው ተመልካቾች ናቸው፡፡"
    },
    {
      "number": 24,
      "text": "ፊቶችም በዚያ ቀን ጨፍጋጊዎች ናቸው፡፡"
    },
    {
      "number": 25,
      "text": "በርሳቸውም ዐደጋ እንደሚሠራባቸው ያረጋግጣሉ፡፡"
    },
    {
      "number": 26,
      "text": "ንቁ (ነፍስ) ብሪዎችን በደረሰች ጊዜ፤"
    },
    {
      "number": 27,
      "text": "«አሻሪው ማነው?» በተባለም ጊዜ፡፡"
    },
    {
      "number": 28,
      "text": "(ሕመምተኛው) እርሱ (የሰፈረበት ነገር ከዚህ ዓለም) መልለየት መኾኑን ባረጋገጠም ጊዜ፡፡"
    },
    {
      "number": 29,
      "text": "ባትም በባት በተጣበቀች ጊዜ፡፡"
    },
    {
      "number": 30,
      "text": "በዚያ ቀን መነዳቱ ወደ ጌታህ (ፍርድ) ነው፡፡"
    },
    {
      "number": 31,
      "text": "አላመነምም አልሰገደምም፡፡"
    },
    {
      "number": 32,
      "text": "ግን አስተባበለ፤ (ከእምነት) ዞረም፡፡"
    },
    {
      "number": 33,
      "text": "ከዚያም እየተንጎባለለ ወደ ቤተሰቡ ኼደ፡፡"
    },
    {
      "number": 34,
      "text": "የምትጠላውን ነገር (አላህ) ያስከትልህ፡፡ ለአንተ ተገቢህም ነው፡፡"
    },
    {
      "number": 35,
      "text": "ከዚያም ጥፋት ይጠጋህ ለአንተ የተገባህም ነው፡፡"
    },
    {
      "number": 36,
      "text": "ሰው ስድ ኾኖ መትተውን ይጠረጥራልን?"
    },
    {
      "number": 37,
      "text": "የሚፈሰስ ከኾነ የፍትወት ጠብታ አልነበረምን?"
    },
    {
      "number": 38,
      "text": "ከዚያም የረጋ ደም ኾነ (አላህ ሰው አድርጎ) ፈጠረውም፡፡ አስተካከለውም፡፡"
    },
    {
      "number": 39,
      "text": "ከእርሱም ሁለት ዓይነቶችን ወንድና ሴትን አደረገ፡፡"
    },
    {
      "number": 40,
      "text": "ይህ (ጌታ) ሙታንን ሕያው በማድረግ ላይ ቻይ አይደለምን?"
    }
  ]
}