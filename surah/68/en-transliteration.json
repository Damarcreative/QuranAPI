{
  "surah": 68,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Noon wa<b>a</b>lqalami wam<u>a</u> yas<u>t</u>uroon<b>a</b>"
    },
    {
      "number": 2,
      "text": "M<u>a</u> anta biniAAmati rabbika bimajnoon<b>in</b>"
    },
    {
      "number": 3,
      "text": "Wainna laka laajran ghayra mamnoon<b>in</b>"
    },
    {
      "number": 4,
      "text": "Wainnaka laAAal<u>a</u> khuluqin AAa<i><u>th</u></i>eem<b>in</b>"
    },
    {
      "number": 5,
      "text": "Fasatub<u>s</u>iru wayub<u>s</u>iroon<b>a</b>"
    },
    {
      "number": 6,
      "text": "Biayyikumu almaftoon<b>u</b>"
    },
    {
      "number": 7,
      "text": "Inna rabbaka huwa aAAlamu biman <u>d</u>alla AAan sabeelihi wahuwa aAAlamu bi<b>a</b>lmuhtadeen<b>a</b>"
    },
    {
      "number": 8,
      "text": "Fal<u>a</u> tu<u>t</u>iAAi almuka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 9,
      "text": "Waddoo law tudhinu fayudhinoon<b>a</b>"
    },
    {
      "number": 10,
      "text": "Wal<u>a</u> tu<u>t</u>iAA kulla <u>h</u>all<u>a</u>fin maheen<b>in</b>"
    },
    {
      "number": 11,
      "text": "Hamm<u>a</u>zin mashsh<u>a</u>in binameem<b>in</b>"
    },
    {
      "number": 12,
      "text": "Mann<u>a</u>AAin lilkhayri muAAtadin atheem<b>in</b>"
    },
    {
      "number": 13,
      "text": "AAutullin baAAda <u>tha</u>lika zaneem<b>in</b>"
    },
    {
      "number": 14,
      "text": "An k<u>a</u>na <u>tha</u> m<u>a</u>lin wabaneen<b>a</b>"
    },
    {
      "number": 15,
      "text": "I<u>tha</u> tutl<u>a</u> AAalayhi <u>a</u>y<u>a</u>tun<u>a</u> q<u>a</u>la as<u>at</u>eeru alawwaleen<b>a</b>"
    },
    {
      "number": 16,
      "text": "Sanasimuhu AAal<u>a</u> alkhur<u>t</u>oom<b>i</b>"
    },
    {
      "number": 17,
      "text": "Inn<u>a</u> balawn<u>a</u>hum kam<u>a</u> balawn<u>a</u> a<u>s</u><u>ha</u>ba aljannati i<u>th</u> aqsamoo laya<u>s</u>rimunnah<u>a</u> mu<u>s</u>bi<u>h</u>een<b>a</b>"
    },
    {
      "number": 18,
      "text": "Wal<u>a</u> yastathnoon<b>a</b>"
    },
    {
      "number": 19,
      "text": "Fa<u>ta</u>fa AAalayh<u>a</u> <u>ta</u>ifun min rabbika wahum n<u>a</u>imoon<b>a</b>"
    },
    {
      "number": 20,
      "text": "Faa<u>s</u>ba<u>h</u>at ka<b>al</b><u>ss</u>areem<b>i</b>"
    },
    {
      "number": 21,
      "text": "Fatan<u>a</u>daw mu<u>s</u>bi<u>h</u>een<b>a</b>"
    },
    {
      "number": 22,
      "text": "Ani ighdoo AAal<u>a</u> <u>h</u>arthikum in kuntum <u>sa</u>rimeen<b>a</b>"
    },
    {
      "number": 23,
      "text": "Fa<b>i</b>n<u>t</u>alaqoo wahum yatakh<u>a</u>fatoon<b>a</b>"
    },
    {
      "number": 24,
      "text": "An l<u>a</u> yadkhulannah<u>a</u> alyawma AAalaykum miskeen<b>un</b>"
    },
    {
      "number": 25,
      "text": "Waghadaw AAal<u>a</u> <u>h</u>ardin q<u>a</u>direen<b>a</b>"
    },
    {
      "number": 26,
      "text": "Falamm<u>a</u> raawh<u>a</u> q<u>a</u>loo inn<u>a</u> la<u>da</u>lloon<b>a</b>"
    },
    {
      "number": 27,
      "text": "Bal na<u>h</u>nu ma<u>h</u>roomoon<b>a</b>"
    },
    {
      "number": 28,
      "text": "Q<u>a</u>la awsa<u>t</u>uhum alam aqul lakum lawl<u>a</u> tusabbi<u>h</u>oon<b>a</b>"
    },
    {
      "number": 29,
      "text": "Q<u>a</u>loo sub<u>ha</u>na rabbin<u>a</u> inn<u>a</u> kunn<u>a</u> <i><u>th</u></i><u>a</u>limeen<b>a</b>"
    },
    {
      "number": 30,
      "text": "Faaqbala baAA<u>d</u>uhum AAal<u>a</u> baAA<u>d</u>in yatal<u>a</u>wamoon<b>a</b>"
    },
    {
      "number": 31,
      "text": "Q<u>a</u>loo y<u>a</u> waylan<u>a</u> inn<u>a</u> kunn<u>a</u> <u>ta</u>gheen<b>a</b>"
    },
    {
      "number": 32,
      "text": "AAas<u>a</u> rabbun<u>a</u> an yubdilan<u>a</u> khayran minh<u>a</u> inn<u>a</u> il<u>a</u> rabbin<u>a</u> r<u>a</u>ghiboon<b>a</b>"
    },
    {
      "number": 33,
      "text": "Ka<u>tha</u>lika alAAa<u>tha</u>bu walaAAa<u>tha</u>bu al<u>a</u>khirati akbaru law k<u>a</u>noo yaAAlamoon<b>a</b>"
    },
    {
      "number": 34,
      "text": "Inna lilmuttaqeena AAinda rabbihim jann<u>a</u>ti a<b>l</b>nnaAAeem<b>i</b>"
    },
    {
      "number": 35,
      "text": "AfanajAAalu almuslimeena ka<b>a</b>lmujrimeen<b>a</b>"
    },
    {
      "number": 36,
      "text": "M<u>a</u> lakum kayfa ta<u>h</u>kumoon<b>a</b>"
    },
    {
      "number": 37,
      "text": "Am lakum kit<u>a</u>bun feehi tadrusoon<b>a</b>"
    },
    {
      "number": 38,
      "text": "Inna lakum feehi lam<u>a</u> takhayyaroon<b>a</b>"
    },
    {
      "number": 39,
      "text": "Am lakum aym<u>a</u>nun AAalayn<u>a</u> b<u>a</u>lighatun il<u>a</u> yawmi alqiy<u>a</u>mati inna lakum lam<u>a</u> ta<u>h</u>kumoon<b>a</b>"
    },
    {
      "number": 40,
      "text": "Salhum ayyuhum bi<u>tha</u>lika zaAAeem<b>un</b>"
    },
    {
      "number": 41,
      "text": "Am lahum shurak<u>a</u>o falyatoo bishurak<u>a</u>ihim in k<u>a</u>noo <u>sa</u>diqeen<b>a</b>"
    },
    {
      "number": 42,
      "text": "Yawma yukshafu AAan s<u>a</u>qin wayudAAawna il<u>a</u> a<b>l</b>ssujoodi fal<u>a</u> yasta<u>t</u>eeAAoon<b>a</b>"
    },
    {
      "number": 43,
      "text": "Kh<u>a</u>shiAAatan ab<u>sa</u>ruhum tarhaquhum <u>th</u>illatun waqad k<u>a</u>noo yudAAawna il<u>a</u> a<b>l</b>ssujoodi wahum s<u>a</u>limoon<b>a</b>"
    },
    {
      "number": 44,
      "text": "Fa<u>th</u>arnee waman yuka<u>thth</u>ibu bih<u>atha</u> al<u>h</u>adeethi sanastadrijuhum min <u>h</u>aythu l<u>a</u> yaAAlamoon<b>a</b>"
    },
    {
      "number": 45,
      "text": "Waomlee lahum inna kaydee mateen<b>un</b>"
    },
    {
      "number": 46,
      "text": "Am tasaluhum ajran fahum min maghramin muthqaloon<b>a</b>"
    },
    {
      "number": 47,
      "text": "Am AAindahumu alghaybu fahum yaktuboon<b>a</b>"
    },
    {
      "number": 48,
      "text": "Fa<b>i</b><u>s</u>bir li<u>h</u>ukmi rabbika wal<u>a</u> takun ka<u>sah</u>ibi al<u>h</u>ooti i<u>th</u> n<u>a</u>d<u>a</u> wahuwa mak<i><u>th</u></i>oom<b>un</b>"
    },
    {
      "number": 49,
      "text": "Lawl<u>a</u> an tad<u>a</u>rakahu niAAmatun min rabbihi lanubi<u>th</u>a bi<b>a</b>lAAar<u>a</u>i wahuwa ma<u>th</u>moom<b>un</b>"
    },
    {
      "number": 50,
      "text": "Fa<b>i</b>jtab<u>a</u>hu rabbuhu fajaAAalahu mina a<b>l</b><u>ssa</u>li<u>h</u>een<b>a</b>"
    },
    {
      "number": 51,
      "text": "Wain yak<u>a</u>du alla<u>th</u>eena kafaroo layuzliqoonaka biab<u>sa</u>rihim lamm<u>a</u> samiAAoo a<b>l</b><u>thth</u>ikra wayaqooloona innahu lamajnoon<b>un</b>"
    },
    {
      "number": 52,
      "text": "Wam<u>a</u> huwa ill<u>a</u> <u>th</u>ikrun lilAA<u>a</u>lameen<b>a</b>"
    }
  ]
}