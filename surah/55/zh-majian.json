{
  "surah": 55,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "至仁主，"
    },
    {
      "number": 2,
      "text": "曾教授《古蘭經》，"
    },
    {
      "number": 3,
      "text": "他創造了人，"
    },
    {
      "number": 4,
      "text": "並教人修辭。"
    },
    {
      "number": 5,
      "text": "日月是依定數而運行的。"
    },
    {
      "number": 6,
      "text": "草木是順從他的意旨的。"
    },
    {
      "number": 7,
      "text": "他曾將天升起。他曾規定公平，"
    },
    {
      "number": 8,
      "text": "以免你們用稱不公。"
    },
    {
      "number": 9,
      "text": "你們應當秉公地僅守衡度，你們不要使所稱之物份量不足。"
    },
    {
      "number": 10,
      "text": "他為眾生而將大地放下。"
    },
    {
      "number": 11,
      "text": "大地上有水果，和有花篦的海棗，"
    },
    {
      "number": 12,
      "text": "與有稈的五穀和香草。"
    },
    {
      "number": 13,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 14,
      "text": "他曾用陶器般的乾土創造人，"
    },
    {
      "number": 15,
      "text": "他用火焰創造精靈。"
    },
    {
      "number": 16,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 17,
      "text": "他是兩個東方的主，也是兩個西方的主。"
    },
    {
      "number": 18,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 19,
      "text": "他曾任兩海相交而會合，"
    },
    {
      "number": 20,
      "text": "兩海之間，有一個堤防，兩海互不侵犯。"
    },
    {
      "number": 21,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 22,
      "text": "他從兩海中取出大珍珠和小珍珠。"
    },
    {
      "number": 23,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 24,
      "text": "在海中桅帆高舉，狀如山巒的船舶，只是他的。"
    },
    {
      "number": 25,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 26,
      "text": "凡在大地上的，都要毀滅；"
    },
    {
      "number": 27,
      "text": "惟有你的主的本體，具有尊嚴與大德，將永恆存在。"
    },
    {
      "number": 28,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 29,
      "text": "凡在天地間的都仰求他；他時時都有事物。"
    },
    {
      "number": 30,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 31,
      "text": "精靈和人類啊！我將專心應付你們。"
    },
    {
      "number": 32,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 33,
      "text": "精靈和人類的群眾啊！如果你們能通過天地的境界，你們就通過吧！你們必須憑據一種權柄，才能通過。"
    },
    {
      "number": 34,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 35,
      "text": "火焰和火煙將被降於你們，而你們不能自衛。"
    },
    {
      "number": 36,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 37,
      "text": "當天破離的時候，天將變成玫瑰色，好像紅皮一樣。"
    },
    {
      "number": 38,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 39,
      "text": "在那日，任何人和精靈都不因罪過而受審問。"
    },
    {
      "number": 40,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 41,
      "text": "犯罪者將因他們的形跡而被認識，他們的額髮將被繫在腳掌上。"
    },
    {
      "number": 42,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 43,
      "text": "這是犯罪者所否認的火獄。"
    },
    {
      "number": 44,
      "text": "他們將往來於火獄和沸水之間。"
    },
    {
      "number": 45,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 46,
      "text": "凡怕站在主的御前受審問者，都得享受兩座樂園。"
    },
    {
      "number": 47,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 48,
      "text": "那兩座樂園，是有各種果樹的。"
    },
    {
      "number": 49,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 50,
      "text": "在那兩座樂園裡，有兩洞流行的泉源。"
    },
    {
      "number": 51,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 52,
      "text": "在那兩座樂園裡，每種水果，都有兩樣。"
    },
    {
      "number": 53,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 54,
      "text": "他們靠在用錦緞做裡子的坐褥上，那兩座樂園的水果，都是手所能及的。"
    },
    {
      "number": 55,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 56,
      "text": "在那些樂園中，有不視非禮的妻子；在他們的妻子之前，任何人和任何精靈都未與她們交接過。"
    },
    {
      "number": 57,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 58,
      "text": "她們好像紅寶石和小珍珠一樣。"
    },
    {
      "number": 59,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 60,
      "text": "行善者，只受善報。"
    },
    {
      "number": 61,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 62,
      "text": "次於那兩座樂園的，還有兩座樂園。"
    },
    {
      "number": 63,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 64,
      "text": "那兩座樂園都是蒼翠的。"
    },
    {
      "number": 65,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 66,
      "text": "在那兩座樂園裡，有兩洞湧出的泉源。"
    },
    {
      "number": 67,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 68,
      "text": "在那兩座樂園裡，有水果，有海棗，有石榴。"
    },
    {
      "number": 69,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 70,
      "text": "在那些樂園裡，有許多賢淑佳麗的女子。"
    },
    {
      "number": 71,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 72,
      "text": "她們是白皙的，是蟄居於帳幕中的。"
    },
    {
      "number": 73,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 74,
      "text": "在他們的妻子之前，任何人或精靈，都未曾與她們交接過。"
    },
    {
      "number": 75,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 76,
      "text": "他們靠在翠綠的坐褥和美麗的花毯上。"
    },
    {
      "number": 77,
      "text": "你們究竟否認你們的主的哪一件恩典呢？"
    },
    {
      "number": 78,
      "text": "多福哉，你具尊嚴和大德的主的名號！"
    }
  ]
}