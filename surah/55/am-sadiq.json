{
  "surah": 55,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "አል-ረሕማን፤"
    },
    {
      "number": 2,
      "text": "ቁርኣንን አስተማረ፡፡"
    },
    {
      "number": 3,
      "text": "ሰውን ፈጠረ፡፡"
    },
    {
      "number": 4,
      "text": "መናገርን አስተማረው፡፡"
    },
    {
      "number": 5,
      "text": "ፀሐይና ጨረቃ በተወሰነ ልክ (ይኼዳሉ)፡፡"
    },
    {
      "number": 6,
      "text": "ሐረግና ዛፍም (ለእርሱ) ይሰግዳሉ፡፡"
    },
    {
      "number": 7,
      "text": "ሰማይንም አጓናት፡፡ ትክክለኛነትንም ደነገገ፡፡"
    },
    {
      "number": 8,
      "text": "በሚዛን (ስትመዝኑ) እንዳትበድሉ፡፡"
    },
    {
      "number": 9,
      "text": "መመዘንንም በትክክል መዝኑ፡፡ ተመዛኙንም አታጉድሉ፡፡"
    },
    {
      "number": 10,
      "text": "ምድርንም ለፍጡሩ አደላደላት፡፡"
    },
    {
      "number": 11,
      "text": "በውስጧ እሸት ባለ ሺፋኖች የኾኑ ዘንባባዎችም ያሉባት ስትኾን፡፡"
    },
    {
      "number": 12,
      "text": "የገለባ ባለቤት የኾነ ቅንጣትም፡፡ ባለ መልካም መዐዛ ቅጠሎችም (ያሉባት ስትኾን)፡፡"
    },
    {
      "number": 13,
      "text": "(ሰዎችና ጋኔኖች ሆይ!) ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 14,
      "text": "ሰውን እንደ ሸክላ ከሚቅጨለጨል ደረቅ ጭቃ ፈጠረው፡፡"
    },
    {
      "number": 15,
      "text": "ጃንንም ከእሳት ከኾነ ነበልባል ፈጠረው፡፡"
    },
    {
      "number": 16,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 17,
      "text": "የሁለቱ ምሥራቆች ጌታ፤ የሁለቱ ምዕራቦችም ጌታ ነው፡፡"
    },
    {
      "number": 18,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 19,
      "text": "ሁለቱን ባሕሮች የሚገናኙ ሲኾኑ ለቀቃቸው፡፡"
    },
    {
      "number": 20,
      "text": "(እንዳይዋሐዱ) በመካከላቸው ጋራጅ አልለ፡፡ (አንዱ ባንዱ ላይ) ወሰን አያልፉም፡፡"
    },
    {
      "number": 21,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"
    },
    {
      "number": 22,
      "text": "ሉልና መርጃን ከሁለቱ ይወጣል፡፡"
    },
    {
      "number": 23,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 24,
      "text": "እንደ ጋራዎች ኾነው በባሕር ውስጥ የተሠሩት ተንሻለዮቹም (ታንኳዎች) የእርሱ ናቸው፡፡"
    },
    {
      "number": 25,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 26,
      "text": "በእርሷ (በምድር) ላይ ያለው ሁሉ ጠፊ ነው፡፡"
    },
    {
      "number": 27,
      "text": "የልቅናና የልግሥና ባለቤት የኾነው የጌታህ ፊትም ይቀራል፡፡ (አይጠፋም)፡፡"
    },
    {
      "number": 28,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"
    },
    {
      "number": 29,
      "text": "በሰማያትና በምድር ውስጥ ያሉት ሁሉ ይለምኑታል፡፡ በየቀኑ ሁሉ እርሱ በሥራ ላይ ነው፡፡"
    },
    {
      "number": 30,
      "text": "ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"
    },
    {
      "number": 31,
      "text": "እናንተ ሁለት ከባዶች (ሰዎችና ጋኔኖች) ሆይ! ለእናንተ (መቆጣጠር) በእርግጥ እናስባለን፡፡"
    },
    {
      "number": 32,
