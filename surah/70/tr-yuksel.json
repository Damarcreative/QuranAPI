{
  "surah": 70,
  "translation": "tr-yuksel",
  "ayahs": [
    {
      "number": 0,
      "text": "Rahman ve Rahim ALLAH'ın ismiyle."
    },
    {
      "number": 1,
      "text": "Sorgulayan birisi, gerçekleşecek azabı sordu."
    },
    {
      "number": 2,
      "text": "Onu inkarcılardan savacak kimse yoktur."
    },
    {
      "number": 3,
      "text": "Yükseliş Yollarının Sahibi olan ALLAH'tandır."
    },
    {
      "number": 4,
      "text": "Melekler ve ruh (vahiy/komutlar/Cebrail), elli bin yıla eşit bir gün içinde O'na yükselir."
    },
    {
      "number": 5,
      "text": "Şimdi sen güzelce sabret."
    },
    {
      "number": 6,
      "text": "Onlar onu uzak görüyorlar."
    },
    {
      "number": 7,
      "text": "Biz ise onu yakın görüyoruz."
    },
    {
      "number": 8,
      "text": "Gün gelecek, gök erimiş maden gibi."
    },
    {
      "number": 9,
      "text": "Dağlar ise atılmış yün gibi olur."
    },
    {
      "number": 10,
      "text": "Dost dostun durumunu sormaz."
    },
    {
      "number": 11,
      "text": "Birbirlerine gösterilirler. Suçlu, o günün azabından kurtulmak için fidye vermek ister: Oğullarını,"
    },
    {
      "number": 12,
      "text": "Eşini, kardeşini,"
    },
    {
      "number": 13,
      "text": "Kendisini yetiştiren tüm akrabalarını,"
    },
    {
      "number": 14,
      "text": "Ve yeryüzünde bulunan herkesi, ki kurtulsun."
    },
    {
      "number": 15,
      "text": "Hayır, o alevli ateştir."
    },
    {
      "number": 16,
      "text": "Yakmak için isteklidir..."
    },
    {
      "number": 17,
      "text": "Çağırır, sırtını dönüp gideni,"
    },
    {
      "number": 18,
      "text": "Toplayıp kasaya saklayanı."
    },
    {
      "number": 19,
      "text": "Doğrusu insan endişeli bir karaktere sahiptir."
    },
    {
      "number": 20,
      "text": "Kendisine kötülük dokunduğu zaman ümidini keser."
    },
    {
      "number": 21,
      "text": "Kendisine iyilik dokunduğu zaman ise cimridir."
    },
    {
      "number": 22,
      "text": "Ancak namaz kılanlar hariç:"
    },
    {
      "number": 23,
      "text": "Onlar ki namazlarını kaçırmazlar;"
    },
    {
      "number": 24,
      "text": "Paralarında bilinen bir pay (zekat) ayrılmıştır,"
    },
    {
      "number": 25,
      "text": "İsteyen yoksula ve yoksuna..."
    },
    {
      "number": 26,
      "text": "Onlar Din Gününü doğrularlar;"
    },
    {
      "number": 27,
      "text": "Rab'lerinin azabından çekinirler;"
    },
    {
      "number": 28,
      "text": "Rab'lerinin azabına güven olmaz."
    },
    {
      "number": 29,
      "text": "Onlar cinsel ilişkiden sakınırlar;"
    },
    {
      "number": 30,
      "text": "Ancak eşleri, yahut yeminlerinin/anlaşmalarının hak sahibi olduklari hariç; onlardan dolayı yerilmezler."
    },
    {
      "number": 31,
      "text": "- bunun ötesini arayanlar ise aşırı gidenlerdir-"
    },
    {
      "number": 32,
      "text": "Onlar güvenilirdirler, sözlerine bağlıdırlar;"
    },
    {
      "number": 33,
      "text": "Gereği gibi tanıklıkta bulunurlar;"
    },
    {
      "number": 34,
      "text": "Namazlarına özen gösterirler."
    },
    {
      "number": 35,
      "text": "Onlar cennetlerde ağırlanırlar."
    },
    {
      "number": 36,
      "text": "Peki şimdi inkarcılara ne oluyor da senin önünde koşuşuyorlar?"
    },
    {
      "number": 37,
      "text": "Sağdan, soldan gruplar halinde..."
    },
    {
      "number": 38,
      "text": "Herbiri, nimet cennetine sokulacağını mı umuyor?"
    },
    {
      "number": 39,
      "text": "Asla; biz onları yarattık, bildikleri şeyden..."
    },
    {
      "number": 40,
      "text": "Doğuların ve batıların Rabbine andolsun; bizim gücümüz yeter..."
    },
    {
      "number": 41,
      "text": "Onları, kendilerinden daha iyilerle değiştirmeye... Bizi kimse yenemez"
    },
    {
      "number": 42,
      "text": "Bırak onları, kendilerine söz verilen gün ile karşı karşıya gelinceye kadar dalsınlar, oynasınlar."
    },
    {
      "number": 43,
      "text": "O gün mezarlarından hızlı hızlı çıkarlar; kurban taşına sürülüyorlarmış gibi..."
    },
    {
      "number": 44,
      "text": "Gözleri dönmüş, kendilerini utanç sarmış olarak. İşte bu, onlara söz verilmiş olan gündür."
    }
  ]
}