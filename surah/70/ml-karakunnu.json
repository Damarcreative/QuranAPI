{
  "surah": 70,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "സംഭവിക്കാനിരിക്കുന്ന ശിക്ഷയെ സംബന്ധിച്ച് ഒരന്വേഷകന്‍ ആരാഞ്ഞുവല്ലോ."
    },
    {
      "number": 2,
      "text": "അത് സത്യനിഷേധികള്‍ക്കുള്ളതാണ്. അതിനെ തടയുന്ന ആരുമില്ല."
    },
    {
      "number": 3,
      "text": "ചവിട്ടുപടികളുടെ ഉടമയായ അല്ലാഹുവില്‍ നിന്നുള്ളതാണത്."
    },
    {
      "number": 4,
      "text": "മലക്കുകളും പരിശുദ്ധാത്മാവും അവന്റെ സന്നിധിയിലേക്ക് കയറിപ്പോകുന്നു. അമ്പതിനായിരം കൊല്ലം ദൈര്‍ഘ്യമുള്ള ഒരു ദിനത്തില്‍"
    },
    {
      "number": 5,
      "text": "അതിനാല്‍ ക്ഷമിക്കുക. മനോഹരമായ ക്ഷമ."
    },
    {
      "number": 6,
      "text": "അവരത് അകലെയായാണ് കാണുന്നത്."
    },
    {
      "number": 7,
      "text": "നാമോ അടുത്തായും കാണുന്നു."
    },
    {
      "number": 8,
      "text": "അന്ന് ആകാശം ഉരുകിയ ലോഹം പോലെയാകും."
    },
    {
      "number": 9,
      "text": "മലകള്‍ കടഞ്ഞെടുത്ത രോമം പോലെയും."
    },
    {
      "number": 10,
      "text": "അന്ന് ഒരുറ്റവനും തന്റെ തോഴനെ തേടുകയില്ല."
    },
    {
      "number": 11,
      "text": "അവരന്യോന്യം കാണുന്നുണ്ടാകും. അപ്പോള്‍ കുറ്റവാളി കൊതിച്ചുപോകും: അന്നാളിലെ ശിക്ഷയില്‍നിന്നൊഴിവാകാന്‍ മക്കളെ പണയം നല്‍കിയാലോ!"
    },
    {
      "number": 12,
      "text": "സഹധര്‍മിണിയെയും സഹോദരനെയും നല്‍കിയാലോ!"
    },
    {
      "number": 13,
      "text": "തനിക്ക് അഭയമേകിപ്പോന്ന കുടുംബത്തെയും."
    },
    {
      "number": 14,
      "text": "ഭൂമിയിലുള്ള മറ്റെല്ലാറ്റിനെയും. അങ്ങനെ താന്‍ രക്ഷപ്പെട്ടിരുന്നെങ്കില്‍!"
    },
    {
      "number": 15,
      "text": "വേണ്ട! അത് കത്തിക്കാളുന്ന നരകത്തീയാണ്."
    },
    {
      "number": 16,
      "text": "തൊലി ഉരിച്ചു കളയുന്ന തീ!"
    },
    {
      "number": 17,
      "text": "സത്യത്തോട് പുറം തിരിയുകയും പിന്തിരിഞ്ഞു പോവുകയും ചെയ്തവരെ അത് വിളിച്ചുവരുത്തും."
    },
    {
      "number": 18,
      "text": "ധനം ശേഖരിച്ച് സൂക്ഷിച്ചുവെച്ചവരെയും."
    },
    {
      "number": 19,
      "text": "മനുഷ്യന്‍ ക്ഷമ കെട്ടവനായാണ് സൃഷ്ടിക്കപ്പെട്ടത്."
    },
    {
      "number": 20,
      "text": "വിപത്ത് വരുമ്പോള്‍ അവന്‍ വെപ്രാളം കാട്ടും."
    },
    {
      "number": 21,
      "text": "നേട്ടം കിട്ടിയാലോ കെട്ടിപ്പൂട്ടിവെക്കും."
    },
    {
      "number": 22,
      "text": "നമസ്കരിക്കുന്നവരൊഴികെ."
    },
    {
      "number": 23,
      "text": "അവര്‍ നമസ്കാരത്തില്‍ നിഷ്ഠ പുലര്‍ത്തുന്നവരാണ്."
    },
    {
      "number": 24,
      "text": "അവരുടെ ധനത്തില്‍ നിര്‍ണിതമായ അവകാശമുണ്ട് --"
    },
    {
      "number": 25,
      "text": "ചോദിച്ചെത്തുന്നവര്‍ക്കും പ്രാഥമികാവശ്യങ്ങള്‍ക്കു വകയില്ലാത്തവര്‍ക്കും."
    },
    {
      "number": 26,
      "text": "വിധിദിനം സത്യമാണെന്ന് അംഗീകരിക്കുന്നവരാണവര്‍."
    },
    {
      "number": 27,
      "text": "തങ്ങളുടെ നാഥന്റെ ശിക്ഷയെ പേടിക്കുന്നവരും."
    },
    {
      "number": 28,
      "text": "അവരുടെ നാഥന്റെ ശിക്ഷയെക്കുറിച്ച് നിര്‍ഭയരാകാവതല്ല; തീര്‍ച്ച."
    },
    {
      "number": 29,
      "text": "അവര്‍ തങ്ങളുടെ സദാചാരനിഷ്ഠ സംരക്ഷിച്ചു പോരുന്നവരാണ്."
    },
    {
      "number": 30,
      "text": "തങ്ങളുടെ ഭാര്യമാരിലോ അധീനതയിലുള്ളവരിലോ ഒഴികെ. ഇവരുമായി ബന്ധപ്പെടുന്നത് ആക്ഷേപാര്‍ഹമല്ല."
    },
    {
      "number": 31,
      "text": "എന്നാല്‍ അതിനപ്പുറം ആഗ്രഹിക്കുന്നവരാരോ അവരത്രെ അതിക്രമികള്‍."
    },
    {
      "number": 32,
      "text": "തങ്ങളുടെ വശമുള്ള സൂക്ഷിപ്പുസ്വത്തുക്കള്‍ സംരക്ഷിക്കുന്നവരും കരാര്‍ പാലിക്കുന്നവരുമാണവര്‍."
    },
    {
      "number": 33,
      "text": "തങ്ങളുടെ സാക്ഷ്യങ്ങള്‍ സത്യസന്ധമായി പൂര്‍ത്തീകരിക്കുന്നവരും."
    },
    {
      "number": 34,
      "text": "നമസ്കാരം നിഷ്ഠയോടെ നിര്‍വഹിക്കുന്നവരും."
    },
    {
      "number": 35,
      "text": "അവര്‍ സ്വര്‍ഗത്തില്‍ അത്യധികം ആദരിക്കപ്പെടുന്നവരായിരിക്കും."
    },
    {
      "number": 36,
      "text": "ഈ സത്യനിഷേധികള്‍ക്ക് എന്തുപറ്റി? നിന്റെ നേരെ പാഞ്ഞുവരികയാണല്ലോ അവര്‍."
    },
    {
      "number": 37,
      "text": "ഇടത്തുനിന്നും വലത്തുനിന്നും കൂട്ടം കൂട്ടമായി."
    },
    {
      "number": 38,
      "text": "അവരോരോരുത്തരും താന്‍ അനുഗൃഹീത സ്വര്‍ഗത്തില്‍ കടക്കുമെന്ന് കൊതിക്കുകയാണോ?"
    },
    {
      "number": 39,
      "text": "ഒരിക്കലുമില്ല! അവര്‍ക്കുതന്നെ നന്നായറിയാവുന്ന വസ്തുവില്‍ നിന്നാണ് നാമവരെ പടച്ചത്."
    },
    {
      "number": 40,
      "text": "വേണ്ട, ഉദയാസ്തമയ സ്ഥാനങ്ങളുടെ നാഥന്റെ പേരില്‍ ഞാനിതാ സത്യം ചെയ്യുന്നു. നിസ്സംശയം നാം കഴിവുറ്റവനാണ്."
    },
    {
      "number": 41,
      "text": "അവരുടെ സ്ഥാനത്ത് അവരെക്കാള്‍ ഉത്തമമായ ജനതയെ കൊണ്ടുവരാന്‍ ; നമ്മെ ആരും മറികടക്കുകയില്ല."
    },
    {
      "number": 42,
      "text": "അതിനാല്‍ അവരെ വിട്ടേക്കുക. അവര്‍ക്കു താക്കീതു നല്‍കപ്പെട്ട ദിനം വരുംവരെ അവര്‍ തങ്ങളുടെ തോന്നിവാസങ്ങളിലും ദുര്‍വൃത്തികളിലും മുഴുകി കഴിയട്ടെ."
    },
    {
      "number": 43,
      "text": "അവര്‍ തങ്ങളുടെ ശവകുടീരങ്ങളില്‍ നിന്ന് പുറപ്പെട്ട് ഓടിയണയുന്ന ദിനമാണത്. തങ്ങളുടെ ലക്ഷ്യസ്ഥാനമായ നാട്ടക്കുറിയിലേക്ക് ഓടിയൊഴുകുന്ന പോലെ."
    },
    {
      "number": 44,
      "text": "കണ്ണുകള്‍ താണുപോയ അവസ്ഥയിലായിരിക്കും അന്നവര്‍. അപമാനം അവരെ ആവരണം ചെയ്തിരിക്കും. അവര്‍ക്ക് മുന്നറിയിപ്പു നല്‍കപ്പെട്ടിരുന്ന ദിനം അതത്രെ."
    }
  ]
}