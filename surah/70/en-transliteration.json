{
  "surah": 70,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Saala s<u>a</u>ilun biAAa<u>tha</u>bin w<u>a</u>qiAA<b>in</b>"
    },
    {
      "number": 2,
      "text": "Lilk<u>a</u>fireena laysa lahu d<u>a</u>fiAA<b>un</b>"
    },
    {
      "number": 3,
      "text": "Mina All<u>a</u>hi <u>th</u>ee almaAA<u>a</u>rij<b>i</b>"
    },
    {
      "number": 4,
      "text": "TaAAruju almal<u>a</u>ikatu wa<b>al</b>rroo<u>h</u>u ilayhi fee yawmin k<u>a</u>na miqd<u>a</u>ruhu khamseena alfa sana<b>tin</b>"
    },
    {
      "number": 5,
      "text": "Fa<b>i</b><u>s</u>bir <u>s</u>abran jameel<u>a</u><b>n</b>"
    },
    {
      "number": 6,
      "text": "Innahum yarawnahu baAAeed<u>a</u><b>n</b>"
    },
    {
      "number": 7,
      "text": "Wanar<u>a</u>hu qareeb<u>a</u><b>n</b>"
    },
    {
      "number": 8,
      "text": "Yawma takoonu a<b>l</b>ssam<u>a</u>o ka<b>a</b>lmuhl<b>i</b>"
    },
    {
      "number": 9,
      "text": "Watakoonu aljib<u>a</u>lu ka<b>a</b>lAAihn<b>i</b>"
    },
    {
      "number": 10,
      "text": "Wal<u>a</u> yasalu <u>h</u>ameemun <u>h</u>ameem<u>a</u><b>n</b>"
    },
    {
      "number": 11,
      "text": "Yuba<u>ss</u>aroonahum yawaddu almujrimu law yaftadee min AAa<u>tha</u>bi yawmii<u>th</u>in bibaneeh<b>i</b>"
    },
    {
      "number": 12,
      "text": "Wa<u>sah</u>ibatihi waakheeh<b>i</b>"
    },
    {
      "number": 13,
      "text": "Wafa<u>s</u>eelatihi allatee tuweeh<b>i</b>"
    },
    {
      "number": 14,
      "text": "Waman fee alar<u>d</u>i jameeAAan thumma yunjeeh<b>i</b>"
    },
    {
      "number": 15,
      "text": "Kall<u>a</u> innah<u>a</u> la<i><u>th</u></i><u>a</u>"
    },
    {
      "number": 16,
      "text": "Nazz<u>a</u>AAatan li<b>l</b>shshaw<u>a</u>"
    },
    {
      "number": 17,
      "text": "TadAAoo man adbara watawall<u>a</u>"
    },
    {
      "number": 18,
      "text": "WajamaAAa faawAA<u>a</u>"
    },
    {
      "number": 19,
      "text": "Inna alins<u>a</u>na khuliqa halooAA<u>a</u><b>n</b>"
    },
    {
      "number": 20,
      "text": "I<u>tha</u> massahu a<b>l</b>shsharru jazooAA<u>a</u><b>n</b>"
    },
    {
      "number": 21,
      "text": "Wai<u>tha</u> massahu alkhayru manooAA<u>a</u><b>n</b>"
    },
    {
      "number": 22,
      "text": "Ill<u>a</u> almu<u>s</u>alleen<b>a</b>"
    },
    {
      "number": 23,
      "text": "Alla<u>th</u>eena hum AAal<u>a</u> <u>s</u>al<u>a</u>tihim d<u>a</u>imoon<b>a</b>"
    },
    {
      "number": 24,
      "text": "Wa<b>a</b>lla<u>th</u>eena fee amw<u>a</u>lihim <u>h</u>aqqun maAAloom<b>un</b>"
    },
    {
      "number": 25,
      "text": "Li<b>l</b>ss<u>a</u>ili wa<b>a</b>lma<u>h</u>room<b>i</b>"
    },
    {
      "number": 26,
      "text": "Wa<b>a</b>lla<u>th</u>eena yu<u>s</u>addiqoona biyawmi a<b>l</b>ddeen<b>i</b>"
    },
    {
      "number": 27,
      "text": "Wa<b>a</b>lla<u>th</u>eena hum min AAa<u>tha</u>bi rabbihim mushfiqoon<b>a</b>"
    },
    {
      "number": 28,
      "text": "Inna AAa<u>tha</u>ba rabbihim ghayru mamoon<b>in</b>"
    },
    {
      "number": 29,
      "text": "Wa<b>a</b>lla<u>th</u>eena hum lifuroojihim <u>ha</u>fi<i><u>th</u></i>oon<b>a</b>"
    },
    {
      "number": 30,
      "text": "Ill<u>a</u> AAal<u>a</u> azw<u>a</u>jihim aw m<u>a</u> malakat aym<u>a</u>nuhum fainnahum ghayru maloomeen<b>a</b>"
    },
    {
      "number": 31,
      "text": "Famani ibtagh<u>a</u> war<u>a</u>a <u>tha</u>lika faol<u>a</u>ika humu alAA<u>a</u>doon<b>a</b>"
    },
    {
      "number": 32,
      "text": "Wa<b>a</b>lla<u>th</u>eena hum liam<u>a</u>n<u>a</u>tihim waAAahdihim r<u>a</u>AAoon<b>a</b>"
    },
    {
      "number": 33,
      "text": "Wa<b>a</b>lla<u>th</u>eena hum bishah<u>a</u>d<u>a</u>tihim q<u>a</u>imoon<b>a</b>"
    },
    {
      "number": 34,
      "text": "Wa<b>a</b>lla<u>th</u>eena hum AAal<u>a</u> <u>s</u>al<u>a</u>tihim yu<u>ha</u>fi<i><u>th</u></i>oon<b>a</b>"
    },
    {
      "number": 35,
      "text": "Ol<u>a</u>ika fee jann<u>a</u>tin mukramoon<b>a</b>"
    },
    {
      "number": 36,
      "text": "Fam<u>a</u>li alla<u>th</u>eena kafaroo qibalaka muh<u>t</u>iAAeen<b>a</b>"
    },
    {
      "number": 37,
      "text": "AAani alyameeni waAAani a<b>l</b>shshim<u>a</u>li AAizeen<b>a</b>"
    },
    {
      "number": 38,
      "text": "Aya<u>t</u>maAAu kullu imriin minhum an yudkhala jannata naAAeem<b>in</b>"
    },
    {
      "number": 39,
      "text": "Kall<u>a</u> inn<u>a</u> khalaqn<u>a</u>hum mimm<u>a</u> yaAAlamoon<b>a</b>"
    },
    {
      "number": 40,
      "text": "Fal<u>a</u> oqsimu birabbi almash<u>a</u>riqi wa<b>a</b>lmagh<u>a</u>ribi inn<u>a</u> laq<u>a</u>diroon<b>a</b>"
    },
    {
      "number": 41,
      "text": "AAal<u>a</u> an nubaddila khayran minhum wam<u>a</u> na<u>h</u>nu bimasbooqeen<b>a</b>"
    },
    {
      "number": 42,
      "text": "Fa<u>th</u>arhum yakhoo<u>d</u>oo wayalAAaboo <u>h</u>att<u>a</u> yul<u>a</u>qoo yawmahumu alla<u>th</u>ee yooAAadoon<b>a</b>"
    },
    {
      "number": 43,
      "text": "Yawma yakhrujoona mina alajd<u>a</u>thi sir<u>a</u>AAan kaannahum il<u>a</u> nu<u>s</u>ubin yoofi<u>d</u>oon<b>a</b>"
    },
    {
      "number": 44,
      "text": "Kh<u>a</u>shiAAatan ab<u>sa</u>ruhum tarhaquhum <u>th</u>illatun <u>tha</u>lika alyawmu alla<u>th</u>ee k<u>a</u>noo yooAAadoon<b>a</b>"
    }
  ]
}