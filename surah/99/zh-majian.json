{
  "surah": 99,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "當大地猛烈地震動,"
    },
    {
      "number": 2,
      "text": "拋其重擔,"
    },
    {
      "number": 3,
      "text": "說\"大地怎麼啦?\""
    },
    {
      "number": 4,
      "text": "在那日, 大地將報告它的消息。"
    },
    {
      "number": 5,
      "text": "因為你的主已啟示了它;"
    },
    {
      "number": 6,
      "text": "在那日, 人們將紛紛地離散,"
    },
    {
      "number": 7,
      "text": "以便他們得見自己行為的報應。"
    },
    {
      "number": 8,
      "text": "行一個小螞蟻重的善事者, 將見其善報; 作一個小螞蟻重的惡事者, 將見其惡報。"
    }
  ]
}