{
  "surah": 99,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "I<u>tha</u> zulzilati alar<u>d</u>u zilz<u>a</u>lah<u>a</u>"
    },
    {
      "number": 2,
      "text": "Waakhrajati alar<u>d</u>u athq<u>a</u>lah<u>a</u>"
    },
    {
      "number": 3,
      "text": "Waq<u>a</u>la alins<u>a</u>nu m<u>a</u> lah<u>a</u>"
    },
    {
      "number": 4,
      "text": "Yawmai<u>th</u>in tu<u>h</u>addithu akhb<u>a</u>rah<u>a</u>"
    },
    {
      "number": 5,
      "text": "Bianna rabbaka aw<u>ha</u> lah<u>a</u>"
    },
    {
      "number": 6,
      "text": "Yawmai<u>th</u>in ya<u>s</u>duru a<b>l</b>nn<u>a</u>su asht<u>a</u>tan liyuraw aAAm<u>a</u>lahum"
    },
    {
      "number": 7,
      "text": "Faman yaAAmal mithq<u>a</u>la <u>th</u>arratin khayran yarah<b>u</b>"
    },
    {
      "number": 8,
      "text": "Waman yaAAmal mithq<u>a</u>la <u>th</u>arratin sharran yarah<b>u</b>"
    }
  ]
}