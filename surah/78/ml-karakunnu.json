{
  "surah": 78,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "ഏതിനെപ്പറ്റിയാണ് അവരന്യോന്യം ചോദിച്ചുകൊണ്ടിരിക്കുന്നത്?"
    },
    {
      "number": 2,
      "text": "അതിഭയങ്കരമായ വാര്‍ത്തയെപ്പറ്റി തന്നെ."
    },
    {
      "number": 3,
      "text": "അതിലവര്‍ ഭിന്നാഭിപ്രായക്കാരാണ്."
    },
    {
      "number": 4,
      "text": "വേണ്ട; വൈകാതെ അവരറിയുകതന്നെ ചെയ്യും."
    },
    {
      "number": 5,
      "text": "വീണ്ടും വേണ്ട; ഉറപ്പായും അവരറിയും."
    },
    {
      "number": 6,
      "text": "ഭൂമിയെ നാം മെത്തയാക്കിയില്ലേ?"
    },
    {
      "number": 7,
      "text": "മലകളെ ആണികളും?"
    },
    {
      "number": 8,
      "text": "നിങ്ങളെ നാം ഇണകളായി സൃഷ്ടിച്ചു."
    },
    {
      "number": 9,
      "text": "നിങ്ങളുടെ ഉറക്കത്തെ നാം വിശ്രമമാക്കി."
    },
    {
      "number": 10,
      "text": "രാവിനെ വസ്ത്രമാക്കി."
    },
    {
      "number": 11,
      "text": "പകലിനെ ജീവിതവേളയാക്കി."
    },
    {
      "number": 12,
      "text": "നിങ്ങള്‍ക്കു മേലെ ഭദ്രമായ ഏഴാകാശങ്ങളെ നാം നിര്‍മിച്ചു."
    },
    {
      "number": 13,
      "text": "കത്തിജ്ജ്വലിക്കുന്ന ഒരു വിളക്കും നാം സ്ഥാപിച്ചു."
    },
    {
      "number": 14,
      "text": "കാര്‍മുകിലില്‍നിന്ന് കുത്തിയൊഴുകും വെള്ളമിറക്കി."
    },
    {
      "number": 15,
      "text": "അതുവഴി ധാന്യവും ചെടികളും ഉല്‍പാദിപ്പിക്കാന്‍."
    },
    {
      "number": 16,
      "text": "ഇടതൂര്‍ന്ന തോട്ടങ്ങളും."
    },
    {
      "number": 17,
      "text": "നിശ്ചയമായും വിധിദിനം സമയനിര്‍ണിതമാണ്."
    },
    {
      "number": 18,
      "text": "കാഹളം ഊതുന്ന ദിനമാണത്. അപ്പോള്‍ നിങ്ങള്‍ കൂട്ടംകൂട്ടമായി വന്നെത്തും."
    },
    {
      "number": 19,
      "text": "ആകാശം തുറക്കപ്പെടും. അത് അനേകം കവാടങ്ങളായിത്തീരും."
    },
    {
      "number": 20,
      "text": "പര്‍വതങ്ങള്‍ ഇളകി നീങ്ങും. അവ മരീചികയാകും."
    },
    {
      "number": 21,
      "text": "നിശ്ചയമായും നരകത്തീ പതിസ്ഥലമാണ്."
    },
    {
      "number": 22,
      "text": "അതിക്രമികളുടെ സങ്കേതം."
    },
    {
      "number": 23,
      "text": "അവരതില്‍ യുഗങ്ങളോളം വസിക്കും."
    },
    {
      "number": 24,
      "text": "കുളിരോ കുടിനീരോ അവരവിടെ അനുഭവിക്കുകയില്ല."
    },
    {
      "number": 25,
      "text": "തിളക്കുന്ന വെള്ളവും ചലവുമല്ലാതെ."
    },
    {
      "number": 26,
      "text": "അര്‍ഹിക്കുന്ന പ്രതിഫലം."
    },
    {
      "number": 27,
      "text": "തീര്‍ച്ചയായും അവര്‍ വിചാരണ പ്രതീക്ഷിക്കുന്നവരായിരുന്നില്ല."
    },
    {
      "number": 28,
      "text": "നമ്മുടെ താക്കീതുകളെ അവര്‍ അപ്പാടെ കള്ളമാക്കി തള്ളി."
    },
    {
      "number": 29,
      "text": "എല്ലാ കാര്യവും നാം കൃത്യമായി രേഖപ്പെടുത്തി വെച്ചിട്ടുണ്ട്."
    },
    {
      "number": 30,
      "text": "അതിനാല്‍ നിങ്ങള്‍ അനുഭവിച്ചുകൊള്ളുക. നിങ്ങള്‍ക്കു ശിക്ഷയല്ലാതൊന്നും വര്‍ധിപ്പിച്ചു തരാനില്ല."
    },
    {
      "number": 31,
      "text": "ഭക്തന്മാര്‍ക്ക് വിജയം ഉറപ്പ്."
    },
    {
      "number": 32,
      "text": "അവര്‍ക്ക് സ്വര്‍ഗത്തോപ്പുകളും മുന്തിരിക്കുലകളുമുണ്ട്."
    },
    {
      "number": 33,
      "text": "തുടുത്ത മാറിടമുള്ള തുല്യവയസ്കരായ തരുണികളും."
    },
    {
      "number": 34,
      "text": "നിറഞ്ഞ കോപ്പകളും."
    },
    {
      "number": 35,
      "text": "അവരവിടെ പൊയ്മൊഴികളോ വിടുവാക്കുകളോ കേള്‍ക്കുകയില്ല."
    },
    {
      "number": 36,
      "text": "നിന്റെ നാഥനില്‍ നിന്നുള്ള പ്രതിഫലമായാണത്. അവരര്‍ഹിക്കുന്ന സമ്മാനം."
    },
    {
      "number": 37,
      "text": "അവന്‍, ആകാശഭൂമികളുടെയും അവയ്ക്കിടയിലുള്ളവയുടെയും നാഥനാണ്. ദയാപരന്‍. അവനുമായി നേരില്‍ സംഭാഷണം നടത്താനാര്‍ക്കുമാവില്ല."
    },
    {
      "number": 38,
      "text": "ജിബ്രീലും മറ്റു മലക്കുകളും അണിനിരക്കും ദിനമാണ് അതുണ്ടാവുക. അന്നാര്‍ക്കും സംസാരിക്കാനാവില്ല; കരുണാനിധിയായ നാഥന്‍ അനുവാദം നല്‍കിയവന്നും സത്യം പറഞ്ഞവന്നുമൊഴികെ."
    },
    {
      "number": 39,
      "text": "അതത്രെ സത്യദിനം. അതിനാല്‍ ഇഷ്ടമുള്ളവന്‍ തന്റെ നാഥങ്കലേക്ക് മടങ്ങാനുള്ള മാര്‍ഗമവലംബിക്കട്ടെ."
    },
    {
      "number": 40,
      "text": "ആസന്നമായ ശിക്ഷയെ സംബന്ധിച്ച് തീര്‍ച്ചയായും നാം നിങ്ങള്‍ക്ക് താക്കീതു നല്‍കിയിരിക്കുന്നു. മനുഷ്യന്‍ തന്റെ ഇരു കരങ്ങളും ചെയ്തുവെച്ചത് നോക്കിക്കാണും ദിനം. അന്ന് സത്യനിഷേധി പറയും: \"ഞാന്‍ മണ്ണായിരുന്നെങ്കില്‍ എത്ര നന്നായേനെ.”"
    }
  ]
}