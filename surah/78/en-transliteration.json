{
  "surah": 78,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "AAamma yatas<u>a</u>aloon<b>a</b>"
    },
    {
      "number": 2,
      "text": "AAani a<b>l</b>nnabai alAAa<i><u>th</u></i>eem<b>i</b>"
    },
    {
      "number": 3,
      "text": "Alla<u>th</u>ee hum feehi mukhtalifoon<b>a</b>"
    },
    {
      "number": 4,
      "text": "Kall<u>a</u> sayaAAlamoon<b>a</b>"
    },
    {
      "number": 5,
      "text": "Thumma kall<u>a</u> sayaAAlamoon<b>a</b>"
    },
    {
      "number": 6,
      "text": "Alam najAAali alar<u>d</u>a mih<u>a</u>d<u>a</u><b>n</b>"
    },
    {
      "number": 7,
      "text": "Wa<b>a</b>ljib<u>a</u>la awt<u>a</u>d<u>a</u><b>n</b>"
    },
    {
      "number": 8,
      "text": "Wakhalaqn<u>a</u>kum azw<u>a</u>j<u>a</u><b>n</b>"
    },
    {
      "number": 9,
      "text": "WajaAAaln<u>a</u> nawmakum sub<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 10,
      "text": "WajaAAaln<u>a</u> allayla lib<u>a</u>s<u>a</u><b>n</b>"
    },
    {
      "number": 11,
      "text": "WajaAAaln<u>a</u> a<b>l</b>nnah<u>a</u>ra maAA<u>a</u>sh<u>a</u><b>n</b>"
    },
    {
      "number": 12,
      "text": "Wabanayn<u>a</u> fawqakum sabAAan shid<u>a</u>d<u>a</u><b>n</b>"
    },
    {
      "number": 13,
      "text": "WajaAAaln<u>a</u> sir<u>a</u>jan wahh<u>a</u>j<u>a</u><b>n</b>"
    },
    {
      "number": 14,
      "text": "Waanzaln<u>a</u> mina almuAA<u>s</u>ir<u>a</u>ti m<u>a</u>an thajj<u>a</u>j<u>a</u><b>n</b>"
    },
    {
      "number": 15,
      "text": "Linukhrija bihi <u>h</u>abban wanab<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 16,
      "text": "Wajann<u>a</u>tin alf<u>a</u>f<u>a</u><b>n</b>"
    },
    {
      "number": 17,
      "text": "Inna yawma alfa<u>s</u>li k<u>a</u>na meeq<u>a</u>t<u>a</u><b>n</b>"
    },
    {
      "number": 18,
      "text": "Yawma yunfakhu fee a<b>l</b><u>ss</u>oori fatatoona afw<u>a</u>j<u>a</u><b>n</b>"
    },
    {
      "number": 19,
      "text": "Wafuti<u>h</u>ati a<b>l</b>ssam<u>a</u>o fak<u>a</u>nat abw<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 20,
      "text": "Wasuyyirati aljib<u>a</u>lu fak<u>a</u>nat sar<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 21,
      "text": "Inna jahannama k<u>a</u>nat mir<u>sa</u>d<u>a</u><b>n</b>"
    },
    {
      "number": 22,
      "text": "Li<b>l</b><u>tta</u>gheena ma<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 23,
      "text": "L<u>a</u>bitheena feeh<u>a</u> a<u>h</u>q<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 24,
      "text": "L<u>a</u> ya<u>th</u>ooqoona feeh<u>a</u> bardan wal<u>a</u> shar<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 25,
      "text": "Ill<u>a</u> <u>h</u>ameeman waghass<u>a</u>q<u>a</u><b>n</b>"
    },
    {
      "number": 26,
      "text": "Jaz<u>a</u>an wif<u>a</u>q<u>a</u><b>n</b>"
    },
    {
      "number": 27,
      "text": "Innahum k<u>a</u>noo l<u>a</u> yarjoona <u>h</u>is<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 28,
      "text": "Waka<u>thth</u>aboo bi<u>a</u>y<u>a</u>tin<u>a</u> ki<u>ththa</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 29,
      "text": "Wakulla shayin a<u>hs</u>ayn<u>a</u>hu kit<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 30,
      "text": "Fa<u>th</u>ooqoo falan nazeedakum ill<u>a</u> AAa<u>tha</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 31,
      "text": "Inna lilmuttaqeena maf<u>a</u>z<u>a</u><b>n</b>"
    },
    {
      "number": 32,
      "text": "<u>H</u>ad<u>a</u>iqa waaAAn<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 33,
      "text": "Wakaw<u>a</u>AAiba atr<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 34,
      "text": "Wakasan dih<u>a</u>q<u>a</u><b>n</b>"
    },
    {
      "number": 35,
      "text": "L<u>a</u> yasmaAAoona feeh<u>a</u> laghwan wal<u>a</u> ki<u>ththa</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 36,
      "text": "Jaz<u>a</u>an min rabbika AAa<u>ta</u>an <u>h</u>is<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 37,
      "text": "Rabbi a<b>l</b>ssam<u>a</u>w<u>a</u>ti wa<b>a</b>lar<u>d</u>i wam<u>a</u> baynahum<u>a</u> a<b>l</b>rra<u>h</u>m<u>a</u>ni l<u>a</u> yamlikoona minhu khi<u>ta</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 38,
      "text": "Yawma yaqoomu a<b>l</b>rroo<u>h</u>u wa<b>a</b>lmal<u>a</u>ikatu <u>s</u>affan l<u>a</u> yatakallamoona ill<u>a</u> man a<u>th</u>ina lahu a<b>l</b>rra<u>h</u>m<u>a</u>nu waq<u>a</u>la <u>s</u>aw<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 39,
      "text": "<u>Tha</u>lika alyawmu al<u>h</u>aqqu faman sh<u>a</u>a ittakha<u>th</u>a il<u>a</u> rabbihi ma<u>a</u>b<u>a</u><b>n</b>"
    },
    {
      "number": 40,
      "text": "Inn<u>a</u> an<u>th</u>arn<u>a</u>kum AAa<u>tha</u>ban qareeban yawma yan<i><u>th</u></i>uru almaro m<u>a</u> qaddamat yad<u>a</u>hu wayaqoolu alk<u>a</u>firu y<u>a</u> laytanee kuntu tur<u>a</u>b<u>a</u><b>n</b>"
    }
  ]
}