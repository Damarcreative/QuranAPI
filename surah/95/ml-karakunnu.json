{
  "surah": 95,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "അത്തിയും ഒലീവും സാക്ഷി."
    },
    {
      "number": 2,
      "text": "സീനാമല സാക്ഷി."
    },
    {
      "number": 3,
      "text": "നിര്‍ഭീതമായ ഈ മക്കാനഗരം സാക്ഷി."
    },
    {
      "number": 4,
      "text": "തീര്‍ച്ചയായും മനുഷ്യനെ നാം മികവുറ്റ ഘടനയില്‍ സൃഷ്ടിച്ചു."
    },
    {
      "number": 5,
      "text": "പിന്നെ നാമവനെ പതിതരില്‍ പതിതനാക്കി."
    },
    {
      "number": 6,
      "text": "സത്യവിശ്വാസം സ്വീകരിച്ചവരെയും സല്‍ക്കര്‍മങ്ങള്‍ പ്രവര്‍ത്തിച്ചവരെയുമൊഴികെ. അവര്‍ക്ക്, അറുതിയില്ലാത്ത പ്രതിഫലമുണ്ട്."
    },
    {
      "number": 7,
      "text": "എന്നിട്ടും രക്ഷാശിക്ഷകളുടെ കാര്യത്തില്‍ നിന്നെ കള്ളമാക്കുന്നതെന്ത്?"
    },
    {
      "number": 8,
      "text": "വിധികര്‍ത്താക്കളില്‍ ഏറ്റവും നല്ല വിധികര്‍ത്താവ് അല്ലാഹുവല്ലയോ?"
    }
  ]
}