{
  "surah": 95,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "سوگند به [کوه‌] تین و زیتون،"
    },
    {
      "number": 2,
      "text": "و طور سینا،"
    },
    {
      "number": 3,
      "text": "و این شهر امن [و امان‌]،"
    },
    {
      "number": 4,
      "text": "[که‌] براستی انسان را در نیکوترین اعتدال آفریدیم."
    },
    {
      "number": 5,
      "text": "سپس او را به پست‌ترین [مراتب‌] پستی بازگردانیدیم؛"
    },
    {
      "number": 6,
      "text": "مگر کسانی را که گرویده و کارهای شایسته کرده‌اند، که پاداشی بی‌منّت خواهند داشت."
    },
    {
      "number": 7,
      "text": "پس چه چیز، تو را بعد [از این‌] به تکذیب جزا وامی‌دارد؟"
    },
    {
      "number": 8,
      "text": "آیا خدا نیکوترین داوران نیست؟"
    }
  ]
}