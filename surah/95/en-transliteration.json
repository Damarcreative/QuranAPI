{
  "surah": 95,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>al</b>tteeni wa<b>al</b>zzaytoon<b>i</b>"
    },
    {
      "number": 2,
      "text": "Wa<u>t</u>oori seeneen<b>a</b>"
    },
    {
      "number": 3,
      "text": "Wah<u>atha</u> albaladi alameen<b>i</b>"
    },
    {
      "number": 4,
      "text": "Laqad khalaqn<u>a</u> alins<u>a</u>na fee a<u>h</u>sani taqweem<b>in</b>"
    },
    {
      "number": 5,
      "text": "Thumma radadn<u>a</u>hu asfala s<u>a</u>fileen<b>a</b>"
    },
    {
      "number": 6,
      "text": "Ill<u>a</u> alla<u>th</u>eena <u>a</u>manoo waAAamiloo a<b>l</b><u>ssa</u>li<u>ha</u>ti falahum ajrun ghayru mamnoon<b>in</b>"
    },
    {
      "number": 7,
      "text": "Fam<u>a</u> yuka<u>thth</u>ibuka baAAdu bi<b>al</b>ddeen<b>i</b>"
    },
    {
      "number": 8,
      "text": "Alaysa All<u>a</u>hu bia<u>h</u>kami al<u>ha</u>kimeen<b>a</b>"
    }
  ]
}