{
  "surah": 95,
  "translation": "fa-moezzi",
  "ayahs": [
    {
      "number": 0,
      "text": "بنام خداوند بخشاینده مهربان‌"
    },
    {
      "number": 1,
      "text": "سوگند به انجیر و زیتون‌"
    },
    {
      "number": 2,
      "text": "و طور سینین (یا سینا)"
    },
    {
      "number": 3,
      "text": "و این شهر آرام (یا ایمن)"
    },
    {
      "number": 4,
      "text": "که آفریدیم انسان را در نکوتر اندام‌"
    },
    {
      "number": 5,
      "text": "سپس بازگردانیدیمش فرود فرودین‌"
    },
    {
      "number": 6,
      "text": "مگر آنان که ایمان آوردند و کردار شایسته کردند که ایشان را است مزدی بی‌پایان‌"
    },
    {
      "number": 7,
      "text": "پس چه چیز تکذیب کند تو را از این پس به دین‌"
    },
    {
      "number": 8,
      "text": "آیا نیست خدا حکم‌کننده‌ترین حکم‌کنندگان‌"
    }
  ]
}