{
  "surah": 95,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Клянусь смоковницей и маслиной,"
    },
    {
      "number": 2,
      "text": "и горою Синаем,"
    },
    {
      "number": 3,
      "text": "и этим городом безопасным!"
    },
    {
      "number": 4,
      "text": "Мы сотворили человека лучшим сложением,"
    },
    {
      "number": 5,
      "text": "а потом вернем его в нижайшее из низких (состояний),"
    },
    {
      "number": 6,
      "text": "кроме тех, которые уверовали и творили добрые дела, - им награда неисчислимая!"
    },
    {
      "number": 7,
      "text": "Что же после этого заставляет считать тебя лгущим о суде?"
    },
    {
      "number": 8,
      "text": "Разве Аллах не лучший из решающих?"
    }
  ]
}