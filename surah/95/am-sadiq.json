{
  "surah": 95,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በበለስና በዘይት ወይራ እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "በሲኒን ተራራም፤"
    },
    {
      "number": 3,
      "text": "በዚህ በጸጥተኛው አገርም (እምላለሁ)፡፡"
    },
    {
      "number": 4,
      "text": "ሰውን በጣም በአማረ አቋም ላይ ፈጠርነው፡፡"
    },
    {
      "number": 5,
      "text": "ከዚያም (ከፊሉን) ከዝቅተኞች ሁሉ በታች አድርገን መለስነው፡፡"
    },
    {
      "number": 6,
      "text": "ግን እነዚያ ያመኑት መልካሞችንም የሠሩት ለእነርሱ ተቆራጭ ያልኾነ ምንዳ አልላቸው፡፡"
    },
    {
      "number": 7,
      "text": "ታዲያ ከዚህ በኋላ በፍርዱ ምን አስተባባይ አደረገህ?"
    },
    {
      "number": 8,
      "text": "አላህ ከፈራጆች ሁሉ ይበልጥ ፈራጅ አይደለምን? (ነው)፡፡"
    }
  ]
}