{
  "surah": 95,
  "translation": "fa-gharaati",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند بخشنده‌ی مهربان."
    },
    {
      "number": 1,
      "text": "سوگند به انجیر و زیتون!"
    },
    {
      "number": 2,
      "text": "سوگند به طور سینا!"
    },
    {
      "number": 3,
      "text": "سوگند به [مکه] این شهر امن!"
    },
    {
      "number": 4,
      "text": "که ما انسان را در نیکوترین ساختار آفریدیم."
    },
    {
      "number": 5,
      "text": "سپس او را به پست‌ترین مرحله بازگرداندیم."
    },
    {
      "number": 6,
      "text": "مگر کسانی که ایمان آوردند و کارهای شایسته کردند که آنان پاداشی همیشه ماندگار دارند."
    },
    {
      "number": 7,
      "text": "پس [ای انسان!] بعد از این [همه دلایل‌]، چه چیزی تو را به تکذیب قیامت وامی‌دارد؟"
    },
    {
      "number": 8,
      "text": "آیا خدا بهترینِ داوران نیست؟"
    }
  ]
}