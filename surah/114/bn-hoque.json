{
  "surah": 114,
  "translation": "bn-hoque",
  "ayahs": [
    {
      "number": 1,
      "text": "তুমি বলে যাও -- ''আমি আশ্রয় চাইছি মানুষের প্রভুর কাছে, --"
    },
    {
      "number": 2,
      "text": "''মানুষের মালিকের, --"
    },
    {
      "number": 3,
      "text": "''মানুষের উপাস্যের,"
    },
    {
      "number": 4,
      "text": "''গোপনে আনাগোনাকারীর কুমন্ত্রণার অনিষ্ট থেকে, --"
    },
    {
      "number": 5,
      "text": "''যে মানুষের বুকের ভেতরে কুমন্ত্রণা দেয়,"
    },
    {
      "number": 6,
      "text": "''জিনের অথবা মানুষের মধ্যে থেকে।’’"
    }
  ]
}