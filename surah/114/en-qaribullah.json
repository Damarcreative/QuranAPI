  "surah": 114,
  "translation": "en-qaribullah",
  "ayahs": [
    {
      "number": 0,
      "text": "In the Name of Allah, the Merciful, the Most Merciful"
    },
    {
      "number": 1,
      "text": "Say: 'I take refuge with the Lord of people,"
    },
    {
      "number": 2,
      "text": "the King of people,"
    },
    {
      "number": 3,
      "text": "the God of people,"
    },
    {
      "number": 4,
      "text": "from the evil of the slinking whisperer."
    },
    {
      "number": 5,
      "text": "who whispers in the chests of people,"
    },
    {
      "number": 6,
      "text": "both jinn and people.'"
    }
  ]
}