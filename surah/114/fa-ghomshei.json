{
  "surah": 114,
  "translation": "fa-ghomshei",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند بخشنده مهربان"
    },
    {
      "number": 1,
      "text": "بگو: من پناه می‌جویم به پروردگار آدمیان."
    },
    {
      "number": 2,
      "text": "پادشاه آدمیان."
    },
    {
      "number": 3,
      "text": "یکتا معبود آدمیان."
    },
    {
      "number": 4,
      "text": "از شرّ آن وسوسه‌گر نهانی."
    },
    {
      "number": 5,
      "text": "آن شیطان که وسوسه و اندیشه بد افکند در دل مردمان."
    },
    {
      "number": 6,
      "text": "چه آن شیطان از جنس جن باشد و یا از نوع انسان."
    }
  ]
}