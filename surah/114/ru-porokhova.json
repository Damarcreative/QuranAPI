{
  "surah": 114,
  "translation": "ru-porokhova",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Всемилостивого, Милосердного!"
    },
    {
      "number": 1,
      "text": "Скажи: \"Ищу спасенья я у Господа людей,"
    },
    {
      "number": 2,
      "text": "Властителя людей,"
    },
    {
      "number": 3,
      "text": "У Бога человеческого рода"
    },
    {
      "number": 4,
      "text": "От зла недоброго смутьяна, Что, наущая, исчезает, -"
    },
    {
      "number": 5,
      "text": "Кто смуту вносит В сердце человека"
    },
    {
      "number": 6,
      "text": "И обитает среди джиннов и людей\"."
    }
  ]
}