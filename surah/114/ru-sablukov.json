{
  "surah": 114,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Скажи: \"Ищу убежища у Господа людей,"
    },
    {
      "number": 2,
      "text": "Царя людей,"
    },
    {
      "number": 3,
      "text": "Бога людей,"
    },
    {
      "number": 4,
      "text": "от злобы скрытного искусителя,"
    },
    {
      "number": 5,
      "text": "Искушающего сердца людей,"
    },
    {
      "number": 6,
      "text": "От гениев и людей\"."
    }
  ]
}