{
  "surah": 114,
  "translation": "fa-sadeqi",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خدای رحمتگر بر آفریدگان، رحمتگر بر ویژگان‌"
    },
    {
      "number": 1,
      "text": "بگو: «پناه می‌برم به پروردگار مردم؛»"
    },
    {
      "number": 2,
      "text": "«(به) مالک و حاکم (بر) مردم؛»"
    },
    {
      "number": 3,
      "text": "«(به) معبود مردم.»"
    },
    {
      "number": 4,
      "text": "«از شرّ وسوسه‌گر بس فراری و پنهان‌گر؛»"
    },
    {
      "number": 5,
      "text": "«آن که در درون سینه‌های مردم وسوسه می‌کند؛»"
    },
    {
      "number": 6,
      "text": "«(خواه) از جنیان و (خواه) انسان!»"
    }
  ]
}