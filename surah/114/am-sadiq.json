{
  "surah": 114,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በል «በሰዎች ፈጣሪ እጠበቃለሁ፡፡"
    },
    {
      "number": 2,
      "text": "«የሰዎች ሁሉ ንጉሥ በኾነው፡፡"
    },
    {
      "number": 3,
      "text": "«የሰዎች አምላክ በኾነው፡፡"
    },
    {
      "number": 4,
      "text": "«ብቅ እልም ባይ ከኾነው ጎትጓች (ሰይጣን) ክፋት፡፡"
    },
    {
      "number": 5,
      "text": "«ከዚያ በሰዎች ልቦች ውስጥ የሚጎተጉት ከኾነው፡፡"
    },
    {
      "number": 6,
      "text": "«ከጋኔኖችም ከሰዎችም (ሰይጣናት እጠበቃለሁ በል)፡፡»"
    }
  ]
}