{
  "surah": 114,
  "translation": "fa-ansarian",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خدا که رحمتش بی‌اندازه است و مهربانی‌اش همیشگی."
    },
    {
      "number": 1,
      "text": "بگو: پناه می برم به پروردگار مردم"
    },
    {
      "number": 2,
      "text": "[به] پادشاه مردم"
    },
    {
      "number": 3,
      "text": "[به] معبود مردم"
    },
    {
      "number": 4,
      "text": "از زیان وسوسه گر کمین گرفته و پنهان،"
    },
    {
      "number": 5,
      "text": "آنکه همواره در سینه های مردم وسوسه می کند"
    },
    {
      "number": 6,
      "text": "از جنّیان و آدمیان."
    }
  ]
}