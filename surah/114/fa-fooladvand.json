{
  "surah": 114,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 1,
      "text": "بگو: «پناه می‌برم به پروردگار مردم،"
    },
    {
      "number": 2,
      "text": "پادشاه مردم،"
    },
    {
      "number": 3,
      "text": "معبود مردم،"
    },
    {
      "number": 4,
      "text": "از شرّ وسوسه‌گر نهانی؛"
    },
    {
      "number": 5,
      "text": "آن کس که در سینه‌های مردم وسوسه می‌کند،"
    },
    {
      "number": 6,
      "text": "چه از جنّ و [چه از] انس.»"
    }
  ]
}