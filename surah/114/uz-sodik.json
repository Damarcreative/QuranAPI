{
  "surah": 114,
  "translation": "uz-sodik",
  "ayahs": [
    {
      "number": 1,
      "text": "Одамлар Роббисидан."
    },
    {
      "number": 2,
      "text": "Одамлар Подшоҳидан."
    },
    {
      "number": 3,
      "text": "Одамлар Илоҳидан паноҳ сўрайман."
    },
    {
      "number": 4,
      "text": "Беркиниб, кўриниб турувчи васвоснинг."
    },
    {
      "number": 5,
      "text": "Одамлар қалбига васваса соладиганнинг."
    },
    {
      "number": 6,
      "text": "Жинлардан ва одамлардан бўлганнинг ёмонлигидан, деб айт. (Оятда зикр қилинган «беркиниб, кўриб турувчи»дан мурод шайтондир.)"
    }
  ]
}