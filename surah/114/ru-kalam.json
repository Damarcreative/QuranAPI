{
  "surah": 114,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 1,
      "text": "Скажи: «Я прибегаю к защите Господа людей,"
    },
    {
      "number": 2,
      "text": "Властелина людей,"
    },
    {
      "number": 3,
      "text": "Бога людей,"
    },
    {
      "number": 4,
      "text": "от зла искусителя, отступающего [при упоминании Аллаха],"
    },
    {
      "number": 5,
      "text": "который нашептывает в сердца людей."
    },
    {
      "number": 6,
      "text": "[Шайтан бывает] Из джиннов и людей»."
    }
  ]
}