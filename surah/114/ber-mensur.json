  "ayahs": [
    {
      "number": 0,
      "text": "S yisem n Öebbi, Aênin Ipêunun,"
    },
    {
      "number": 1,
      "text": "Ini: \"ad iyi Iûûeô, Mass n yimdanen!"
    },
    {
      "number": 2,
      "text": "Agellid n yimdanen,"
    },
    {
      "number": 3,
      "text": "Öebbi n yimdanen,"
    },
    {
      "number": 4,
      "text": "si lhemm u$way n win ipfezwin,"
    },
    {
      "number": 5,
      "text": "i i$ewwun idmaren n yimdanen,"
    },
    {
      "number": 6,
      "text": "si leonun u seg yimdanen."
