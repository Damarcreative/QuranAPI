{
  "surah": 84,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "ሰማይ በተቀደደች ጊዜ፤"
    },
    {
      "number": 2,
      "text": "ለጌታዋም (ትዕዛዝ) በሰማች ጊዜ፤ (ልትሰማ) ተገባትም፤"
    },
    {
      "number": 3,
      "text": "ምድርም በተለጠጠች ጊዜ፤"
    },
    {
      "number": 4,
      "text": "በውስጧ ያለውንም ሁሉ በጣለችና ባዶ በኾነች ጊዜ፤"
    },
    {
      "number": 5,
      "text": "ለጌታዋም በሰማች ጊዜ፤ (መስማት) ተገባትም፤ (ሰው ሁሉ ሥራውን ይገናኛል)፡፡"
    },
    {
      "number": 6,
      "text": "አንተ ሰው ሆይ! አንተ ጌታህን (በሞት) እስከምትገናኝ ድረስ ልፋትን ለፊ ነህ፤ ተገናኚውም ነህ፡፡"
    },
    {
      "number": 7,
      "text": "መጽሐፉን በቀኙ የተሰጠ ሰውማ፤"
    },
    {
      "number": 8,
      "text": "በእርግጥ ቀላልን ምርመራ ይመረመራል፡፡"
    },
    {
      "number": 9,
      "text": "ወደ ቤተሰቦቹም ተደሳች ኾኖ ይመለሳል፡፡"
    },
    {
      "number": 10,
      "text": "መጽሐፉን በጀርባው ኋላ የተሰጠ ሰውማ፤"
    },
    {
      "number": 11,
      "text": "(ዋ! ጥፋቴ በማለት) ጥፋትን በእርግጥ ይጠራል፡፡"
    },
    {
      "number": 12,
      "text": "የተጋጋመች እሳትንም ይገባል፡፡"
    },
    {
      "number": 13,
      "text": "እርሱ በቤተሰቡ ውስጥ ተደሳች ነበርና፡፡"
    },
    {
      "number": 14,
      "text": "እርሱ (ወደ አላህ) የማይመለስ መኾኑን አስቧልና፡፡"
    },
    {
      "number": 15,
      "text": "አይደለም (ይመለሳል)፡፡ ጌታው በእርሱ (መመለስ) ዐዋቂ ነበር፤ (ነውም)፡፡"
    },
    {
      "number": 16,
      "text": "አትካዱ፤ በወጋገኑ እምላለሁ፡፡"
    },
    {
      "number": 17,
      "text": "በሌሊቱም በሰበሰውም ሁሉ፤"
    },
    {
      "number": 18,
      "text": "በጨረቃውም በሞላ ጊዜ (እምላለሁ)፡፡"
    },
    {
      "number": 19,
      "text": "ከኹነታ በኋላ ወደ ሌላ ኹነታ ትለዋወጣላችሁ፡፡"
    },
    {
      "number": 20,
      "text": "የማያምኑት ለእነርሱ ምን አላቸው?"
    },
    {
      "number": 21,
      "text": "በእነርሱም ላይ ቁርኣን በተነበበ ጊዜ የማይሰግዱት፤ (ምንአላቸው?)"
    },
    {
      "number": 22,
      "text": "በእርግጡ እነዚያ የካዱት (በትንሣኤ) ያስተባብላሉ፡፡"
    },
    {
      "number": 23,
      "text": "አላህም (በልቦቻቸው) የሚቆጥሩትን ዐዋቂ ነው፡፡"
    },
    {
      "number": 24,
      "text": "በአሳማሚ ቅጣትም አብስራቸው፡፡"
    },
    {
      "number": 25,
      "text": "ግን እነዚያ ያመኑና መልካሞችን የሠሩ ለእነርሱ የማይቆረጥ ምንዳ አልላቸው፡፡"
    }
  ]
}