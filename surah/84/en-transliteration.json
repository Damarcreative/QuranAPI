{
  "surah": 84,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "I<u>tha</u> a<b>l</b>ssam<u>a</u>o inshaqqat"
    },
    {
      "number": 2,
      "text": "Waa<u>th</u>inat lirabbih<u>a</u> wa<u>h</u>uqqat"
    },
    {
      "number": 3,
      "text": "Wai<u>tha</u> alar<u>d</u>u muddat"
    },
    {
      "number": 4,
      "text": "Waalqat m<u>a</u> feeh<u>a</u> watakhallat"
    },
    {
      "number": 5,
      "text": "Waa<u>th</u>inat lirabbih<u>a</u> wa<u>h</u>uqqat"
    },
    {
      "number": 6,
      "text": "Y<u>a</u> ayyuh<u>a</u> alins<u>a</u>nu innaka k<u>a</u>di<u>h</u>un il<u>a</u> rabbika kad<u>h</u>an famul<u>a</u>qeeh<b>i</b>"
    },
    {
      "number": 7,
      "text": "Faam<u>a</u> man ootiya kit<u>a</u>bahu biyameenih<b>i</b>"
    },
    {
      "number": 8,
      "text": "Fasawfa yu<u>ha</u>sabu <u>h</u>is<u>a</u>ban yaseer<u>a</u><b>n</b>"
    },
    {
      "number": 9,
      "text": "Wayanqalibu il<u>a</u> ahlihi masroor<u>a</u><b>n</b>"
    },
    {
      "number": 10,
      "text": "Waamm<u>a</u> man ootiya kit<u>a</u>bahu war<u>a</u>a <i><u>th</u></i>ahrih<b>i</b>"
    },
    {
      "number": 11,
      "text": "Fasawfa yadAAoo thuboor<u>a</u><b>n</b>"
    },
    {
      "number": 12,
      "text": "Waya<u>s</u>l<u>a</u> saAAeer<u>a</u><b>n</b>"
    },
    {
      "number": 13,
      "text": "Innahu k<u>a</u>na fee ahlihi masroor<u>a</u><b>n</b>"
    },
    {
      "number": 14,
      "text": "Innahu <i><u>th</u></i>anna an lan ya<u>h</u>oor<b>a</b>"
    },
    {
      "number": 15,
      "text": "Bal<u>a</u> inna rabbahu k<u>a</u>na bihi ba<u>s</u>eer<u>a</u><b>n</b>"
    },
    {
      "number": 16,
      "text": "Fal<u>a</u> oqsimu bi<b>al</b>shshafaq<b>i</b>"
    },
    {
      "number": 17,
      "text": "Wa<b>a</b>llayli wam<u>a</u> wasaq<b>a</b>"
    },
    {
      "number": 18,
      "text": "Wa<b>a</b>lqamari i<u>tha</u> ittasaq<b>a</b>"
    },
    {
      "number": 19,
      "text": "Latarkabunna <u>t</u>abaqan AAan <u>t</u>abaq<b>in</b>"
    },
    {
      "number": 20,
      "text": "Fam<u>a</u> lahum l<u>a</u> yuminoon<b>a</b>"
    },
    {
      "number": 21,
      "text": "Wai<u>tha</u> quria AAalayhimu alqur<u>a</u>nu l<u>a</u> yasjudoon<b>a</b>"
    },
    {
      "number": 22,
      "text": "Bali alla<u>th</u>eena kafaroo yuka<u>thth</u>iboon<b>a</b>"
    },
    {
      "number": 23,
      "text": "Wa<b>A</b>ll<u>a</u>hu aAAlamu bim<u>a</u> yooAAoon<b>a</b>"
    },
    {
      "number": 24,
      "text": "Fabashshirhum biAAa<u>tha</u>bin aleem<b>in</b>"
    },
    {
      "number": 25,
      "text": "Ill<u>a</u> alla<u>th</u>eena <u>a</u>manoo waAAamiloo a<b>l</b><u>ssa</u>li<u>ha</u>ti lahum ajrun ghayru mamnoon<b>in</b>"
    }
  ]
}