{
  "surah": 84,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "ആകാശം പൊട്ടിപ്പിളരുമ്പോള്‍!"
    },
    {
      "number": 2,
      "text": "അത് തന്റെ നാഥന്ന് കീഴ്പ്പെടുമ്പോള്‍!- അത് അങ്ങനെ ചെയ്യാന്‍ കടപ്പെട്ടിരിക്കുന്നുവല്ലോ."
    },
    {
      "number": 3,
      "text": "ഭൂമി പരത്തപ്പെടുമ്പോള്‍-"
    },
    {
      "number": 4,
      "text": "അതിനകത്തുള്ളതിനെ പുറത്തേക്ക് തള്ളുകയും അത് ശൂന്യമായിത്തീരുകയും."
    },
    {
      "number": 5,
      "text": "അത് അതിന്റെ നാഥന്ന് കീഴ്പ്പെടുകയും ചെയ്യുമ്പോള്‍! -അങ്ങനെ ചെയ്യാന്‍ അത് കടപ്പെട്ടിരിക്കുന്നുവല്ലോ."
    },
    {
      "number": 6,
      "text": "അല്ലയോ മനുഷ്യാ; നീ നിന്റെ നാഥനിലേക്ക് കടുത്ത ക്ളേശത്തോടെ ചെന്നെത്തുന്നവനാണ്; അങ്ങനെ അവനുമായി കണ്ടുമുട്ടുന്നവനും."
    },
    {
      "number": 7,
      "text": "എന്നാല്‍ തന്റെ കര്‍മപുസ്തകം വലതു കയ്യില്‍ നല്‍കപ്പെടുന്നവനോ;"
    },
    {
      "number": 8,
      "text": "അവന് നിസ്സാരമായ വിചാരണയേ ഉണ്ടാവുകയുള്ളൂ."
    },
    {
      "number": 9,
      "text": "അവന്‍ തന്റെ വീട്ടുകാരുടെ അടുത്തേക്ക് സന്തോഷത്തോടെ മടങ്ങിച്ചെല്ലും."
    },
    {
      "number": 10,
      "text": "എന്നാല്‍ കര്‍മപുസ്തകം തന്റെ പിന്‍ഭാഗത്തൂടെ നല്‍കപ്പെടുന്നവനോ;"
    },
    {
      "number": 11,
      "text": "അവന്‍ “നാശമേ”യെന്ന് വിലപിച്ചു കൊണ്ടിരിക്കും."
    },
    {
      "number": 12,
      "text": "ആളിക്കത്തുന്ന നരകത്തീയില്‍ കത്തിയെരിയും."
    },
    {
      "number": 13,
      "text": "തീര്‍ച്ചയായും അവന്‍ തന്റെ കുടുംബക്കാര്‍ക്കിടയില്‍ ആഹ്ളാദത്തോടെ കഴിയുന്നവനായിരുന്നു."
    },
    {
      "number": 14,
      "text": "താന്‍ മടങ്ങിവരില്ലെന്നാണ് അവന്‍ കരുതിയത്."
    },
    {
      "number": 15,
      "text": "എന്നാല്‍ ഉറപ്പായും അവന്റെ നാഥന്‍ അവനെ സൂക്ഷ്മമായി നിരീക്ഷിക്കുന്നവനായിരുന്നു."
    },
    {
      "number": 16,
      "text": "ഞാനിതാ സത്യംചെയ്യുന്നു; സൂര്യാസ്തമയ സമയത്തെ ശോഭകൊണ്ട്."
    },
    {
      "number": 17,
      "text": "രാത്രിയും അതുള്‍ക്കൊള്ളുന്നതുകൊണ്ടും."
    },
    {
      "number": 18,
      "text": "ചന്ദ്രന്‍ സാക്ഷി- അതു പൂര്‍ണത പ്രാപിക്കുമ്പോള്‍."
    },
    {
      "number": 19,
      "text": "നിശ്ചയമായും നിങ്ങള്‍ പടിപടിയായി പുരോഗമിച്ചുകൊണ്ടിരിക്കും."
    },
    {
      "number": 20,
      "text": "എന്നിട്ടും അവര്‍ക്കെന്തു പറ്റി, അവര്‍ വിശ്വസിക്കുന്നില്ലല്ലോ?"
    },
    {
      "number": 21,
      "text": "ഖുര്‍ആന്‍ ഓതിക്കേള്‍പിക്കുമ്പോള്‍ സാഷ്ടാംഗം പ്രണമിക്കുന്നുമില്ല."
    },
    {
      "number": 22,
      "text": "എന്നല്ല; സത്യനിഷേധികള്‍ അതിനെ കളവാക്കി തള്ളുകയാണ്."
    },
    {
      "number": 23,
      "text": "അവര്‍ മനസ്സില്‍ സൂക്ഷിക്കുന്നവയൊക്കെയും നന്നായറിയുന്നവനാണ് അല്ലാഹു."
    },
    {
      "number": 24,
      "text": "അതിനാല്‍ നീ അവര്‍ക്ക് നോവേറിയ ശിക്ഷയെ സംബന്ധിച്ച് വിവരമറിയിക്കുക."
    },
    {
      "number": 25,
      "text": "സത്യവിശ്വാസം സ്വീകരിക്കുകയും സല്‍ക്കര്‍മങ്ങള്‍ പ്രവര്‍ത്തിക്കുകയും ചെയ്തവര്‍ക്കൊഴികെ. അവര്‍ക്ക് അറുതിയില്ലാത്ത പ്രതിഫലമുണ്ട്."
    }
  ]
}