{
  "surah": 100,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "以喘息而奔馳的馬隊盟誓,"
    },
    {
      "number": 2,
      "text": "以蹄發火花的馬隊盟誓,"
    },
    {
      "number": 3,
      "text": "以早晨出擊,"
    },
    {
      "number": 4,
      "text": "捲起塵埃,"
    },
    {
      "number": 5,
      "text": "攻入敵圍的馬隊盟誓,"
    },
    {
      "number": 6,
      "text": "人對于主, 確是孤負的。"
    },
    {
      "number": 7,
      "text": "他自己對那孤負確是見証的,"
    },
    {
      "number": 8,
      "text": "他對于財產確是酷好的。"
    },
    {
      "number": 9,
      "text": "難道他不知道嗎？當墳中的朽骨被揭發,"
    },
    {
      "number": 10,
      "text": "胸中的秘密被顯示的時侯,"
    },
    {
      "number": 11,
      "text": "在那日, 他們的主, 確是徹知他們的。"
    }
  ]
}