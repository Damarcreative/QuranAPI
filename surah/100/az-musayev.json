{
  "surah": 100,
  "translation": "az-musayev",
  "ayahs": [
    {
      "number": 1,
      "text": "And olsun tövşüyə-tövşüyə çapanlara!"
    },
    {
      "number": 2,
      "text": "And olsun dırnaqları ilə qığılcım çıxaranlara!"
    },
    {
      "number": 3,
      "text": "And olsun sübh çağı həmlə edənlərə ki,"
    },
    {
      "number": 4,
      "text": "hücuma keçib tozanaq qaldıraraq"
    },
    {
      "number": 5,
      "text": "qoşunun içərisinə soxulurlar."
    },
    {
      "number": 6,
      "text": "Həqiqətən, insan Rəbbinə qarşı yaman nankordur."
    },
    {
      "number": 7,
      "text": "Özü də bunun şahididir."
    },
    {
      "number": 8,
      "text": "Həqiqətən, o, var-dövlətə çox hərisdir."
    },
    {
      "number": 9,
      "text": "Məgər o bilmir ki, qəbirlərdə olanlar çıxardılacağı"
    },
    {
      "number": 10,
      "text": "və kökslərdə olanlar aşkar ediləcəyi zaman –"
    },
    {
      "number": 11,
      "text": "məhz o gün Rəbbi onlardan xəbərdar olacaqdır?"
    }
  ]
}