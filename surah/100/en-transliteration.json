  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>a</b>lAA<u>a</u>diy<u>a</u>ti <u>d</u>ab<u>ha</u><b>n</b>"
    },
    {
      "number": 2,
      "text": "Fa<b>a</b>lmooriy<u>a</u>ti qad<u>ha</u><b>n</b>"
    },
    {
      "number": 3,
      "text": "Fa<b>a</b>lmugheer<u>a</u>ti <u>s</u>ub<u>ha</u><b>n</b>"
    },
    {
      "number": 4,
      "text": "Faatharna bihi naqAA<u>a</u><b>n</b>"
    },
    {
      "number": 5,
      "text": "Fawasa<u>t</u>na bihi jamAA<u>a</u><b>n</b>"
    },
    {
      "number": 6,
      "text": "Inna alins<u>a</u>na lirabbihi lakanood<b>un</b>"
    },
    {
      "number": 7,
      "text": "Wainnahu AAal<u>a</u> <u>tha</u>lika lashaheed<b>un</b>"
    },
    {
      "number": 8,
      "text": "Wainnahu li<u>h</u>ubbi alkhayri lashadeed<b>un</b>"
    },
    {
      "number": 9,
      "text": "Afal<u>a</u> yaAAlamu i<u>tha</u> buAAthira m<u>a</u> fee alquboor<b>i</b>"
    },
    {
      "number": 10,
      "text": "Wa<u>h</u>u<u>ss</u>ila m<u>a</u> fee a<b>l</b><u>ss</u>udoor<b>i</b>"
    },
    {
      "number": 11,
      "text": "Inna rabbahum bihim yawmai<u>th</u>in lakhabeer<b>un</b>"
    }
  ]
