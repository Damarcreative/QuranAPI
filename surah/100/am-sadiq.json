{
  "surah": 100,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "እያለከለኩ ሩዋጮች በኾኑት (ፈረሶች) እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "(በሰኮናቸው) እያጋጩ እሳትን አውጪዎች በኾኑትም፤"
    },
    {
      "number": 3,
      "text": "በማለዳ ወራሪዎች በኾኑትም፤"
    },
    {
      "number": 4,
      "text": "በእርሱ አቧራን በቀሰቀሱትም፤"
    },
    {
      "number": 5,
      "text": "በ(ጠላት) ክቢ መካከል በእርሱ (በጧት) በተጋፈጡትም እምላለሁ፡፡"
    },
    {
      "number": 6,
      "text": "ሰው ለጌታው ብርቱ ከሓዲ ነው፡፡"
    },
    {
      "number": 7,
      "text": "እርሱም በዚህ ላይ መስካሪ ነው፡፡"
    },
    {
      "number": 8,
      "text": "እርሱም ገንዘብን ለመውደድ በጣም ብርቱ ነው፡፡"
    },
    {
      "number": 9,
      "text": "(ሰው) አያውቅምን? በመቃብሮች ያሉት (ሙታን) በተቀሰቀሱ ጊዜ፤"
    },
    {
      "number": 10,
      "text": "በልቦች ውስጥ ያለውም ሁሉ በተገለጸ ጊዜ (እንዴት እንደሚኾን)፡፡"
    },
    {
      "number": 11,
      "text": "ጌታቸው በዚያ ቀን በእነርሱ (ነገር) በእርግጥ ውስጠ አዋቂ ነው፡፡"
    }
  ]
}