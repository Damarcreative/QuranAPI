  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 0,
      "text": "Хвала Аллаху – Господу миров [создавшему мир и управляющему им],"
    },
    {
      "number": 1,
      "text": "Клянусь мчащимися, тяжело дышащими [конями]!"
    },
    {
      "number": 2,
      "text": "И клянусь [конями] высекающими [копытами] искры!"
    },
    {
      "number": 3,
      "text": "И [конями] нападающими на заре,"
    },
    {
      "number": 4,
      "text": "которые окутывают [врагов густой] пылью,"
    },
    {
      "number": 5,
      "text": "врываясь прямо в центр толпы."
    },
    {
      "number": 6,
      "text": "Поистине, человек своему Господу неблагодарен."
    },
    {
      "number": 7,
      "text": "И, поистине, он сам [человек] этому свидетель."
    },
    {
      "number": 8,
      "text": "Ведь он страстно любит [земные] блага."
    },
    {
      "number": 9,
      "text": "Разве он не знает, что, когда воскресят тех, кто в могилах,"
    },
    {
      "number": 10,
      "text": "и выявится все [тайное], что [было] в душах [людей],"
    },
    {
      "number": 11,
      "text": "их Господь будет, поистине, знать обо всем [и воздаст им за их убеждения и дела]?!"
    }
  ]
}