{
  "surah": 26,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "<u>Ta</u>seenmeem"
    },
    {
      "number": 2,
      "text": "Tilka <u>a</u>y<u>a</u>tu alkit<u>a</u>bi almubeen<b>i</b>"
    },
    {
      "number": 3,
      "text": "LaAAallaka b<u>a</u>khiAAun nafsaka all<u>a</u> yakoonoo mumineen<b>a</b>"
    },
    {
      "number": 4,
      "text": "In nasha nunazzil AAalayhim mina a<b>l</b>ssam<u>a</u>i <u>a</u>yatan fa<i><u>th</u></i>allat aAAn<u>a</u>quhum lah<u>a</u> kh<u>ad</u>iAAeen<b>a</b>"
    },
    {
      "number": 5,
      "text": "Wam<u>a</u> yateehim min <u>th</u>ikrin mina a<b>l</b>rra<u>h</u>m<u>a</u>ni mu<u>h</u>dathin ill<u>a</u> k<u>a</u>noo AAanhu muAAri<u>d</u>een<b>a</b>"
    },
    {
      "number": 6,
      "text": "Faqad ka<u>thth</u>aboo fasayateehim anb<u>a</u>o m<u>a</u> k<u>a</u>noo bihi yastahzioon<b>a</b>"
    },
    {
      "number": 7,
      "text": "Awalam yaraw il<u>a</u> alar<u>d</u>i kam anbatn<u>a</u> feeh<u>a</u> min kulli zawjin kareem<b>in</b>"
    },
    {
      "number": 8,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 9,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 10,
      "text": "Wai<u>th</u> n<u>a</u>d<u>a</u> rabbuka moos<u>a</u> ani iti alqawma a<b>l</b><i><u>thth</u></i><u>a</u>limeen<b>a</b>"
    },
    {
      "number": 11,
      "text": "Qawma firAAawna al<u>a</u> yattaqoon<b>a</b>"
    },
    {
      "number": 12,
      "text": "Q<u>a</u>la rabbi innee akh<u>a</u>fu an yuka<u>thth</u>iboon<b>i</b>"
    },
    {
      "number": 13,
      "text": "Waya<u>d</u>eequ <u>s</u>adree wal<u>a</u> yan<u>t</u>aliqu lis<u>a</u>nee faarsil il<u>a</u> h<u>a</u>roon<b>a</b>"
    },
    {
      "number": 14,
      "text": "Walahum AAalayya <u>th</u>anbun faakh<u>a</u>fu an yaqtuloon<b>i</b>"
    },
    {
      "number": 15,
      "text": "Q<u>a</u>la kall<u>a</u> fa<b>i</b><u>th</u>hab<u>a</u> bi<u>a</u>y<u>a</u>tin<u>a</u> inn<u>a</u> maAAakum mustamiAAoon<b>a</b>"
    },
    {
      "number": 16,
      "text": "Fatiy<u>a</u> firAAawna faqool<u>a</u> inn<u>a</u> rasoolu rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 17,
      "text": "An arsil maAAan<u>a</u> banee isr<u>a</u>eel<b>a</b>"
    },
    {
      "number": 18,
      "text": "Q<u>a</u>la alam nurabbika feen<u>a</u> waleedan walabithta feen<u>a</u> min AAumurika sineen<b>a</b>"
    },
    {
      "number": 19,
      "text": "WafaAAalta faAAlataka allatee faAAalta waanta mina alk<u>a</u>fireen<b>a</b>"
    },
    {
      "number": 20,
      "text": "Q<u>a</u>la faAAaltuh<u>a</u> i<u>th</u>an waan<u>a</u> mina a<b>l</b><u>dda</u>lleen<b>a</b>"
    },
    {
      "number": 21,
      "text": "Fafarartu minkum lamm<u>a</u> khiftukum fawahaba lee rabbee <u>h</u>ukman wajaAAalanee mina almursaleen<b>a</b>"
    },
    {
      "number": 22,
      "text": "Watilka niAAmatun tamunnuh<u>a</u> AAalayya an AAabbadta banee isr<u>a</u>eel<b>a</b>"
    },
    {
      "number": 23,
      "text": "Q<u>a</u>la firAAawnu wam<u>a</u> rabbu alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 24,
      "text": "Q<u>a</u>la rabbu a<b>l</b>ssam<u>a</u>w<u>a</u>ti wa<b>a</b>lar<u>d</u>i wam<u>a</u> baynahum<u>a</u> in kuntum mooqineen<b>a</b>"
    },
    {
      "number": 25,
      "text": "Q<u>a</u>la liman <u>h</u>awlahu al<u>a</u> tastamiAAoon<b>a</b>"
    },
    {
      "number": 26,
      "text": "Q<u>a</u>la rabbukum warabbu <u>a</u>b<u>a</u>ikumu alawwaleen<b>a</b>"
    },
    {
      "number": 27,
      "text": "Q<u>a</u>la inna rasoolakumu alla<u>th</u>ee orsila ilaykum lamajnoon<b>un</b>"
    },
    {
      "number": 28,
      "text": "Q<u>a</u>la rabbu almashriqi wa<b>a</b>lmaghribi wam<u>a</u> baynahum<u>a</u> in kuntum taAAqiloon<b>a</b>"
    },
    {
      "number": 29,
      "text": "Q<u>a</u>la laini ittakha<u>th</u>ta il<u>a</u>han ghayree laajAAalannaka mina almasjooneen<b>a</b>"
    },
    {
      "number": 30,
      "text": "Q<u>a</u>la awalaw jituka bishayin mubeen<b>in</b>"
    },
    {
      "number": 31,
      "text": "Q<u>a</u>la fati bihi in kunta mina a<b>l</b><u>ssa</u>diqeen<b>a</b>"
    },
    {
      "number": 32,
      "text": "Faalq<u>a</u> AAa<u>sa</u>hu fai<u>tha</u> hiya thuAAb<u>a</u>nun mubeen<b>un</b>"
    },
    {
      "number": 33,
      "text": "WanazaAAa yadahu fai<u>tha</u> hiya bay<u>da</u>o li<b>l</b>nn<u>a</u><i><u>th</u></i>ireen<b>a</b>"
    },
    {
      "number": 34,
      "text": "Q<u>a</u>la lilmalai <u>h</u>awlahu inna h<u>atha</u> las<u>ah</u>irun AAaleem<b>un</b>"
    },
    {
      "number": 35,
      "text": "Yureedu an yukhrijakum min ar<u>d</u>ikum bisi<u>h</u>rihi fam<u>atha</u> tamuroon<b>a</b>"
    },
    {
      "number": 36,
      "text": "Q<u>a</u>loo arjih waakh<u>a</u>hu wa<b>i</b>bAAath fee almad<u>a</u>ini <u>ha</u>shireen<b>a</b>"
    },
    {
      "number": 37,
      "text": "Yatooka bikulli sa<u>hha</u>rin AAaleem<b>in</b>"
    },
    {
      "number": 38,
      "text": "FajumiAAa a<b>l</b>ssa<u>h</u>aratu limeeq<u>a</u>ti yawmin maAAloom<b>in</b>"
    },
    {
      "number": 39,
      "text": "Waqeela li<b>l</b>nn<u>a</u>si hal antum mujtamiAAoon<b>a</b>"
    },
    {
      "number": 40,
      "text": "LaAAallan<u>a</u> nattabiAAu a<b>l</b>ssa<u>h</u>arata in k<u>a</u>noo humu algh<u>a</u>libeen<b>a</b>"
    },
    {
      "number": 41,
      "text": "Falamm<u>a</u> j<u>a</u>a a<b>l</b>ssa<u>h</u>aratu q<u>a</u>loo lifirAAawna ainna lan<u>a</u> laajran in kunn<u>a</u> na<u>h</u>nu algh<u>a</u>libeen<b>a</b>"
    },
    {
      "number": 42,
      "text": "Q<u>a</u>la naAAam wainnakum i<u>th</u>an lamina almuqarrabeen<b>a</b>"
    },
    {
      "number": 43,
      "text": "Q<u>a</u>la lahum moos<u>a</u> alqoo m<u>a</u> antum mulqoon<b>a</b>"
    },
    {
      "number": 44,
      "text": "Faalqaw <u>h</u>ib<u>a</u>lahum waAAi<u>s</u>iyyahum waq<u>a</u>loo biAAizzati firAAawna inn<u>a</u> lana<u>h</u>nu algh<u>a</u>liboon<b>a</b>"
    },
    {
      "number": 45,
      "text": "Faalq<u>a</u> moos<u>a</u> AAa<u>sa</u>hu fai<u>tha</u> hiya talqafu m<u>a</u> yafikoon<b>a</b>"
    },
    {
      "number": 46,
      "text": "Faolqiya a<b>l</b>ssa<u>h</u>aratu s<u>a</u>jideen<b>a</b>"
    },
    {
      "number": 47,
      "text": "Q<u>a</u>loo <u>a</u>mann<u>a</u> birabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 48,
      "text": "Rabbi moos<u>a</u> wah<u>a</u>roon<b>a</b>"
    },
    {
      "number": 49,
      "text": "Q<u>a</u>la <u>a</u>mantum lahu qabla an <u>ath</u>ana lakum innahu lakabeerukumu alla<u>th</u>ee AAallamakumu a<b>l</b>ssi<u>h</u>ra falasawfa taAAlamoona laoqa<u>tt</u>iAAanna aydiyakum waarjulakum min khil<u>a</u>fin walao<u>s</u>allibannakum ajmaAAeen<b>a</b>"
    },
    {
      "number": 50,
      "text": "Q<u>a</u>loo l<u>a</u> <u>d</u>ayra inn<u>a</u> il<u>a</u> rabbin<u>a</u> munqaliboon<b>a</b>"
    },
    {
      "number": 51,
      "text": "Inn<u>a</u> na<u>t</u>maAAu an yaghfira lan<u>a</u> rabbun<u>a</u> kha<u>ta</u>y<u>a</u>n<u>a</u> an kunn<u>a</u> awwala almumineen<b>a</b>"
    },
    {
      "number": 52,
      "text": "Waaw<u>h</u>ayn<u>a</u> il<u>a</u> moos<u>a</u> an asri biAAib<u>a</u>dee innakum muttabaAAoon<b>a</b>"
    },
    {
      "number": 53,
      "text": "Faarsala firAAawnu fee almad<u>a</u>ini <u>ha</u>shireen<b>a</b>"
    },
    {
      "number": 54,
      "text": "Inna h<u>a</u>ol<u>a</u>i lashir<u>th</u>imatun qaleeloon<b>a</b>"
    },
    {
      "number": 55,
      "text": "Wainnahum lan<u>a</u> lagh<u>a</u>i<i><u>th</u></i>oon<b>a</b>"
    },
    {
      "number": 56,
      "text": "Wainn<u>a</u> lajameeAAun <u>hath</u>iroon<b>a</b>"
    },
    {
      "number": 57,
      "text": "Faakhrajn<u>a</u>hum min jann<u>a</u>tin waAAuyoon<b>in</b>"
    },
    {
      "number": 58,
      "text": "Wakunoozin wamaq<u>a</u>min kareem<b>in</b>"
    },
    {
      "number": 59,
      "text": "Ka<u>tha</u>lika waawrathn<u>a</u>h<u>a</u> banee isr<u>a</u>eel<b>a</b>"
    },
    {
      "number": 60,
      "text": "FaatbaAAoohum mushriqeen<b>a</b>"
    },
    {
      "number": 61,
      "text": "Falamm<u>a</u> tar<u>a</u>a aljamAA<u>a</u>ni q<u>a</u>la a<u>s</u><u>ha</u>bu moos<u>a</u> inn<u>a</u> lamudrakoon<b>a</b>"
    },
    {
      "number": 62,
      "text": "Q<u>a</u>la kall<u>a</u> inna maAAiya rabbee sayahdeen<b>i</b>"
    },
    {
      "number": 63,
      "text": "Faaw<u>h</u>ayn<u>a</u> il<u>a</u> moos<u>a</u> ani i<u>d</u>rib biAAa<u>sa</u>ka alba<u>h</u>ra fa<b>i</b>nfalaqa fak<u>a</u>na kullu firqin ka<b>al</b><u>tt</u>awdi alAAa<i><u>th</u></i>eem<b>i</b>"
    },
    {
      "number": 64,
      "text": "Waazlafn<u>a</u> thamma al<u>a</u>khareen<b>a</b>"
    },
    {
      "number": 65,
      "text": "Waanjayn<u>a</u> moos<u>a</u> waman maAAahu ajmaAAeen<b>a</b>"
    },
    {
      "number": 66,
      "text": "Thumma aghraqn<u>a</u> al<u>a</u>khareen<b>a</b>"
    },
    {
      "number": 67,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 68,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 69,
      "text": "Wa<b>o</b>tlu AAalayhim nabaa ibr<u>a</u>heem<b>a</b>"
    },
    {
      "number": 70,
      "text": "I<u>th</u> q<u>a</u>la liabeehi waqawmihi m<u>a</u> taAAbudoon<b>a</b>"
    },
    {
      "number": 71,
      "text": "Q<u>a</u>loo naAAbudu a<u>s</u>n<u>a</u>man fana<i><u>th</u></i>allu lah<u>a</u> AA<u>a</u>kifeen<b>a</b>"
    },
    {
      "number": 72,
      "text": "Q<u>a</u>la hal yasmaAAoonakum i<u>th</u> tadAAoon<b>a</b>"
    },
    {
      "number": 73,
      "text": "Aw yanfaAAoonakum aw ya<u>d</u>urroon<b>a</b>"
    },
    {
      "number": 74,
      "text": "Q<u>a</u>loo bal wajadn<u>a</u> <u>a</u>b<u>a</u>an<u>a</u> ka<u>tha</u>lika yafAAaloon<b>a</b>"
    },
    {
      "number": 75,
      "text": "Q<u>a</u>la afaraaytum m<u>a</u> kuntum taAAbudoon<b>a</b>"
    },
    {
      "number": 76,
      "text": "Antum wa<u>a</u>b<u>a</u>okumu alaqdamoon<b>a</b>"
    },
    {
      "number": 77,
      "text": "Fainnahum AAaduwwun lee ill<u>a</u> rabba alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 78,
      "text": "Alla<u>th</u>ee khalaqanee fahuwa yahdeen<b>i</b>"
    },
    {
      "number": 79,
      "text": "Wa<b>a</b>lla<u>th</u>ee huwa yu<u>t</u>AAimunee wayasqeen<b>i</b>"
    },
    {
      "number": 80,
      "text": "Wai<u>tha</u> mari<u>d</u>tu fahuwa yashfeen<b>i</b>"
    },
    {
      "number": 81,
      "text": "Wa<b>a</b>lla<u>th</u>ee yumeetunee thumma yu<u>h</u>yeen<b>i</b>"
    },
    {
      "number": 82,
      "text": "Wa<b>a</b>lla<u>th</u>ee a<u>t</u>maAAu an yaghfira lee kha<u>t</u>eeatee yawma a<b>l</b>ddeen<b>i</b>"
    },
    {
      "number": 83,
      "text": "Rabbi hab lee <u>h</u>ukman waal<u>h</u>iqnee bi<b>al</b><u>ssa</u>li<u>h</u>een<b>a</b>"
    },
    {
      "number": 84,
      "text": "Wa<b>i</b>jAAal lee lis<u>a</u>na <u>s</u>idqin fee al<u>a</u>khireen<b>a</b>"
    },
    {
      "number": 85,
      "text": "Wa<b>i</b>jAAalnee min warathati jannati a<b>l</b>nnaAAeem<b>i</b>"
    },
    {
      "number": 86,
      "text": "Wa<b>i</b>ghfir liabee innahu k<u>a</u>na mina a<b>l</b><u>dda</u>lleen<b>a</b>"
    },
    {
      "number": 87,
      "text": "Wal<u>a</u> tukhzinee yawma yubAAathoon<b>a</b>"
    },
    {
      "number": 88,
      "text": "Yawma l<u>a</u> yanfaAAu m<u>a</u>lun wal<u>a</u> banoon<b>a</b>"
    },
    {
      "number": 89,
      "text": "Ill<u>a</u> man at<u>a</u> All<u>a</u>ha biqalbin saleem<b>in</b>"
    },
    {
      "number": 90,
      "text": "Waozlifati aljannatu lilmuttaqeen<b>a</b>"
    },
    {
      "number": 91,
      "text": "Waburrizati alja<u>h</u>eemu lilgh<u>a</u>ween<b>a</b>"
    },
    {
      "number": 92,
      "text": "Waqeela lahum ayna m<u>a</u> kuntum taAAbudoon<b>a</b>"
    },
    {
      "number": 93,
      "text": "Min dooni All<u>a</u>hi hal yan<u>s</u>uroonakum aw yanta<u>s</u>iroon<b>a</b>"
    },
    {
      "number": 94,
      "text": "Fakubkiboo feeh<u>a</u> hum wa<b>a</b>lgh<u>a</u>woon<b>a</b>"
    },
    {
      "number": 95,
      "text": "Wajunoodu ibleesa ajmaAAoon<b>a</b>"
    },
    {
      "number": 96,
      "text": "Q<u>a</u>loo wahum feeh<u>a</u> yakhta<u>s</u>imoon<b>a</b>"
    },
    {
      "number": 97,
      "text": "Ta<b>A</b>ll<u>a</u>hi in kunn<u>a</u> lafee <u>d</u>al<u>a</u>lin mubeen<b>in</b>"
    },
    {
      "number": 98,
      "text": "I<u>th</u> nusawweekum birabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 99,
      "text": "Wam<u>a</u> a<u>d</u>allan<u>a</u> ill<u>a</u> almujrimoon<b>a</b>"
    },
    {
      "number": 100,
      "text": "Fam<u>a</u> lan<u>a</u> min sh<u>a</u>fiAAeen<b>a</b>"
    },
    {
      "number": 101,
      "text": "Wal<u>a</u> <u>s</u>adeeqin <u>h</u>ameem<b>in</b>"
    },
    {
      "number": 102,
      "text": "Falaw anna lan<u>a</u> karratan fanakoona mina almumineen<b>a</b>"
    },
    {
      "number": 103,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 104,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 105,
      "text": "Ka<u>thth</u>abat qawmu noo<u>h</u>in almursaleen<b>a</b>"
    },
    {
      "number": 106,
      "text": "I<u>th</u> q<u>a</u>la lahum akhoohum noo<u>h</u>un al<u>a</u> tattaqoon<b>a</b>"
    },
    {
      "number": 107,
      "text": "Innee lakum rasoolun ameen<b>un</b>"
    },
    {
      "number": 108,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 109,
      "text": "Wam<u>a</u> asalukum AAalayhi min ajrin in ajriya ill<u>a</u> AAal<u>a</u> rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 110,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 111,
      "text": "Q<u>a</u>loo anuminu laka wa<b>i</b>ttabaAAaka alar<u>th</u>aloon<b>a</b>"
    },
    {
      "number": 112,
      "text": "Q<u>a</u>la wam<u>a</u> AAilmee bim<u>a</u> k<u>a</u>noo yaAAmaloon<b>a</b>"
    },
    {
      "number": 113,
      "text": "In <u>h</u>is<u>a</u>buhum ill<u>a</u> AAal<u>a</u> rabbee law tashAAuroon<b>a</b>"
    },
    {
      "number": 114,
      "text": "Wam<u>a</u> an<u>a</u> bi<u>ta</u>ridi almumineen<b>a</b>"
    },
    {
      "number": 115,
      "text": "In an<u>a</u> ill<u>a</u> na<u>th</u>eerun mubeen<b>un</b>"
    },
    {
      "number": 116,
      "text": "Q<u>a</u>loo lain lam tantahi y<u>a</u> noo<u>h</u>u latakoonanna mina almarjoomeen<b>a</b>"
    },
    {
      "number": 117,
      "text": "Q<u>a</u>la rabbi inna qawmee ka<u>thth</u>aboon<b>i</b>"
    },
    {
      "number": 118,
      "text": "Fa<b>i</b>fta<u>h</u> baynee wabaynahum fat<u>h</u>an wanajjinee waman maAAiya mina almumineen<b>a</b>"
    },
    {
      "number": 119,
      "text": "Faanjayn<u>a</u>hu waman maAAahu fee alfulki almashhoon<b>i</b>"
    },
    {
      "number": 120,
      "text": "Thumma aghraqn<u>a</u> baAAdu alb<u>a</u>qeen<b>a</b>"
    },
    {
      "number": 121,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 122,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 123,
      "text": "Ka<u>thth</u>abat AA<u>a</u>dun almursaleen<b>a</b>"
    },
    {
      "number": 124,
      "text": "I<u>th</u> q<u>a</u>la lahum akhoohum hoodun al<u>a</u> tattaqoon<b>a</b>"
    },
    {
      "number": 125,
      "text": "Innee lakum rasoolun ameen<b>un</b>"
    },
    {
      "number": 126,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 127,
      "text": "Wam<u>a</u> asalukum AAalayhi min ajrin in ajriya ill<u>a</u> AAal<u>a</u> rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 128,
      "text": "Atabnoona bikulli reeAAin <u>a</u>yatan taAAbathoon<b>a</b>"
    },
    {
      "number": 129,
      "text": "Watattakhi<u>th</u>oona ma<u>sa</u>niAAa laAAallakum takhludoon<b>a</b>"
    },
    {
      "number": 130,
      "text": "Wai<u>tha</u> ba<u>t</u>ashtum ba<u>t</u>ashtum jabb<u>a</u>reen<b>a</b>"
    },
    {
      "number": 131,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 132,
      "text": "Wa<b>i</b>ttaqoo alla<u>th</u>ee amaddakum bim<u>a</u> taAAlamoon<b>a</b>"
    },
    {
      "number": 133,
      "text": "Amaddakum bianAA<u>a</u>min wabaneen<b>a</b>"
    },
    {
      "number": 134,
      "text": "Wajann<u>a</u>tin waAAuyoon<b>in</b>"
    },
    {
      "number": 135,
      "text": "Innee akh<u>a</u>fu AAalaykum AAa<u>tha</u>ba yawmin AAa<i><u>th</u></i>eem<b>in</b>"
    },
    {
      "number": 136,
      "text": "Q<u>a</u>loo saw<u>a</u>on AAalayn<u>a</u> awaAAa<i><u>th</u></i>ta am lam takun mina alw<u>a</u>AAi<i><u>th</u></i>een<b>a</b>"
    },
    {
      "number": 137,
      "text": "In h<u>atha</u> ill<u>a</u> khuluqu alawwaleen<b>a</b>"
    },
    {
      "number": 138,
      "text": "Wam<u>a</u> na<u>h</u>nu bimuAAa<u>thth</u>abeen<b>a</b>"
    },
    {
      "number": 139,
      "text": "Faka<u>thth</u>aboohu faahlakn<u>a</u>hum inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 140,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 141,
      "text": "Ka<u>thth</u>abat thamoodu almursaleen<b>a</b>"
    },
    {
      "number": 142,
      "text": "I<u>th</u> q<u>a</u>la lahum akhoohum <u>sa</u>li<u>h</u>un al<u>a</u> tattaqoon<b>a</b>"
    },
    {
      "number": 143,
      "text": "Innee lakum rasoolun ameen<b>un</b>"
    },
    {
      "number": 144,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 145,
      "text": "Wam<u>a</u> asalukum AAalayhi min ajrin in ajriya ill<u>a</u> AAal<u>a</u> rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 146,
      "text": "Atutrakoona fee m<u>a</u> h<u>a</u>hun<u>a</u> <u>a</u>mineen<b>a</b>"
    },
    {
      "number": 147,
      "text": "Fee jann<u>a</u>tin waAAuyoon<b>in</b>"
    },
    {
      "number": 148,
      "text": "WazurooAAin wanakhlin <u>t</u>alAAuh<u>a</u> ha<u>d</u>eem<b>un</b>"
    },
    {
      "number": 149,
      "text": "Watan<u>h</u>itoona mina aljib<u>a</u>li buyootan f<u>a</u>riheen<b>a</b>"
    },
    {
      "number": 150,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 151,
      "text": "Wal<u>a</u> tu<u>t</u>eeAAoo amra almusrifeen<b>a</b>"
    },
    {
      "number": 152,
      "text": "Alla<u>th</u>eena yufsidoona fee alar<u>d</u>i wal<u>a</u> yu<u>s</u>li<u>h</u>oon<b>a</b>"
    },
    {
      "number": 153,
      "text": "Q<u>a</u>loo innam<u>a</u> anta mina almusa<u>hh</u>areen<b>a</b>"
    },
    {
      "number": 154,
      "text": "M<u>a</u> anta ill<u>a</u> basharun mithlun<u>a</u> fati bi<u>a</u>yatin in kunta mina a<b>l</b><u>ssa</u>diqeena"
    },
    {
      "number": 155,
      "text": "Q<u>a</u>la h<u>ath</u>ihi n<u>a</u>qatun lah<u>a</u> shirbun walakum shirbu yawmin maAAloom<b>in</b>"
    },
    {
      "number": 156,
      "text": "Wal<u>a</u> tamassooh<u>a</u> bisooin fayakhu<u>th</u>akum AAa<u>tha</u>bu yawmin AAa<i><u>th</u></i>eem<b>in</b>"
    },
    {
      "number": 157,
      "text": "FaAAaqarooh<u>a</u> faa<u>s</u>ba<u>h</u>oo n<u>a</u>dimeen<b>a</b>"
    },
    {
      "number": 158,
      "text": "Faakha<u>th</u>ahumu alAAa<u>tha</u>bu inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 159,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 160,
      "text": "Ka<u>thth</u>abat qawmu loo<u>t</u>in almursaleen<b>a</b>"
    },
    {
      "number": 161,
      "text": "I<u>th</u> q<u>a</u>la lahum akhoohum loo<u>t</u>un al<u>a</u> tattaqoon<b>a</b>"
    },
    {
      "number": 162,
      "text": "Innee lakum rasoolun ameen<b>un</b>"
    },
    {
      "number": 163,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 164,
      "text": "Wam<u>a</u> asalukum AAalayhi min ajrin in ajriya ill<u>a</u> AAal<u>a</u> rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 165,
      "text": "Atatoona a<b>l</b><u>thth</u>ukr<u>a</u>na mina alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 166,
      "text": "Wata<u>th</u>aroona m<u>a</u> khalaqa lakum rabbukum min azw<u>a</u>jikum bal antum qawmun AA<u>a</u>doon<b>a</b>"
    },
    {
      "number": 167,
      "text": "Q<u>a</u>loo lain lam tantahi y<u>a</u> loo<u>t</u>u latakoonanna mina almukhrajeen<b>a</b>"
    },
    {
      "number": 168,
      "text": "Q<u>a</u>la innee liAAamalikum mina alq<u>a</u>leen<b>a</b>"
    },
    {
      "number": 169,
      "text": "Rabbi najjinee waahlee mimm<u>a</u> yaAAmaloon<b>a</b>"
    },
    {
      "number": 170,
      "text": "Fanajjayn<u>a</u>hu waahlahu ajmaAAeen<b>a</b>"
    },
    {
      "number": 171,
      "text": "Ill<u>a</u> AAajoozan fee algh<u>a</u>bireen<b>a</b>"
    },
    {
      "number": 172,
      "text": "Thumma dammarn<u>a</u> al<u>a</u>khareen<b>a</b>"
    },
    {
      "number": 173,
      "text": "Waam<u>t</u>arn<u>a</u> AAalayhim ma<u>t</u>aran fas<u>a</u>a ma<u>t</u>aru almun<u>th</u>areen<b>a</b>"
    },
    {
      "number": 174,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 175,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 176,
      "text": "Ka<u>thth</u>aba a<u>s</u><u>ha</u>bu alaykati almursaleen<b>a</b>"
    },
    {
      "number": 177,
      "text": "I<u>th</u> q<u>a</u>la lahum shuAAaybun al<u>a</u> tattaqoon<b>a</b>"
    },
    {
      "number": 178,
      "text": "Innee lakum rasoolun ameen<b>un</b>"
    },
    {
      "number": 179,
      "text": "Fa<b>i</b>ttaqoo All<u>a</u>ha waa<u>t</u>eeAAoon<b>i</b>"
    },
    {
      "number": 180,
      "text": "Wam<u>a</u> asalukum AAalayhi min ajrin in ajriya ill<u>a</u> AAal<u>a</u> rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 181,
      "text": "Awfoo alkayla wal<u>a</u> takoonoo mina almukhsireen<b>a</b>"
    },
    {
      "number": 182,
      "text": "Wazinoo bi<b>a</b>lqis<u>ta</u>si almustaqeem<b>i</b>"
    },
    {
      "number": 183,
      "text": "Wal<u>a</u> tabkhasoo a<b>l</b>nn<u>a</u>sa ashy<u>a</u>ahum wal<u>a</u> taAAthaw fee alar<u>d</u>i mufsideen<b>a</b>"
    },
    {
      "number": 184,
      "text": "Wa<b>i</b>ttaqoo alla<u>th</u>ee khalaqakum wa<b>a</b>ljibillata alawwaleen<b>a</b>"
    },
    {
      "number": 185,
      "text": "Q<u>a</u>loo innam<u>a</u> anta mina almusa<u>hh</u>areen<b>a</b>"
    },
    {
      "number": 186,
      "text": "Wam<u>a</u> anta ill<u>a</u> basharun mithlun<u>a</u> wain na<i><u>th</u></i>unnuka lamina alk<u>ath</u>ibeen<b>a</b>"
    },
    {
      "number": 187,
      "text": "Faasqi<u>t</u> AAalayn<u>a</u> kisafan mina a<b>l</b>ssam<u>a</u>i in kunta mina a<b>l</b><u>ssa</u>diqeen<b>a</b>"
    },
    {
      "number": 188,
      "text": "Q<u>a</u>la rabbee aAAlamu bim<u>a</u> taAAmaloon<b>a</b>"
    },
    {
      "number": 189,
      "text": "Faka<u>thth</u>aboohu faakha<u>th</u>ahum AAa<u>tha</u>bu yawmi a<b>l</b><i><u>thth</u></i>ullati innahu k<u>a</u>na AAa<u>tha</u>ba yawmin AAa<i><u>th</u></i>eem<b>in</b>"
    },
    {
      "number": 190,
      "text": "Inna fee <u>tha</u>lika la<u>a</u>yatan wam<u>a</u> k<u>a</u>na aktharuhum mumineen<b>a</b>"
    },
    {
      "number": 191,
      "text": "Wainna rabbaka lahuwa alAAazeezu a<b>l</b>rra<u>h</u>eem<b>u</b>"
    },
    {
      "number": 192,
      "text": "Wainnahu latanzeelu rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 193,
      "text": "Nazala bihi a<b>l</b>rroo<u>h</u>u alameen<b>u</b>"
    },
    {
      "number": 194,
      "text": "AAal<u>a</u> qalbika litakoona mina almun<u>th</u>ireen<b>a</b>"
    },
    {
      "number": 195,
      "text": "Bilis<u>a</u>nin AAarabiyyin mubeen<b>in</b>"
    },
    {
      "number": 196,
      "text": "Wainnahu lafee zuburi alawwaleen<b>a</b>"
    },
    {
      "number": 197,
      "text": "Awalam yakun lahum <u>a</u>yatan an yaAAlamahu AAulam<u>a</u>o banee isr<u>a</u>eel<b>a</b>"
    },
    {
      "number": 198,
      "text": "Walaw nazzaln<u>a</u>hu AAal<u>a</u> baAA<u>d</u>i alaAAjameen<b>a</b>"
    },
    {
      "number": 199,
      "text": "Faqaraahu AAalayhim m<u>a</u> k<u>a</u>noo bihi mumineen<b>a</b>"
    },
    {
      "number": 200,
      "text": "Ka<u>tha</u>lika salakn<u>a</u>hu fee quloobi almujrimeen<b>a</b>"
    },
    {
      "number": 201,
      "text": "L<u>a</u> yuminoona bihi <u>h</u>att<u>a</u> yarawoo alAAa<u>tha</u>ba alaleem<b>a</b>"
    },
    {
      "number": 202,
      "text": "Fayatiyahum baghtatan wahum l<u>a</u> yashAAuroon<b>a</b>"
    },
    {
      "number": 203,
      "text": "Fayaqooloo hal na<u>h</u>nu mun<i><u>th</u></i>aroon<b>a</b>"
    },
    {
      "number": 204,
      "text": "AfabiAAa<u>tha</u>bin<u>a</u> yastaAAjiloon<b>a</b>"
    },
    {
      "number": 205,
      "text": "Afaraayta in mattaAAn<u>a</u>hum sineen<b>a</b>"
    },
    {
      "number": 206,
      "text": "Thumma j<u>a</u>ahum m<u>a</u> k<u>a</u>noo yooAAadoon<b>a</b>"
    },
    {
      "number": 207,
      "text": "M<u>a</u> aghn<u>a</u> AAanhum m<u>a</u> k<u>a</u>noo yumattaAAoon<b>a</b>"
    },
    {
      "number": 208,
      "text": "Wam<u>a</u> ahlakn<u>a</u> min qaryatin ill<u>a</u> lah<u>a</u> mun<u>th</u>iroon<b>a</b>"
    },
    {
      "number": 209,
      "text": "<u>Th</u>ikr<u>a</u> wam<u>a</u> kunn<u>a</u> <i><u>th</u></i><u>a</u>limeen<b>a</b>"
    },
    {
      "number": 210,
      "text": "Wam<u>a</u> tanazzalat bihi a<b>l</b>shshay<u>at</u>een<b>u</b>"
    },
    {
      "number": 211,
      "text": "Wam<u>a</u> yanbaghee lahum wam<u>a</u> yasta<u>t</u>eeAAoon<b>a</b>"
    },
    {
      "number": 212,
      "text": "Innahum AAani a<b>l</b>ssamAAi lamaAAzooloona"
    },
    {
      "number": 213,
      "text": "Fal<u>a</u> tadAAu maAAa All<u>a</u>hi il<u>a</u>han <u>a</u>khara fatakoona mina almuAAa<u>thth</u>abeen<b>a</b>"
    },
    {
      "number": 214,
      "text": "Waan<u>th</u>ir AAasheerataka alaqrabeen<b>a</b>"
    },
    {
      "number": 215,
      "text": "Wa<b>i</b>khfi<u>d</u> jan<u>ah</u>aka limani ittabaAAaka mina almumineen<b>a</b>"
    },
    {
      "number": 216,
      "text": "Fain AAa<u>s</u>awka faqul innee bareeon mimm<u>a</u> taAAmaloon<b>a</b>"
    },
    {
      "number": 217,
      "text": "Watawakkal AAal<u>a</u> alAAazeezi a<b>l</b>rra<u>h</u>eem<b>i</b>"
    },
    {
      "number": 218,
      "text": "Alla<u>th</u>ee yar<u>a</u>ka <u>h</u>eena taqoom<b>u</b>"
    },
    {
      "number": 219,
      "text": "Wataqallubaka fee a<b>l</b>ss<u>a</u>jideen<b>a</b>"
    },
    {
      "number": 220,
      "text": "Innahu huwa a<b>l</b>ssameeAAu alAAaleem<b>u</b>"
    },
    {
      "number": 221,
      "text": "Hal onabbiokum AAal<u>a</u> man tanazzalu a<b>l</b>shshay<u>at</u>een<b>u</b>"
    },
    {
      "number": 222,
      "text": "Tanazzalu AAal<u>a</u> kulli aff<u>a</u>kin atheem<b>in</b>"
    },
    {
      "number": 223,
      "text": "Yulqoona a<b>l</b>ssamAAa waaktharuhum k<u>ath</u>iboon<b>a</b>"
    },
    {
      "number": 224,
      "text": "Wa<b>al</b>shshuAAar<u>a</u>o yattabiAAuhumu algh<u>a</u>woon<b>a</b>"
    },
    {
      "number": 225,
      "text": "Alam tara annahum fee kulli w<u>a</u>din yaheemoon<b>a</b>"
    },
    {
      "number": 226,
      "text": "Waannahum yaqooloona m<u>a</u> l<u>a</u> yafAAaloon<b>a</b>"
    },
    {
      "number": 227,
      "text": "Ill<u>a</u> alla<u>th</u>eena <u>a</u>manoo waAAamiloo a<b>l</b><u>ssa</u>li<u>ha</u>ti wa<u>th</u>akaroo All<u>a</u>ha katheeran wa<b>i</b>nta<u>s</u>aroo min baAAdi m<u>a</u> <i><u>th</u></i>ulimoo wasayaAAlamu alla<u>th</u>eena <i><u>th</u></i>alamoo ayya munqalabin yanqaliboon<b>a</b>"
    }
  ]
}