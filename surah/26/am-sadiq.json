{
  "surah": 26,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "ጠ.ሰ.መ. (ጧ ሲን ሚም)፡፡"
    },
    {
      "number": 2,
      "text": "ይህች ግልጽ ከኾነው መጽሐፍ አንቀጾች ናት፡፡"
    },
    {
      "number": 3,
      "text": "አማኞች ባለመኾናቸው፤ (በቁጭት) ነፍስህን ገዳይ መኾን ይፈራልሃል፡፡"
    },
    {
      "number": 4,
      "text": "ብንሻ በእነሱ ላይ ከሰማይ ተዓምረን እናወርድና አንገቶቻቸው (መሪዎቻቸው) ለእርሷ ተዋራጆች ይኾናሉ፡፡"
    },
    {
      "number": 5,
      "text": "ከአልረሕማንም ዘንድ ኣዲስ የተወረደ ቁርኣን አይመጣላቸውም፤ ከእርሱ የሚሸሹ ቢኾኑ እንጂ፡፡"
    },
    {
      "number": 6,
      "text": "በእርግጥም አስተባበሉ፡፡ የዚያም በእርሱ ይሳለቁበት የነበሩት ወሬዎች (ፍጻሜ) ይመጣባቸዋል፡፡"
    },
    {
      "number": 7,
      "text": "ወደ ምድርም በውስጧ ከመልካም (በቃይ) ጎሳ ሁሉ ብዙን እንዳበቀልን አላዩምን፡፡"
    },
    {
      "number": 8,
      "text": "በዚህ አስደናቂ ምልክት አልለበት፡፡ አብዛኞቻቸውም አማኞች አልነበሩም፡፡"
    },
    {
      "number": 9,
      "text": "ጌታህም እርሱ በእርግጥ አሸናፊ አዛኝ ነው፡፡"
    },
    {
      "number": 10,
      "text": "ጌታህም ሙሳን «ወደ በደለኞቹ ሕዝቦች ኺድ» በማለት በጠራው ጊዜ (አስታውስ)፡፡"
    },
    {
      "number": 11,
      "text": "«ወደ ፈርዖን ሕዝቦች (ኺድ) አላህን አይፈሩምን» (አለው)፡፡"
    },
    {
      "number": 12,
      "text": "(ሙሳም) አለ «ጌታዬ ሆይ! እኔ ሊያስተባብሉኝ እፈራለሁ፡፡"
    },
    {
      "number": 13,
      "text": "«ልቤም ይጠብባል፡፡ ምላሴም አይፈታም፡፡ ስለዚህ ወደ ሃሩን ላክ፡፡"
    },
    {
      "number": 14,
      "text": "«ለእነርሱም በእኔ ላይ (የደም) ወንጀል አልለ፡፡ ስለዚህ እንዳይገድሉኝ እፈራለሁ፡፡»"
    },
    {
      "number": 15,
      "text": "(አላህ) አለ «ተው! (አይነኩህም)፡፡ በተዓምራቶቻችንም ኺዱ፡፡ እኛ ከእናንተ ጋር ሰሚዎች ነንና፡፡"
    },
    {
      "number": 16,
      "text": "«ወደ ፈርዖንም ኺዱ፡፡ በሉትም፡- እኛ የዓለማት ጌታ መልክተኞች ነን፡፡"
    },
    {
      "number": 17,
      "text": "«የእስራኤልን ልጆች ከእኛ ጋር ልቀቅ፡፡»"
    },
    {
      "number": 18,
      "text": "(ፈርዖንም) አለ «ልጅ ኾነህ በእኛ ውስጥ አላሳደግንህምን በእኛ ውስጥም ከዕድሜህ ብዙ ዓመታትን አልተቀመጥክምን"
    },
    {
      "number": 19,
      "text": "«ያችንም የሠራሃትን ሥራህን አልሠራህምን አንተም ከውለታ ቢሶቹ ነህ» (አለ)፡፡"
    },
    {
      "number": 20,
      "text": "(ሙሳም) አለ «ያን ጊዜ እኔም ከተሳሳቱት ኾኜ ሠራኋት፡፡"
    },
    {
      "number": 21,
      "text": "«በፈራኋችሁም ጊዜ ከእንናተ ሸሸሁ፡፡ ጌታየም ለእኔ ጥበብን ሰጠኝ፡፡ ከመልክተኞቹም አደረገኝ፡፡"
    },
    {
      "number": 22,
      "text": "«ይህችም የእስራኤልን ልጆች ባሪያ በማድረግህ በእኔ ላይ የምትመጻደቅባት ጸጋ ነት፡፡»"
    },
    {
      "number": 23,
      "text": "ፈርዖን አለ «(ላከኝ የምትለው) የዓለማትም ጌታ ምንድነው»"
    },
    {
      "number": 24,
      "text": "(ሙሳ) «የሰማያትና የምድር በመካከላቸውም ያለው ሁሉ ጌታ ነው፡፡ የምታረጋግጡ ብትኾኑ (ነገሩ ይህ ነው)፤» አለው፡፡"
    },
    {
      "number": 25,
      "text": "(ፈርዖንም) በዙሪያው ላሉት ሰዎች «አትሰሙምን» አለ፡፡"
    },
    {
      "number": 26,
      "text": "(ሙሳ) «ጌታችሁና የመጀመሪያዎቹ አባቶቻችሁም ጌታ ነው» አለው፡፡"
    },
    {
      "number": 27,
      "text": "(ፈርዖን)\t«ያ ወደእናንተ የተላከው መልክተኛችሁ በእርግጥ ዕብድ ነው» አለ፡፡"
    },
    {
      "number": 28,
      "text": "(ሙሳ) «የምሥራቅና የምዕራብ በመካከላቸውም ያለው ነገር ሁሉ ጌታ ነው፡፡ ታውቁ እንደኾናችሁ (እመኑበት)» አለው፡፡"
    },
    {
      "number": 29,
      "text": "(ፈርዖን) «ከእኔ ሌላ አምላክን ብትይዝ በውነቱ ከእስረኞቹ አደርግሃለሁ» አለ፡፡"
    },
    {
      "number": 30,
      "text": "(ሙሳ) «በግልጽ አስረጅ ብመጣህም እንኳ» አለው፡፡"
    },
    {
      "number": 31,
      "text": "«እንግዲያውስ ከእውነተኞች እንደኾንክ (አስረጁን) አምጣው» አለ፡፡"
    },
    {
      "number": 32,
      "text": "በትሩንም ጣለ፡፡ እርሷም ወዲያውኑ ግልጽ እባብ ኾነች፡፡"
    },
    {
      "number": 33,
      "text": "እጁንም አወጣ፡፡ ወዲያውም እርሷ ለተመልካቾች (የምታበራ) ነጭ ኾነች፡፡"
    },
    {
      "number": 34,
      "text": "(ፈርዖን) በዙሪያው ላሉት መማክርት «ይህ በእርግጥ ዐዋቂ ድግምተኛ ነው» አለ፡፡"
    },
    {
      "number": 35,
      "text": "«ከምድራችሁ በድግምቱ ሊያወጣችሁ ይፈልጋልና ምንን ታዛላችሁ» (አላቸው)፡፡"
    },
    {
      "number": 36,
      "text": "አሉት «እርሱን ወንድሙንም አቆይና በየከተሞቹ ሰብሳቢዎችን ላክ፡፡"
    },
    {
      "number": 37,
      "text": "«በጣም ዐዋቂ ድግምተኞችን ሁሉ ያመጡልሃልና፡፡»"
    },
    {
      "number": 38,
      "text": "ድግምተኞቹም በታወቀ ቀን ቀጠሮ ተሰበሰቡ፡፡"
    },
    {
      "number": 39,
      "text": "ለሰዎቹም «እናንተ ተሰብስባችኋልን» ተባለ፡፡"
    },
    {
      "number": 40,
      "text": "«ድግምተኞቹን እነሱ አሸናፊዎች ቢኾኑ እንከተል ዘንድ» (ተባለ)፡፡"
    },
    {
      "number": 41,
      "text": "«ድግምተኞቹም በመጡ ጊዜ ለፈርዖን እኛ አሸናፊዎች ብንሆን ለእኛ በእርግጥ ዋጋ አለን» አሉት፡፡"
    },
    {
      "number": 42,
      "text": "«አዎን፤ እናንተም ያን ጊዜ ከባለሟሎቹ ትኾናላችሁ» አላቸው፡፡"
    },
    {
      "number": 43,
      "text": "ሙሳ «ለእነርሱ እናንተ የምትጥሉትን ጣሉ» አላቸው፡፡"
    },
    {
      "number": 44,
      "text": "ገመዶቻቸውንና በትሮቻቸውንም ጣሉ፡፡ «በፈርዖንም ክብር ይኹንብን፡፡ እኛ በእርግጥ አሸናፊዎቹ እኛ ነን» አሉ፡፡"
    },
    {
      "number": 45,
      "text": "ሙሳም በትሩን ጣለ፡፡ ወዲያውም እርሷ የሚያስመስሉትን ሁሉ ትውጣለች፡፡"
    },
    {
      "number": 46,
      "text": "ድግምተኞቹም ሰጋጆች ኾነው ወደቁ፡፡"
    },
    {
      "number": 47,
      "text": "(እነሱም) አሉ «በዓለማት ጌታ አመንን፡፡"
    },
    {
      "number": 48,
      "text": "«በሙሳና በሃሩን ጌታ፡፡»"
    },
    {
      "number": 49,
      "text": "(ፈርዖንም) «ለእናንተ ሳልፈቅድላችሁ በፊት ለእርሱ አመናችሁን እርሱ ያ ድግምትን ያስተማራችሁ ታላቃችሁ ነው፡፡ ወደፊትም (የሚያገኛችሁን) በእርግጥ ታውቃላችሁ፡፡ እጆቻችሁንና እግሮቻችሁን (ቀኝና ግራን) በማናጋት እቆረርጣለሁ፡፡ ሁላችሁንም እሰቅላችኋለሁም» አለ፡፡"
    },
    {
      "number": 50,
      "text": "(እነርሱም) አሉ «ጉዳት የለብንም፡፡ እኛ ወደ ጌታችን ተመላሾች ነን፡፡"
    },
    {
      "number": 51,
      "text": "«እኛ የምእምናን መጀመሪያ በመኾናችን ጌታችን ኀጢአቶቻችንን ለእኛ ሊምር እንከጅላለን፡፡»"
    },
    {
      "number": 52,
      "text": "ወደ ሙሳም «ባሮቼን ይዘህ ሌሊት ኺድ፡፡ እናንተ የሚከተሉዋችሁ ናችሁና» ስንል ላክን፡፡"
    },
    {
      "number": 53,
      "text": "ፈርዖንም በየከተሞቹ ሰብሳቢዎችን (እንዲህ ሲል) ላከ፡፡"
    },
    {
      "number": 54,
      "text": "«እነዚህ ጥቂቶች ጭፈሮች ናቸው፡፡"
    },
    {
      "number": 55,
      "text": "«እነርሱም ለእኛ አስቆጪዎች ናቸው፡፡"
    },
    {
      "number": 56,
      "text": "«እኛም ብዙዎች ጥንቁቆች ነን፤» (አለ)፡፡"
    },
    {
      "number": 57,
      "text": "አወጣናቸውም፡፡ ከአትክልቶችና ከምንጮች፡፡"
    },
    {
      "number": 58,
      "text": "ከድልቦችም ከመልካም መቀመጫዎችም፡፡"
    },
    {
      "number": 59,
      "text": "እንደዚሁ ለእስራኤል ልጆች አወረስናትም፡፡"
