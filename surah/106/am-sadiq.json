{
  "surah": 106,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "ቁረይሽን ለማላመድ (ባለዝሆኖቹን አጠፋ)፡፡"
    },
    {
      "number": 2,
      "text": "የብርድና የበጋን ወራት ጉዞ ሊያላምዳቸው ይህንን ሠራ፡፡"
    },
    {
      "number": 3,
      "text": "ስለዚህ የዚህን ቤት (የከዕባን) ጌታ ይግገዙ፡፡"
    },
    {
      "number": 4,
      "text": "ያንን ከረኃብ ያበላቸውን ከፍርሃትም ያረካቸውን (ጌታ ያምልኩ)፡፡"
    }
  ]
}