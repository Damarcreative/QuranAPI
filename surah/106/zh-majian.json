{
  "surah": 106,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "因為保護古來氏,"
    },
    {
      "number": 2,
      "text": "因為在冬季和夏季的旅行中保護他們,"
    },
    {
      "number": 3,
      "text": "故教他們崇敬這天房的主,"
    },
    {
      "number": 4,
      "text": "他曾為飢荒而賑濟他們, 曾為恐怖而保祐他們。"
    }
  ]
}