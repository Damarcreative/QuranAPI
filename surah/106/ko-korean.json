{
  "surah": 106,
  "translation": "ko-korean",
  "ayahs": [
    {
      "number": 0,
      "text": "자비로우시고 자애로우신 하나님의 이름으로"
    },
    {
      "number": 1,
      "text": "꾸레이쉬 족의 보호를 위하여"
    },
    {
      "number": 2,
      "text": "대상으로 하여금 겨울과 여름에 안전하게 여행케 하였노라"
    },
    {
      "number": 3,
      "text": "그러므로 이 집의 주님을 그 들로 하여금 경배토록 하라"
    },
    {
      "number": 4,
      "text": "그분은 그들을 기아로부터 배불려 주셨고 공포로부터 안전케 하여 주셨노라"
    }
  ]
}