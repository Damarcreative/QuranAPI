{
  "surah": 106,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Корейшане, за соглас свой,"
    },
    {
      "number": 2,
      "text": "За соглас между собой в отправлении караванов зимой и летом,"
    },
    {
      "number": 3,
      "text": "Да покланяются Господу сего дома,"
    },
    {
      "number": 4,
      "text": "Питающему их во время глада, охраняющему их от страха."
    }
  ]
}