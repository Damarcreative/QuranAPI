{
  "surah": 107,
  "translation": "ta-tamil",
  "ayahs": [
    {
      "number": 0,
      "text": "அளவற்ற அருளாளன், நிகரற்ற அன்பாளன், அல்லாஹ்வின் பெயரால்! (தொடங்குகிறேன்)."
    },
    {
      "number": 1,
      "text": "(நபியே!) நியாயத்தீர்ப்பைப் பொய்ப்பிக்கின்றானே அவனை நீர் பார்த்தீரா?"
    },
    {
      "number": 2,
      "text": "பின்னர் அவன்தான் அநாதைகளை விரட்டுகிறான்."
    },
    {
      "number": 3,
      "text": "மேலும், ஏழைக்கு உணவளிப்பதின் பேரிலும் அவன் தூண்டுவதில்லை."
    },
    {
      "number": 4,
      "text": "இன்னும், (கவனமற்ற) தொழுகையாளிகளுக்குக் கேடுதான்."
    },
    {
      "number": 5,
      "text": "அவர்கள் எத்தகையோர் என்றால் தம் தொழுகையில் பராமுகமாக(வும், அசிரத்தையாக)வும் இருப்போர்."
    },
    {
      "number": 6,
      "text": "அவர்கள் பிறருக்குக் காண்பிக்(கவே தான் தொழு)கிறார்கள்."
    },
    {
      "number": 7,
      "text": "மேலும், அற்பமான (புழங்கும்) பொருள்களைக் (கொடுப்பதை விட்டும்) தடுக்கிறார்கள்."
    }
  ]
}