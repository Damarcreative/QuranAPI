{
  "surah": 107,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 0,
      "text": "Хвала Аллаху – Господу миров [создавшему мир и управляющему им],"
    },
    {
      "number": 1,
      "text": "Видел ли ты того, кто не верит в воздаяние [Судного дня]?"
    },
    {
      "number": 2,
      "text": "И это – тот, кто гонит сироту"
    },
    {
      "number": 3,
      "text": "и не побуждает накормить нищего."
    },
    {
      "number": 4,
      "text": "И горе молящимся,"
    },
    {
      "number": 5,
      "text": "которые небрежны к своим намазам,"
    },
    {
      "number": 6,
      "text": "которые совершают [намаз] напоказ"
    },
    {
      "number": 7,
      "text": "и препятствуют даже малому подаянию!"
    }
  ]
}