{
  "surah": 107,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ያንን በምርመራው የሚያስተባብለውን አየህን? (ዐወቅከውን?)"
    },
    {
      "number": 2,
      "text": "ይህም ያ የቲምን በኀይል የሚገፈትረው፤"
    },
    {
      "number": 3,
      "text": "ድኻንም በማብላት ላይ የማያግባባው ሰው ነው፡፡"
    },
    {
      "number": 4,
      "text": "ወዮላቸው ለሰጋጆች፡፡"
    },
    {
      "number": 5,
      "text": "ለእነዚያ እነርሱ ከስግደታቸው ዘንጊዎች ለኾኑት፤ (ሰጋጆች)፡፡"
    },
    {
      "number": 6,
      "text": "ለእነዚያ እነርሱ ይዩልኝ ባዮች ለኾኑት፡፡"
    },
    {
      "number": 7,
      "text": "የዕቃ ትውስትንም (ሰዎችን) የሚከለክሉ ለኾኑት (ወዮላቸው)፡፡"
    }
  ]
}