{
  "surah": 107,
  "translation": "ru-porokhova",
  "ayahs": [
    {
      "number": 1,
      "text": "Видал ли ты того, Кто отвергает Воздаянье?"
    },
    {
      "number": 2,
      "text": "Таков лишь тот, кто отгоняет сироту,"
    },
    {
      "number": 3,
      "text": "Откажет в пище он тому, кто голодает."
    },
    {
      "number": 4,
      "text": "И горе верующим тем,"
    },
    {
      "number": 5,
      "text": "Кто небрежет в своих молитвах,"
    },
    {
      "number": 6,
      "text": "Кто свою веру ставит напоказ,"
    },
    {
      "number": 7,
      "text": "А ближнему откажет в самом малом."
    }
  ]
}