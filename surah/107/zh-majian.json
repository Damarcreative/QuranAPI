{
  "surah": 107,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "你曾見否認報應日的人嗎？"
    },
    {
      "number": 2,
      "text": "他就是那個呵斥孤兒,"
    },
    {
      "number": 3,
      "text": "且不勉勵人賑濟貧民的人。"
    },
    {
      "number": 4,
      "text": "傷哉！禮拜的人們,"
    },
    {
      "number": 5,
      "text": "他們是忽視拜功的,"
    },
    {
      "number": 6,
      "text": "他們是沽名釣譽的,"
    },
    {
      "number": 7,
      "text": "他們是不肯借人什物的。"
    }
  ]
}