{
  "surah": 107,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Видал ли ты того, кто ложью считает религию?"
    },
    {
      "number": 2,
      "text": "Это ведь тот, кто отгоняет сироту"
    },
    {
      "number": 3,
      "text": "и не побуждает накормить бедного."
    },
    {
      "number": 4,
      "text": "Горе же молящимся,"
    },
    {
      "number": 5,
      "text": "которые о молитве своей небрегут,"
    },
    {
      "number": 6,
      "text": "которые лицемерят"
    },
    {
      "number": 7,
      "text": "и отказывают в подаянии!"
    }
  ]
}