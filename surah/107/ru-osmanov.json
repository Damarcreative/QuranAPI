{
  "surah": 107,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного."
    },
    {
      "number": 1,
      "text": "Думал ли ты о том, кто отрицает расплату [Судного дня]?"
    },
    {
      "number": 2,
      "text": "Это ведь тот, кто гонит сироту"
    },
    {
      "number": 3,
      "text": "и не призывает [людей] кормить бедняков."
    },
    {
      "number": 4,
      "text": "Горе же тем молящимся,"
    },
    {
      "number": 5,
      "text": "которые не читают молитвы истово,"
    },
    {
      "number": 6,
      "text": "которые лицемерят"
    },
    {
      "number": 7,
      "text": "и запрещают подавать милостыню."
    }
  ]
}