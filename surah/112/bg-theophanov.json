  "ayahs": [
    {
      "number": 0,
      "text": "В името на Аллах, Всемилостивия, Милосърдния!"
    },
    {
      "number": 1,
      "text": "Кажи [о, Мухаммад]: “Той е Аллах - Единствения,"
    },
    {
      "number": 2,
      "text": "Аллах, Целта [на всички въжделения]!"
    },
    {
      "number": 3,
      "text": "Нито е раждал, нито е роден,"
    },
    {
      "number": 4,
      "text": "и няма равен Нему.”"
    }
  ]
}