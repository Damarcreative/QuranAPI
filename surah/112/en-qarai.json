  "translation": "en-qarai",
  "ayahs": [
    {
      "number": 0,
      "text": "In the Name of Allah, the All-beneficent, the All-merciful."
    },
    {
      "number": 1,
      "text": "Say, ‘He is Allah, the One."
    },
    {
      "number": 2,
      "text": "Allah is the All-embracing."
    },
    {
      "number": 3,
      "text": "He neither begat, nor was begotten,"
    },
    {
      "number": 4,
      "text": "nor has He any equal.’"
    }
  ]
}