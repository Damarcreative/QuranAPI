{
  "surah": 112,
  "translation": "en-mubarakpuri",
  "ayahs": [
    {
      "number": 0,
      "text": "In the Name of Allah, the Most Gracious, the Most Merciful."
    },
    {
      "number": 1,
      "text": "Say: \"He is Allah, One.\""
    },
    {
      "number": 2,
      "text": "\"Allah As-Samad.\""
    },
    {
      "number": 3,
      "text": "\"He begets not, nor was He begotten.\""
    },
    {
      "number": 4,
      "text": "\"And there is none comparable to Him.\""
    }
  ]
}