{
  "surah": 112,
  "translation": "bn-hoque",
  "ayahs": [
    {
      "number": 1,
      "text": "তুমি বলো -- ''তিনি আল্লাহ্‌, একক-অদ্বিতীয়;"
    },
    {
      "number": 2,
      "text": "''আল্লাহ্ -- পরম নির্ভরস্থল।"
    },
    {
      "number": 3,
      "text": "''তিনি জন্ম দেন না, এবং জন্ম নেনও নি,"
    },
    {
      "number": 4,
      "text": "''এবং কেউই তাঁর সমতুল্য হতে পারে না।’’"
    }
  ]
}