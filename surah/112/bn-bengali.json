  "surah": 112,
  "translation": "bn-bengali",
  "ayahs": [
    {
      "number": 0,
      "text": "শুরু করছি আল্লাহর নামে যিনি পরম করুণাময়, অতি দয়ালু।"
    },
    {
      "number": 1,
      "text": "বলুন, তিনি আল্লাহ, এক,"
    },
    {
      "number": 2,
      "text": "আল্লাহ অমুখাপেক্ষী,"
    },
    {
      "number": 3,
      "text": "তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি"
    },
    {
      "number": 4,
      "text": "এবং তার সমতুল্য কেউ নেই।"
    }
  ]
}