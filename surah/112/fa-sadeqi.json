  "translation": "fa-sadeqi",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خدای رحمتگر بر آفریدگان، رحمتگر بر ویژگان‌"
    },
    {
      "number": 1,
      "text": "بگو: «او خدای یکتا و یگانه است.»"
    },
    {
      "number": 2,
      "text": "«خدا، (همان) پروردگار بی‌نیاز مطلق است.»"
    },
    {
      "number": 3,
      "text": "«(هرگز) نزاد و زاده نشد.»"
    },
    {
      "number": 4,
      "text": "«و برای او هیچ‌گاه همتا و همپایی نبوده است.»"
    }
  ]
