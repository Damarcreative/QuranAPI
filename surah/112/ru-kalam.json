{
  "surah": 112,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 1,
      "text": "Скажи: «Он – Аллах – Один."
    },
    {
      "number": 2,
      "text": "Аллах Самодостаточен."
    },
    {
      "number": 3,
      "text": "Он не родил и не был рожден."
    },
    {
      "number": 4,
      "text": "И нет никого [и ничего] равного [и подобного] Ему»."
    }
  ]
}