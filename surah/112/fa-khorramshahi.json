{
  "surah": 112,
  "translation": "fa-khorramshahi",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند بخشنده مهربان‌"
    },
    {
      "number": 1,
      "text": "بگو او خداوند یگانه است‌"
    },
    {
      "number": 2,
      "text": "خداوند صمد"
    },
    {
      "number": 3,
      "text": "نه فرزند آرد و نه از کسی زاده است‌"
    },
    {
      "number": 4,
      "text": "و او را هیچ کس همتا نیست‌"
    }
  ]
}