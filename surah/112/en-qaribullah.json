  "ayahs": [
    {
      "number": 0,
      "text": "In the Name of Allah, the Merciful, the Most Merciful"
    },
    {
      "number": 1,
      "text": "Say: 'He is Allah, the One,"
    },
    {
      "number": 2,
      "text": "the called upon."
    },
    {
      "number": 3,
      "text": "Who has not given birth, and has not been born,"
    },
    {
      "number": 4,
      "text": "and there is none equal to Him'"
    }
  ]
}