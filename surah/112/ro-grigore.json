{
  "surah": 112,
  "translation": "ro-grigore",
  "ayahs": [
    {
      "number": 0,
      "text": "În numele lui Dumnezeu cel Milos şi Milostiv."
    },
    {
      "number": 1,
      "text": "Spune: “Unul este Dumnezeu."
    },
    {
      "number": 2,
      "text": "Dumnezeu!.. Absolutul!"
    },
    {
      "number": 3,
      "text": "El nu naşte şi nu se naşte,"
    },
    {
      "number": 4,
      "text": "şi nimeni nu-I este asemenea.”"
    }
  ]
}