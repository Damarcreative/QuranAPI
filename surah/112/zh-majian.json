{
  "surah": 112,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "你說：他是真主，是獨一的主；"
    },
    {
      "number": 2,
      "text": "真主是萬物所仰賴的；"
    },
    {
      "number": 3,
      "text": "他沒有生產，也沒有被生產；"
    },
    {
      "number": 4,
      "text": "沒有任何物可以做他的匹敵。"
    }
  ]
}