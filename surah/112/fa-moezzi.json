{
  "surah": 112,
  "translation": "fa-moezzi",
  "ayahs": [
    {
      "number": 0,
      "text": "بنام خداوند بخشاینده مهربان‌"
    },
    {
      "number": 1,
      "text": "بگو او است خدای یکتا"
    },
    {
      "number": 2,
      "text": "خداوند است صمد"
    },
    {
      "number": 3,
      "text": "نه زائید و نه زاده شده‌"
    },
    {
      "number": 4,
      "text": "و نبودش همتا کسی‌"
    }
  ]
}