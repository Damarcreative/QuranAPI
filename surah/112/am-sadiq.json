{
  "surah": 112,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በል «እርሱ አላህ አንድ ነው፡፡"
    },
    {
      "number": 2,
      "text": "«አላህ (የሁሉ) መጠጊያ ነው፡፡"
    },
    {
      "number": 3,
      "text": "«አልወለደም፤ አልተወለደምም፡፡"
    },
    {
      "number": 4,
      "text": "«ለእርሱም አንድም ብጤ የለውም፡፡»"
    }
  ]
}