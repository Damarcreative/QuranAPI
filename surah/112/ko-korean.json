  "surah": 112,
  "translation": "ko-korean",
  "ayahs": [
    {
      "number": 0,
      "text": "자비로우시고 자애로우신 하나님의 이름으로"
    },
    {
      "number": 1,
      "text": "일러가로되 하나님은 단 한분이시고"
    },
    {
      "number": 2,
      "text": "하나님은 영원하시며"
    },
    {
      "number": 3,
      "text": "성자와 성부도 두지 않으셨으 며"
    },
    {
      "number": 4,
      "text": "그분과 대등한 것 세상에 없 노라"
    }
  ]
}