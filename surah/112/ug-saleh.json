{
  "surah": 112,
  "translation": "ug-saleh",
  "ayahs": [
    {
      "number": 0,
      "text": "ناھايىتى شەپقەتلىك ۋە مېھرىبان اﷲ نىڭ ئىسمى بىلەن باشلايمەن"
    },
    {
      "number": 1,
      "text": "(ئى مۇھەممەد!) ئېيتقىنكى، ئۇ - اﷲ بىردۇر"
    },
    {
      "number": 2,
      "text": "ھەممە اﷲ قا موھتاجدۇر"
    },
    {
      "number": 3,
      "text": "اﷲ بالا تاپقانمۇ ئەمەس، تۇغۇلغانمۇ ئەمەس"
    },
    {
      "number": 4,
      "text": "ھېچ كىشى ئۇنىڭغا تەڭداش بولالمايدۇ"
    }
  ]
}