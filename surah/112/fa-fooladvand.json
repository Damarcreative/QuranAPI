  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "بگو: «اوست خدای یگانه،"
    },
    {
      "number": 2,
      "text": "خدای صمد [ثابت - متعالی‌]،"
    },
    {
      "number": 3,
      "text": "[کسی را] نزاده، و زاده نشده است،"
    },
    {
      "number": 4,
      "text": "و هیچ کس او را همتا نیست.»"
    }
  ]
}