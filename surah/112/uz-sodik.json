{
  "surah": 112,
  "translation": "uz-sodik",
  "ayahs": [
    {
      "number": 1,
      "text": "Айт: «У Аллоҳ ягонадир»."
    },
    {
      "number": 2,
      "text": "Аллоҳ сомаддир. (Ҳожатларни ва рағбатларни қондирувчидир.)"
    },
    {
      "number": 3,
      "text": "У туғмаган ва туғилмаган."
    },
    {
      "number": 4,
      "text": "Ва Унга ҳеч ким тенг бўлмаган. (Аллоҳ таолога бирор зот на зотида, на сифатида ва на амалида тенг бўлган эмас, бўлолмайди ҳам.)"
    }
  ]
}