{
  "surah": 112,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "പറയുക, അവനാണ് അല്ലാഹു. അവന്‍ ഏകനാണ്."
    },
    {
      "number": 2,
      "text": "അല്ലാഹു ആരെയും ആശ്രയിക്കാത്തവനാണ്. ഏവരാലും ആശ്രയിക്കപ്പെടുന്നവനും."
    },
    {
      "number": 3,
      "text": "അവന്‍ പിതാവോ പുത്രനോ അല്ല."
    },
    {
      "number": 4,
      "text": "അവനു തുല്യനായി ആരുമില്ല."
    }
  ]
}