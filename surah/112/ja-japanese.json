  "surah": 112,
  "translation": "ja-japanese",
  "ayahs": [
    {
      "number": 0,
      "text": "慈悲あまねく慈愛深きアッラーの御名において。"
    },
    {
      "number": 1,
      "text": "言え，「かれはアッラー，唯一なる御方であられる。"
    },
    {
      "number": 2,
      "text": "アッラーは，自存され，"
    },
    {
      "number": 3,
      "text": "御産みなさらないし，御産れになられたのではない，"
    },
    {
      "number": 4,
      "text": "かれに比べ得る，何ものもない。」"
    }
  ]
}