{
  "surah": 112,
  "translation": "ta-tamil",
  "ayahs": [
    {
      "number": 1,
      "text": "(நபியே!) நீர் கூறுவீராக: அல்லாஹ் அவன் ஒருவனே."
    },
    {
      "number": 2,
      "text": "அல்லாஹ் (எவரிடத்தும்) தேவையற்றவன்."
    },
    {
      "number": 3,
      "text": "அவன் (எவரையும்) பெறவுமில்லை (எவராலும்) பெறப்படவுமில்லை."
    },
    {
      "number": 4,
      "text": "அன்றியும், அவனுக்கு நிகராக எவரும் இல்லை."
    }
  ]
}