{
  "surah": 112,
  "translation": "en-itani",
  "ayahs": [
    {
      "number": 1,
      "text": "Say, “He is God, the One."
    },
    {
      "number": 2,
      "text": "God, the Absolute."
    },
    {
      "number": 3,
      "text": "He begets not, nor was He begotten."
    },
    {
      "number": 4,
      "text": "And there is nothing comparable to Him.”"
    }
  ]
}