{
  "surah": 109,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 0,
      "text": "പരമകാരുണികനും ദയാപരനുമായ അല്ലാഹുവിന്റെ നാമത്തില്‍."
    },
    {
      "number": 1,
      "text": "പറയുക: അല്ലയോ സത്യനിഷേധികളേ,"
    },
    {
      "number": 2,
      "text": "നിങ്ങള്‍ ആരാധിക്കുന്നവയെ ഞാന്‍ ആരാധിക്കുന്നില്ല."
    },
    {
      "number": 3,
      "text": "ഞാന്‍ ആരാധിക്കുന്നതിനെ ആരാധിക്കുന്നവരല്ല നിങ്ങള്‍."
    },
    {
      "number": 4,
      "text": "നിങ്ങള്‍ ആരാധിക്കുന്നവയെ ആരാധിക്കുന്നവനല്ല ഞാന്‍."
    },
    {
      "number": 5,
      "text": "ഞാന്‍ ആരാധിക്കുന്നതിനെ ആരാധിക്കുന്നവരല്ല നിങ്ങളും."
    },
    {
      "number": 6,
      "text": "നിങ്ങള്‍ക്ക് നിങ്ങളുടെ മതം. എനിക്ക് എന്റെ മതം."
    }
  ]
}