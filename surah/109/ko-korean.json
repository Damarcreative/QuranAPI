{
  "surah": 109,
  "translation": "ko-korean",
  "ayahs": [
    {
      "number": 0,
      "text": "자비로우시고 자애로우신 하나님의 이름으로"
    },
    {
      "number": 1,
      "text": "불신자들에게 일러 가로되"
    },
    {
      "number": 2,
      "text": "너희가 숭배하는 것을 내가 숭배하지 아니하며"
    },
    {
      "number": 3,
      "text": "내가 경배하는 분을 너희가 경배하지 아니하고"
    },
    {
      "number": 4,
      "text": "너희가 숭배했던 것들을 내가숭배하지 아니할 것이며"
    },
    {
      "number": 5,
      "text": "내가 경배한 그분을 너희가 경배하지 않을 것이니"
    },
    {
      "number": 6,
      "text": "너희에게는 너희의 종교가 있고 나에게는 나의 종교가 있을 뿐이라"
    }
  ]
}