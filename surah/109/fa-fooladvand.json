{
  "surah": 109,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "بگو: «ای کافران،"
    },
    {
      "number": 2,
      "text": "آنچه می‌پرستید، نمی‌پرستم."
    },
    {
      "number": 3,
      "text": "و آنچه می‌پرستم، شما نمی‌پرستید."
    },
    {
      "number": 4,
      "text": "و نه آنچه پرستیدید من می‌پرستم."
    },
    {
      "number": 5,
      "text": "و نه آنچه می‌پرستم شما می‌پرستید."
    },
    {
      "number": 6,
      "text": "دین شما برای خودتان، و دین من برای خودم.»"
    }
  ]
}