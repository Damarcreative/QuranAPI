{
  "surah": 109,
  "translation": "es-garcia",
  "ayahs": [
    {
      "number": 1,
      "text": "Di: \"¡Oh, incrédulos!"
    },
    {
      "number": 2,
      "text": "No adoro lo que adoran."
    },
    {
      "number": 3,
      "text": "Ni adoran ustedes a Quien yo adoro."
    },
    {
      "number": 4,
      "text": "Y jamás adoraré lo que adoran."
    },
    {
      "number": 5,
      "text": "Ni adorarán ustedes a Quien yo adoro."
    },
    {
      "number": 6,
      "text": "Ustedes tienen su religión y yo la mía\"."
    }
  ]
}