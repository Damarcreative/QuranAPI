{
  "surah": 69,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "እውነትን አረጋጋጪቱ (ትንሣኤ)፡፡"
    },
    {
      "number": 2,
      "text": "አረጋጋጪቱም (እርሷ) ምንድን ናት!"
    },
    {
      "number": 3,
      "text": "አረጋጋጪቱም ምን እንደኾነች ምን አሳወቀህ?"
    },
    {
      "number": 4,
      "text": "ሰሙድና ዓድ በቆርቋሪይቱ (ትንሣኤ) አስተባበሉ፡፡"
    },
    {
      "number": 5,
      "text": "ሠሙድማ ወሰን በሌላት ጩኸት ተጠፋ፤ (ተወደሙ)፡፡"
    },
    {
      "number": 6,
      "text": "ዓድማ በኀይል በምትንሻሻ ብርቱ ነፋስ ተጠፉ፡፡"
    },
    {
      "number": 7,
      "text": "ተከታታይ በኾኑ ሰባት ሌሊቶችና ስምንት መዓልቶች ውስጥ በእነርሱ ላይ ለቀቃት፡፡ ሕዝቦቹንም፤ በውስጧ የተጣሉ ኾነው ልክ ክፍት የኾኑ የዘንባባ ግንዶች መስለው ታያቸዋለህ፡፡"
    },
    {
      "number": 8,
      "text": "ለእነርሱም ቀሪን ታያለህን?"
    },
    {
      "number": 9,
      "text": "ፈርዖን ከበፊቱ የነበሩትም ሰዎች ተገልባጮቹም (ከተሞች) በኀጢአት (ሥራዎች) መጡ፡፡"
    },
    {
      "number": 10,
      "text": "የጌታቸውንም መልእክተኛ ትዕዛዝ ጣሱ፡፡ የበረታችንም አያያዝ ያዛቸው፡፡"
    },
    {
      "number": 11,
      "text": "እኛ ውሃው ባየለ ጊዜ በተንሻላይቱ ታንኳ ውስጥ ጫንናችሁ፡፡"
    },
    {
      "number": 12,
      "text": "ለእናንተ መገሰጫ ልናደርጋት አጥኒ የኾነችም ጆሮ ታጠናት ዘንድ፡፡"
    },
    {
      "number": 13,
      "text": "በቀንዱም አንዲት መንነፋት በተነፋች ጊዜ፡፡"
    },
    {
      "number": 14,
      "text": "ምድርና ጋራዎችም (ከስፍራቸው) በተነሱና አንዲትን መሰባበር በተሰባበሩ ጊዜ፡፡"
    },
    {
      "number": 15,
      "text": "በዚያ ቀን ኋኝቱ (ትንሣኤ) ትኾናለች፡፡"
    },
    {
      "number": 16,
      "text": "ሰማይም ትቀደዳለች፡፡ ስለዚህ እርሷ በዚያ ቀን ደካማ ናት፡፡"
    },
    {
      "number": 17,
      "text": "መላእክትም በየጫፎችዋ ላይ ይኾናሉ፡፡ የጌታህንም ዐርሽ በዚያ ቀን ስምንት መላእክት ከበላያቸው ይሸከማሉ፡፡"
    },
    {
      "number": 18,
      "text": "በዚያ ቀን ከእናንተ ተደባቂ (ነገሮች) የማይደበቁ ሲኾኑ ትቅቀረባላችሁ፡፡"
    },
    {
      "number": 19,
      "text": "መጽሐፉን በቀኙ የተሰጠ ሰውማ (ለጓደኞቹ) «እንኩ፤ መጽሐፌን አንብቡ» ይላል፡፡"
    },
    {
      "number": 20,
      "text": "«እኔ ምርመራየን የምገናኝ መኾኔን አረጋገጥኩ፤» (ተዘጋጀሁም ይላል)፡፡"
    },
    {
      "number": 21,
      "text": "እርሱም በተወደደች ኑሮ ውሰጥ ይኾናል፡፡"
    },
    {
      "number": 22,
      "text": "በከፍተኛይቱ ገነት ውስጥ፡፡"
    },
    {
      "number": 23,
      "text": "ፍሬዎችዋ ቅርቦች የኾኑ፡፡"
    },
    {
      "number": 24,
      "text": "በአለፉት ቀናት ውስጥ (በምድረ ዓለም) ባስቀደማችሁት ምክንያት ብሉ፤ ጠጡም፤ (ይባላሉ)፡፡"
    },
    {
      "number": 25,
      "text": "መጽሐፉንም በግራው የተሰጠማ «ዋ ጥፋቴ! ምነው መጽሐፌን ባልተሰጠሁ» ይላል፡፡"
    },
    {
      "number": 26,
      "text": "«ምርመራየንም ምን እንደኾነ ባላወቅኩ፡፡"
    },
    {
      "number": 27,
      "text": "«እርሷ (ሞት ሕይወቴን) ምነው ፈጻሚ በኾነች፡፡"
    },
    {
      "number": 28,
      "text": "«ገንዘቤ ከእኔ ምንንም አላብቃቃኝ፤ (አልጠቀመኝም)፡፡"
    },
    {
      "number": 29,
      "text": "«ኀይሌ ከእኔ ላይ ጠፋ» (ይላል)፡፡"
    },
    {
      "number": 30,
      "text": "«ያዙት፤ እሰሩትም፡፡"
    },
    {
      "number": 31,
      "text": "«ከዚያም በእሳት ውሰጥ አግቡት፡፡"
    },
    {
      "number": 32,
      "text": "«ከዚያም ርዝመቷ ሰባ ክንድ በኾነች ሰንሰለት ውስጥ አግቡት፡፡»"
    },
    {
      "number": 33,
      "text": "እርሱ ታላቅ በኾነው አላህ አያምንም ነበርና፡፡"
    },
    {
      "number": 34,
      "text": "ድኾችንም በማብላት ላይ አያግባባም ነበርና፡፡"
    },
    {
      "number": 35,
      "text": "ለእርሱም ዛሬ እዚህ ዘመድ የለውም፡፡"
    },
    {
      "number": 36,
      "text": "ምግብም ከእሳት ሰዎች ቁስል እጣቢ (እዥ) በስተቀር የለውም፡፡"
    },
    {
      "number": 37,
      "text": "ኀጢኣተኞች እንጅ ሌላ አይበላውም፤ (ይባላል)፡፡"
    },
    {
      "number": 38,
      "text": "በምታዩትም ነገር እምላለሁ፡፡"
    },
    {
      "number": 39,
      "text": "በማታዩትም ነገር፡፡"
    },
    {
      "number": 40,
      "text": "እርሱ (ቁርኣን) የተከበረ መልክተኛ ቃል ነው፡፡"
    },
    {
      "number": 41,
      "text": "እርሱም የባለቅኔ ቃል (ግጥም) አይደለም፡፡ ጥቂትን ብቻ ታምናላችሁ፡፡"
    },
    {
      "number": 42,
      "text": "የጠንቋይም ቃል አይደለም፡፡ ጥቂትን ብቻ ታስታውሳላችሁ፡፡"
    },
    {
      "number": 43,
      "text": "ከዓለማት ጌታ የተወረደ ነው፡፡"
    },
    {
      "number": 44,
      "text": "በእኛ ላይም ከፊልን ቃላት (ያላልነውን) በቀጠፈ ኖሮ፤"
    },
    {
      "number": 45,
      "text": "በኀይል በያዝነው ነበር፡፡"
    },
    {
      "number": 46,
      "text": "ከዚያም ከእርሱ የልቡን ሥር (የተንጠለጠለበትን ጅማት) በቆረጥን ነበር፡፡"
    },
    {
      "number": 47,
      "text": "ከእናንተም ውስጥ ከእርሱ ላይ ከልካዮች ምንም አይኖሩም፡፡"
    },
    {
      "number": 48,
      "text": "እርሱም (ቁርኣን) ለጥንቁቆቹ መገሠጫ ነው፡፡"
    },
    {
      "number": 49,
      "text": "እኛም ከእናንተ ውስጥ አስተባባዮች መኖራቸውን በእርግጥ እናውቃለን፡፡"
    },
    {
      "number": 50,
      "text": "እርሱም (ቁርኣን) በከሓዲዎቹ ላይ ጸጸት ነው፡፡"
    },
    {
      "number": 51,
      "text": "እርሱም የተረጋገጠ እውነት ነው፡፡"
    },
    {
      "number": 52,
      "text": "የታላቁን ጌታህንም ስም አወድስ፡፡"
    }
  ]
}