{
  "surah": 69,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Al<u>ha</u>qqa<b>tu</b>"
    },
    {
      "number": 2,
      "text": "M<u>a</u> al<u>ha</u>qqa<b>tu</b>"
    },
    {
      "number": 3,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> al<u>ha</u>qqa<b>tu</b>"
    },
    {
      "number": 4,
      "text": "Ka<u>thth</u>abat thamoodu waAA<u>a</u>dun bi<b>a</b>lq<u>a</u>riAAa<b>ti</b>"
    },
    {
      "number": 5,
      "text": "Faamm<u>a</u> thamoodu faohlikoo bi<b>al</b><u>tta</u>ghiya<b>ti</b>"
    },
    {
      "number": 6,
      "text": "Waamm<u>a</u> AA<u>a</u>dun faohlikoo biree<u>h</u>in <u>s</u>ar<u>s</u>arin AA<u>a</u>tiya<b>tin</b>"
    },
    {
      "number": 7,
      "text": "Sakhkharah<u>a</u> AAalayhim sabAAa lay<u>a</u>lin watham<u>a</u>niyata ayy<u>a</u>min <u>h</u>usooman fatar<u>a</u> alqawma feeh<u>a</u> <u>s</u>arAA<u>a</u> kaannahum aAAj<u>a</u>zu nakhlin kh<u>a</u>wiya<b>tun</b>"
    },
    {
      "number": 8,
      "text": "Fahal tar<u>a</u> lahum min b<u>a</u>qiya<b>tin</b>"
    },
    {
      "number": 9,
      "text": "Waj<u>a</u>a firAAawnu waman qablahu wa<b>a</b>lmutafik<u>a</u>tu bi<b>a</b>lkh<u>at</u>ia<b>ti</b>"
    },
    {
      "number": 10,
      "text": "FaAAa<u>s</u>aw rasoola rabbihim faakha<u>th</u>ahum akh<u>th</u>atan r<u>a</u>biya<b>tan</b>"
    },
    {
      "number": 11,
      "text": "Inn<u>a</u> lamm<u>a</u> <u>t</u>agh<u>a</u> alm<u>a</u>o <u>h</u>amaln<u>a</u>kum fee alj<u>a</u>riya<b>ti</b>"
    },
    {
      "number": 12,
      "text": "LinajAAalah<u>a</u> lakum ta<u>th</u>kiratan wataAAiyah<u>a</u> o<u>th</u>unun w<u>a</u>AAiya<b>tun</b>"
    },
    {
      "number": 13,
      "text": "Fai<u>tha</u> nufikha fee a<b>l</b><u>ss</u>oori nafkhatun w<u>ah</u>ida<b>tun</b>"
    },
    {
      "number": 14,
      "text": "Wa<u>h</u>umilati alar<u>d</u>u wa<b>a</b>ljib<u>a</u>lu fadukkat<u>a</u> dakkatan w<u>ah</u>ida<b>tan</b>"
    },
    {
      "number": 15,
      "text": "Fayawmai<u>th</u>in waqaAAati alw<u>a</u>qiAAa<b>tu</b>"
    },
    {
      "number": 16,
      "text": "Wa<b>i</b>nshaqqati a<b>l</b>ssam<u>a</u>o fahiya yawmai<u>th</u>in w<u>a</u>hiya<b>tun</b>"
    },
    {
      "number": 17,
      "text": "Wa<b>a</b>lmalaku AAal<u>a</u> arj<u>a</u>ih<u>a</u> waya<u>h</u>milu AAarsha rabbika fawqahum yawmai<u>th</u>in tham<u>a</u>niya<b>tun</b>"
    },
    {
      "number": 18,
      "text": "Yawmai<u>th</u>in tuAAra<u>d</u>oona l<u>a</u> takhf<u>a</u> minkum kh<u>a</u>fiya<b>tun</b>"
    },
    {
      "number": 19,
      "text": "Faamm<u>a</u> man ootiya kit<u>a</u>bahu biyameenihi fayaqoolu h<u>a</u>omu iqraoo kit<u>a</u>biyah"
    },
    {
      "number": 20,
      "text": "Innee <i><u>th</u></i>anantu annee mul<u>a</u>qin <u>h</u>is<u>a</u>biyah"
    },
    {
      "number": 21,
      "text": "Fahuwa fee AAeeshatin r<u>ad</u>iya<b>tin</b>"
    },
    {
      "number": 22,
      "text": "Fee jannatin AA<u>a</u>liya<b>tin</b>"
    },
    {
      "number": 23,
      "text": "Qu<u>t</u>oofuh<u>a</u> d<u>a</u>niya<b>tun</b>"
    },
    {
      "number": 24,
      "text": "Kuloo wa<b>i</b>shraboo haneean bim<u>a</u> aslaftum fee alayy<u>a</u>mi alkh<u>a</u>liya<b>ti</b>"
    },
    {
      "number": 25,
      "text": "Waamm<u>a</u> man ootiya kit<u>a</u>bahu bishim<u>a</u>lihi fayaqoolu y<u>a</u> laytanee lam oota kit<u>a</u>biyah"
    },
    {
      "number": 26,
      "text": "Walam adri m<u>a</u> <u>h</u>is<u>a</u>biyah"
    },
    {
      "number": 27,
      "text": "Y<u>a</u> laytah<u>a</u> k<u>a</u>nati alq<u>ad</u>iya<b>tu</b>"
    },
    {
      "number": 28,
      "text": "M<u>a</u> aghn<u>a</u> AAannee m<u>a</u>liyah"
    },
    {
      "number": 29,
      "text": "Halaka AAannee sul<u>ta</u>niyah"
    },
    {
      "number": 30,
      "text": "Khu<u>th</u>oohu faghullooh<b>u</b>"
    },
    {
      "number": 31,
      "text": "Thumma alja<u>h</u>eema <u>s</u>allooh<b>u</b>"
    },
    {
      "number": 32,
      "text": "Thumma fee silsilatin <u>th</u>arAAuh<u>a</u> sabAAoona <u>th</u>ir<u>a</u>AAan fa<b>o</b>slukooh<b>u</b>"
    },
    {
      "number": 33,
      "text": "Innahu k<u>a</u>na l<u>a</u> yuminu bi<b>A</b>ll<u>a</u>hi alAAa<i><u>th</u></i>eem<b>i</b>"
    },
    {
      "number": 34,
      "text": "Wal<u>a</u> ya<u>h</u>u<u>dd</u>u AAal<u>a</u> <u>t</u>aAA<u>a</u>mi almiskeen<b>i</b>"
    },
    {
      "number": 35,
      "text": "Falaysa lahu alyawma h<u>a</u>hun<u>a</u> <u>h</u>ameem<b>un</b>"
    },
    {
      "number": 36,
      "text": "Wal<u>a</u> <u>t</u>aAA<u>a</u>mun ill<u>a</u> min ghisleen<b>in</b>"
    },
    {
      "number": 37,
      "text": "L<u>a</u> yakuluhu ill<u>a</u> alkh<u>at</u>ioon<b>a</b>"
    },
    {
      "number": 38,
      "text": "Fal<u>a</u> oqsimu bim<u>a</u> tub<u>s</u>iroon<b>a</b>"
    },
    {
      "number": 39,
      "text": "Wam<u>a</u> l<u>a</u> tub<u>s</u>iroon<b>a</b>"
    },
    {
      "number": 40,
      "text": "Innahu laqawlu rasoolin kareem<b>in</b>"
    },
    {
      "number": 41,
      "text": "Wam<u>a</u> huwa biqawli sh<u>a</u>AAirin qaleelan m<u>a</u> tuminoon<b>a</b>"
    },
    {
      "number": 42,
      "text": "Wal<u>a</u> biqawli k<u>a</u>hinin qaleelan m<u>a</u> ta<u>th</u>akkaroon<b>a</b>"
    },
    {
      "number": 43,
      "text": "Tanzeelun min rabbi alAA<u>a</u>lameen<b>a</b>"
    },
    {
      "number": 44,
      "text": "Walaw taqawwala AAalayn<u>a</u> baAA<u>d</u>a alaq<u>a</u>weel<b>i</b>"
    },
    {
      "number": 45,
      "text": "Laakha<u>th</u>n<u>a</u> minhu bi<b>a</b>lyameen<b>i</b>"
    },
    {
      "number": 46,
      "text": "Thumma laqa<u>t</u>aAAn<u>a</u> minhu alwateen<b>a</b>"
    },
    {
      "number": 47,
      "text": "Fam<u>a</u> minkum min a<u>h</u>adin AAanhu <u>ha</u>jizeen<b>a</b>"
    },
    {
      "number": 48,
      "text": "Wainnahu lata<u>th</u>kiratun lilmuttaqeen<b>a</b>"
    },
    {
      "number": 49,
      "text": "Wainn<u>a</u> lanaAAlamu anna minkum muka<u>thth</u>ibeen<b>a</b>"
    },
    {
      "number": 50,
      "text": "Wainnahu la<u>h</u>asratun AAal<u>a</u> alk<u>a</u>fireen<b>a</b>"
    },
    {
      "number": 51,
      "text": "Wainnahu la<u>h</u>aqqu alyaqeen<b>i</b>"
    },
    {
      "number": 52,
      "text": "Fasabbi<u>h</u> bi<b>i</b>smi rabbika alAAa<i><u>th</u></i>eem<b>i</b>"
    }
  ]
}