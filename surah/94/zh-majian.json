{
  "surah": 94,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "難道我沒有為你而開拓你的胸襟嗎？"
    },
    {
      "number": 2,
      "text": "我卸下了你的重任"
    },
    {
      "number": 3,
      "text": "即使你的背擔負過重的，"
    },
    {
      "number": 4,
      "text": "而提高了你的聲望，"
    },
    {
      "number": 5,
      "text": "與艱難相伴的，確是容易，"
    },
    {
      "number": 6,
      "text": "與艱難相伴的，確是容易，"
    },
    {
      "number": 7,
      "text": "當你的事務完畢時，"
    },
    {
      "number": 8,
      "text": "你應當勤勞，你應當向你的主懇求。"
    }
  ]
}