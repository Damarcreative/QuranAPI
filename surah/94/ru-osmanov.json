{
  "surah": 94,
  "translation": "ru-osmanov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного."
    },
    {
      "number": 1,
      "text": "Разве не раскрыли Мы твое сердце [, Мухаммад, для веры]?"
    },
    {
      "number": 2,
      "text": "Не облегчили твою ношу,"
    },
    {
      "number": 3,
      "text": "отягчавшую твою спину?"
    },
    {
      "number": 4,
      "text": "Разве не возвысили Мы упоминание твоего [имени]?"
    },
    {
      "number": 5,
      "text": "Ведь, воистину, за тягостью - облегчение;"
    },
    {
      "number": 6,
      "text": "воистину, за тягостью - облегчение."
    },
    {
      "number": 7,
      "text": "Когда же ты освободишься [от джихада], то обратись к [молитве]"
    },
    {
      "number": 8,
      "text": "и устреми [помыслы] к Господу своему."
    }
  ]
}