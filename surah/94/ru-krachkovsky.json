{
  "surah": 94,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Разве Мы не раскрыли тебе твою грудь?"
    },
    {
      "number": 2,
      "text": "И не сняли с тебя твою ношу,"
    },
    {
      "number": 3,
      "text": "которая тяготила твою спину?"
    },
    {
      "number": 4,
      "text": "И возвысили твои поминания?"
    },
    {
      "number": 5,
      "text": "Ведь, поистине, с тягостью легкость, -"
    },
    {
      "number": 6,
      "text": "поистине, с тягостью легкость!"
    },
    {
      "number": 7,
      "text": "И когда ты покончишь, то труждайся"
    },
    {
      "number": 8,
      "text": "и к твоему Господу устремляйся!"
    }
  ]
}