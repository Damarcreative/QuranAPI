{
  "surah": 94,
  "translation": "ru-kalam",
  "ayahs": [
    {
      "number": 0,
      "text": "Хвала Аллаху – Господу миров [создавшему мир и управляющему им],"
    },
    {
      "number": 1,
      "text": "Разве Мы не раскрыли твою [о Мухаммад] грудь [твое сердце для света пророчества]?"
    },
    {
      "number": 2,
      "text": "[Разве мы] Не сняли с тебя бремя,"
    },
    {
      "number": 3,
      "text": "которое отягощало твою спину?"
    },
    {
      "number": 4,
      "text": "[Разве Мы не] Возвысили упоминание тебя?"
    },
    {
      "number": 5,
      "text": "И, поистине, за трудностью – облегчение."
    },
    {
      "number": 6,
      "text": "Поистине, за трудностью – облегчение."
    },
    {
      "number": 7,
      "text": "И если ты освободился [завершил дело], то трудись [возьмись за новое дело]."
    },
    {
      "number": 8,
      "text": "И устремись к Господу своему."
    }
  ]
}