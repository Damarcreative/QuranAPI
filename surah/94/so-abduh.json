      "text": "Miyaannaan kor yeelin magacaaga (xusiddaada)."
    },
    {
      "number": 5,
      "text": "Cidhiidhina waxaa ku dhaw fudayd (faraj)."
    },
    {
      "number": 6,
      "text": "Cidhiidhina waxaa ku dhaw fudayd."
    },
    {
