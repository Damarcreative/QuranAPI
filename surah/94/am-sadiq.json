{
  "surah": 94,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "ልብህን ለአንተ አላሰፋንልህምን? (አስፍተንልሃል)፡፡"
    },
    {
      "number": 2,
      "text": "ሸክምህንም ካንተ አውርደንልሃል፡፡"
    },
    {
      "number": 3,
      "text": "ያንን ጀርባህን ያከበደውን (ሸክም)፡፡"
    },
    {
      "number": 4,
      "text": "መወሳትህንም ላንተ ከፍ አድርገንልሃል፡፡"
    },
    {
      "number": 5,
      "text": "ከችግርም ጋር ምቾት አልለ፡፡"
    },
    {
      "number": 6,
      "text": "ከችግር ጋር በእርግጥ ምቾት አልለ፡፡"
    },
    {
      "number": 7,
      "text": "በጨረስክም ጊዜ ልፋ፡፡ (ቀጥል)፡፡"
    },
    {
      "number": 8,
      "text": "ወደ ጌታህም ብቻ ከጅል፡፡"
    }
  ]
}