  "translation": "es-cortes",
  "ayahs": [
    {
      "number": 0,
      "text": "¡En el nombre de Alá, el Compasivo, el Misericordioso!"
    },
    {
      "number": 1,
      "text": "¿No te hemos infundido ánimo,"
    },
    {
      "number": 2,
      "text": "Liberado de la carga"
    },
    {
      "number": 3,
      "text": "Que agobiaba tu espalda"
    },
    {
      "number": 4,
      "text": "Y alzado tu reputación?"
    },
    {
      "number": 5,
      "text": "¡La adversidad y la felicidad van a una!"
    },
    {
      "number": 6,
      "text": "¡La adversidad y la felicidad van a una!"
    },
    {
      "number": 7,
      "text": "Cuando estés libre, ¡mantente diligente!"
    },
    {
      "number": 8,
      "text": "Y a tu Señor ¡deséale ardientemente!"
    }
  ]
}