{
  "surah": 94,
  "translation": "fa-khorramshahi",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند بخشنده مهربان‌"
    },
    {
      "number": 1,
      "text": "آیا دلت را برایت گشاده نداشتیم؟"
    },
    {
      "number": 2,
      "text": "و بارت را [از دوشت‌] برنگرفتیم؟"
    },
    {
      "number": 3,
      "text": "همان که می‌خواست پشت را بشکند"
    },
    {
      "number": 4,
      "text": "و آوازه‌ات را بلند گرداندیم‌"
    },
    {
      "number": 5,
      "text": "بی‌گمان در جنب دشواری، آسانی است‌"
    },
    {
      "number": 6,
      "text": "آری در جنب دشواری آسانی است‌"
    },
    {
      "number": 7,
      "text": "پس چون فراغت یافتی، [در دعا] بکوش‌"
    },
    {
      "number": 8,
      "text": "و به سوی پروردگارت بگرای‌"
    }
  ]
}