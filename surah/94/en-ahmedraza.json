{
  "surah": 94,
  "translation": "en-ahmedraza",
  "ayahs": [
    {
      "number": 1,
      "text": "Did We not widen your bosom?"
    },
    {
      "number": 2,
      "text": "And relieve you of the burden –"
    },
    {
      "number": 3,
      "text": "Which had broken your back?"
    },
    {
      "number": 4,
      "text": "And We have exalted your remembrance for you."
    },
    {
      "number": 5,
      "text": "So indeed with hardship is ease."
    },
    {
      "number": 6,
      "text": "Indeed with hardship is ease."
    },
    {
      "number": 7,
      "text": "So when you finish the prayer, strive in supplication."
    },
    {
      "number": 8,
      "text": "And incline towards your Lord."
    }
  ]
}