{
  "surah": 94,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "آیا برای تو سینه‌ات را نگشاده‌ایم؟"
    },
    {
      "number": 2,
      "text": "و بار گرانت را از [دوش‌] تو برنداشتیم؟"
    },
    {
      "number": 3,
      "text": "[باری‌] که [گویی‌] پشت تو را شکست."
    },
    {
      "number": 4,
      "text": "و نامت را برای تو بلند گردانیدیم."
    },
    {
      "number": 5,
      "text": "پس [بدان که‌] با دشواری، آسانی است."
    },
    {
      "number": 6,
      "text": "آری، با دشواری، آسانی است."
    },
    {
      "number": 7,
      "text": "پس چون فراغت یافتی، به طاعت درکوش؛"
    },
    {
      "number": 8,
      "text": "و با اشتیاق، به سوی پروردگارت روی آور."
    }
  ]
}