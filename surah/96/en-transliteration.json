{
  "surah": 96,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Iqra biismi rabbika alla<u>th</u>ee khalaq<b>a</b>"
    },
    {
      "number": 2,
      "text": "Khalaqa alins<u>a</u>na min AAalaq<b>in</b>"
    },
    {
      "number": 3,
      "text": "Iqra warabbuka alakram<b>u</b>"
    },
    {
      "number": 4,
      "text": "Alla<u>th</u>ee AAallama bi<b>a</b>lqalam<b>i</b>"
    },
    {
      "number": 5,
      "text": "AAallama alins<u>a</u>na m<u>a</u> lam yaAAlam"
    },
    {
      "number": 6,
      "text": "Kall<u>a</u> inna alins<u>a</u>na laya<u>t</u>gh<u>a</u>"
    },
    {
      "number": 7,
      "text": "An ra<u>a</u>hu istaghn<u>a</u>"
    },
    {
      "number": 8,
      "text": "Inna il<u>a</u> rabbika a<b>l</b>rrujAA<u>a</u>"
    },
    {
      "number": 9,
      "text": "Araayta alla<u>th</u>ee yanh<u>a</u>"
    },
    {
      "number": 10,
      "text": "AAabdan i<u>tha</u> <u>s</u>all<u>a</u>"
    },
    {
      "number": 11,
      "text": "Araayta in k<u>a</u>na AAal<u>a</u> alhud<u>a</u>"
    },
    {
      "number": 12,
      "text": "Aw amara bi<b>al</b>ttaqw<u>a</u>"
    },
    {
      "number": 13,
      "text": "Araayta in ka<u>thth</u>aba watawall<u>a</u>"
    },
    {
      "number": 14,
      "text": "Alam yaAAlam bianna All<u>a</u>ha yar<u>a</u>"
    },
    {
      "number": 15,
      "text": "Kall<u>a</u> lain lam yantahi lanasfaAAan bi<b>al</b>nn<u>as</u>iya<b>ti</b>"
    },
    {
      "number": 16,
      "text": "N<u>as</u>iyatin k<u>ath</u>ibatin kh<u>at</u>ia<b>tin</b>"
    },
    {
      "number": 17,
      "text": "FalyadAAu n<u>a</u>diyah<b>u</b>"
    },
    {
      "number": 18,
      "text": "SanadAAu a<b>l</b>zzab<u>a</u>niya<b>ta</b>"
    },
    {
      "number": 19,
      "text": "Kall<u>a</u> l<u>a</u> tu<u>t</u>iAAhu wa<b>o</b>sjud wa<b>i</b>qtarib"
    }
  ]
}