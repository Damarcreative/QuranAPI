{
  "surah": 111,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "Tabbat yad<u>a</u> abee lahabin watab<b>ba</b>"
    },
    {
      "number": 2,
      "text": "M<u>a</u> aghn<u>a</u> AAanhu m<u>a</u>luhu wam<u>a</u> kasab<b>a</b>"
    },
    {
      "number": 3,
      "text": "Saya<u>s</u>l<u>a</u> n<u>a</u>ran <u>tha</u>ta lahab<b>in</b>"
    },
    {
      "number": 4,
      "text": "Wa<b>i</b>mraatuhu <u>h</u>amm<u>a</u>lata al<u>h</u>a<u>t</u>ab<b>i</b>"
    },
    {
      "number": 5,
      "text": "Fee jeedih<u>a</u> <u>h</u>ablun min masad<b>in</b>"
    }
  ]
}