{
  "surah": 111,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "願焰父兩手受傷！他必定受傷,"
    },
    {
      "number": 2,
      "text": "他的財產, 和他所獲得的, 將無裨于他,"
    },
    {
      "number": 3,
      "text": "他將入有焰的烈火,"
    },
    {
      "number": 4,
      "text": "他的擔柴的妻子, 也將入烈火,"
    },
    {
      "number": 5,
      "text": "她的頸上繫著一條堅實的繩子。"
    }
  ]
}