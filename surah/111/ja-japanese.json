{
  "surah": 111,
  "translation": "ja-japanese",
  "ayahs": [
    {
      "number": 0,
      "text": "慈悲あまねく慈愛深きアッラーの御名において。"
    },
    {
      "number": 1,
      "text": "アブー・ラハブの両手は滅び，かれも滅びてしまえ。"
    },
    {
      "number": 2,
      "text": "かれの富も儲けた金も，かれのために役立ちはしない。"
    },
    {
      "number": 3,
      "text": "やがてかれは，燃え盛る炎の業火の中で焼かれよう。"
    },
    {
      "number": 4,
      "text": "かれの妻はその薪を運ぶ，"
    },
    {
      "number": 5,
      "text": "首に棕櫚の荒縄かけて。"
    }
  ]
}