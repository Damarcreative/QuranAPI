{
  "surah": 111,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "بریده باد دو دست ابولهب، و مرگ بر او باد."
    },
    {
      "number": 2,
      "text": "دارایی او و آنچه اندوخت، سودش نکرد."
    },
    {
      "number": 3,
      "text": "بزودی در آتشی پرزبانه درآید."
    },
    {
      "number": 4,
      "text": "و زنش، آن هیمه‌کش [آتش فروز]،"
    },
    {
      "number": 5,
      "text": "بر گردنش طنابی از لیف خرماست."
    }
  ]
}