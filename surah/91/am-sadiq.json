{
  "surah": 91,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በፀሐይና በብርሃኗ እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "በጨረቃም በተከተላት ጊዜ፤"
    },
    {
      "number": 3,
      "text": "በቀኑም (ፀሐይን) በገለጻት ጊዜ፤"
    },
    {
      "number": 4,
      "text": "በሌሊቱም በሸፈናት ጊዜ፤"
    },
    {
      "number": 5,
      "text": "በሰማይቱም በገነባትም (ጌታ)፤"
    },
    {
      "number": 6,
      "text": "በምድሪቱም በዘረጋትም፤"
    },
    {
      "number": 7,
      "text": "በነፍስም ባስተካከላትም፤"
    },
    {
      "number": 8,
      "text": "አመጽዋንና ፍርሃትዋንም ባሳወቃት (አምላክ እምላለሁ)፡፡"
    },
    {
      "number": 9,
      "text": "(ከኀጢኣት) ያጠራት ሰው ፍላጎቱን በእርግጥ አገኘ፡፡"
    },
    {
      "number": 10,
      "text": "(በኀጢኣት) የሸፈናትም ሰው በእውነት አፈረ፡፡"
    },
    {
      "number": 11,
      "text": "ሠሙድ ወሰን በማለፍዋ አስተባበለች፡፡"
    },
    {
      "number": 12,
      "text": "ጠማማዋ በተንቀሳቀሰ ጊዜ፡፡"
    },
    {
      "number": 13,
      "text": "ለእነርሱም የአላህ መልክተኛ (ሷሊህ) «የአላህን ግመል የመጠጥ ተራዋንም (ተጠንቀቁ)» አላቸው፡፡"
    },
    {
      "number": 14,
      "text": "አስተባበሉትም፡፡ (ቋንጃዋን) ወጓትም፡፡ በኀጢኣታቸውም ምክንያት ጌታቸው (ቅጣትን) በእነርሱ ላይ ደመደመባቸው፤ አስተካከላትም፡፡"
    },
    {
      "number": 15,
      "text": "ፍጻሜዋንም (የምታስከትለውን) አያፈራም፡፡"
    }
  ]
}