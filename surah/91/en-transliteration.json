{
  "surah": 91,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>al</b>shshamsi wa<u>d</u>u<u>ha</u>h<u>a</u>"
    },
    {
      "number": 2,
      "text": "Wa<b>a</b>lqamari i<u>tha</u> tal<u>a</u>h<u>a</u>"
    },
    {
      "number": 3,
      "text": "Wa<b>al</b>nnah<u>a</u>ri i<u>tha</u> jall<u>a</u>h<u>a</u>"
    },
    {
      "number": 4,
      "text": "Wa<b>a</b>llayli i<u>tha</u> yaghsh<u>a</u>h<u>a</u>"
    },
    {
      "number": 5,
      "text": "Wa<b>al</b>ssam<u>a</u>i wam<u>a</u> ban<u>a</u>h<u>a</u>"
    },
    {
      "number": 6,
      "text": "Wa<b>a</b>lar<u>d</u>i wam<u>a</u> <u>t</u>a<u>ha</u>h<u>a</u>"
    },
    {
      "number": 7,
      "text": "Wanafsin wam<u>a</u> saww<u>a</u>h<u>a</u>"
    },
    {
      "number": 8,
      "text": "Faalhamah<u>a</u> fujoorah<u>a</u> wataqw<u>a</u>h<u>a</u>"
    },
    {
      "number": 9,
      "text": "Qad afla<u>h</u>a man zakk<u>a</u>h<u>a</u>"
    },
    {
      "number": 10,
      "text": "Waqad kh<u>a</u>ba man dass<u>a</u>h<u>a</u>"
    },
    {
      "number": 11,
      "text": "Ka<u>thth</u>abat thamoodu bi<u>t</u>aghw<u>a</u>h<u>a</u>"
    },
    {
      "number": 12,
      "text": "I<u>th</u>i inbaAAatha ashq<u>a</u>h<u>a</u>"
    },
    {
      "number": 13,
      "text": "Faq<u>a</u>la lahum rasoolu All<u>a</u>hi n<u>a</u>qata All<u>a</u>hi wasuqy<u>a</u>h<u>a</u>"
    },
    {
      "number": 14,
      "text": "Faka<u>thth</u>aboohu faAAaqarooh<u>a</u> fadamdama AAalayhim rabbuhum bi<u>th</u>anbihim fasaww<u>a</u>h<u>a</u>"
    },
    {
      "number": 15,
      "text": "Wal<u>a</u> yakh<u>a</u>fu AAuqb<u>a</u>h<u>a</u>"
    }
  ]
}