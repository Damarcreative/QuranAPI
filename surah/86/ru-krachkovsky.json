{
  "surah": 86,
  "translation": "ru-krachkovsky",
  "ayahs": [
    {
      "number": 1,
      "text": "Клянусь небом и идущим ночью!"
    },
    {
      "number": 2,
      "text": "А что даст тебе знать, что такое идущий ночью?"
    },
    {
      "number": 3,
      "text": "Звезда пронизывающая."
    },
    {
      "number": 4,
      "text": "Поистине, над всякой душой есть хранитель."
    },
    {
      "number": 5,
      "text": "Пусть же посмотрит человек, из чего он создан!"
    },
    {
      "number": 6,
      "text": "Создан из воды изливающейся."
    },
    {
      "number": 7,
      "text": "Выходит она из хребта и грудных костей."
    },
    {
      "number": 8,
      "text": "Поистине, Он в силах вернуть его снова,"
    },
    {
      "number": 9,
      "text": "в тот день, как будут испытуемы тайны."
    },
    {
      "number": 10,
      "text": "И нет у него ни силы, ни помощника."
    },
    {
      "number": 11,
      "text": "Клянусь небом, обладателем возврата."
    },
    {
      "number": 12,
      "text": "И землей, обладательницей раскалывания."
    },
    {
      "number": 13,
      "text": "Это, поистине, слово решающее,"
    },
    {
      "number": 14,
      "text": "и это - не шутка!"
    },
    {
      "number": 15,
      "text": "Они ведь замышляют хитрость."
    },
    {
      "number": 16,
      "text": "И Я замышляю хитрость."
    },
    {
      "number": 17,
      "text": "Дай же отсрочку неверным, отсрочь им немного!"
    }
  ]
}