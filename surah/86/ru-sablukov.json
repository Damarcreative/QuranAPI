{
  "surah": 86,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Клянусь небом, клянусь денницей"
    },
    {
      "number": 2,
      "text": "(О если бы кто вразумил тебя, что такое денница?"
    },
    {
      "number": 3,
      "text": "Это звезда ярко блистающая.)"
    },
    {
      "number": 4,
      "text": "Нет ни одной души, при которой не было бы стража."
    },
    {
      "number": 5,
      "text": "Да обратит человек взор на то, из чего творится он."
    },
    {
      "number": 6,
      "text": "Он творится из влаги, выливающейся,"
    },
    {
      "number": 7,
      "text": "Выходящей из чресел и костей груди."
    },
    {
      "number": 8,
      "text": "Действительно, Он может возвратить его к Себе,"
    },
    {
      "number": 9,
      "text": "В тот день, когда тайны будут явны,"
    },
    {
      "number": 10,
      "text": "Когда у него не будет ни силы своей, ни помощника."
    },
    {
      "number": 11,
      "text": "Клянусь небом, проливающим дожди;"
    },
    {
      "number": 12,
      "text": "Клянусь землею, выращающею травы:"
    },
    {
      "number": 13,
      "text": "Действительно, он есть слово самое правдивое,"
    },
    {
      "number": 14,
      "text": "А не есть он что - то шутливое."
    },
    {
      "number": 15,
      "text": "Они умышляют умысел,"
    },
    {
      "number": 16,
      "text": "И Я умышляю умысел."
    },
    {
      "number": 17,
      "text": "Потому, дай неверным отсрочку, дай им отсрочку на некоторое время."
    }
  ]
}