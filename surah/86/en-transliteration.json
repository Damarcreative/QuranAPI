{
  "surah": 86,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 1,
      "text": "Wa<b>al</b>ssam<u>a</u>i wa<b>al</b><u>tta</u>riq<b>i</b>"
    },
    {
      "number": 2,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> a<b>l</b><u>tta</u>riq<b>u</b>"
    },
    {
      "number": 3,
      "text": "A<b>l</b>nnajmu a<b>l</b>thth<u>a</u>qib<b>u</b>"
    },
    {
      "number": 4,
      "text": "In kullu nafsin lamm<u>a</u> AAalayh<u>a</u> <u>ha</u>fi<i><u>th</u></i><b>un</b>"
    },
    {
      "number": 5,
      "text": "Falyan<i><u>th</u></i>uri alins<u>a</u>nu mimma khuliq<b>a</b>"
    },
    {
      "number": 6,
      "text": "Khuliqa min m<u>a</u>in d<u>a</u>fiq<b>in</b>"
    },
    {
      "number": 7,
      "text": "Yakhruju min bayni a<b>l</b><u>ss</u>ulbi wa<b>al</b>ttar<u>a</u>ib<b>i</b>"
    },
    {
      "number": 8,
      "text": "Innahu AAal<u>a</u> rajAAihi laq<u>a</u>dir<b>un</b>"
    },
    {
      "number": 9,
      "text": "Yawma tubl<u>a</u> a<b>l</b>ssar<u>a</u>ir<b>u</b>"
    },
    {
      "number": 10,
      "text": "Fam<u>a</u> lahu min quwwatin wal<u>a</u> n<u>as</u>ir<b>in</b>"
    },
    {
      "number": 11,
      "text": "Wa<b>al</b>ssam<u>a</u>i <u>tha</u>ti a<b>l</b>rrajAA<b>i</b>"
    },
    {
      "number": 12,
      "text": "Wa<b>a</b>lar<u>d</u>i <u>tha</u>ti a<b>l</b><u>ss</u>adAA<b>i</b>"
    },
    {
      "number": 13,
      "text": "Innahu laqawlun fa<u>s</u>l<b>un</b>"
    },
    {
      "number": 14,
      "text": "Wam<u>a</u> huwa bi<b>a</b>lhazl<b>i</b>"
    },
    {
      "number": 15,
      "text": "Innahum yakeedoona kayd<u>a</u><b>n</b>"
    },
    {
      "number": 16,
      "text": "Waakeedu kayd<u>a</u><b>n</b>"
    },
    {
      "number": 17,
      "text": "Famahhili alk<u>a</u>fireena amhilhum ruwayd<u>a</u><b>n</b>"
    }
  ]
}