{
  "surah": 110,
  "translation": "ko-korean",
  "ayahs": [
    {
      "number": 0,
      "text": "자비로우시고 자애로우신 하나님의 이름으로"
    },
    {
      "number": 1,
      "text": "하나님의 도움으로 승리하는그때에"
    },
    {
      "number": 2,
      "text": "떼지어 하나님의 종교로 귀의하는 백성들을 그대는 보리니"
    },
    {
      "number": 3,
      "text": "주님을 찬미하고 주님께 관용을 구하라 실로 그분은 관용으로 충만하시니라"
    }
  ]
}