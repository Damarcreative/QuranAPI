{
  "surah": 110,
  "translation": "zh-jian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "当真主的援助和胜利降临,"
    },
    {
      "number": 2,
      "text": "而你看见众人成群结队地崇奉真主的宗教时,"
    },
    {
      "number": 3,
      "text": "你应当赞颂你的主超绝万物, 并且向他求饶, 他确是至宥的。"
    }
  ]
}