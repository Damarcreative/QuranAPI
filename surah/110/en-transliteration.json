    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "I<u>tha</u> j<u>a</u>a na<u>s</u>ru All<u>a</u>hi wa<b>a</b>lfat<u>h</u><b>u</b>"
