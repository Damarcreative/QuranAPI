    {
      "number": 0,
      "text": "Во имя Аллаха милостивого, милосердного!"
    },
    {
      "number": 1,
      "text": "Поистине, Мы даровали тебе обильный!"
    },
    {
      "number": 2,
      "text": "Помолись же Господу твоему и заколи!"
    },
    {
      "number": 3,
      "text": "Ведь ненавистник твой - он куцый."
    }
  ]
}