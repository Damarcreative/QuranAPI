{
  "surah": 108,
  "translation": "bn-hoque",
  "ayahs": [
    {
      "number": 1,
      "text": "নিঃসন্দেহ আমরা তোমাকে প্রাচুর্য দিয়েছি।"
    },
    {
      "number": 2,
      "text": "সুতরাং তোমার প্রভুর উদ্দেশ্যে নামায আদায় করো এবং কুরবানি করো।"
    },
    {
      "number": 3,
      "text": "তোমার বিদ্বেষকারীই তো স্বয়ং বঞ্চিত।"
    }
  ]
}