    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "我确已赐你多福,"
    },
    {
      "number": 2,
      "text": "故你应当为你的主而礼拜, 并宰牺牲。"
    },
    {
      "number": 3,
      "text": "怨恨你者, 确是绝后的。"
    }
  ]
}