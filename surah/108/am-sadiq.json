{
  "surah": 108,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "እኛ በጣም ብዙ በጎ ነገሮችን ሰጠንህ፡፡"
    },
    {
      "number": 2,
      "text": "ስለዚህ ለጌታህ ስገድ፤ (በስሙ) ሰዋም፡፡"
    },
    {
      "number": 3,
      "text": "ጠይህ (የሚጠላህ) እርሱ በእርግጥ (ዘሩ) የተቆረጠው ነው፡፡"
    }
  ]
}