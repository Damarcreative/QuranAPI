  "surah": 108,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 1,
      "text": "Мы дали тебе кевсер;"
    },
    {
      "number": 2,
      "text": "Потому молись Господу твоему и заколи жертву."
    },
    {
      "number": 3,
      "text": "Ненавидящий тебя исчезнет."
    }
  ]
