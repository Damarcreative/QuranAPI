{
  "surah": 108,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "我確已賜你多福,"
    },
    {
      "number": 2,
      "text": "故你應當為你的主而禮拜, 并宰犧牲。"
    },
    {
      "number": 3,
      "text": "怨恨你者, 確是絕后的。"
    }
  ]
}