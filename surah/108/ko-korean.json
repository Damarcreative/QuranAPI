  "surah": 108,
  "translation": "ko-korean",
  "ayahs": [
    {
      "number": 0,
      "text": "자비로우시고 자애로우신 하나님의 이름으로"
    },
    {
      "number": 1,
      "text": "하나님이 그대에게 풍성한 은혜를 베풀었나니"
    },
    {
      "number": 2,
      "text": "주님께 기도하고 제물을 바 치라"
    },
    {
      "number": 3,
      "text": "실로 그대의 적은 모든 희망 으로부터 단절된 자들이라"
    }
  ]
}