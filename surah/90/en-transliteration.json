{
  "surah": 90,
  "translation": "en-transliteration",
  "ayahs": [
    {
      "number": 0,
      "text": "Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>"
    },
    {
      "number": 1,
      "text": "L<u>a</u> oqsimu bih<u>atha</u> albalad<b>i</b>"
    },
    {
      "number": 2,
      "text": "Waanta <u>h</u>illun bih<u>atha</u> albalad<b>i</b>"
    },
    {
      "number": 3,
      "text": "Waw<u>a</u>lidin wam<u>a</u> walad<b>a</b>"
    },
    {
      "number": 4,
      "text": "Laqad khalaqn<u>a</u> alins<u>a</u>na fee kabad<b>in</b>"
    },
    {
      "number": 5,
      "text": "Aya<u>h</u>sabu an lan yaqdira AAalayhi a<u>h</u>ad<b>un</b>"
    },
    {
      "number": 6,
      "text": "Yaqoolu ahlaktu m<u>a</u>lan lubad<u>a</u><b>n</b>"
    },
    {
      "number": 7,
      "text": "Aya<u>h</u>sabu an lam yarahu a<u>h</u>ad<b>un</b>"
    },
    {
      "number": 8,
      "text": "Alam najAAal lahu AAaynayn<b>i</b>"
    },
    {
      "number": 9,
      "text": "Walis<u>a</u>nan washafatayn<b>i</b>"
    },
    {
      "number": 10,
      "text": "Wahadayn<u>a</u>hu a<b>l</b>nnajdayn<b>i</b>"
    },
    {
      "number": 11,
      "text": "Fal<u>a</u> iqta<u>h</u>ama alAAaqaba<b>ta</b>"
    },
    {
      "number": 12,
      "text": "Wam<u>a</u> adr<u>a</u>ka m<u>a</u> alAAaqaba<b>tu</b>"
    },
    {
      "number": 13,
      "text": "Fakku raqaba<b>tin</b>"
    },
    {
      "number": 14,
      "text": "Aw i<u>t</u>AA<u>a</u>mun fee yawmin <u>th</u>ee masghaba<b>tin</b>"
    },
    {
      "number": 15,
      "text": "Yateeman <u>tha</u> maqraba<b>tin</b>"
    },
    {
      "number": 16,
      "text": "Aw miskeenan <u>tha</u> matraba<b>tin</b>"
    },
    {
      "number": 17,
      "text": "Thumma k<u>a</u>na mina alla<u>th</u>eena <u>a</u>manoo wataw<u>as</u>aw bi<b>al</b><u>ss</u>abri wataw<u>as</u>aw bi<b>a</b>lmar<u>h</u>ama<b>ti</b>"
    },
    {
      "number": 18,
      "text": "Ol<u>a</u>ika a<u>s</u><u>ha</u>bu almaymana<b>ti</b>"
    },
    {
      "number": 19,
      "text": "Wa<b>a</b>lla<u>th</u>eena kafaroo bi<u>a</u>y<u>a</u>tin<u>a</u> hum a<u>s</u><u>ha</u>bu almashama<b>ti</b>"
    },
    {
      "number": 20,
      "text": "AAalayhim n<u>a</u>run mu<u>s</u>ada<b>tun</b>"
    }
  ]
}