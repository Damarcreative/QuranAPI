{
  "surah": 90,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "അങ്ങനെയല്ല; ഈ മക്കാനഗരം സാക്ഷി."
    },
    {
      "number": 2,
      "text": "നീ ഈ നഗരത്തില്‍ താമസിക്കുന്നവനല്ലോ."
    },
    {
      "number": 3,
      "text": "ജനയിതാവും അവന്‍ ജന്മമേകിയതും സാക്ഷി."
    },
    {
      "number": 4,
      "text": "നിശ്ചയം; നാം മനുഷ്യനെ സൃഷ്ടിച്ചത് ക്ളേശമനുഭവിക്കുന്നവനായാണ്."
    },
    {
      "number": 5,
      "text": "തന്നെ പിടികൂടാനാര്‍ക്കും കഴിയില്ലെന്നാണോ അവന്‍ കരുതുന്നത്?"
    },
    {
      "number": 6,
      "text": "അവന്‍ അവകാശപ്പെട്ടു; താന്‍ ധാരാളം ധനം തുലച്ചെന്ന്."
    },
    {
      "number": 7,
      "text": "അവന്‍ കരുതുന്നുവോ; അവനെ ആരും കാണുന്നില്ലെന്ന്."
    },
    {
      "number": 8,
      "text": "അവനു നാം കണ്ണിണകള്‍ നല്‍കിയില്ലേ?;"
    },
    {
      "number": 9,
      "text": "നാവും ചുണ്ടിണകളും?"
    },
    {
      "number": 10,
      "text": "തെളിഞ്ഞ രണ്ടു വഴികള്‍ നാമവന് കാണിച്ചുകൊടുത്തില്ലേ?"
    },
    {
      "number": 11,
      "text": "എന്നിട്ടും അവന്‍ മലമ്പാത താണ്ടിക്കടന്നില്ല."
    },
    {
      "number": 12,
      "text": "മലമ്പാത എന്തെന്ന് നിനക്കെന്തറിയാം?"
    },
    {
      "number": 13,
      "text": "അത് അടിമയുടെ മോചനമാണ്."
    },
    {
      "number": 14,
      "text": "അല്ലെങ്കില്‍ കൊടും വറുതി നാളിലെ അന്നദാനം."
    },
    {
      "number": 15,
      "text": "അടുത്ത ബന്ധുവായ അനാഥയ്ക്ക്."
    },
    {
      "number": 16,
      "text": "അല്ലെങ്കില്‍ പട്ടിണിക്കാരനായ മണ്ണുപുരണ്ട അഗതിക്ക്."
    },
    {
      "number": 17,
      "text": "പിന്നെ സത്യവിശ്വാസം സ്വീകരിക്കുകയും ക്ഷമയും കാരുണ്യവും പരസ്പരം ഉപദേശിക്കുകയും ചെയ്തവരില്‍ ഉള്‍പ്പെടലുമാണ്."
    },
    {
      "number": 18,
      "text": "അവര്‍ തന്നെയാണ് വലതു പക്ഷക്കാര്‍."
    },
    {
      "number": 19,
      "text": "നമ്മുടെ സൂക്തങ്ങളെ തള്ളിപ്പറഞ്ഞവരോ, അവര്‍ ഇടതുപക്ഷക്കാരും."
    },
    {
      "number": 20,
      "text": "അവര്‍ക്കുമേല്‍ മൂടപ്പെട്ട നരകമുണ്ട്."
    }
  ]
}