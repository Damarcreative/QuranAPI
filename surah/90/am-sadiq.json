{
  "surah": 90,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በዚህ አገር (በመካ) እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "አንተ በዚህ አገር ሰፋሪ ስትኾን፡፡"
    },
    {
      "number": 3,
      "text": "በወላጂም በወለዳቸውም ሰዎች (በአዳምና በዘሮቹ ሁሉ እምላለሁ)፡፡"
    },
    {
      "number": 4,
      "text": "ሰውን ሁሉ በእርግጥ በልፋት ውስጥ ኾኖ ፈጠርነው፡፡"
    },
    {
      "number": 5,
      "text": "በእርሱ ላይ አንድም የማይችል መኾኑን ይጠረጥራልን?"
    },
    {
      "number": 6,
      "text": "«ብዙን ገንዘብ አጠፋሁ» ይላል፡፡"
    },
    {
      "number": 7,
      "text": "አንድም ያላየው መኾኑን ያስባልን?"
    },
    {
      "number": 8,
      "text": "ለእርሱ ሁለት ዓይኖችን አላደረግንለትምን?"
    },
    {
      "number": 9,
      "text": "ምላስንና ሁለት ከንፈሮችንም፡፡"
    },
    {
      "number": 10,
      "text": "ሁለትን መንገዶችም አልመራነውምን?"
    },
    {
      "number": 11,
      "text": "ዓቀበቲቱንም አልወጣም፡፡"
    },
    {
      "number": 12,
      "text": "ዓቀበቲቱም (መውጣቷ) ምን እንደኾነች ምን አሳወቀህ?"
    },
    {
      "number": 13,
      "text": "(እርሱ) ጫንቃን መልቀቅ ነው፡፡"
    },
    {
      "number": 14,
      "text": "ወይም የረኃብ ባለቤት በኾነ ቀን ማብላት፡፡"
    },
    {
      "number": 15,
      "text": "የዝምድና ባለቤት የኾነን የቲም፤"
    },
    {
      "number": 16,
      "text": "ወይም የዐፈር ባለቤት የኾነን ድኻ (ማብላት ነው)፡፡"
    },
    {
      "number": 17,
      "text": "(ዐቀበቲቱን አልወጣም)፡፡ ከዚያም ከነዚያ ከአመኑትና በመታገስ አደራ ከተባባሉት፣ በማዘንም አደራ ከተባባሉት ሰዎች አልኾነም፡፡"
    },
    {
      "number": 18,
      "text": "እነዚያ (ይህንን የፈጸሙ) የቀኝ ጓዶች ናቸው፡፡"
    },
    {
      "number": 19,
      "text": "እነዚያም በአንቀጾቻችን የካዱት እነርሱ የግራ ጓዶች ናቸው፡፡"
    },
    {
      "number": 20,
      "text": "በእነርሱ ላይ የተዘጋች እሳት አልለች፡፡"
    }
  ]
}