{
  "surah": 90,
  "translation": "ta-tamil",
  "ayahs": [
    {
      "number": 1,
      "text": "இந்நகரத்தின் மீது நான் சத்தியம் செய்கின்றேன்."
    },
    {
      "number": 2,
      "text": "நீர் இந்நகரத்தில் (சுதந்திரமாகத்) தங்கியிருக்கும் நிலையில்,"
    },
    {
      "number": 3,
      "text": "பெற்றோர் மீதும், (பெற்ற) சந்ததியின் மீதும் சத்தியமாக,"
    },
    {
      "number": 4,
      "text": "திடமாக, நாம் மனிதனைக் கஷ்டத்தில் (உள்ளவனாகப்) படைத்தோம்."
    },
    {
      "number": 5,
      "text": "'ஒருவரும், தன் மீது சக்தி பெறவே மாட்டார்' என்று அவன் எண்ணிக் கொள்கிறானா?"
    },
    {
      "number": 6,
      "text": "\"ஏராளமான பொருளை நான் அழித்தேன்\" என்று அவன் கூறுகிறான்."
    },
    {
      "number": 7,
      "text": "தன்னை ஒருவரும் பார்க்கவில்லையென்று அவன் எண்ணுகிறானா?"
    },
    {
      "number": 8,
      "text": "அவனுக்கு நாம் இரண்டு கண்களை நாம் ஆக்கவில்லையா?"
    },
    {
      "number": 9,
      "text": "மேலும் நாவையும், இரண்டு உதடுகளையும் (ஆக்கவில்லையா)?"
    },
    {
      "number": 10,
      "text": "அன்றியும் (நன்மை, தீமையாகிய) இருபாதைகளை நாம் அவனுக்குக் காண்பித்தோம்."
    },
    {
      "number": 11,
      "text": "ஆயினும், அவன் கணவாயைக் கடக்கவில்லை."
    },
    {
      "number": 12,
      "text": "(நபியே!) கணவாய் என்பது என்ன என்பதை உமக்கு எது அறிவிக்கும்."
    },
    {
      "number": 13,
      "text": "(அது) ஓர் அடிமையை விடுவித்தல்-"
    },
    {
      "number": 14,
      "text": "அல்லது, பசித்திருக்கும் நாளில் உணவளித்தலாகும்."
    },
    {
      "number": 15,
      "text": "உறவினனான ஓர் அநாதைக்கோ,"
    },
    {
      "number": 16,
      "text": "அல்லது (வறுமை) மண்ணில் புரளும் ஓர் ஏழைக்கோ (உணவளிப்பதாகும்)."
    },
    {
      "number": 17,
      "text": "பின்னர், ஈமான் கொண்டு, பொறுமையைக் கொண்டு ஒருவருக்கொருவர் உபதேசித்தும், கிருபையைக் கொண்டு ஒருவருக் கொருவர் உபதேசித்தும் வந்தவர்களில் இருப்பதுவும் (கணவாயைக் கடத்தல்) ஆகும்."
    },
    {
      "number": 18,
      "text": "அத்தகையவர் தாம் வலப்புறத்தில் இருப்பவர்கள்."
    },
    {
      "number": 19,
      "text": "ஆனால், எவர்கள் நம் வசனங்களை நிராகரிக்கிறார்களோ, அவர்கள் தாம் இடப்பக்கத்தையுடையோர்."
    },
    {
      "number": 20,
      "text": "அவர்கள் மீது (எப்பக்கமும்) மூடப்பட்ட நெருப்பு இருக்கிறது."
    }
  ]
}