{
  "surah": 113,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "你說: 我求庇于曙光的主,"
    },
    {
      "number": 2,
      "text": "免遭他所創造者的毒害;"
    },
    {
      "number": 3,
      "text": "免遭黑夜籠罩時的毒害;"
    },
    {
      "number": 4,
      "text": "免遭吹破堅決的主意者的毒害;"
    },
    {
      "number": 5,
      "text": "免遭嫉妒時的毒害。"
    }
  ]
}