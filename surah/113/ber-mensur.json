{
  "surah": 113,
  "translation": "ber-mensur",
  "ayahs": [
    {
      "number": 0,
      "text": "S yisem n Öebbi, Aênin Ipêunun,"
    },
    {
      "number": 1,
      "text": "Ini: \"ad iyi Iûûeô, Mass n wanqaô!"
    },
    {
      "number": 2,
      "text": "Si lhemm n wayen Ixelq,"
    },
    {
      "number": 3,
      "text": "si lhemm n tillas ma ssant,"
    },
    {
      "number": 4,
      "text": "si lhemm n tid ipûuvun di tyersiwin,"
    },
    {
      "number": 5,
      "text": "si lhemm um$ecci, ma iusem."
    }
  ]
}