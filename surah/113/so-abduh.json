{
  "surah": 113,
  "translation": "so-abduh",
  "ayahs": [
    {
      "number": 1,
      "text": "Waxaad dhahdaa (Nabiyow) waxaan ka magangalay Eebeha Subaxa (abuuray)."
    },
    {
      "number": 2,
      "text": "Wixii shar leh sharkiisa."
    },
    {
      "number": 3,
      "text": "Iyo Habeenka sharkiisa markuu madoobaado."
    },
    {
      "number": 4,
      "text": "Iyo sharka Sixirrowga wax ku tufa guntimaha."
    },
    {
      "number": 5,
      "text": "Iyo sharka Xaasidka wax Xasda."
    }
  ]
}