{
  "surah": 113,
  "translation": "zh-jian",
  "ayahs": [
    {
      "number": 0,
      "text": "奉至仁至慈的真主之名"
    },
    {
      "number": 1,
      "text": "你说: 我求庇于曙光的主,"
    },
    {
      "number": 2,
      "text": "免遭他所创造者的毒害;"
    },
    {
      "number": 3,
      "text": "免遭黑夜笼罩时的毒害;"
    },
    {
      "number": 4,
      "text": "免遭吹破坚决的主意者的毒害;"
    },
    {
      "number": 5,
      "text": "免遭嫉妒时的毒害。"
    }
  ]
}