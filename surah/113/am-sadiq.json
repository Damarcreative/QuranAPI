{
  "surah": 113,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 0,
      "text": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡"
    },
    {
      "number": 1,
      "text": "በል «በተፈልቃቂው ጎህ ጌታ እጠበቃለሁ፡፡"
    },
    {
      "number": 2,
      "text": "«ከፈጠረው ፍጡር ሁሉ ክፋት፡፡"
    },
    {
      "number": 3,
      "text": "«ከሌሊትም ክፋት ባጨለመ ጊዜ፤"
    },
    {
      "number": 4,
      "text": "«በተቋጠሩ (ክሮች) ላይ ተፊዎች ከኾኑት (ደጋሚ) ሴቶችም ክፋት፡፡"
    },
    {
      "number": 5,
      "text": "«ከምቀኛም ክፋት በተመቀኘ ጊዜ፤ (እጠበቃለሁ በል)፡፡»"
    }
  ]
}