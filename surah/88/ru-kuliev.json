{
  "surah": 88,
  "translation": "ru-kuliev",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Аллаха, Милостивого, Милосердного!"
    },
    {
      "number": 1,
      "text": "Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?"
    },
    {
      "number": 2,
      "text": "Одни лица в тот день будут унижены,"
    },
    {
      "number": 3,
      "text": "изнурены и утомлены."
    },
    {
      "number": 4,
      "text": "Они войдут в Огонь жаркий."
    },
    {
      "number": 5,
      "text": "Их будут поить из источника кипящего"
    },
    {
      "number": 6,
      "text": "и кормить только ядовитыми колючками,"
    },
    {
      "number": 7,
      "text": "от которых не поправляются и которые не утоляют голода."
    },
    {
      "number": 8,
      "text": "Другие же лица в тот день будут радостны."
    },
    {
      "number": 9,
      "text": "Они будут довольны своими стараниями"
    },
    {
      "number": 10,
      "text": "в Вышних садах."
    },
    {
      "number": 11,
      "text": "Они не услышат там словоблудия."
    },
    {
      "number": 12,
      "text": "Там есть источник текущий."
    },
    {
      "number": 13,
      "text": "Там воздвигнуты ложа,"
    },
    {
      "number": 14,
      "text": "расставлены чаши,"
    },
    {
      "number": 15,
      "text": "разложены подушки,"
    },
    {
      "number": 16,
      "text": "и разостланы ковры."
    },
    {
      "number": 17,
      "text": "Неужели они не видят, как созданы верблюды,"
    },
    {
      "number": 18,
      "text": "как вознесено небо,"
    },
    {
      "number": 19,
      "text": "как водружены горы,"
    },
    {
      "number": 20,
      "text": "как распростерта земля?"
    },
    {
      "number": 21,
      "text": "Наставляй же, ведь ты - наставник,"
    },
    {
      "number": 22,
      "text": "и ты не властен над ними."
    },
    {
      "number": 23,
      "text": "А тех, кто отвернется и не уверует,"
    },
    {
      "number": 24,
      "text": "Аллах подвергнет величайшим мучениям."
    },
    {
      "number": 25,
      "text": "К Нам они вернутся,"
    },
    {
      "number": 26,
      "text": "и затем Мы потребуем у них отчета."
    }
  ]
}