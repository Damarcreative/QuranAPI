{
  "surah": 88,
  "translation": "ml-karakunnu",
  "ayahs": [
    {
      "number": 1,
      "text": "ആവരണം ചെയ്യുന്ന മഹാവിപത്തിന്റെ വാര്‍ത്ത നിനക്കു വന്നെത്തിയോ?"
    },
    {
      "number": 2,
      "text": "അന്ന് ചില മുഖങ്ങള്‍ പേടിച്ചരണ്ടവയായിരിക്കും."
    },
    {
      "number": 3,
      "text": "അധ്വാനിച്ച് തളര്‍ന്നവയും."
    },
    {
      "number": 4,
      "text": "ചുട്ടെരിയും നരകത്തിലവര്‍ ചെന്നെത്തും."
    },
    {
      "number": 5,
      "text": "തിളച്ചു മറിയുന്ന ഉറവയില്‍നിന്നാണവര്‍ക്ക് കുടിക്കാന്‍ കിട്ടുക."
    },
    {
      "number": 6,
      "text": "കയ്പുള്ള മുള്‍ചെടിയില്‍ നിന്നല്ലാതെ അവര്‍ക്കൊരാഹാരവുമില്ല."
    },
    {
      "number": 7,
      "text": "അത് ശരീരത്തെ പോഷിപ്പിക്കില്ല. വിശപ്പിനു ശമനമേകുകയുമില്ല."
    },
    {
      "number": 8,
      "text": "എന്നാല്‍ മറ്റു ചില മുഖങ്ങള്‍ അന്ന് പ്രസന്നങ്ങളായിരിക്കും."
    },
    {
      "number": 9,
      "text": "തങ്ങളുടെ കര്‍മങ്ങളെക്കുറിച്ച് സംതൃപ്തരും."
    },
    {
      "number": 10,
      "text": "അവര്‍ അത്യുന്നതമായ സ്വര്‍ഗീയാരാമത്തിലായിരിക്കും."
    },
    {
      "number": 11,
      "text": "വിടുവാക്കുകള്‍ അവിടെ കേള്‍ക്കുകയില്ല."
    },
    {
      "number": 12,
      "text": "അവിടെ ഒഴുകുന്ന അരുവിയുണ്ട്."
    },
    {
      "number": 13,
      "text": "ഉയര്‍ത്തിയൊരുക്കിയ മഞ്ചങ്ങളും."
    },
    {
      "number": 14,
      "text": "തയ്യാറാക്കിവെച്ച പാനപാത്രങ്ങളും."
    },
    {
      "number": 15,
      "text": "നിരത്തിവെച്ച തലയണകളും."
    },
    {
      "number": 16,
      "text": "പരത്തിവെച്ച പരവതാനികളും."
    },
    {
      "number": 17,
      "text": "അവര്‍ നോക്കുന്നില്ലേ? ഒട്ടകത്തെ; അതിനെ എങ്ങനെ സൃഷ്ടിച്ചുവെന്ന്?"
    },
    {
      "number": 18,
      "text": "ആകാശത്തെ; അതിനെ എവ്വിധം ഉയര്‍ത്തിയെന്ന്?"
    },
    {
      "number": 19,
      "text": "പര്‍വതങ്ങളെ, അവയെ എങ്ങനെ സ്ഥാപിച്ചുവെന്ന്?"
    },
    {
      "number": 20,
      "text": "ഭൂമിയെ, അതിനെ എങ്ങനെ വിശാലമാക്കിയെന്ന്?"
    },
    {
      "number": 21,
      "text": "അതിനാല്‍ നീ ഉദ്ബോധിപ്പിക്കുക. നീ ഒരുദ്ബോധകന്‍ മാത്രമാണ്."
    },
    {
      "number": 22,
      "text": "നീ അവരുടെ മേല്‍ നിര്‍ബന്ധം ചെലുത്തുന്നവനല്ല."
    },
    {
      "number": 23,
      "text": "ആര്‍ പിന്തിരിയുകയും സത്യത്തെ തള്ളിപ്പറയുകയും ചെയ്യുന്നുവോ,"
    },
    {
      "number": 24,
      "text": "അവനെ അല്ലാഹു കഠിനമായി ശിക്ഷിക്കും."
    },
    {
      "number": 25,
      "text": "നിശ്ചയമായും നമ്മുടെ അടുത്തേക്കാണ് അവരുടെ മടക്കം."
    },
    {
      "number": 26,
      "text": "പിന്നെ അവരുടെ വിചാരണയും നമ്മുടെ ചുമതലയിലാണ്"
    }
  ]
}