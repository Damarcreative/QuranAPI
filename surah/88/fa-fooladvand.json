{
  "surah": 88,
  "translation": "fa-fooladvand",
  "ayahs": [
    {
      "number": 0,
      "text": "به نام خداوند رحمتگر مهربان"
    },
    {
      "number": 1,
      "text": "آیا خبر «غاشیه» به تو رسیده است؟"
    },
    {
      "number": 2,
      "text": "در آن روز، چهره‌هایی زبونند،"
    },
    {
      "number": 3,
      "text": "که تلاش کرده، رنج [بیهوده‌] برده‌اند."
    },
    {
      "number": 4,
      "text": "[ناچار] در آتشی سوزان درآیند."
    },
    {
      "number": 5,
      "text": "از چشمه‌ای داغ نوشانیده شوند."
    },
    {
      "number": 6,
      "text": "خوراکی جز خار خشک ندارند،"
    },
    {
      "number": 7,
      "text": "[که‌] نه فربه کند، و نه گرسنگی را باز دارد."
    },
    {
      "number": 8,
      "text": "در آن روز، چهره‌هایی شادابند."
    },
    {
      "number": 9,
      "text": "از کوشش خود خشنودند."
    },
    {
      "number": 10,
      "text": "در بهشت برین‌اند."
    },
    {
      "number": 11,
      "text": "سخن بیهوده‌ای در آنجا نشنوند."
    },
    {
      "number": 12,
      "text": "در آن، چشمه‌ای روان باشد."
    },
    {
      "number": 13,
      "text": "تختهایی بلند در آنجاست."
    },
    {
      "number": 14,
      "text": "و قدحهایی نهاده شده."
    },
    {
      "number": 15,
      "text": "و بالشهایی پهلوی هم [چیده‌]."
    },
    {
      "number": 16,
      "text": "و فرشهایی [زربفت‌] گسترده."
    },
    {
      "number": 17,
      "text": "آیا به شتر نمی‌نگرند که چگونه آفریده شده؟"
    },
    {
      "number": 18,
      "text": "و به آسمان که چگونه برافراشته شده؟"
    },
    {
      "number": 19,
      "text": "و به کوه‌ها که چگونه برپا داشته شده؟"
    },
    {
      "number": 20,
      "text": "و به زمین که چگونه گسترده شده است؟"
    },
    {
      "number": 21,
      "text": "پس تذکر ده که تو تنها تذکردهنده‌ای."
    },
    {
      "number": 22,
      "text": "بر آنان تسلّطی نداری،"
    },
    {
      "number": 23,
      "text": "مگر کسی که روی بگرداند و کفر ورزد،"
    },
    {
      "number": 24,
      "text": "که خدا او را به آن عذاب بزرگتر عذاب کند."
    },
    {
      "number": 25,
      "text": "در حقیقت، بازگشت آنان به سوی ماست،"
    },
    {
      "number": 26,
      "text": "آنگاه حساب [خواستن از] آنان به عهده ماست."
    }
  ]
}