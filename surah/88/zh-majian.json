{
  "surah": 88,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "大災的消息，確已降臨你了，"
    },
    {
      "number": 2,
      "text": "在那日，將有許多人，是恭敬的、"
    },
    {
      "number": 3,
      "text": "勞動的、辛苦的，"
    },
    {
      "number": 4,
      "text": "他們將入烈火，"
    },
    {
      "number": 5,
      "text": "將飲沸泉，"
    },
    {
      "number": 6,
      "text": "他們沒有食物，但有荊棘，"
    },
    {
      "number": 7,
      "text": "既不能肥人，又不能充飢；"
    },
    {
      "number": 8,
      "text": "在那日，將有許多人，是享福的，"
    },
    {
      "number": 9,
      "text": "是為其勞績而愉快的，"
    },
    {
      "number": 10,
      "text": "他們將在崇高的樂園中，"
    },
    {
      "number": 11,
      "text": "聽不到惡言，"
    },
    {
      "number": 12,
      "text": "裡面有流泉，"
    },
    {
      "number": 13,
      "text": "裡面有高榻，"
    },
    {
      "number": 14,
      "text": "有陳設著的杯盞，"
    },
    {
      "number": 15,
      "text": "有排列著的靠枕，"
    },
    {
      "number": 16,
      "text": "有鋪展開的絨毯。"
    },
    {
      "number": 17,
      "text": "難道他們不觀察嗎？駱駝是怎樣造成的，"
    },
    {
      "number": 18,
      "text": "天是怎樣升高的，"
    },
    {
      "number": 19,
      "text": "山巒是怎樣豎起的，"
    },
    {
      "number": 20,
      "text": "大地是怎樣展開的。"
    },
    {
      "number": 21,
      "text": "你當教誨，你只是教誨（他們的），"
    },
    {
      "number": 22,
      "text": "你絕不是監察他們的，"
    },
    {
      "number": 23,
      "text": "但誰轉身離去而且不信道，"
    },
    {
      "number": 24,
      "text": "真主將以最大的刑罰懲治誰。"
    },
    {
      "number": 25,
      "text": "他們必定只歸於我，"
    },
    {
      "number": 26,
      "text": "他們的稽核，必定由我負責。"
    }
  ]
}