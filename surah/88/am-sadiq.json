{
  "surah": 88,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "የሸፋኝቱ (ትንሣኤ) ወሬ መጣህን?"
    },
    {
      "number": 2,
      "text": "ፊቶች በዚያ ቀን ተዋራጆች ናቸው፡፡"
    },
    {
      "number": 3,
      "text": "ሠሪዎች ለፊዎች ናቸው፡፡"
    },
    {
      "number": 4,
      "text": "ተኳሳን እሳት ይገባሉ፡፡"
    },
    {
      "number": 5,
      "text": "በጣም ከፈላች ምንጭ ይጋታሉ፡፡"
    },
    {
      "number": 6,
      "text": "ለእነርሱ ዶሪዕ ከሚባል (እሾሃም) ዛፍ እንጅ ሌላ ምግብ የላቸውም፡፡"
    },
    {
      "number": 7,
      "text": "የማያሰባ ከረኃብም የማያብቃቃ ከኾነው፡፡"
    },
    {
      "number": 8,
      "text": "ፊቶች በዚያ ቀን ተቀማጣዮች ናቸው፡፡"
    },
    {
      "number": 9,
      "text": "ለሥራቸው ተደሳቾች ናቸው፡፡"
    },
    {
      "number": 10,
      "text": "በከፍተኛ ገነት ውስጥ ናቸው፡፡"
    },
    {
      "number": 11,
      "text": "በውስጧ ውድቅን ነገር አይሰሙም፡፡"
    },
    {
      "number": 12,
      "text": "በውስጧ ፈሳሾች ምንጮች አልሉ፡፡"
    },
    {
      "number": 13,
      "text": "በውስጧ ከፍ የተደረጉ አልጋዎች አልሉ፡፡"
    },
    {
      "number": 14,
      "text": "በተርታ የተኖሩ ብርጭቆዎችም፡፡"
    },
    {
      "number": 15,
      "text": "የተደረደሩ መከዳዎችም፡፡"
    },
    {
      "number": 16,
      "text": "የተነጠፉ ስጋጃዎችም (አልሉ)፡፡"
    },
    {
      "number": 17,
      "text": "(ከሓዲዎች) አይመለከቱምን? ወደ ግመል እንዴት እነደተፈጠረች!"
    },
    {
      "number": 18,
      "text": "ወደ ሰማይም እንዴት ከፍ እንደ ተደረገች!"
    },
    {
      "number": 19,
      "text": "ወደ ተራራዎችም እንዴት እንደ ተቸከሉ!"
    },
    {
      "number": 20,
      "text": "ወደ ምድርም እንዴ እንደተዘረጋች (አይመለከቱምን?)"
    },
    {
      "number": 21,
      "text": "አስታውስም፤ አንተ አስታዋሽ ብቻ ነህና፡፡"
    },
    {
      "number": 22,
      "text": "በእነርሱ ላይ ተሿሚ (አስገዳጅ) አይደለህም፡፡"
    },
    {
      "number": 23,
      "text": "ግን (ከእውነት) የዞረና የካደ ሰው፤"
    },
    {
      "number": 24,
      "text": "አላህ ታላቁን ቅጣት ይቀጣዋል፡፡"
    },
    {
      "number": 25,
      "text": "መመለሻቸው ወደእኛ ብቻ ነው፡፡"
    },
    {
      "number": 26,
      "text": "ከዚያም ምርመራቸው በእኛ ላይ ብቻ ነው፡፡"
    }
  ]
}