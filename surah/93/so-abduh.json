{
  "surah": 93,
  "translation": "so-abduh",
  "ayahs": [
    {
      "number": 1,
      "text": "Eebe wuxuu ku dhaartay Barqinka."
    },
    {
      "number": 2,
      "text": "Iyo Habeenku markuu xasilo (Madoobaado)."
    },
    {
      "number": 3,
      "text": "Inaan Eebe ka tagin Nabiyow kuuna cadhoonin."
    },
    {
      "number": 4,
      "text": "Aakharana kaaga khayr badan Aduunka."
    },
    {
      "number": 5,
      "text": "Eebaana ku siindoona (wanaag) waadna raalli noqon."
    },
    {
      "number": 6,
      "text": "Miyuusan ku helin Eebahaa Adigoo Agoon ah oosan ku dhawaynin."
    },
    {
      "number": 7,
      "text": "Miyuunase ku helin Adigoo baadi ah oosan ku hanuuninin."
    },
    {
      "number": 8,
      "text": "Miyuunase ku helin Adigoo caydhi ah oosna ku hodminin (kuu waxyoonin)."
    },
    {
      "number": 9,
      "text": "Ee Agoonta ha xoogin (hana dhihin)."
    },
    {
      "number": 10,
      "text": "Ka wax su'aalina ha canaanan."
    },
    {
      "number": 11,
      "text": "Nicmada Eebahaana ka sheekee (ku mahadi)."
    }
  ]
}