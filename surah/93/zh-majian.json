{
  "surah": 93,
  "translation": "zh-majian",
  "ayahs": [
    {
      "number": 1,
      "text": "誓以上午，"
    },
    {
      "number": 2,
      "text": "誓以黑夜，當其寂靜的時候，"
    },
    {
      "number": 3,
      "text": "你的主沒有棄絕你，也沒有怨恨你；"
    },
    {
      "number": 4,
      "text": "後世於你，確比今世更好；"
    },
    {
      "number": 5,
      "text": "你的主將來必賞賜你，以至你喜悅。"
    },
    {
      "number": 6,
      "text": "難道他沒有發現你伶仃孤苦，而使你有所歸宿？"
    },
    {
      "number": 7,
      "text": "他曾發現你徘徊歧途，而把你引入正路；"
    },
    {
      "number": 8,
      "text": "發現你家境寒苦，而使你衣食豐足。"
    },
    {
      "number": 9,
      "text": "至於孤兒，你不要壓迫他；"
    },
    {
      "number": 10,
      "text": "至於乞丐，你不要喝斥他，"
    },
    {
      "number": 11,
      "text": "至於你的主所賜你的恩典呢，你應當宣示它。"
    }
  ]
}