{
  "surah": 93,
  "translation": "ru-sablukov",
  "ayahs": [
    {
      "number": 0,
      "text": "Во имя Бога милостивого, милосердного."
    },
    {
      "number": 1,
      "text": "Клянусь утренней светозарностью;"
    },
    {
      "number": 2,
      "text": "Клянусь ночью, когда она темнеет:"
    },
    {
      "number": 3,
      "text": "Господь твой не оставил тебя, и не презрел."
    },
    {
      "number": 4,
      "text": "Будущее для тебя лучше настоящего."
    },
    {
      "number": 5,
      "text": "Господь твой скоро ущедрит тебя, и ты будешь доволен"
    },
    {
      "number": 6,
      "text": "Не сиротой ли Он нашел тебя, и - приютил?"
    },
    {
      "number": 7,
      "text": "Не блуждающим ли Он нашел тебя, и - на прямой путь постановил?"
    },
    {
      "number": 8,
      "text": "Он нашел тебя бедным, и - обогатил."
    },
    {
      "number": 9,
      "text": "А потому, сироты не притесняй,"
    },
    {
      "number": 10,
      "text": "Нищего от себя криком не отгоняй,"
    },
    {
      "number": 11,
      "text": "Но благость Господа твоего им проявляй!"
    }
  ]
}