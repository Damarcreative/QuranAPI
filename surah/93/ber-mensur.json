{
  "surah": 93,
  "translation": "ber-mensur",
  "ayahs": [
    {
      "number": 1,
      "text": "S tafat n tûebêit!"
    },
    {
      "number": 2,
      "text": "S yiv, ma irked!"
    },
    {
      "number": 3,
      "text": "Ur k Iooi Mass ik, ur k Ikrih."
    },
    {
      "number": 4,
      "text": "Tudert taneggarut ik, a ppif tamezwarut ik."
    },
    {
      "number": 5,
      "text": "A k tôavi tikci, deqqal, n Mass ik."
    },
    {
      "number": 6,
      "text": "Day ur k id Iufa ara d agujil, Isduri k?"
    },
    {
      "number": 7,
      "text": "Iufa k id d utlif, Inha k."
    },
    {
      "number": 8,
      "text": "Iufa k id d igellil, I$at ik."
    },
    {
      "number": 9,
      "text": "Ihi, ur qehheô agujil."
    },
    {
      "number": 10,
      "text": "Ur ppara amappar."
    },
    {
      "number": 11,
      "text": "Wanag, $ef l$it n Mass ik, xas eêku."
    }
  ]
}