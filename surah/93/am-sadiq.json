{
  "surah": 93,
  "translation": "am-sadiq",
  "ayahs": [
    {
      "number": 1,
      "text": "በረፋዱ እምላለሁ፡፡"
    },
    {
      "number": 2,
      "text": "በሌሊቱም ጸጥ ባለ ጊዜ፤"
    },
    {
      "number": 3,
      "text": "ጌታህ አላሰናበተህም፤ አልጠላህምም፡፡"
    },
    {
      "number": 4,
      "text": "መጨረሻይቱም (ዓለም) ከመጀመሪያይቱ ይልቅ ላንተ በላጭ ናት፡፡"
    },
    {
      "number": 5,
      "text": "ጌታህም ወደ ፊት (ብዙን ስጦታ) በእርግጥ ይሰጥሃል፡፡ ትደሰታለህም፡፡"
    },
    {
      "number": 6,
      "text": "የቲም ኾነህ አላገኘህምና አላስጠጋህምን? (አስጠግቶሃል)፡፡"
    },
    {
      "number": 7,
      "text": "የሳትክም ኾነህ አገኘህ መራህም፡፡"
    },
    {
      "number": 8,
      "text": "ድኻም ኾነህ አገኘህ፤ አከበረህም፡፡"
    },
    {
      "number": 9,
      "text": "የቲምንማ አትጨቁን፡፡"
    },
    {
      "number": 10,
      "text": "ለማኝንም አትገላምጥ፡፡"
    },
    {
      "number": 11,
      "text": "በጌታህም ጸጋ አውራ፤ (ግለጻት)፡፡"
    }
  ]
}